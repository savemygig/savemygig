---
import Analytics from '../components/Analytics.astro';
import Brand from '../components/Brand.astro';
import Consent from '../components/Consent.astro';
import LangPicker from '../components/LangPicker.astro';
import Search from '../components/Search.astro';
import { VERSION_LABEL, IS_BETA } from '../lib/version';
import { LANGS, byCode, liveLangs, localizedPath, DEFAULT_LANG, anyTranslationLive, anyNotice, insideEmergencyMode } from '../i18n/registry';
import { t } from '../i18n/ui';
import TranslationNotice from '../components/TranslationNotice.astro';
import LangUndo from '../components/LangUndo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/gear" */
  path: string;
  /** noindex utility pages */
  noindex?: boolean;
  /** per-page OG card, e.g. "/og/exfat-vs-fat32-cdj.png" */
  ogImage?: string;
  /** Social share title, when it needs to be shorter/cleaner than the SEO
      <title> (Antonio, 2026-07-30: the keyword-rich title tag stays for
      Google, the share card gets the trimmed version). Falls back to title. */
  ogTitle?: string;
  /** Social share description, when the SEO meta description would repeat
      the ogTitle on a share card (Antonio, 2026-07-30: if the title already
      carries the positioning line, the description shouldn't repeat it).
      Falls back to description. */
  ogDescription?: string;
  /** Leaf label for the BreadcrumbList (e.g. "CDJ-3000X"). Optional: when it
      is absent the current page is simply left off the trail, which Google
      explicitly allows, rather than printing a slug-derived guess like
      "Cdj 3000x". Pass it on pages where the trail is worth completing. */
  crumbName?: string;
  /** Language code for THIS page: 'en' | 'pt' | 'es'. Defaults to English.
      `path` is always the ENGLISH path either way, e.g. "/checklist": the
      canonical URL, the hreflang set and every internal link are derived
      from it, so a translated page never has to know its own prefix. */
  lang?: string;
}

const { title, description, path, noindex = false, ogImage, ogTitle, ogDescription, crumbName, lang = DEFAULT_LANG } = Astro.props;
const L = byCode(lang);
const S = t(lang);
/** Localize an internal path for the CURRENT language. Every nav, footer and
    layout link goes through this, so a Portuguese page cannot link a reader
    back into English by accident. */
const lp = (p) => localizedPath(p, lang);
/** THE SEO GUARANTEE, in one expression. hreflang is emitted ONLY between
    languages that are actually live. While pt and es are unpublished this
    array is empty, so no page ever tells a crawler that a translation
    exists, and the English site's markup is byte-identical to what it was
    before i18n landed. Publishing is flipping `live` in the registry, which
    turns on the alternates, the sitemap entries and the indexable robots tag
    together, which is the only safe order. */
const alternates = anyTranslationLive() ? liveLangs() : [];
const SITE = 'https://www.savemygig.com';
// THE FOOTER SHARE PAYLOAD, localized 2026-08-05. All four buttons carried one
// hardcoded English sentence and the bare English homepage, under a heading
// (footer.shareLead) that has been translated for weeks. So a Brazilian DJ read
// "Todo DJ conhece um DJ que precisa disso:", pressed WhatsApp, and sent an
// English message pointing at the English site. Sharing is the cheapest growth
// this project has and it was pointing every non-English reader at a page they
// would not have shared themselves.
// No trailing slash on the English root: localizedPath('/') returns '/', and
// the shared link should read savemygig.com, not savemygig.com/. /pt and /es
// have no trailing slash either, which is how the site is actually served.
const shareUrl = `${SITE}${localizedPath('/', lang)}`.replace(/\/$/, '');
const shareText = S.footer.shareText;
const enc = (x) => encodeURIComponent(x);
const canonical = `${SITE}${localizedPath(path === '/' ? '/' : path, lang)}`;
// Default share image (2026-07-30): landscape 1200x630, cropped from
// Antonio's shield-logo social art so a shared link matches the same brand
// mark as his social posts instead of a mismatched portrait photo.
const ogImageUrl = `${SITE}${ogImage ?? '/images/og-share.jpg'}`;

// BreadcrumbList (2026-08-01). This is the markup Google reads to print
// "savemygig.com › Knowledge base › Pioneer DJ / AlphaTheta" under a result
// instead of a raw URL. The site had visible breadcrumbs on the knowledge
// pages but none of it was machine-readable, so search engines never showed
// the trail. Built from the canonical path so every page gets one for free.
//
// Only REAL hub pages are listed here. A segment with no page behind it (the
// /fix articles have no /fix index, for instance) is skipped rather than
// linked, because a breadcrumb pointing at a 404 is worse than no breadcrumb.
//
// LOCALIZED (2026-08-04). These labels used to be English string literals, so
// a Spanish page would have shipped a breadcrumb reading "Home > Knowledge
// base". They now come from the same UI catalogue the visible nav and footer
// use, which is the only way the printed trail and the marked-up trail can
// stay the same words in three languages. "Pioneer DJ / AlphaTheta" stays
// literal: it is two company names, and a company name is not translated.
//
// It is computed BEFORE the entity graph because the WebPage node below
// references it by @id.
// `at` (2026-08-05) is an OVERRIDE for the URL a hub crumb points at, for the
// one case where the segment is real but the page behind it is not. Without
// it a hub could only ever link its own path, which is why /fix could not be
// in this table at all: the 13 fix articles live under /fix and there is no
// /fix index page, so a crumb linking /fix would be a breadcrumb pointing at a
// 404, which the note above says is worse than no breadcrumb.
//
// /faq IS the fix library's hub, and this is not a new opinion: the visible
// breadcrumb on /fix/format-usb-for-cdj has read "Home / Fixes / Format a USB"
// with Fixes pointing at /faq since that page was written. This makes the
// machine-readable trail say the same thing as the printed one, which is the
// only version of this that is worth having.
const CRUMB_HUBS: Record<string, { name: string; at?: string }> = {
  '/knowledge': { name: S.footer.knowledgeBase },
  '/knowledge/pioneer-dj': { name: 'Pioneer DJ / AlphaTheta' },
  '/legal': { name: S.footer.legal },
  '/fix': { name: S.crumbs.fixes, at: '/faq' },
};

const crumbItems: { name: string; item?: string }[] = [{ name: S.home, item: `${SITE}${localizedPath('/', lang)}` }];
{
  const segs = path.split('/').filter(Boolean);
  let acc = '';
  for (const seg of segs) {
    acc += `/${seg}`;
    if (acc === path) break; // the leaf is handled separately below
    const hub = CRUMB_HUBS[acc];
    if (hub) crumbItems.push({ name: hub.name, item: `${SITE}${localizedPath(hub.at ?? acc, lang)}` });
  }
  // The current page. Google allows omitting it, so a page that did not pass
  // crumbName just ends its trail at the last hub instead of guessing a name.
  const leaf = crumbName ?? (path !== '/' ? CRUMB_HUBS[path]?.name : undefined);
  if (leaf) crumbItems.push({ name: leaf, item: canonical });
}

const breadcrumbSchema = crumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: crumbItems.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.item ? { item: c.item } : {}),
  })),
} : null;

// Site-wide entity graph. Search engines and AI answer engines both weight
// "who is this and why should I trust them", and until now none of it was
// machine-readable even though the logo, the four social profiles and the
// author name were all already on the page. The @id values let the per-page
// TechArticle/HowTo blocks reference one shared Organization and Person
// instead of each declaring an anonymous stub.
//
// THE CONTRACT WITH TRANSLATED PAGES (2026-08-04). Everything this layout
// emits is already language-aware: inLanguage comes from the registry tag,
// the breadcrumb labels come from the UI catalogue, and every URL in the
// graph goes through localizedPath, so a page rendered with lang="pt" emits
// a pt-BR graph on /pt/ URLs without knowing anything about itself.
//
// A PAGE-LEVEL block is the page file's own responsibility, because page
// prose lives in per-language page files by design (see src/i18n/ui.js). So
// when src/pages/pt/faq.astro is written, its JSON-LD must carry the
// TRANSLATED strings, inLanguage 'pt-BR', and @id values on the /pt/ URL:
// https://www.savemygig.com/pt/faq#webpage, not the English one. Copying the
// English block into a translated page would point two languages at one node
// and hand an answer engine Portuguese prose labelled English.
//
// The Organization's own name, slogan and description stay in English on
// every language. That is correct, not an oversight: there is ONE
// organisation with ONE @id across the whole site, schema.org has no way to
// give it three descriptions that Google reads, and "Save My Gig" and
// "DJ Booth Intelligence" are brand strings that are not translated anyway.
const entityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Save My Gig',
      url: SITE,
      email: 'info@savemygig.com',
      // The slogan property is real schema.org vocabulary and it is exactly
      // what an AI answer engine quotes when asked what this organisation is.
      slogan: 'DJ Booth Intelligence',
      description: 'The DJ Booth Intelligence platform. Free step-by-step rescue for Pioneer CDJ and XDJ USB failures, rekordbox export problems and error codes, plus the prevention system and booth knowledge behind them.',
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE}/#logo`,
        url: `${SITE}/images/save-my-gig-seal.png`,
        width: 512,
        height: 512,
        caption: 'Save My Gig',
      },
      image: { '@id': `${SITE}/#logo` },
      // NO founder property, and no Person in this graph, BY DECISION
      // (2026-08-03): Save My Gig is a faceless company, made by DJs for
      // DJs. No individual is named anywhere public, and schema IS public,
      // it ships in every page's source. Articles carry the ORGANIZATION as
      // author (valid schema.org, common for publications). The knowsAbout
      // list moved here from the old Person so the expertise signal stays.
      // Do not reintroduce personal names into any public surface.
      knowsAbout: [
        'Pioneer CDJ',
        'Pioneer XDJ',
        'rekordbox',
        'DJ USB troubleshooting',
        'FAT32 formatting',
        'DJ data recovery',
      ],
      sameAs: [
        'https://www.instagram.com/savemygig/',
        'https://www.tiktok.com/@savemygig',
        'https://x.com/savemygig',
        'https://www.youtube.com/@savemygig',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Save My Gig',
      description: 'DJ Booth Intelligence.',
      publisher: { '@id': `${SITE}/#org` },
      // LANGUAGE-AWARE (2026-08-04). Was hardcoded 'en', which would have
      // told Google that the Spanish and Portuguese builds were English the
      // moment they went live. L.tag is the registry's BCP 47 tag, so this
      // emits en / pt-BR / es without the page knowing anything.
      //
      // NO potentialAction/SearchAction here, deliberately: the site search
      // is a client-side overlay with no query URL (no /search?q=), so a
      // SearchAction would advertise an endpoint that does not exist.
      // Add it the day a real ?q= results page ships, not before.
      inLanguage: L.tag,
    },
    // THE PAGE ITSELF (2026-08-04). Until now the graph described the
    // publisher and the site but never the document, so BreadcrumbList and
    // the per-page TechArticle/HowTo blocks were floating with nothing to
    // attach to and an answer engine had no single node saying "this URL is
    // about X, in language Y, and it is free to read". One WebPage node per
    // page fixes all three. Every value here is already in the <head> above
    // as <title>, <meta description>, <link canonical> and <html lang>, so
    // nothing is asserted that the page does not already assert.
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#org` },
      publisher: { '@id': `${SITE}/#org` },
      inLanguage: L.tag,
      // True and load-bearing for answer engines: no paywall, no account,
      // no metered access anywhere on this site. It tells a crawler the
      // text it can see is the whole text a human sees.
      isAccessibleForFree: true,
      ...(breadcrumbSchema ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
  ],
};
---
<!doctype html>
{/* data-sw-lang: which language's offline copy this page installs. It used to
    reach the registration script through define:vars, which forced that script
    inline and re-sent it inside all 143 documents. The worker precaches ONE
    language and a different script URL is a different worker, so the DEFAULT
    language maps to an empty string here (no ?lang, the original worker URL)
    and every other language to its own code. The mapping stays in the layout,
    beside the registry it comes from, rather than being re-derived from
    <html lang> in script, which would have to know that pt is served as pt-BR. */}
<html lang={L.tag} dir={L.dir} data-sw-lang={lang === DEFAULT_LANG ? '' : lang}>
<head>
  <meta charset="utf-8" />
  {/* DO NOT MOVE, DO NOT DELETE, AND DO NOT LET ANYTHING BE INSERTED IN ITS
      PLACE. Without this line a phone renders the page at a 980px virtual
      viewport and shows the DESKTOP layout, shrunk: the full horizontal nav
      instead of the drawer, unreadable type, the footer in four columns.
      It was deleted by accident on 2026-08-05 while the language detection
      block below was being added, it shipped, and it was caught only because
      Antonio opened the site on his own iPhone. Every mobile visitor between
      those two moments got a broken site, on a product whose entire audience
      is holding a phone in a dark booth. scripts/check-head.mjs now fails the
      build if it ever goes missing again. */}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  {/* LANGUAGE DETECTION. Built exactly to the spec approved on 2026-08-03,
      and it emits NOTHING AT ALL until a translation is actually live, so
      today this is zero bytes on every page. Four rules, each of which is
      the reason a normal i18n redirect damages a site and this one does not:

      1. BROWSER LANGUAGE, NEVER COUNTRY OR IP. IP-based routing is what
         actually breaks indexing. Googlebot crawls from the US reporting
         en-US, so it stays on English and is never sent anywhere.
      2. CLIENT SIDE ONLY. The Cloudflare edge never routes by language, so
         one URL always returns one page to everybody, crawler or not.
      3. THE BARE ROOT AND NOTHING ELSE. Somebody who clicked a search
         result for a specific page gets exactly that page in exactly that
         language. A deep link is never redirected, ever.
      4. IT NEVER INTERRUPTS. No modal, no "we noticed you speak...". It
         silently changes which language the content is in, and the picker
         is the override. A DJ thirty minutes from a set meets no dialog.

      RULE 4, AMENDED 2026-08-05. Antonio clicked a link to the plain domain
      from WhatsApp and landed on the SPANISH site with no explanation and no
      obvious way back. Everything above worked as specified; the specification
      was wrong. "Never interrupt" was right about modals and wrong about
      silence, because moving somebody to another language without saying so is
      exactly how a shared link reads as broken, and the person it hurts is the
      one whose browser guessed wrong, who had no way to say so short of
      hunting the picker out of the menu.
      So the redirect now leaves a mark, and the page it lands on shows ONE
      dismissible line offering the way back (src/components/LangUndo.astro).
      Not a dialog, not a question that blocks reading: an acknowledgement.
      Nothing else changed. The URL still decides what is on screen, deep links
      are still never redirected and never see the line, and arriving still only
      SEEDS an empty preference. Tapping the line's link is a deliberate pick,
      so THAT overwrites, the same way the picker does.

      THE MARK IS A sessionStorage FLAG, NOT ?from=auto. A query parameter would
      create a second crawlable URL for the two most important pages on the
      translated sites: a canonical and hreflang problem, an extra row in the
      search index and a second page in analytics, all to carry one bit for one
      pageview. This carries the bit with no URL variant at all.

      A NOTE ON HOSTS, because it will come up again and it is NOT fixable here:
      www.savemygig.com and savemygig.com are SEPARATE localStorage origins. A
      preference picked on one does not exist on the other, so a visitor who
      chose English on www can still be guessed at on the bare host, and the
      undo line above is what saves them when that happens. Making the two
      hosts one storage origin needs a host-level redirect in Cloudflare, which
      is Antonio's to set. Do not try to paper over it in script: reading the
      other host's storage is not possible, and syncing it through a URL
      parameter would reintroduce exactly the crawlable variants the paragraph
      above exists to avoid.

      It runs before <title> deliberately: at the root, the redirect should
      happen before the browser starts fetching anything else. */}
  {anyTranslationLive() && (
    <script
      is:inline
      define:vars={{
        LIVE: liveLangs().map((l) => l.code),
        PREFIX: Object.fromEntries(LANGS.map((l) => [l.code, l.prefix])),
        PAGE_LANG: lang,
        DEF: DEFAULT_LANG,
        IS_ROOT: path === '/',
      }}
    >
      (function () {
        var KEY = 'SMG_LANG';
        function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function set(v) { try { localStorage.setItem(KEY, v); } catch (e) { /* private mode */ } }

        // THE "YOU WERE MOVED" MARK. sessionStorage, so it dies with the tab
        // and creates no URL anything can crawl, cache or count. It is written
        // immediately before the redirect and READ ONCE on the other side.
        var AUTO = 'SMG_AUTO_LANG';
        function markAuto(v) { try { sessionStorage.setItem(AUTO, v); } catch (e) { /* private mode: no line, which is the old behaviour */ } }
        // Consuming, not peeking. Removing it on read is what guarantees the
        // line appears on the redirect's own landing pageview and never again,
        // including if the visitor comes back to this page later in the session.
        function takeAuto() {
          try {
            var v = sessionStorage.getItem(AUTO);
            if (v !== null) sessionStorage.removeItem(AUTO);
            return v;
          } catch (e) { return null; }
        }

        // ARRIVING IS NOT CHOOSING. Antonio's rule, 2026-08-05: the language
        // the site remembers is the last one the visitor PICKED, and it
        // survives into the next session.
        //
        // So this branch only ever SEEDS an empty preference, it never
        // overwrites one. A first-time visitor who lands on a Portuguese page
        // from a search has told us something real, and we keep it. A visitor
        // who already chose English in the header and then opens a Portuguese
        // link a friend sent them has NOT changed their mind, and the first
        // version of this silently replaced their choice with an accident.
        // They still read that page in Portuguese, because the URL always
        // decides what is on screen, but the plain domain still gives them
        // English next time.
        //
        // The picker writes SMG_LANG itself and always overwrites, which is
        // what makes a deliberate change stick. This branch NEVER navigates,
        // which is what keeps deep links untouched.
        if (PAGE_LANG !== DEF) {
          // Consume the mark on EVERY translated page, not just the homepage.
          // The redirect can only land on a prefixed homepage, so anywhere else
          // finding a mark means it was left over, and a leftover that survives
          // is a line that appears on a pageview nobody was redirected to.
          var auto = takeAuto();
          // The flag has to name THIS language and this has to be the page the
          // redirect targets, or it is not the landing pageview and there is
          // nothing to acknowledge. LangUndo.astro reads this global; it is the
          // only thing that ever reveals the line.
          if (auto === PAGE_LANG && IS_ROOT) window.__smgAutoLang = PAGE_LANG;
          if (LIVE.indexOf(PAGE_LANG) > -1 && !get()) set(PAGE_LANG);
          return;
        }
        if (!IS_ROOT) return;

        // Only here, on the plain domain, may anything move.
        var want = get();
        if (!want || LIVE.indexOf(want) < 0) {
          want = null;
          var navs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < navs.length && !want; i++) {
            // "pt-BR" and "pt-PT" both mean the Portuguese site. Matching on
            // the base subtag is the whole reason a Portuguese phone set to
            // any region lands correctly.
            var base = String(navs[i]).toLowerCase().split('-')[0];
            if (LIVE.indexOf(base) > -1) want = base;
          }
        }
        if (!want || want === DEF) return;
        var to = PREFIX[want];
        // Detection does NOT write SMG_LANG. Landing on the prefixed page
        // does, one line above, on the next load. A guess is not a choice
        // until the visitor has been shown its result.
        if (to) {
          // The one place the mark is ever written, so the undo line cannot
          // appear on anything except this redirect's own destination.
          markAuto(want);
          location.replace(to + location.search + location.hash);
        }
      })();
    </script>
  )}
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* An unpublished language is noindex REGARDLESS of the page's own flag.
      This is the belt to the registry's braces: even if a translated page
      were somehow added to the sitemap, the page itself refuses indexing. */}
  {noindex || !L.live
    ? <meta name="robots" content={L.live ? 'noindex,follow' : 'noindex,nofollow'} />
    : <meta name="robots" content="index,follow" />}
  {/* Matches --bg and the manifest theme_color, so the browser chrome is the
      same black as the page instead of a flatter pure black beside it. */}
  <meta name="theme-color" content="#0a0a0b" />
  {/* hreflang. Reciprocal and self-referencing, which is what Google
      requires: every version lists every version INCLUDING itself, and
      x-default points at English as the catch-all for languages we do not
      serve. Empty while nothing is published. */}
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.tag} href={`${SITE}${localizedPath(path === '/' ? '/' : path, a.code)}`} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={`${SITE}${path === '/' ? '/' : path}`} />
  )}
  <meta property="og:locale" content={L.ogLocale} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Save My Gig" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {/* Points at the shield the page already loads. favicon.svg was a
      byte-identical copy, so browsers fetched the same 9.9KB twice under
      two URLs. Verified with cmp. */}
  <link rel="icon" type="image/svg+xml" href="/images/logo-shield.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Save My Gig" />
  {/* FONT PRELOADS DELETED 2026-08-04, on measurement, not taste. Both faces
      are font-display:swap, so they never blocked paint; the preloads simply
      pulled 60KB to the front of the queue ahead of the document itself.
      Removing them, median of 7 throttled runs: FCP home 568 to 280ms,
      /emergency 532 to 272, /checklist 504 to 288, /faq 512 to 264, the
      CDJ-3000 page 568 to 264. LCP fell 128 to 168ms on every text-LCP page
      and blocking time roughly halved. The cost is a slightly larger font
      swap, which lifts homepage CLS from 0.007 to 0.023, still five times
      inside the 0.1 budget. Moving them below the stylesheet does nothing
      (the preload scanner finds them regardless) and fetchpriority="low"
      does nothing either. Both were measured before deleting. */}
  <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  <Analytics />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">{S.skip}</a>
  {/* CONSENT SITS HERE, NOT AT THE END OF THE BODY (2026-08-05).
      It is role="dialog" and it is the first thing a visitor is asked, so a
      keyboard or screen-reader user should meet it where they meet it
      visually: first. Rendered last, it was reachable only after tabbing
      through the entire header, the whole page and the whole footer.

      AND IT IS NOT ON /emergency AT ALL. That page is the triage screen: a DJ
      opens it because something is broken right now, and the five doors are
      the only thing on it. A cookie banner is a fixed layer over the bottom
      door and a decision about analytics standing between a DJ and the
      decision they actually came to make. The rescue tunnel has never carried
      it (Tunnel.astro does not include the component); the triage screen is
      the same situation one tap earlier. The choice is still asked everywhere
      else, and it is still asked before anything is measured: Analytics only
      ever runs through __smgLoadAnalytics, which only a stored yes calls.

      THE TEST IS insideEmergencyMode(), NOT `path !== '/emergency'`
      (2026-08-06). It shipped as the literal on the same day the helper was
      extracted into src/i18n/registry.js to be the single definition of this
      boundary, which left two of them. That is not hypothetical tidiness: the
      autolinker had the same split the same day, its copy said /protocol and
      stopped, and /emergency shipped six injected links out of the rescue as a
      result. Behaviour here is identical today, because Base renders /emergency
      and Tunnel renders /protocol, but the next page to join Emergency Mode is
      now covered instead of silently getting the banner back. */}
