---
import Analytics from '../components/Analytics.astro';
import Consent from '../components/Consent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/gear" */
  path: string;
  /** noindex utility pages */
  noindex?: boolean;
  /** per-page OG card, e.g. "/og/exfat-vs-fat32-cdj.png" */
  ogImage?: string;
}

const { title, description, path, noindex = false, ogImage } = Astro.props;
const canonical = `https://www.savemygig.com${path === '/' ? '/' : path}`;
const ogImageUrl = `https://www.savemygig.com${ogImage ?? '/images/dj-usb-not-detected-emergency.webp'}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow" />}
  <meta name="theme-color" content="#000000" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Save My Gig!" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600&display=swap" />
  <Analytics />
  <slot name="head" />
</head>
<body>
  <header class="site-nav-wrap">
    <div class="site-nav">
      <a href="/" class="nav-brand">
        <span class="nb-name">Save My Gig<span class="accent">!</span></span>
        <span class="nb-tag">DJ rescue and prevention</span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
      <nav class="nav-links" id="navLinks" aria-label="Site">
        <a href="/" class="nav-home">Home</a>
        <a href="/emergency">Emergency</a>
        <a href="/prepare">Prevention</a>
        <a href="/checklist">Checklist</a>
        <a href="/recovery">Recovery</a>
        <a href="/gear">Gear</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>
  <slot />
  <footer class="site-footer">
    <div class="foot-share">
      <p class="foot-share-h">Send it to a DJ friend.</p>
      <p class="foot-share-sub">The more DJs know about it, the more gigs it saves.</p>
      <div class="foot-share-btns">
        <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp" href="https://wa.me/?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention%2C%20for%20when%20your%20USB%20dies%20before%20a%20set.%20https%3A%2F%2Fwww.savemygig.com">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4zm4.3 9.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7 1c-.2.1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.5-1.1v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3c-.3.3-1 1-1 2.3s1 2.7 1.1 2.9 2 3.1 4.9 4.3c1.8.7 2.5.8 3.4.6.5 0 1.4-.5 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on Telegram" href="https://t.me/share/url?url=https%3A%2F%2Fwww.savemygig.com&text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 2.9 11.6c-1.1.4-1 1.5-.1 1.8l4.7 1.5 1.8 5.7c.2.5.4.7.9.7.4 0 .7-.2 1-.5l2.3-2.3 4.9 3.6c.9.5 1.6.2 1.8-.8l3.3-15.4c.3-1.2-.4-1.8-1.6-1.3zM8.7 14.2l9-5.6c.4-.3.8-.1.5.2l-7.3 6.6-.3 3z"/></svg>
          <span>Telegram</span>
        </a>
        <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on X" href="https://twitter.com/intent/tweet?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention&url=https%3A%2F%2Fwww.savemygig.com">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
          <span>X</span>
        </a>
        <button type="button" class="share-btn" id="shareCopy" aria-label="Copy link">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
          <span>Copy link</span>
        </button>
      </div>
    </div>

    <div class="foot-feedback">
      <p class="foot-feedback-h">Got an idea or found a bug?</p>
      <p class="foot-feedback-sub">Suggestion, bug, anything. Leave your Instagram and we follow you back.</p>
      <a href="/feedback" class="btn btn-ghost foot-feedback-btn">Send feedback</a>
    </div>
    <div class="foot-links">
      <a href="/emergency">Emergency Mode</a>
      <a href="/prepare">Prevention</a>
      <a href="/gear">Gear</a>
      <a href="/recovery">Data Recovery</a>
      <a href="/faq">FAQ</a>
      <a href="/about">About</a>
    </div>
    <p>Save My Gig! · Built by a DJ who's been there. · <a href="https://buymeacoffee.com/savemygig" data-event="affiliate_click" data-program="bmc" data-placement="footer">Buy me a coffee ☕</a> · <a href="/privacy">Privacy</a></p>
  </footer>
  <Consent />
  <script>
    const t = document.getElementById('navToggle');
    const l = document.getElementById('navLinks');
    if (t && l) {
      t.addEventListener('click', () => {
        const open = l.classList.toggle('open');
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    const copyBtn = document.getElementById('shareCopy');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('https://www.savemygig.com');
          const old = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = old; }, 1500);
        } catch (e) { /* ignore */ }
      });
    }

  </script>
</body>
</html>

<style is:global>
  .site-nav-wrap { border-bottom: 1px solid var(--edge-soft); }
  .foot-share { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; margin-bottom: 1.6rem; }
  .foot-share-h { font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: var(--text); margin: 0; text-align: center; }
  .foot-share-sub { font-size: 0.82rem; color: var(--text-dim); margin: 0 0 0.5rem; text-align: center; max-width: 30rem; }
  .foot-share-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-body); font-weight: 600; font-size: 0.82rem; letter-spacing: 0.01em;
    color: var(--text-dim); text-decoration: none; background: var(--surf); border: 1px solid var(--edge);
    border-radius: 999px; padding: 0.5rem 1rem; cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .share-btn svg { flex: 0 0 auto; }
  .share-btn:hover { border-color: var(--text-dim); color: var(--text); background: var(--surf-2); }
  .foot-feedback { max-width: 30rem; margin: 1.8rem auto 0; display: flex; flex-direction: column; align-items: center; }
  .foot-feedback-h { font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: var(--text); margin: 0 0 0.2rem; text-align: center; }
  .foot-feedback-sub { font-size: 0.82rem; color: var(--text-dim); margin: 0 0 0.9rem; text-align: center; }
  .foot-feedback-btn { width: auto; margin: 0; padding: 0.6rem 1.6rem; }
  .site-nav {
    max-width: var(--site-w); margin: 0 auto; padding: 0.8rem 1.25rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; position: relative;
  }
  .nav-brand { display: flex; flex-direction: column; gap: 3px; text-decoration: none; line-height: 1; }
  .nb-name {
    font-family: var(--font-display); font-weight: 900; font-size: 1.36rem;
    text-transform: uppercase; letter-spacing: -0.02em; color: var(--text);
  }
  .nb-name .accent { color: var(--red); }
  .nb-tag {
    font-family: var(--font-body); font-weight: 600; font-size: 0.55rem; letter-spacing: 0.125em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .nav-home { display: none; }
  .nav-links { display: flex; gap: 1.05rem; }
  .nav-links a {
    font-family: var(--font-body); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--text-dim); text-decoration: none; transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-toggle {
    display: none; width: 42px; height: 38px; background: transparent;
    border: 1px solid var(--edge); border-radius: var(--radius);
    flex-direction: column; align-items: center; justify-content: center; gap: 4px; cursor: pointer; padding: 0;
  }
  .nav-toggle .bar { width: 18px; height: 2px; background: var(--text); display: block; }
  .nav-toggle:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

  @media (max-width: 640px) {
    .nav-toggle { display: flex; }
    .nb-name { font-size: 1.55rem; }
    .nb-tag { font-size: 0.62rem; letter-spacing: 0.135em; }
    .nav-home { display: block; }
    .nav-links {
      display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 30;
      flex-direction: column; gap: 0; background: var(--surf);
      border-bottom: 1px solid var(--edge); padding: 0.25rem 1.25rem 0.75rem;
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 0.8rem 0; border-bottom: 1px solid var(--edge-soft); font-size: 0.95rem; }
    .nav-links a:last-child { border-bottom: none; }
  }
</style>
