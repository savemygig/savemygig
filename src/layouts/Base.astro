---
import Analytics from '../components/Analytics.astro';
import Consent from '../components/Consent.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/gear" */
  path: string;
  /** noindex utility pages */
  noindex?: boolean;
  /** per-page OG card, e.g. "/og/exfat-vs-fat32-cdj.png" */
  ogImage?: string;
}

const { title, description, path, noindex = false, ogImage } = Astro.props;
const SITE = 'https://www.savemygig.com';
const canonical = `${SITE}${path === '/' ? '/' : path}`;
const ogImageUrl = `${SITE}${ogImage ?? '/images/dj-usb-not-detected-emergency.webp'}`;

// Site-wide entity graph. Search engines and AI answer engines both weight
// "who is this and why should I trust them" — and until now none of it was
// machine-readable even though the logo, the four social profiles and the
// author name were all already on the page. The @id values let the per-page
// TechArticle/HowTo blocks reference one shared Organization and Person
// instead of each declaring an anonymous stub.
const entityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Save My Gig!',
      alternateName: 'Save My Gig',
      url: SITE,
      email: 'savemygig@gmail.com',
      description: 'Free DJ rescue and prevention. Step-by-step help for Pioneer CDJ and XDJ USB failures, Rekordbox export problems and error codes.',
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE}/#logo`,
        url: `${SITE}/images/save-my-gig-seal.png`,
        width: 400,
        height: 400,
        caption: 'Save My Gig!',
      },
      image: { '@id': `${SITE}/#logo` },
      founder: { '@id': `${SITE}/#antonio` },
      sameAs: [
        'https://www.instagram.com/savemygig/',
        'https://www.tiktok.com/@savemygig',
        'https://x.com/savemygig',
        'https://www.youtube.com/@savemygig',
      ],
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#antonio`,
      name: 'Antonio Afonso',
      jobTitle: 'DJ and founder of Save My Gig',
      worksFor: { '@id': `${SITE}/#org` },
      knowsAbout: [
        'Pioneer CDJ',
        'Pioneer XDJ',
        'Rekordbox',
        'DJ USB troubleshooting',
        'FAT32 formatting',
        'DJ data recovery',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Save My Gig!',
      description: 'DJ rescue and prevention.',
      publisher: { '@id': `${SITE}/#org` },
      inLanguage: 'en',
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow" />}
  <meta name="theme-color" content="#000000" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Save My Gig!" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Save My Gig" />
  <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />
  <Analytics />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-nav-wrap">
    <div class="site-nav">
      <a href="/" class="nav-brand" aria-label="Save My Gig, DJ rescue and prevention, home">
        <!-- Shield mark (Antonio's new asset, 2026-07-29). SVG scales crisp
             at any DPI; 36x42 keeps the shield's own aspect in the slot. -->
        <img src="/images/logo-shield.svg" alt="" width="47" height="54" class="nb-seal" decoding="async" />
        <span class="nb-text">
          <span class="nb-name">Save My Gig<span class="accent">!</span></span>
          <span class="nb-tag">DJ rescue and prevention</span>
        </span>
      </a>
      <button class="nav-search-btn" id="navSearchBtn" aria-label="Search Save My Gig" aria-expanded="false" aria-controls="searchOverlay">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
      <nav class="nav-links" id="navLinks" aria-label="Site">
        <a href="/" class="nav-home">Home</a>
        <!-- Order mirrors the three homepage doors: Checklist, Emergency,
             Prevention. Recovery and Knowledge follow. The nav and the doors
             must not disagree about what comes first. The checklist leads
             because it is the daily tool; the rescue is one tap behind it and
             most DJs in trouble arrive straight on /fix or /emergency anyway. -->
        <a href="/checklist" class:list={[{ 'nav-on': path.startsWith('/checklist') }]}>Checklist</a>
        <a href="/emergency" class:list={[{ 'nav-on': path.startsWith('/emergency') || path.startsWith('/protocol') }]}>Emergency</a>
        <a href="/prepare" class:list={[{ 'nav-on': path.startsWith('/prepare') }]}>Prevention</a>
        <a href="/recovery" class:list={[{ 'nav-on': path.startsWith('/recovery') }]}>Recovery</a>
        <a href="/knowledge" class:list={[{ 'nav-on': path.startsWith('/knowledge') }]}>Knowledge</a>
        <a href="/gear" class:list={['nav-more', { 'nav-on': path.startsWith('/gear') }]}>Gear</a>
        <a href="/about" class:list={['nav-more', { 'nav-on': path.startsWith('/about') }]}>About</a>
      </nav>
    </div>
  </header>
  <div class="so" id="searchOverlay" hidden>
    <div class="so-panel" role="dialog" aria-modal="true" aria-label="Search Save My Gig">
      <Search />
      <button type="button" class="so-close" id="searchClose" aria-label="Close search">&times;</button>
    </div>
  </div>

  <div id="main">
    <slot />
  </div>
  <footer class="site-footer">
    <div class="foot-inner">

      <div class="foot-share">
        <div class="foot-share-copy">
          <!-- "Good deed of the day: send this to a DJ friend." until
               2026-07-27. Antonio: sounded like a charity poster. The share
               ask now reads as crew knowledge passed along, and the buttons
               below are the punchline. -->
          <!-- Colon, not a period (Antonio): the line INTRODUCES the share
               buttons below it, so it ends the way an introduction does. -->
          <p class="foot-share-h">Every DJ knows a DJ who needs this:</p>
        </div>
        <div class="foot-share-btns">
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp" href="https://wa.me/?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention%2C%20for%20when%20your%20USB%20dies%20before%20a%20set.%20https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4zm4.3 9.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7 1c-.2.1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.5-1.1v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3c-.3.3-1 1-1 2.3s1 2.7 1.1 2.9 2 3.1 4.9 4.3c1.8.7 2.5.8 3.4.6.5 0 1.4-.5 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on Telegram" href="https://t.me/share/url?url=https%3A%2F%2Fwww.savemygig.com&text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 2.9 11.6c-1.1.4-1 1.5-.1 1.8l4.7 1.5 1.8 5.7c.2.5.4.7.9.7.4 0 .7-.2 1-.5l2.3-2.3 4.9 3.6c.9.5 1.6.2 1.8-.8l3.3-15.4c.3-1.2-.4-1.8-1.6-1.3zM8.7 14.2l9-5.6c.4-.3.8-.1.5.2l-7.3 6.6-.3 3z"/></svg>
            <span>Telegram</span>
          </a>
          <!-- Desktop has room for words, so all four pills carry them
               (Antonio). On a phone the labels on X and Copy disappear and
               those two go back to icon pills, which is what keeps the row on
               one line. -->
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on Twitter" href="https://twitter.com/intent/tweet?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention&url=https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
            <span class="sb-opt">Twitter</span>
          </a>
          <!-- "Copy to paste" only on desktop (Antonio, 2026-07-30): mobile
               keeps the icon-only pill (.sb-opt already hides there). The
               "Copied!" feedback swaps in via a class on the button, never
               via .textContent on the whole element, so the SVG icon is
               never destroyed and needs no restore step. -->
          <button type="button" class="share-btn" id="shareCopy" aria-label="Copy link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
            <span class="sb-opt">Copy to paste</span>
            <span class="sb-copied">Copied!</span>
          </button>
        </div>
      </div>

      <div class="foot-rule"></div>

      <div class="foot-cols">
        <div class="foot-brand">
          <!-- Mobile only (Antonio): the brand block spans the full width on
               a phone and the right half sat empty, so the seal fills it,
               CENTERED in that space both ways (a corner-pinned version
               shipped for an hour and looked like a sticker). Desktop keeps
               the clean four-column grid, no seal. -->
          <img class="foot-seal" src="/images/seal-footer.webp" alt="" width="104" height="104" loading="lazy" aria-hidden="true" />
          <a href="/" class="foot-lockup" aria-label="Save My Gig, DJ rescue and prevention">
            <span class="foot-lockup-text">
              <span class="foot-wordmark">Save My Gig<span class="accent">!</span></span>
              <span class="foot-tag">DJ rescue and prevention</span>
            </span>
          </a>
          <div class="foot-social">
            <a class="soc-btn" href="https://www.instagram.com/savemygig/" target="_blank" rel="noopener" aria-label="Save My Gig on Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2c2.7 0 3 0 4.1.1 1 .1 1.7.2 2.3.5.6.2 1.1.5 1.6 1 .5.5.8 1 1 1.6.3.6.4 1.3.5 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 1-.2 1.7-.5 2.3-.2.6-.5 1.1-1 1.6-.5.5-1 .8-1.6 1-.6.3-1.3.4-2.3.5-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1-.1-1.7-.2-2.3-.5-.6-.2-1.1-.5-1.6-1-.5-.5-.8-1-1-1.6-.3-.6-.4-1.3-.5-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c.1-1 .2-1.7.5-2.3.2-.6.5-1.1 1-1.6.5-.5 1-.8 1.6-1 .6-.3 1.3-.4 2.3-.5C9 2 9.3 2 12 2zm0 1.8c-2.7 0-3 0-4 .1-.8 0-1.2.2-1.5.3-.4.1-.7.3-1 .6-.3.3-.5.6-.6 1-.1.3-.3.7-.3 1.5-.1 1-.1 1.3-.1 4s0 3 .1 4c0 .8.2 1.2.3 1.5.1.4.3.7.6 1 .3.3.6.5 1 .6.3.1.7.3 1.5.3 1 .1 1.3.1 4 .1s3 0 4-.1c.8 0 1.2-.2 1.5-.3.4-.1.7-.3 1-.6.3-.3.5-.6.6-1 .1-.3.3-.7.3-1.5.1-1 .1-1.3.1-4s0-3-.1-4c0-.8-.2-1.2-.3-1.5-.1-.4-.3-.7-.6-1-.3-.3-.6-.5-1-.6-.3-.1-.7-.3-1.5-.3-1-.1-1.3-.1-4-.1zm0 3.1a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2zm0 1.8a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6zm5.3-3.1a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/></svg>
            </a>
            <a class="soc-btn" href="https://www.tiktok.com/@savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on TikTok">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.6a2.4 2.4 0 1 1-1.7-2.3V9.2a5.4 5.4 0 1 0 4.7 5.3V9a7.2 7.2 0 0 0 4 1.3V7.3a4.3 4.3 0 0 1-2-1.5z"/></svg>
            </a>
            <a class="soc-btn" href="https://x.com/savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on X">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
            </a>
            <a class="soc-btn" href="https://www.youtube.com/@savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on YouTube">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/></svg>
            </a>
          </div>
          <!-- Minimal on purpose (Antonio): a small cup and a text link, not
               the official BMC image button, which shouted next to the quiet
               icon row. -->
          <a class="foot-bmc" href="https://www.buymeacoffee.com/savemygig" target="_blank" rel="noopener" data-event="affiliate_click" data-program="bmc" data-placement="footer">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 8h1a3 3 0 0 1 0 6h-1"/><path d="M3 8h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M7 2v2"/><path d="M11 2v2"/></svg>
            <span>Buy me a coffee</span>
          </a>
        </div>

        <nav class="foot-col" aria-label="Rescue">
          <span class="foot-col-h">Rescue</span>
          <!-- Order per Antonio: install leads (the installed app IS rescue,
               it guides with no internet), then the crisis doors. "As an
               app", precisely: a PWA is the site installing AS one. -->
          <a href="/install">Install as an app</a>
          <a href="/emergency">Emergency mode</a>
          <a href="/recovery">Data recovery</a>
          <a href="/faq">FAQ</a>
        </nav>
        <nav class="foot-col" aria-label="Prevent">
          <span class="foot-col-h">Prepare</span>
          <!-- Checklist first (Antonio): it is the daily tool, same logic as
               the nav. "Gear" stays "Gear": it is the word DJs use. -->
          <a href="/checklist">Checklist</a>
          <a href="/prepare">Prevention</a>
          <a href="/gear">Gear</a>
          <a href="/knowledge">Knowledge base</a>
        </nav>
        <nav class="foot-col" aria-label="More">
          <span class="foot-col-h">More</span>
          <a href="/about">About</a>
          <a href="/partners">Partners</a>
          <a href="/legal">Legal</a>
          <a href="/feedback">Feedback</a>
        </nav>
      </div>

      <div class="foot-rule"></div>

      <div class="foot-base">
        <!-- Plural, per Antonio: it is not one person anymore, there is a
             crew of DJs and techs behind this. -->
        <!-- Symbols, SETTLED with Antonio 2026-07-27 (after full walkthrough):
             © = copyright, automatic, no registration needed, protects the
             site's content, KEEP. ™ = unregistered trademark claim, legal
             before filing, KEEP. ® = registered mark, FORBIDDEN until an
             actual registration exists; never "upgrade" the ™. -->
        <!-- On narrow phones the dot-joined line wrapped raggedly (Antonio,
             S10e). The separator becomes a deliberate line break there. -->
        <span class="foot-copy">© 2026 Save My Gig!&trade;<span class="fc-sep"> · </span><span class="fc-rest">Built by DJs who've been there.</span></span>
        <!-- Alive-signal, per Antonio's homepage review: says the project is
             maintained without printing a date that would itself go stale.
             Same font size as the line above (Antonio). -->
        <span class="foot-live">Updated continuously with new gear and solutions.</span>
      </div>
    </div>
  </footer>
  <Consent />
  <script>
    const t = document.getElementById('navToggle');
    const l = document.getElementById('navLinks');
    if (t && l) {
      t.addEventListener('click', () => {
        const open = l.classList.toggle('open');
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    const sBtn = document.getElementById('navSearchBtn');
    const sOv = document.getElementById('searchOverlay');
    const sClose = document.getElementById('searchClose');
    if (sBtn && sOv) {
      const openSearch = () => {
        sOv.hidden = false;
        sBtn.setAttribute('aria-expanded', 'true');
        const inp = sOv.querySelector('.srch-input');
        if (inp) (inp as HTMLInputElement).focus();
      };
      const closeSearch = () => {
        sOv.hidden = true;
        sBtn.setAttribute('aria-expanded', 'false');
        sBtn.focus();
      };
      sBtn.addEventListener('click', openSearch);
      if (sClose) sClose.addEventListener('click', closeSearch);
      sOv.addEventListener('click', (e) => { if (e.target === sOv) closeSearch(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !sOv.hidden) closeSearch();
        // "/" opens search, the way every developer tool does it
        const t = e.target as HTMLElement;
        const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
        if (e.key === '/' && sOv.hidden && !typing) { e.preventDefault(); openSearch(); }
      });
    }

    // Footer brand = back to top (Antonio): tapping the wordmark or the
    // seal pushes you to the beginning of the page, same move as the
    // floating circle. The href="/" stays as the no-JS fallback.
    const footTop = (e: Event) => {
      e.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    };
    document.querySelectorAll('.foot-lockup, .foot-seal').forEach((el) => el.addEventListener('click', footTop));

    const copyBtn = document.getElementById('shareCopy');
    if (copyBtn) {
      let copyTimer;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('https://www.savemygig.com');
          clearTimeout(copyTimer);
          copyBtn.classList.add('copied');
          copyTimer = setTimeout(() => copyBtn.classList.remove('copied'), 1500);
        } catch (e) { /* ignore */ }
      });
    }

  </script>
  <!-- Back to top, Antonio's ask (modelled on the EPK pattern he likes): on
       any long page, a round button fades in at the bottom-right once you are
       a screen and a half down, and one tap returns you to the top. Base
       pages only; the emergency tunnel stays free of extra chrome. -->
  <button type="button" class="to-top" id="toTop" aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
  </button>
  <script is:inline>
    (function () {
      var btn = document.getElementById('toTop');
      if (!btn) return;
      var shown = false;
      function check() {
        var want = window.scrollY > window.innerHeight * 1.5;
        if (want !== shown) { shown = want; btn.hidden = !want; }
      }
      window.addEventListener('scroll', check, { passive: true });
      check();
      btn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    })();
  </script>
  <script is:inline>
    // Magic-link device registration: the confirmation email's link carries
    // #reg=<encoded email>. Clicking it proved ownership of the address (the
    // token was verified server-side before the redirect), so this device is
    // registered on the spot: same keys the checklist gate and capture forms
    // read. Open the same email on a new phone and tap the same button, and
    // that phone is in. The fragment is stripped immediately: it never
    // reaches server logs, analytics, or the visible URL for more than a
    // moment.
    (function () {
      var m = (location.hash || '').match(/^#reg=([A-Za-z0-9_-]+)/);
      if (!m) return;
      try {
        var b64 = m[1].replace(/-/g, '+').replace(/_/g, '/');
        var email = decodeURIComponent(atob(b64));
        if (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
          localStorage.setItem('SMG_UNLOCKED', '1');
          localStorage.setItem('SMG_EMAIL', email);
        }
      } catch (e) { /* malformed fragment: ignore */ }
      history.replaceState(null, '', location.pathname + location.search);
    })();
  </script>
