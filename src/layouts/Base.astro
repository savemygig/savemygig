---
import Analytics from '../components/Analytics.astro';
import Brand from '../components/Brand.astro';
import Consent from '../components/Consent.astro';
import LangPicker from '../components/LangPicker.astro';
import Search from '../components/Search.astro';
import { VERSION_LABEL, IS_BETA } from '../lib/version';
import { byCode, liveLangs, localizedPath, DEFAULT_LANG, anyTranslationLive } from '../i18n/registry';
import { t } from '../i18n/ui';
import TranslationNotice from '../components/TranslationNotice.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/gear" */
  path: string;
  /** noindex utility pages */
  noindex?: boolean;
  /** per-page OG card, e.g. "/og/exfat-vs-fat32-cdj.png" */
  ogImage?: string;
  /** Social share title, when it needs to be shorter/cleaner than the SEO
      <title> (Antonio, 2026-07-30: the keyword-rich title tag stays for
      Google, the share card gets the trimmed version). Falls back to title. */
  ogTitle?: string;
  /** Social share description, when the SEO meta description would repeat
      the ogTitle on a share card (Antonio, 2026-07-30: if the title already
      carries the positioning line, the description shouldn't repeat it).
      Falls back to description. */
  ogDescription?: string;
  /** Leaf label for the BreadcrumbList (e.g. "CDJ-3000X"). Optional: when it
      is absent the current page is simply left off the trail, which Google
      explicitly allows, rather than printing a slug-derived guess like
      "Cdj 3000x". Pass it on pages where the trail is worth completing. */
  crumbName?: string;
  /** Language code for THIS page: 'en' | 'pt' | 'es'. Defaults to English.
      `path` is always the ENGLISH path either way, e.g. "/checklist": the
      canonical URL, the hreflang set and every internal link are derived
      from it, so a translated page never has to know its own prefix. */
  lang?: string;
}

const { title, description, path, noindex = false, ogImage, ogTitle, ogDescription, crumbName, lang = DEFAULT_LANG } = Astro.props;
const L = byCode(lang);
const S = t(lang);
/** Localize an internal path for the CURRENT language. Every nav, footer and
    layout link goes through this, so a Portuguese page cannot link a reader
    back into English by accident. */
const lp = (p) => localizedPath(p, lang);
/** THE SEO GUARANTEE, in one expression. hreflang is emitted ONLY between
    languages that are actually live. While pt and es are unpublished this
    array is empty, so no page ever tells a crawler that a translation
    exists, and the English site's markup is byte-identical to what it was
    before i18n landed. Publishing is flipping `live` in the registry, which
    turns on the alternates, the sitemap entries and the indexable robots tag
    together, which is the only safe order. */
const alternates = anyTranslationLive() ? liveLangs() : [];
const SITE = 'https://www.savemygig.com';
const canonical = `${SITE}${localizedPath(path === '/' ? '/' : path, lang)}`;
// Default share image (2026-07-30): landscape 1200x630, cropped from
// Antonio's shield-logo social art so a shared link matches the same brand
// mark as his social posts instead of a mismatched portrait photo.
const ogImageUrl = `${SITE}${ogImage ?? '/images/og-share.jpg'}`;

// BreadcrumbList (2026-08-01). This is the markup Google reads to print
// "savemygig.com › Knowledge base › Pioneer DJ / AlphaTheta" under a result
// instead of a raw URL. The site had visible breadcrumbs on the knowledge
// pages but none of it was machine-readable, so search engines never showed
// the trail. Built from the canonical path so every page gets one for free.
//
// Only REAL hub pages are listed here. A segment with no page behind it (the
// /fix articles have no /fix index, for instance) is skipped rather than
// linked, because a breadcrumb pointing at a 404 is worse than no breadcrumb.
//
// LOCALIZED (2026-08-04). These labels used to be English string literals, so
// a Spanish page would have shipped a breadcrumb reading "Home > Knowledge
// base". They now come from the same UI catalogue the visible nav and footer
// use, which is the only way the printed trail and the marked-up trail can
// stay the same words in three languages. "Pioneer DJ / AlphaTheta" stays
// literal: it is two company names, and a company name is not translated.
//
// It is computed BEFORE the entity graph because the WebPage node below
// references it by @id.
const CRUMB_HUBS: Record<string, string> = {
  '/knowledge': S.footer.knowledgeBase,
  '/knowledge/pioneer-dj': 'Pioneer DJ / AlphaTheta',
  '/legal': S.footer.legal,
};

const crumbItems: { name: string; item?: string }[] = [{ name: S.home, item: `${SITE}${localizedPath('/', lang)}` }];
{
  const segs = path.split('/').filter(Boolean);
  let acc = '';
  for (const seg of segs) {
    acc += `/${seg}`;
    if (acc === path) break; // the leaf is handled separately below
    if (CRUMB_HUBS[acc]) crumbItems.push({ name: CRUMB_HUBS[acc], item: `${SITE}${localizedPath(acc, lang)}` });
  }
  // The current page. Google allows omitting it, so a page that did not pass
  // crumbName just ends its trail at the last hub instead of guessing a name.
  const leaf = crumbName ?? (path !== '/' ? CRUMB_HUBS[path] : undefined);
  if (leaf) crumbItems.push({ name: leaf, item: canonical });
}

const breadcrumbSchema = crumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: crumbItems.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.item ? { item: c.item } : {}),
  })),
} : null;

// Site-wide entity graph. Search engines and AI answer engines both weight
// "who is this and why should I trust them", and until now none of it was
// machine-readable even though the logo, the four social profiles and the
// author name were all already on the page. The @id values let the per-page
// TechArticle/HowTo blocks reference one shared Organization and Person
// instead of each declaring an anonymous stub.
//
// THE CONTRACT WITH TRANSLATED PAGES (2026-08-04). Everything this layout
// emits is already language-aware: inLanguage comes from the registry tag,
// the breadcrumb labels come from the UI catalogue, and every URL in the
// graph goes through localizedPath, so a page rendered with lang="pt" emits
// a pt-BR graph on /pt/ URLs without knowing anything about itself.
//
// A PAGE-LEVEL block is the page file's own responsibility, because page
// prose lives in per-language page files by design (see src/i18n/ui.js). So
// when src/pages/pt/faq.astro is written, its JSON-LD must carry the
// TRANSLATED strings, inLanguage 'pt-BR', and @id values on the /pt/ URL:
// https://www.savemygig.com/pt/faq#webpage, not the English one. Copying the
// English block into a translated page would point two languages at one node
// and hand an answer engine Portuguese prose labelled English.
//
// The Organization's own name, slogan and description stay in English on
// every language. That is correct, not an oversight: there is ONE
// organisation with ONE @id across the whole site, schema.org has no way to
// give it three descriptions that Google reads, and "Save My Gig" and
// "DJ Booth Intelligence" are brand strings that are not translated anyway.
const entityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Save My Gig',
      url: SITE,
      email: 'info@savemygig.com',
      // The slogan property is real schema.org vocabulary and it is exactly
      // what an AI answer engine quotes when asked what this organisation is.
      slogan: 'DJ Booth Intelligence',
      description: 'The DJ Booth Intelligence platform. Free step-by-step rescue for Pioneer CDJ and XDJ USB failures, rekordbox export problems and error codes, plus the prevention system and booth knowledge behind them.',
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE}/#logo`,
        url: `${SITE}/images/save-my-gig-seal.png`,
        width: 512,
        height: 512,
        caption: 'Save My Gig',
      },
      image: { '@id': `${SITE}/#logo` },
      // NO founder property, and no Person in this graph, BY DECISION
      // (2026-08-03): Save My Gig is a faceless company, made by DJs for
      // DJs. No individual is named anywhere public, and schema IS public,
      // it ships in every page's source. Articles carry the ORGANIZATION as
      // author (valid schema.org, common for publications). The knowsAbout
      // list moved here from the old Person so the expertise signal stays.
      // Do not reintroduce personal names into any public surface.
      knowsAbout: [
        'Pioneer CDJ',
        'Pioneer XDJ',
        'rekordbox',
        'DJ USB troubleshooting',
        'FAT32 formatting',
        'DJ data recovery',
      ],
      sameAs: [
        'https://www.instagram.com/savemygig/',
        'https://www.tiktok.com/@savemygig',
        'https://x.com/savemygig',
        'https://www.youtube.com/@savemygig',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Save My Gig',
      description: 'DJ Booth Intelligence.',
      publisher: { '@id': `${SITE}/#org` },
      // LANGUAGE-AWARE (2026-08-04). Was hardcoded 'en', which would have
      // told Google that the Spanish and Portuguese builds were English the
      // moment they went live. L.tag is the registry's BCP 47 tag, so this
      // emits en / pt-BR / es without the page knowing anything.
      //
      // NO potentialAction/SearchAction here, deliberately: the site search
      // is a client-side overlay with no query URL (no /search?q=), so a
      // SearchAction would advertise an endpoint that does not exist.
      // Add it the day a real ?q= results page ships, not before.
      inLanguage: L.tag,
    },
    // THE PAGE ITSELF (2026-08-04). Until now the graph described the
    // publisher and the site but never the document, so BreadcrumbList and
    // the per-page TechArticle/HowTo blocks were floating with nothing to
    // attach to and an answer engine had no single node saying "this URL is
    // about X, in language Y, and it is free to read". One WebPage node per
    // page fixes all three. Every value here is already in the <head> above
    // as <title>, <meta description>, <link canonical> and <html lang>, so
    // nothing is asserted that the page does not already assert.
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: description,
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#org` },
      publisher: { '@id': `${SITE}/#org` },
      inLanguage: L.tag,
      // True and load-bearing for answer engines: no paywall, no account,
      // no metered access anywhere on this site. It tells a crawler the
      // text it can see is the whole text a human sees.
      isAccessibleForFree: true,
      ...(breadcrumbSchema ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
  ],
};
---
<!doctype html>
<html lang={L.tag} dir={L.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* An unpublished language is noindex REGARDLESS of the page's own flag.
      This is the belt to the registry's braces: even if a translated page
      were somehow added to the sitemap, the page itself refuses indexing. */}
  {noindex || !L.live
    ? <meta name="robots" content={L.live ? 'noindex,follow' : 'noindex,nofollow'} />
    : <meta name="robots" content="index,follow" />}
  {/* Matches --bg and the manifest theme_color, so the browser chrome is the
      same black as the page instead of a flatter pure black beside it. */}
  <meta name="theme-color" content="#0a0a0b" />
  {/* hreflang. Reciprocal and self-referencing, which is what Google
      requires: every version lists every version INCLUDING itself, and
      x-default points at English as the catch-all for languages we do not
      serve. Empty while nothing is published. */}
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.tag} href={`${SITE}${localizedPath(path === '/' ? '/' : path, a.code)}`} />
  ))}
  {alternates.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={`${SITE}${path === '/' ? '/' : path}`} />
  )}
  <meta property="og:locale" content={L.ogLocale} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Save My Gig" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {/* Points at the shield the page already loads. favicon.svg was a
      byte-identical copy, so browsers fetched the same 9.9KB twice under
      two URLs. Verified with cmp. */}
  <link rel="icon" type="image/svg+xml" href="/images/logo-shield.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Save My Gig" />
  {/* FONT PRELOADS DELETED 2026-08-04, on measurement, not taste. Both faces
      are font-display:swap, so they never blocked paint; the preloads simply
      pulled 60KB to the front of the queue ahead of the document itself.
      Removing them, median of 7 throttled runs: FCP home 568 to 280ms,
      /emergency 532 to 272, /checklist 504 to 288, /faq 512 to 264, the
      CDJ-3000 page 568 to 264. LCP fell 128 to 168ms on every text-LCP page
      and blocking time roughly halved. The cost is a slightly larger font
      swap, which lifts homepage CLS from 0.007 to 0.023, still five times
      inside the 0.1 budget. Moving them below the stylesheet does nothing
      (the preload scanner finds them regardless) and fetchpriority="low"
      does nothing either. Both were measured before deleting. */}
  <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  <Analytics />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="site-nav-wrap">
    <div class="site-nav">
      <a href={lp("/")} class="nav-brand" aria-label={S.aria.brandHome}>
        <!-- Shield mark (Antonio's new asset, 2026-07-29). SVG scales crisp
             at any DPI; 36x42 keeps the shield's own aspect in the slot. -->
        <img src="/images/logo-shield.svg" alt="" width="47" height="54" class="nb-seal" decoding="async" />
        <Brand variant="full" />
      </a>
      <button class="nav-search-btn" id="navSearchBtn" aria-label="Search Save My Gig" aria-expanded="false" aria-controls="searchOverlay">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
      <nav class="nav-links" id="navLinks" aria-label="Site">
        <a href={lp("/")} class="nav-home">{S.home}</a>
        <!-- Order mirrors the three homepage doors: Checklist, Emergency,
             Prevention. Recovery and Knowledge follow. The nav and the doors
             must not disagree about what comes first. The checklist leads
             because it is the daily tool; the rescue is one tap behind it and
             most DJs in trouble arrive straight on /fix or /emergency anyway. -->
        <a href={lp("/checklist")} class:list={[{ 'nav-on': path.startsWith('/checklist') }]}>{S.nav.checklist}</a>
        <a href={lp("/emergency")} class:list={[{ 'nav-on': path.startsWith('/emergency') || path.startsWith('/protocol') }]}>{S.nav.emergency}</a>
        <a href={lp("/prepare")} class:list={[{ 'nav-on': path.startsWith('/prepare') }]}>{S.nav.prepare}</a>
        <a href={lp("/recovery")} class:list={[{ 'nav-on': path.startsWith('/recovery') }]}>{S.nav.recovery}</a>
        <a href={lp("/knowledge")} class:list={[{ 'nav-on': path.startsWith('/knowledge') }]}>{S.nav.knowledge}</a>
        <a href={lp("/gear")} class:list={['nav-more', 'nav-gear-hide-mobile', { 'nav-on': path.startsWith('/gear') }]}>{S.nav.gear}</a>
        <!-- "About us", not "About" (Antonio, 2026-08-03): in the drawer the
             one word sat short against CHECKLIST and KNOWLEDGE and the column
             read ragged. Nav label only; the footer column keeps the short
             form, where a compact list of links is the right register. -->
        <a href={lp("/about")} class:list={['nav-more', { 'nav-on': path.startsWith('/about') }]}>{S.nav.about}</a>
        <!-- The language picker lives INSIDE the nav, once, so there is one
             instance and one implementation. On desktop the nav is a row and
             it renders as a square left of the search button; on a phone the
             nav IS the drawer and it renders as a collapsing row.
             LAST, after About (Antonio, 2026-08-03, second pass). It sat
             between Knowledge and About for one build and he was right that
             it read wrong: a setting mixed into the middle of a list of
             places. Last is where a setting goes. What was missing the FIRST
             time it sat last was not the position, it was separation, so the
             row now closes the destinations with a gap and its own rule
             instead of pretending to be an eighth destination. -->
        <LangPicker />
      </nav>
    </div>
  </header>
  <div class="so" id="searchOverlay" hidden>
    <div class="so-panel" role="dialog" aria-modal="true" aria-label="Search Save My Gig">
      <Search />
      <button type="button" class="so-close" id="searchClose" aria-label="Close search">&times;</button>
    </div>
  </div>

  <div id="main">
    {/* Sits ABOVE the page's own <main class="wrap">, so it needs the site
        container itself or it would run edge to edge. Bottom padding only:
        the page below brings its own --page-top. */}
    <div class="tx-wrap"><TranslationNotice lang={lang} path={path} /></div>
    <slot />
  </div>
  <footer class="site-footer">
    <div class="foot-inner">

      <div class="foot-share">
        <div class="foot-share-copy">
          <!-- "Good deed of the day: send this to a DJ friend." until
               2026-07-27. Antonio: sounded like a charity poster. The share
               ask now reads as crew knowledge passed along, and the buttons
               below are the punchline. -->
          <!-- Colon, not a period (Antonio): the line INTRODUCES the share
               buttons below it, so it ends the way an introduction does. -->
          <p class="foot-share-h">{S.footer.shareLead}</p>
        </div>
        <div class="foot-share-btns">
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp" href="https://wa.me/?text=Save%20My%20Gig%2C%20DJ%20Booth%20Intelligence%2C%20for%20when%20your%20USB%20dies%20before%20a%20set.%20https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4zm4.3 9.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7 1c-.2.1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.5-1.1v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3c-.3.3-1 1-1 2.3s1 2.7 1.1 2.9 2 3.1 4.9 4.3c1.8.7 2.5.8 3.4.6.5 0 1.4-.5 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on Telegram" href="https://t.me/share/url?url=https%3A%2F%2Fwww.savemygig.com&text=Save%20My%20Gig%2C%20DJ%20Booth%20Intelligence">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 2.9 11.6c-1.1.4-1 1.5-.1 1.8l4.7 1.5 1.8 5.7c.2.5.4.7.9.7.4 0 .7-.2 1-.5l2.3-2.3 4.9 3.6c.9.5 1.6.2 1.8-.8l3.3-15.4c.3-1.2-.4-1.8-1.6-1.3zM8.7 14.2l9-5.6c.4-.3.8-.1.5.2l-7.3 6.6-.3 3z"/></svg>
            <span>Telegram</span>
          </a>
          <!-- Desktop has room for words, so all four pills carry them
               (Antonio). On a phone the labels on X and Copy disappear and
               those two go back to icon pills, which is what keeps the row on
               one line. -->
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on X" href="https://x.com/intent/post?text=Save%20My%20Gig%2C%20DJ%20Booth%20Intelligence&url=https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
            <span class="sb-opt">X</span>
          </a>
          <!-- "Copy to paste" only on desktop (Antonio, 2026-07-30): mobile
               keeps the icon-only pill (.sb-opt already hides there). The
               "Copied!" feedback swaps in via a class on the button, never
               via .textContent on the whole element, so the SVG icon is
               never destroyed and needs no restore step. -->
          <button type="button" class="share-btn" id="shareCopy" aria-label="Copy link">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
            <span class="sb-opt">Copy to paste</span>
            <span class="sb-copied">Copied!</span>
          </button>
        </div>
      </div>

      <div class="foot-rule"></div>

      <div class="foot-cols">
        <div class="foot-brand">
          <!-- Mobile only (Antonio): the brand block spans the full width on
               a phone and the right half sat empty, so the seal fills it,
               CENTERED in that space both ways (a corner-pinned version
               shipped for an hour and looked like a sticker). Desktop keeps
               the clean four-column grid, no seal. -->
          {/* RESTORED 2026-08-03. It came out earlier the same day on "on the
              footer I just want SAVE MY GIG, and then the social media like
              it was before, no SHIELD", which we read as covering the round
              seal too. It did not: he meant the SHIELD. On seeing the footer
              without it: "you took out that circular logo, and I want it
              back." The positioning CSS below was never deleted, only this
              tag, so this is a restore and not a rebuild.

              PULLED then REBUILT, both on 2026-08-04. The pre-press audit
              found the old seal-footer.webp was not merely carrying the
              retired exclamation mark: it had the RETIRED TAGLINE, "DJ
              RESCUE AND PREVENTION", drawn into the artwork, printing the
              dead brand directly beneath the live one on the day press links
              go out. So it came out. Antonio, straight back and right: "in
              mobile it is wrong because it lost the round symbol."
              Both true, so it is regenerated from the live brand instead,
              by scripts/gen-seal.py: the vector shield inside a brand-red
              ring, no words at all, therefore no tagline that can ever go
              stale again. Vector, so it is sharp at 104px and at 16px.
              A lettered seal for print or merch is a design job, not this. */}
          <img class="foot-seal" src="/images/seal-footer.svg" alt="" width="104" height="104" loading="lazy" aria-hidden="true" />
          <a href={lp("/")} class="foot-lockup" aria-label="Save My Gig, DJ Booth Intelligence">
            <Brand variant="footer" />
          </a>
          <div class="foot-social">
            <a class="soc-btn" href="https://www.instagram.com/savemygig/" target="_blank" rel="noopener" aria-label="Save My Gig on Instagram">
