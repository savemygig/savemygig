---
import Analytics from '../components/Analytics.astro';
import Consent from '../components/Consent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** canonical path, e.g. "/gear" */
  path: string;
  /** noindex utility pages */
  noindex?: boolean;
  /** per-page OG card, e.g. "/og/exfat-vs-fat32-cdj.png" */
  ogImage?: string;
}

const { title, description, path, noindex = false, ogImage } = Astro.props;
const SITE = 'https://www.savemygig.com';
const canonical = `${SITE}${path === '/' ? '/' : path}`;
const ogImageUrl = `${SITE}${ogImage ?? '/images/dj-usb-not-detected-emergency.webp'}`;

// Site-wide entity graph. Search engines and AI answer engines both weight
// "who is this and why should I trust them" — and until now none of it was
// machine-readable even though the logo, the four social profiles and the
// author name were all already on the page. The @id values let the per-page
// TechArticle/HowTo blocks reference one shared Organization and Person
// instead of each declaring an anonymous stub.
const entityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'Save My Gig!',
      alternateName: 'Save My Gig',
      url: SITE,
      email: 'savemygig@gmail.com',
      description: 'Free DJ rescue and prevention. Step-by-step help for Pioneer CDJ and XDJ USB failures, Rekordbox export problems and error codes.',
      logo: {
        '@type': 'ImageObject',
        '@id': `${SITE}/#logo`,
        url: `${SITE}/images/save-my-gig-seal.png`,
        width: 400,
        height: 400,
        caption: 'Save My Gig!',
      },
      image: { '@id': `${SITE}/#logo` },
      founder: { '@id': `${SITE}/#antonio` },
      sameAs: [
        'https://www.instagram.com/savemygig/',
        'https://www.tiktok.com/@savemygig',
        'https://x.com/savemygig',
        'https://www.youtube.com/@savemygig',
      ],
    },
    {
      '@type': 'Person',
      '@id': `${SITE}/#antonio`,
      name: 'Antonio Afonso',
      jobTitle: 'DJ and founder of Save My Gig',
      worksFor: { '@id': `${SITE}/#org` },
      knowsAbout: [
        'Pioneer CDJ',
        'Pioneer XDJ',
        'Rekordbox',
        'DJ USB troubleshooting',
        'FAT32 formatting',
        'DJ data recovery',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: SITE,
      name: 'Save My Gig!',
      description: 'DJ rescue and prevention.',
      publisher: { '@id': `${SITE}/#org` },
      inLanguage: 'en',
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex,follow" /> : <meta name="robots" content="index,follow" />}
  <meta name="theme-color" content="#000000" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Save My Gig!" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />
  <Analytics />
  <slot name="head" />
</head>
<body>
  <header class="site-nav-wrap">
    <div class="site-nav">
      <a href="/" class="nav-brand" aria-label="Save My Gig, DJ rescue and prevention, home">
        <picture><source srcset="/images/seal-72.webp" type="image/webp" /><img src="/images/seal-72.png" alt="" width="42" height="42" class="nb-seal" decoding="async" /></picture>
        <span class="nb-text">
          <span class="nb-name">Save My Gig<span class="accent">!</span></span>
          <span class="nb-tag">DJ rescue and prevention</span>
        </span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
      <nav class="nav-links" id="navLinks" aria-label="Site">
        <a href="/" class="nav-home">Home</a>
        <a href="/emergency">Emergency</a>
        <a href="/prepare">Prevention</a>
        <a href="/checklist">Checklist</a>
        <a href="/knowledge">Knowledge</a>
        <a href="/gear">Gear</a>
        <a href="/recovery" class="nav-more">Recovery</a>
        <a href="/about" class="nav-more">About</a>
      </nav>
    </div>
  </header>
  <slot />
  <footer class="site-footer">
    <div class="foot-inner">

      <div class="foot-share">
        <div class="foot-share-copy">
          <p class="foot-share-h">Found this useful? Share it with a DJ friend.</p>
          <p class="foot-share-sub">The more DJs know about it, the more gigs it saves.</p>
        </div>
        <div class="foot-share-btns">
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on WhatsApp" href="https://wa.me/?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention%2C%20for%20when%20your%20USB%20dies%20before%20a%20set.%20https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0 1 12 4zm4.3 9.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7 1c-.2.1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.5-1.1v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3c-.3.3-1 1-1 2.3s1 2.7 1.1 2.9 2 3.1 4.9 4.3c1.8.7 2.5.8 3.4.6.5 0 1.4-.5 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on Telegram" href="https://t.me/share/url?url=https%3A%2F%2Fwww.savemygig.com&text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 2.9 11.6c-1.1.4-1 1.5-.1 1.8l4.7 1.5 1.8 5.7c.2.5.4.7.9.7.4 0 .7-.2 1-.5l2.3-2.3 4.9 3.6c.9.5 1.6.2 1.8-.8l3.3-15.4c.3-1.2-.4-1.8-1.6-1.3zM8.7 14.2l9-5.6c.4-.3.8-.1.5.2l-7.3 6.6-.3 3z"/></svg>
            <span>Telegram</span>
          </a>
          <a class="share-btn" target="_blank" rel="noopener" aria-label="Share on X" href="https://twitter.com/intent/tweet?text=Save%20My%20Gig%2C%20free%20DJ%20rescue%20and%20prevention&url=https%3A%2F%2Fwww.savemygig.com">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
            <span>X</span>
          </a>
          <button type="button" class="share-btn" id="shareCopy" aria-label="Copy link">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1"/></svg>
            <span>Copy link</span>
          </button>
        </div>
      </div>

      <div class="foot-rule"></div>

      <div class="foot-cols">
        <div class="foot-brand">
          <a href="/" class="foot-lockup" aria-label="Save My Gig, DJ rescue and prevention">
            <picture><source srcset="/images/seal-72.webp" type="image/webp" /><img src="/images/seal-72.png" alt="" width="72" height="72" class="foot-seal" loading="lazy" decoding="async" /></picture>
            <span class="foot-lockup-text">
              <span class="foot-wordmark">Save My Gig<span class="accent">!</span></span>
              <span class="foot-tag">DJ rescue and prevention</span>
            </span>
          </a>
          <p class="foot-blurb">Free rescue and prevention for DJs, for when the USB dies before the set. Built by a DJ who has been there.</p>
          <div class="foot-social">
            <a class="soc-btn" href="https://www.instagram.com/savemygig/" target="_blank" rel="noopener" aria-label="Save My Gig on Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2c2.7 0 3 0 4.1.1 1 .1 1.7.2 2.3.5.6.2 1.1.5 1.6 1 .5.5.8 1 1 1.6.3.6.4 1.3.5 2.3.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 1-.2 1.7-.5 2.3-.2.6-.5 1.1-1 1.6-.5.5-1 .8-1.6 1-.6.3-1.3.4-2.3.5-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1-.1-1.7-.2-2.3-.5-.6-.2-1.1-.5-1.6-1-.5-.5-.8-1-1-1.6-.3-.6-.4-1.3-.5-2.3C2 15 2 14.7 2 12s0-3 .1-4.1c.1-1 .2-1.7.5-2.3.2-.6.5-1.1 1-1.6.5-.5 1-.8 1.6-1 .6-.3 1.3-.4 2.3-.5C9 2 9.3 2 12 2zm0 1.8c-2.7 0-3 0-4 .1-.8 0-1.2.2-1.5.3-.4.1-.7.3-1 .6-.3.3-.5.6-.6 1-.1.3-.3.7-.3 1.5-.1 1-.1 1.3-.1 4s0 3 .1 4c0 .8.2 1.2.3 1.5.1.4.3.7.6 1 .3.3.6.5 1 .6.3.1.7.3 1.5.3 1 .1 1.3.1 4 .1s3 0 4-.1c.8 0 1.2-.2 1.5-.3.4-.1.7-.3 1-.6.3-.3.5-.6.6-1 .1-.3.3-.7.3-1.5.1-1 .1-1.3.1-4s0-3-.1-4c0-.8-.2-1.2-.3-1.5-.1-.4-.3-.7-.6-1-.3-.3-.6-.5-1-.6-.3-.1-.7-.3-1.5-.3-1-.1-1.3-.1-4-.1zm0 3.1a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2zm0 1.8a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6zm5.3-3.1a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/></svg>
            </a>
            <a class="soc-btn" href="https://www.tiktok.com/@savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on TikTok">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3v11.6a2.4 2.4 0 1 1-1.7-2.3V9.2a5.4 5.4 0 1 0 4.7 5.3V9a7.2 7.2 0 0 0 4 1.3V7.3a4.3 4.3 0 0 1-2-1.5z"/></svg>
            </a>
            <a class="soc-btn" href="https://x.com/savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on X">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 11H17l-5-6.6L6.3 21H3l7.6-8.7L2.5 2H10l4.5 6L18.9 2zm-1.1 17h1.7L7.3 3.8H5.5L17.8 19z"/></svg>
            </a>
            <a class="soc-btn" href="https://www.youtube.com/@savemygig" target="_blank" rel="noopener" aria-label="Save My Gig on YouTube">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.5zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z"/></svg>
            </a>
          </div>
        </div>

        <nav class="foot-col" aria-label="Rescue">
          <span class="foot-col-h">Rescue</span>
          <a href="/emergency">Emergency mode</a>
          <a href="/recovery">Data recovery</a>
        </nav>
        <nav class="foot-col" aria-label="Prevent">
          <span class="foot-col-h">Prevent</span>
          <a href="/prepare">Prevention</a>
          <a href="/checklist">Checklist</a>
          <a href="/gear">Gear</a>
          <a href="/knowledge">Knowledge base</a>
        </nav>
        <nav class="foot-col" aria-label="More">
          <span class="foot-col-h">More</span>
          <a href="/faq">FAQ</a>
          <a href="/about">About</a>
          <a href="/feedback">Send feedback</a>
          <a href="/privacy">Privacy</a>
          <a href="/disclaimer">Disclaimer</a>
        </nav>
      </div>

      <div class="foot-rule"></div>

      <div class="foot-base">
        <span class="foot-copy">© 2026 Save My Gig! · Built by a DJ who's been there.</span>
        <a class="foot-bmc" href="https://buymeacoffee.com/savemygig" data-event="affiliate_click" data-program="bmc" data-placement="footer">Buy me a coffee ☕</a>
      </div>
    </div>
  </footer>
  <Consent />
  <script>
    const t = document.getElementById('navToggle');
    const l = document.getElementById('navLinks');
    if (t && l) {
      t.addEventListener('click', () => {
        const open = l.classList.toggle('open');
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }
    const copyBtn = document.getElementById('shareCopy');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('https://www.savemygig.com');
          const old = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = old; }, 1500);
        } catch (e) { /* ignore */ }
      });
    }

  </script>
</body>
</html>

<style is:global>
  .site-nav-wrap { border-bottom: 1px solid var(--edge-soft); }
  /* ---- Footer: structured, left-aligned, same width as the nav/body ---- */
  /* Must match .site-nav and .wrap exactly: those are border-box 760px
     INCLUDING their 20px gutters, so .foot-inner needs the same padding
     inside the same max-width or the footer sits 20px out. */
  .foot-inner { max-width: var(--site-w); margin: 0 auto; padding: 0 var(--site-pad); }
  .foot-rule { height: 1px; background: var(--edge-soft); margin: 2rem 0; }

  /* Share strip: copy left, buttons right on desktop; stacks on mobile. */
  .foot-share { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .foot-share-copy { text-align: left; }
  .foot-share-h { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; color: var(--text); margin: 0 0 0.15rem; }
  .foot-share-sub { font-size: 0.85rem; color: var(--text-dim); margin: 0; }
  .foot-share-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-body); font-weight: 600; font-size: 0.82rem; letter-spacing: 0.01em;
    color: var(--text-dim); text-decoration: none; background: var(--surf); border: 1px solid var(--edge);
    border-radius: 999px; padding: 0.5rem 1rem; cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .share-btn svg { flex: 0 0 auto; }
  .share-btn:hover { border-color: var(--text-dim); color: var(--text); background: var(--surf-2); }

  /* Columns: brand block + three link columns. */
  .foot-cols { display: flex; gap: 2.5rem; align-items: flex-start; }
  .foot-brand { flex: 1.7; min-width: 17rem; display: flex; flex-direction: column; align-items: flex-start; }
  /* Seal + wordmark lockup. The badge reads as a graphic mark; the text beside
     it carries the name and tagline (the seal's curved micro-type is not
     legible at this size, by design). */
  .foot-lockup { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; }
  .foot-lockup picture { flex: 0 0 auto; display: block; line-height: 0; }
  .foot-seal { width: 72px; height: 72px; display: block; }
  .foot-lockup-text { display: flex; flex-direction: column; }
  .foot-wordmark {
    font-family: var(--font-display); font-weight: 900; font-size: 1.3rem; line-height: 1;
    text-transform: uppercase; letter-spacing: -0.02em; color: var(--text); text-decoration: none;
  }
  .foot-wordmark .accent { color: var(--red); }
  .foot-tag {
    font-family: var(--font-body); font-weight: 600; font-size: 0.55rem; letter-spacing: 0.125em;
    text-transform: uppercase; color: var(--text-dim); margin-top: 4px; white-space: nowrap;
  }
  .foot-blurb { font-size: 0.85rem; line-height: 1.6; color: var(--text-dim); margin: 0.9rem 0 1.1rem; max-width: 22rem; }
  .foot-social { display: flex; gap: 0.55rem; }
  .soc-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 50%;
    color: var(--text-dim); background: var(--surf); border: 1px solid var(--edge);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.08s ease;
  }
  .soc-btn:hover { color: var(--text); border-color: var(--text-dim); background: var(--surf-2); }
  .soc-btn:active { transform: scale(0.94); }

  .foot-col { flex: 1; display: flex; flex-direction: column; gap: 0.7rem; min-width: 7rem; }
  .foot-col-h {
    font-family: var(--font-body); font-weight: 700; font-size: 0.7rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.1rem;
  }
  .foot-col a {
    font-size: 0.88rem; color: var(--text-dim); text-decoration: none; transition: color 0.15s ease;
  }
  .foot-col a:hover { color: var(--red); }

  /* Base row: copyright left, coffee right. */
  .foot-base { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .foot-copy { font-size: 0.8rem; color: var(--text-faint); }
  .foot-bmc { font-size: 0.8rem; color: var(--text-dim); text-decoration: none; }
  .foot-bmc:hover { color: var(--red); }

  @media (max-width: 640px) {
    .foot-share { flex-direction: column; align-items: flex-start; gap: 0.9rem; }
    .foot-share-btns { justify-content: flex-start; }
    .foot-cols { flex-direction: column; gap: 1.8rem; }
    .foot-brand { min-width: 0; }
    .foot-base { justify-content: flex-start; }
  }
  .site-nav {
    max-width: var(--site-w); margin: 0 auto; padding: 0.8rem 1.25rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; position: relative;
  }
  .nav-brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; line-height: 1; flex: 0 0 auto; }
  .nav-brand picture { flex: 0 0 auto; display: block; line-height: 0; }
  .nb-seal { width: 42px; height: 42px; display: block; }
  .nb-text { display: flex; flex-direction: column; gap: 3px; }
  .nb-name {
    font-family: var(--font-display); font-weight: 900; font-size: 1.36rem;
    text-transform: uppercase; letter-spacing: -0.02em; color: var(--text); white-space: nowrap;
  }
  .nb-name .accent { color: var(--red); }
  .nb-tag {
    font-family: var(--font-body); font-weight: 600; font-size: 0.55rem; letter-spacing: 0.125em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .nav-home { display: none; }
  .nav-links { display: flex; gap: 0.78rem; flex-wrap: nowrap; }
  .nav-links a {
    font-family: var(--font-body); font-weight: 600; font-size: 0.73rem; letter-spacing: 0.04em; white-space: nowrap;
    text-transform: uppercase; color: var(--text-dim); text-decoration: none; transition: color 0.15s ease;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-toggle {
    display: none; width: 42px; height: 38px; background: transparent;
    border: 1px solid var(--edge); border-radius: var(--radius);
    flex-direction: column; align-items: center; justify-content: center; gap: 4px; cursor: pointer; padding: 0;
  }
  .nav-toggle .bar { width: 18px; height: 2px; background: var(--text); display: block; }
  .nav-toggle:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

  /* Secondary destinations: in the drawer on mobile, footer on desktop. */
  @media (min-width: 901px) { .nav-more { display: none; } }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }
    .nb-name { font-size: 1.55rem; }
    .nb-tag { font-size: 0.62rem; letter-spacing: 0.135em; }
    .nav-home { display: block; }
    .nav-links {
      display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 30;
      flex-direction: column; gap: 0; background: var(--surf);
      border-bottom: 1px solid var(--edge); padding: 0.25rem 1.25rem 0.75rem;
    }
    .nav-links.open { display: flex; }
    .nav-links a { padding: 0.8rem 0; border-bottom: 1px solid var(--edge-soft); font-size: 0.95rem; }
    .nav-links a:last-child { border-bottom: none; }
  }
</style>
