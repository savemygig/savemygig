---
// TUNNEL layout, the emergency flow, in the original visual language:
// top-bar (brand + blinking status), no nav, no footer links, no ads,
// no affiliate links, no selling. Nothing competes with the rescue.
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  /** e.g. "CRITICAL_PATH" or "ACTIVE_TRIAGE" */
  status: string;
  red?: boolean;
}

const { title, status, red = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>{title}</title>
  <meta name="robots" content="noindex,follow" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600&display=swap" />
  <Analytics />
</head>
<body>
  <header class="top-bar">
    <a href="/" class="brand">SAVE MY GIG</a>
    <div class:list={['status-indicator', { green: !red }]}>{status}</div>
  </header>
  <main class="screen">
    <slot />
  </main>
</body>
</html>
