---
// TUNNEL layout — the emergency flow. RULES (behavior spec §3.1):
// no nav, no footer, no ads, no affiliate links, no book mention.
// Nothing competes with the rescue.
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  /** e.g. "CRITICAL PATH" or "ACTIVE_TRIAGE" */
  status: string;
  red?: boolean;
}

const { title, status, red = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="robots" content="noindex,follow" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@400;600&display=swap" />
  <Analytics />
</head>
<body>
  <main class="wrap">
    <div class:list={['status-line', { red }]}>{status}</div>
    <slot />
  </main>
</body>
</html>
