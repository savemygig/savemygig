---
// TUNNEL layout, the emergency flow, in the original visual language:
// top-bar (brand + blinking status), no nav, no footer links, no ads,
// no affiliate links, no selling. Nothing competes with the rescue.
import Analytics from '../components/Analytics.astro';
import Disclaimer from '../components/Disclaimer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  /** e.g. "CRITICAL_PATH" or "ACTIVE_TRIAGE" */
  status: string;
  red?: boolean;
  /** optional visible heading; falls back to a screen-reader-only one */
  heading?: string;
}

const { title, status, red = false, heading } = Astro.props;
// Every screen needs an h1 for heading order and screen readers. Most steps
// render their own visible <h2>, so by default we emit a hidden h1 derived
// from the page title rather than change the visual design.
const srHeading = heading ?? title.replace(/\s*\|\s*Save My Gig!?\s*$/i, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>{title}</title>
  <meta name="robots" content="noindex,follow" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/archivo-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <Analytics />
</head>
<body>
  <header class="top-bar">
    <div class="top-bar-inner">
      <a href="/" class="brand" aria-label="Save My Gig, home">
        <picture><source srcset="/images/seal-72.webp" type="image/webp" /><img src="/images/seal-72.png" alt="" width="26" height="26" class="tb-seal" decoding="async" /></picture>
        <span>SAVE MY GIG</span>
      </a>
      <div class:list={['status-indicator', { green: !red }]}>{status}</div>
    </div>
  </header>
  <main class="screen" id="main">
    <h1 class="sr-only">{srHeading}</h1>
    <slot />

    <!-- Every step needs a way back. Without this a mis-tap under pressure was
         only recoverable with the browser back gesture, which is unreliable on
         a phone in a dark booth. -->
    <nav class="tunnel-exit" aria-label="Leave or restart">
      <button type="button" class="tx-btn" id="txBack">&larr; Back one step</button>
      <a class="tx-btn" href="/emergency">Start over</a>
    </nav>

    <Disclaimer variant="compact" />
  </main>
  <script is:inline>
    (function () {
      var b = document.getElementById('txBack');
      if (!b) return;
      // If there is no history to go back to (deep link, new tab), send them
      // to triage instead of leaving a dead button.
      if (window.history.length <= 1) {
        b.textContent = '← Back to triage';
        b.addEventListener('click', function () { window.location.href = '/emergency'; });
      } else {
        b.addEventListener('click', function () { window.history.back(); });
      }
    })();
  </script>
  <script is:inline>
    // Register the service worker so the rescue flow works with no signal.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }
  </script>
</body>
</html>

<style is:global>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .tunnel-exit {
    display: flex; gap: 10px; margin-top: 2.2rem;
    padding-top: 1.2rem; border-top: 1px solid var(--edge-soft);
  }
  .tx-btn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 11px 14px;
    font-family: var(--font-body); font-weight: 600; font-size: 0.82rem;
    letter-spacing: 0.02em; color: var(--text-dim); text-decoration: none;
    background: transparent; border: 1px solid var(--edge);
    border-radius: var(--radius); cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tx-btn:hover { color: var(--text); border-color: var(--text-dim); }
  .tx-btn:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  /* The brand in the top bar is the other way out; make it a real tap target. */
  .top-bar .brand { padding: 11px 0; display: inline-block; }
</style>
