---
// TUNNEL layout, the emergency flow, in the original visual language:
// top-bar (brand + blinking status), no nav, no footer links, no ads,
// no affiliate links, no selling. Nothing competes with the rescue.
import Analytics from '../components/Analytics.astro';
import Brand from '../components/Brand.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { byCode, localizedPath, DEFAULT_LANG } from '../i18n/registry.js';
import { t } from '../i18n/ui.js';
import '../styles/global.css';

interface Props {
  title: string;
  /**
   * DEPRECATED 2026-08-03, accepted and ignored. The status line
   * ("NO_SOUND", "NO_SOUND · HOUSE", "CRITICAL_PATH") used to print at the
   * right of the top bar. Antonio, on staging: "the header changes, it's
   * strange, it looks really really bad, it's better you keep it fixed with
   * the header and that's it." He is right, and the polish backlog had
   * already flagged the system-log status line as unresolved: it is an
   * affectation carrying nothing a DJ can act on, and it made the one
   * element that should be identical on every screen change on every screen.
   * Still accepted so the 55 tree nodes and the 7 full-recovery screens do
   * not all need editing; `status` stays in emergency-tree.js if it is ever
   * wanted back somewhere it can earn its place.
   */
  status?: string;
  /** Deprecated with `status`: it only ever set that line's colour. */
  red?: boolean;
  /** optional visible heading; falls back to a screen-reader-only one */
  heading?: string;
  /**
   * True only on screens that instruct or consent to formatting, erasing or
   * deleting. Drives which disclaimer variant renders. Default false: most
   * screens destroy nothing, so they must not print a data-destruction
   * warning (polish audit, 2026-08-03).
   */
  risk?: boolean;
  /** Optional one-line summary. Not for ranking, these screens are noindex:
      it is for the AI crawlers robots.txt allows into the tunnel, which use
      it to describe the step when citing it. */
  description?: string;
  /**
   * Language code from the registry, for <html lang>. ADDITIVE, 2026-08-04:
   * the tunnel used to hardcode lang="en", which was correct while the
   * rescue flow existed only in English. The pt renderer at
   * src/pages/pt/protocol/[...slug].astro passes lang="pt", and a screen
   * whose <html lang> lies about its language is read wrong by screen
   * readers and by every answer engine robots.txt lets in here. Defaults to
   * the canonical language, so every existing English screen is byte
   * identical.
   */
  lang?: string;
}

const { title, heading, risk = false, description, lang = DEFAULT_LANG } = Astro.props;
// BCP 47 tag, not the bare code: pt is served to Brazil and the registry
// resolves it to pt-BR.
const htmlLang = byCode(lang).tag;
// THE TUNNEL'S OWN FURNITURE, localized 2026-08-05. The rescue screens were
// fully translated while the two controls a DJ actually presses, Back and
// Start over, plus the skip link and the exit href, stayed English. A
// Portuguese rescue that answers in English at the one moment the reader is
// panicking is worse than an English rescue, because it breaks trust exactly
// where the product is supposed to earn it.
const S = t(lang);

// SELF-REFERENCING CANONICAL, added 2026-08-04 by the i18n SEO guard, which
// found all 60 tunnel screens shipping with no canonical at all. These pages
// are noindex by design, so this is not about ranking them. It is about the
// AI crawlers that robots.txt DELIBERATELY allows in here: the rescue tunnel
// is the most useful procedural content on the site, and an answer engine
// that cannot resolve a stable URL for a step cannot cite it. A canonical is
// also what stops a screen being attributed to whatever URL happened to link
// it. Derived from the real path, so it cannot drift from the route.
const SITE = 'https://www.savemygig.com';
// build.format is 'file', so Astro.url.pathname arrives as "/protocol/x.html"
// while the site is served at "/protocol/x" (trailingSlash: 'never'). Strip
// both the extension and any trailing slash or the canonical would advertise
// a URL that differs from the one every link on the site uses, which is the
// canonical tag actively doing harm instead of nothing.
const canonical = SITE + (Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/');
// Every screen needs an h1 for heading order and screen readers. Most steps
// render their own visible <h2>, so by default we emit a hidden h1 derived
// from the page title rather than change the visual design.
const srHeading = heading ?? title.replace(/\s*\|\s*Save My Gig?\s*$/i, '');
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex,follow" />
  {/* Matches --bg and the manifest, same as Base.astro. */}
  <meta name="theme-color" content="#0a0a0b" />
  <link rel="icon" type="image/svg+xml" href="/images/logo-shield.svg" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/* FONT PRELOADS DELETED 2026-08-04, on measurement, not taste. Both faces
      are font-display:swap, so they never blocked paint; the preloads simply
      pulled 60KB to the front of the queue ahead of the document itself.
      Removing them, median of 7 throttled runs: FCP home 568 to 280ms,
      /emergency 532 to 272, /checklist 504 to 288, /faq 512 to 264, the
      CDJ-3000 page 568 to 264. LCP fell 128 to 168ms on every text-LCP page
      and blocking time roughly halved. The cost is a slightly larger font
      swap, which lifts homepage CLS from 0.007 to 0.023, still five times
      inside the 0.1 budget. Moving them below the stylesheet does nothing
      (the preload scanner finds them regardless) and fetchpriority="low"
      does nothing either. Both were measured before deleting. */}
  {/* Lets a rescue screen contribute structured data. Without this slot the
      60 tunnel screens, which are the most useful procedural content on the
      site and which robots.txt deliberately opens to AI crawlers, could not
      carry any markup at all. */}
  <slot name="head" />
  <Analytics />
</head>
<body>
  <a href="#main" class="skip-link">{S.skip}</a>
  <header class="top-bar">
    <div class="top-bar-inner">
      {/* SAME LOCKUP AS THE SITE HEADER (Antonio, 2026-08-03). Same shield at
          47x54, same wordmark, same tagline, same gap. The NAV is still out:
          nothing in the tunnel may compete with the decision on screen, and
          seven escape routes in front of a DJ mid-rescue is what this layout
          exists to prevent. But the brand was never what competed, and
          rendering it at half size only made the site look assembled from
          parts. If you change .nav-brand in Base.astro, change .top-bar .brand
          in global.css with it: one lockup, two surfaces. */}
      {/* LOCALE AWARE 2026-08-05. The one link on a tunnel screen went to the
          ENGLISH homepage from a Portuguese or Spanish rescue screen, which
          is the one place on the site where losing your language mid-crisis
          costs the most. The aria-label was English on all 55 screens too.
          Only the destination and the label: no exit confirmation, nothing
          added to the bar. Nothing new may compete with the decision here. */}
      <a href={localizedPath('/', lang)} class="brand" aria-label={S.aria.brandHome}>
        <img src="/images/logo-shield.svg" alt="" width="47" height="54" class="tb-seal" decoding="async" />
        <Brand />
      </a>
      {/* The status line was here. Deleted 2026-08-03. See the `status` prop
          note above: the header is the one element that must not change from
          screen to screen, and this was the only thing on it that did. */}
    </div>
  </header>
  {/* tabindex="-1": a bare <main> is not focusable either, so the skip link
      above scrolled without moving the virtual cursor on all 55 rescue
      screens. Same fix and same reason as the wrapper in Base.astro; the
      shared `#main:focus { outline: none }` rule lives in global.css. */}
  {/* data-risk: the renderer already knows which screens instruct or
        consent to a format or an erase (RISK_NODES), and this layout
        already took the flag for the disclaimer variant. It now reaches
        the markup too, so CSS can give the destructive option more
        WEIGHT than the way out. See .screen[data-risk] in global.css. */}
  <main class="screen" id="main" tabindex="-1" data-risk={risk ? '1' : undefined}>
    <h1 class="sr-only">{srHeading}</h1>
    <!-- The IN TESTING line used to render here, on all 55 tunnel screens.
         Removed 2026-08-03 (polish audit C4, Antonio's go): the disclosure now
         appears ONCE, as the card on /emergency, before the DJ enters. Same
         honesty, stated where it is read, instead of a doubt reprinted above
         every single instruction. Reinstating is one line if that changes. -->
    <slot />

    <!-- Every step needs a way back. Without this a mis-tap under pressure was
         only recoverable with the browser back gesture, which is unreliable on
         a phone in a dark booth. -->
    <!-- flow_back / flow_restart events: Antonio's flow-outcome logging ask
         (2026-08-03). GA4 attaches page_location, so the abandoned screen is
         recorded with each event. Consent-gated like all analytics. -->
    <nav class="tunnel-exit" aria-label={S.tunnel.exitLabel}>
      <button type="button" class="tx-btn" id="txBack" data-event="flow_back">&larr; {S.tunnel.back}</button>
      <a class="tx-btn" href={localizedPath("/emergency", lang)} data-event="flow_restart">{S.tunnel.restart}</a>
    </nav>

    <Disclaimer variant={risk ? 'compact' : 'quiet'} lang={lang} />
  </main>
  <script is:inline define:vars={{ triageText: S.tunnel.backToTriage, triageHref: localizedPath('/emergency', lang) }}>
    (function () {
      var b = document.getElementById('txBack');
      if (!b) return;
      // If there is no history to go back to (deep link, new tab), send them
      // to triage instead of leaving a dead button. Both the label and the
      // destination come from the page's own language: a Brazilian who opens
      // a step from a search result must not be thrown into English triage.
      if (window.history.length <= 1) {
        b.textContent = '← ' + triageText;
        b.addEventListener('click', function () { window.location.href = triageHref; });
      } else {
        b.addEventListener('click', function () { window.history.back(); });
      }
    })();
  </script>
  <script is:inline define:vars={{ swLang: lang === DEFAULT_LANG ? '' : lang }}>
    // Register the service worker so the rescue flow works with no signal.
    // The language rides on the URL so the worker precaches the language the
    // visitor actually installed from. See public/sw.js.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker
          .register('/sw.js' + (swLang ? '?lang=' + swLang : ''))
          .catch(function () {});
      });
    }
  </script>
</body>
</html>

<style is:global>
  /* .sr-only moved to global.css: Base.astro pages need it too, and while it
     lived here every sr-only element outside the tunnel rendered as visible
     text. */
  .tunnel-exit {
    display: flex; gap: 10px; margin-top: 2.2rem;
    padding-top: 1.2rem; border-top: var(--stroke) solid var(--edge-soft);
  }
  .tx-btn {
    flex: 1; display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 11px 14px;
    font-family: var(--font-body); font-weight: 600; font-size: 0.82rem;
    letter-spacing: 0.02em; color: var(--text-dim); text-decoration: none;
    background: transparent; border: var(--stroke) solid var(--edge);
    border-radius: var(--radius); cursor: pointer;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .tx-btn:hover { color: var(--text); border-color: var(--text-dim); }
  .tx-btn:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  /* DELETED 2026-08-03. This scoped rule set `display: inline-block`, which
     beat global.css's `inline-flex` on specificity, because Astro scoped
     styles carry an extra attribute selector. The Brand component renders as
     a BLOCK level flex container, so inside an inline-block parent it broke
     to its own line and the shield sat ABOVE the wordmark on all 55 rescue
     screens. Antonio caught it on staging. The tap target padding it also
     carried moved into the one shared rule in global.css, where it belongs.
     This is the exact failure the propagation doctrine warns about: a scoped
     copy silently defeating the shared rule. Delete, never override. */
</style>
