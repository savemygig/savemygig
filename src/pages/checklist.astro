  function b64urlToStr(s: string): string {
    let t = s.replace(/-/g, '+').replace(/_/g, '/');
    while (t.length % 4) t += '=';
    const bin = atob(t);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function tryRestore(): boolean {
    const m = location.hash.match(/[#&]r=([^&]+)/);
    if (!m) return false;
    try {
      const data = JSON.parse(b64urlToStr(decodeURIComponent(m[1])));
      if (data && data.c) saveCustom(data.c);
      if (data && Array.isArray(data.x)) saveRemoved(data.x);
      // Renames and order joined the payload later; older links simply lack
      // the keys and restore what they carry.
      if (data && data.r && typeof data.r === 'object') saveRenames(data.r);
      if (data && data.o && typeof data.o === 'object') saveOrder(data.o);
      if (data && Array.isArray(data.s)) saveSections(data.s);
      if (data && Array.isArray(data.h)) saveHiddenGroups(data.h);
      if (data && data.n && typeof data.n === 'object') saveNotes(data.n);
      setUnlocked();
      history.replaceState(null, '', location.pathname + location.search);
      return true;
    } catch (e) { return false; }
  }
  function getListByCat(): Record<string, string[]> {
    const out: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      // A category the DJ removed (or one empty in this mode) stays out of
      // the email and the printout entirely.
      if (getComputedStyle(group).display === 'none') return;
      const cat = group.getAttribute('data-group') || '';
      const labels: string[] = [];
      group.querySelectorAll<HTMLElement>('.task').forEach((li) => {
        // Rows hidden by the current MODE (or removal) stay out: emailing from
        // Basic must email the Basic list, not all 37 items. Computed display
        // is checked on the row itself, so items inside a COLLAPSED section
        // still count; collapsing a group is tidiness, not deletion.
        if (getComputedStyle(li).display === 'none') return;
        const el = li.querySelector<HTMLElement>('.task-label');
        const t = el && el.textContent ? el.textContent.trim() : '';
        if (t) labels.push(t);
      });
      out[cat] = labels;
    });
    return out;
  }
  let backupBusy = false;
  async function sendBackup(email: string) {
    if (backupBusy) return; // double-tap sends double emails
    email = (email || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      if (backupMsg) { backupMsg.textContent = 'That email does not look right.'; backupMsg.className = 'backup-msg err'; }
      return;
    }
    if (backupMsg) { backupMsg.textContent = 'Sending...'; backupMsg.className = 'backup-msg'; }
    backupBusy = true;
    try {
      const res = await fetch('/api/backup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email, listByCat: getListByCat(), custom: loadCustom(), removed: loadRemoved(),
          renames: loadRenames(), order: loadOrder(),
          // User sections travel too: the email needs their titles and the
          // restore link needs their definitions. Hidden categories travel
          // so the second device matches the first.
          sections: loadSections(),
          hiddenGroups: loadHiddenGroups(),
          notes: loadNotes(),
          catNames: (() => { const m: Record<string, string> = {}; document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => { const t = g.querySelector('.group-title'); if (t) m[g.getAttribute('data-group') || ''] = t.textContent || ''; }); return m; })(),
        }),
      });
      // A non-2xx is a SERVER problem. It used to fall through res.json()
      // into the catch and tell a DJ on solid venue Wi-Fi "no connection,
      // find signal", which misdiagnoses the failure at them.
      if (!res.ok) {
        if (backupMsg) { backupMsg.textContent = 'Could not send right now, the problem is on our side. Try again in a minute.'; backupMsg.className = 'backup-msg err'; }
        backupBusy = false;
        return;
      }
      const data = await res.json();
      if (data && data.ok) {
        setEmail(email);
        if (backupForm) backupForm.hidden = true;
        if (backupMsg) { backupMsg.textContent = 'Sent to ' + email + '. Check your inbox for the copy and a link to load it anywhere.'; backupMsg.className = 'backup-msg ok'; }
      } else if (backupMsg) {
        backupMsg.textContent = 'Could not send right now. Try again in a minute.'; backupMsg.className = 'backup-msg err';
      }
    } catch (e) {
      if (backupMsg) { backupMsg.textContent = 'No connection. Try again when you have signal.'; backupMsg.className = 'backup-msg err'; }
    }
    backupBusy = false;
  }

  function isVisible(box: HTMLInputElement): boolean {
    const lvl = box.dataset.level;
    if (mode === 'custom') {
      if (loadRemoved().indexOf(box.dataset.key || '') !== -1) return false;
      // Items inside a category the DJ removed do not exist for the meter.
      const g = box.closest('.task-group');
      if (g && loadHiddenGroups().indexOf(g.getAttribute('data-group') || '') !== -1) return false;
    }
    if (mode === 'basic') return lvl === 'basic';
    if (mode === 'advanced') return lvl !== 'custom';
    return true; // custom mode shows everything, minus what you removed
  }

  function render() {
    const visible = allBoxes().filter(isVisible);
    const done = visible.filter((b) => b.checked).length;
    const totalV = visible.length;
    const pct = totalV ? Math.round((done / totalV) * 100) : 0;

    if (pctEl) pctEl.textContent = pct + '%';
    if (fillEl) fillEl.style.width = pct + '%';
    if (subEl) subEl.textContent = pct === 100 ? 'Ready. Go play.' : `${done} of ${totalV} ready`;
    if (readinessEl) readinessEl.classList.toggle('is-ready', pct === 100 && totalV > 0);

    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const inGroup = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')).filter(isVisible);
      const gid = group.getAttribute('data-group');
      const countEl = document.querySelector<HTMLElement>(`.group-count[data-count="${gid}"]`);
      const gdone = inGroup.filter((b) => b.checked).length;
      if (countEl) {
        countEl.textContent = `${gdone}/${inGroup.length}`;
        countEl.classList.toggle('done', gdone === inGroup.length && inGroup.length > 0);
      }
      // Groups with nothing to show in this mode disappear entirely: in
      // Basic, the all-Pro groups (Backups, Technical Kit, Recovery,
      // Travel) would otherwise sit as empty shells. Custom always shows
      // every group, the DJ needs the empty ones to add into.
      group.hidden = mode !== 'custom' && inGroup.length === 0;
    });
  }

  function attachBox(input: HTMLInputElement) {
    const ticks = load();
    if (ticks[input.dataset.key || '']) input.checked = true;
    input.addEventListener('change', () => {
      const s = load(); s[input.dataset.key || ''] = input.checked; save(s); render();
    });
  }

  /* ----- the DJ's own sections (Custom mode, Antonio's spec) ----- */
  // A named section picks its own icon (Antonio: "it has to be intelligent
  // and understand that medicine is medicine"). Keyword match on the title,
  // in English, Portuguese and Spanish; the bulb is the fallback. All
  // monochrome stroke, per the standing no-emoji rule.
  const SECTION_ICONS: Record<string, string> = {
    health: '<path d="M12 3a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-3v3a2 2 0 0 1-2 2h-0a2 2 0 0 1-2-2v-3H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h3V5a2 2 0 0 1 2-2z"/>',
    disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/>',
    usb: '<rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/>',
    plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
    cup: '<path d="M17 8h1a3 3 0 0 1 0 6h-1"/><path d="M3 8h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M7 2v2"/><path d="M11 2v2"/>',
    shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    star: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
    bulb: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/>',
  };
  const SECTION_ICON_WORDS: [string, string[]][] = [
    ['health', ['medic', 'remed', 'pill', 'pharma', 'farmac', 'health', 'saude', 'salud', 'first aid', 'aid kit']],
    ['disc', ['music', 'musica', 'track', 'vinyl', 'record', 'playlist', 'set ']],
    ['usb', ['cable', 'cabo', 'adapter', 'adaptador', 'usb', 'tech', 'charger', 'carregador', 'cargador']],
    ['plane', ['travel', 'viagem', 'viaje', 'flight', 'voo', 'vuelo', 'hotel', 'tour', 'passport', 'passaporte']],
    ['cup', ['food', 'comida', 'snack', 'drink', 'bebida', 'agua', 'water', 'coffee', 'cafe']],
    ['shield', ['key', 'chave', 'llave', 'secur', 'segur', 'lock', 'backup']],
    ['star', ['cloth', 'roupa', 'ropa', 'wear', 'shirt', 'camis', 'merch', 'style', 'estilo']],
  ];
  function pickSectionIcon(title: string): string {
    const t = ' ' + title.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') + ' ';
    let body = SECTION_ICONS.bulb;
    for (const [icon, words] of SECTION_ICON_WORDS) {
      if (words.some((w) => t.indexOf(w) !== -1)) { body = SECTION_ICONS[icon]; break; }
    }
    return '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + body + '</svg>';
  }
  // User sections are real .task-group elements built here with the same
  // anatomy as the fixed ones, so every existing mechanism (counts, custom
  // items, order, print, email) sees them for free. They render only in
  // Custom mode (they contain only custom-level items, and render() hides
  // empty groups outside Custom).
  function renderSections() {
    document.querySelectorAll('.task-group[data-user-section]').forEach((el) => el.remove());
    const listRoot = document.getElementById('list');
    if (!listRoot) return;
    loadSections().forEach((sec) => {
      const section = document.createElement('section');
      section.className = 'panel task-group';
      section.setAttribute('data-group', sec.id);
      section.setAttribute('data-user-section', '1');
      // h2, matching the built-in category panels above (2026-08-04).
      const gh = document.createElement('h2'); gh.className = 'group-h';
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'group-toggle';
      btn.setAttribute('data-toggle', sec.id); btn.setAttribute('aria-expanded', 'true');
      const ic = document.createElement('span'); ic.className = 'group-ic'; ic.setAttribute('aria-hidden', 'true');
      ic.innerHTML = pickSectionIcon(sec.t);
      const title = document.createElement('span'); title.className = 'group-title'; title.textContent = sec.t;
      const meta = document.createElement('span'); meta.className = 'group-meta';
      const count = document.createElement('span'); count.className = 'group-count'; count.setAttribute('data-count', sec.id); count.textContent = '0/0';
      const chev = document.createElement('span'); chev.className = 'chev'; chev.setAttribute('aria-hidden', 'true');
      meta.appendChild(count); meta.appendChild(chev);
      btn.appendChild(ic); btn.appendChild(title); btn.appendChild(meta);
      // Delete (Edit mode only): takes the section and its items with it.
      const del = document.createElement('button');
      del.type = 'button'; del.className = 'group-remove';
      del.setAttribute('aria-label', 'Delete section ' + sec.t); del.innerHTML = '&times;';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        const c = loadCustom();
        (c[sec.id] || []).forEach((it) => { const t = load(); delete t[it.k]; save(t); });
        delete c[sec.id]; saveCustom(c);
        saveSections(loadSections().filter((s) => s.id !== sec.id));
        renderSections(); renderCustom(); render();
      });
      gh.appendChild(btn); gh.appendChild(del);
      const body = document.createElement('div'); body.className = 'group-body'; body.id = 'body-' + sec.id;
      const ul = document.createElement('ul'); ul.className = 'tasks';
      const addRow = document.createElement('div'); addRow.className = 'add-own';
      const addInput = document.createElement('input');
      addInput.type = 'text'; addInput.className = 'add-input';
      addInput.setAttribute('data-cat', sec.id); addInput.placeholder = 'Add your own...';
      addInput.setAttribute('aria-label', 'Add your own item to ' + sec.t); addInput.maxLength = 80;
      const addBtn = document.createElement('button');
      addBtn.type = 'button'; addBtn.className = 'add-btn'; addBtn.setAttribute('data-add', sec.id); addBtn.textContent = 'Add';
      const doAdd = () => { addCustom(sec.id, addInput.value); addInput.value = ''; addInput.focus(); };
      addBtn.addEventListener('click', doAdd);
      addInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
      addRow.appendChild(addInput); addRow.appendChild(addBtn);
      // Category notes, same anatomy as the fixed groups.
      const notesWrap = document.createElement('div'); notesWrap.className = 'cat-notes';
      const notesBtn = document.createElement('button');
      notesBtn.type = 'button'; notesBtn.className = 'notes-toggle'; notesBtn.textContent = '+ Add notes';
      const notesArea = document.createElement('textarea');
      notesArea.className = 'notes-area'; notesArea.rows = 4; notesArea.maxLength = 2000; notesArea.hidden = true;
      notesArea.placeholder = 'Notes for ' + sec.t + ': setup, contacts, times, links, anything this gig needs.';
      notesArea.setAttribute('aria-label', 'Your notes for ' + sec.t);
      const notesHint = document.createElement('span');
      notesHint.className = 'notes-hint'; notesHint.hidden = true; notesHint.textContent = 'Click outside to save.';
      const notesPrev = document.createElement('div');
      notesPrev.className = 'notes-preview'; notesPrev.setAttribute('data-notes-prev', sec.id);
      notesWrap.appendChild(notesBtn); notesWrap.appendChild(notesArea); notesWrap.appendChild(notesHint);
      body.appendChild(ul); body.appendChild(addRow); body.appendChild(notesWrap);
      section.appendChild(gh); section.appendChild(notesPrev); section.appendChild(body);
      // Collapse behaviour, same rules as the fixed groups.
      const open = loadOpen()[sec.id] === true;
      section.classList.toggle('collapsed', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.addEventListener('click', () => {
        const nowOpen = section.classList.contains('collapsed');
        setGroupOpen(section, nowOpen, true);
      });
      listRoot.appendChild(section);
      // After append: wireNotes finds the preview via document queries.
      wireNotes(notesBtn, notesArea, sec.id);
    });
  }

  // Custom items render into the SAME ul as the built-ins, so a group is one
  // reorderable list. The old .custom-tasks ul stays empty (markup untouched).
  function renderCustom() {
    const custom = loadCustom();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const ul = group.querySelector<HTMLElement>('.tasks');
      if (!ul) return;
      ul.querySelectorAll('.task-custom').forEach((li) => li.remove());
      const items = custom[cat] || [];
      items.forEach((it) => {
        const li = document.createElement('li');
        li.className = 'task task-custom';
        li.setAttribute('data-level', 'custom');
        li.setAttribute('data-key', it.k);
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox'; input.dataset.key = it.k; input.dataset.level = 'custom';
        const box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span'); span.className = 'task-label'; span.textContent = it.t;
        label.appendChild(input); label.appendChild(box); label.appendChild(span);
        const drag = makeDragHandle();
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'task-remove'; rm.setAttribute('aria-label', 'Remove'); rm.innerHTML = '&times;';
        rm.addEventListener('click', () => {
          const c = loadCustom(); c[cat] = (c[cat] || []).filter((x) => x.k !== it.k); saveCustom(c);
          const t = load(); delete t[it.k]; save(t); renderCustom(); render();
        });
        li.appendChild(label); li.appendChild(makeEditButton()); li.appendChild(drag); li.appendChild(rm);
        attachBox(input);
        initRename(span);
        ul.appendChild(li);
      });
    });
    applyOrder();
  }

  /* ----- reorder (drag the handle up or down, Custom + Edit only) ----- */
  function makeDragHandle(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-drag';
    b.setAttribute('aria-label', 'Drag to reorder');
    // An SVG, not the "↕" character: iOS renders that codepoint as a blue
    // EMOJI, so the handles looked nothing like the desktop ones.
    // Third iteration, both bounds set by Antonio. 16x16 read as a smudge
    // ("too glued"), 15x24 shouted louder than the checkbox next to it ("too
    // big, I don't like it"). 11x18 with a thinner stroke keeps the clear
    // shaft-and-heads shape that fixed the first complaint at a weight that
    // sits quietly in the row. The 44x44 tap target is padding, unchanged.
    b.innerHTML = '<svg viewBox="0 0 14 22" width="11" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v18"/><path d="m3 6 4-4 4 4"/><path d="m3 16 4 4 4-4"/></svg>';
    initDrag(b);
    return b;
  }
  function initDrag(handle: HTMLElement) {
    handle.addEventListener('pointerdown', (ev: PointerEvent) => {
      if (!(mode === 'custom' && editMode)) return;
      // An open rename must commit before rows start moving: preventDefault
      // below suppresses the focus change, and moving a focused element in
      // the DOM drops focus WITHOUT firing blur, which orphaned the input.
      const openEdit = document.querySelector('.task-label-edit') as HTMLInputElement | null;
      if (openEdit) openEdit.blur();
      const li = handle.closest('li.task') as HTMLElement | null; if (!li) return;
      const ul = li.parentElement as HTMLElement | null; if (!ul) return;
      ev.preventDefault();
      // NO setPointerCapture here: reordering moves the li (and the handle
      // inside it) in the DOM, which silently destroys pointer capture and
      // eats the pointerup. Document-level listeners survive the move.
      const grabOffset = ev.clientY - li.getBoundingClientRect().top;
      li.classList.add('dragging');
      document.body.classList.add('dragging-row');

      // Put the row where the finger is, reorder if it has crossed a
      // neighbour, then re-anchor to the finger so it never jumps.
      const place = (clientY: number) => {
        li.style.transform = '';
        const nat = li.getBoundingClientRect();
        const wantTop = clientY - grabOffset;
        const visCenter = wantTop + nat.height / 2;
        const sibs = Array.from(ul.children)
          .filter((n) => n !== li && !(n as HTMLElement).classList.contains('removed')) as HTMLElement[];
        for (const sib of sibs) {
          const r = sib.getBoundingClientRect();
          if (visCenter > r.top && visCenter < r.bottom) {
            const before = new Map<HTMLElement, number>();
            sibs.forEach((s) => before.set(s, s.getBoundingClientRect().top));
            if (visCenter < r.top + r.height / 2) ul.insertBefore(li, sib);
            else ul.insertBefore(li, sib.nextSibling);
            // Slide the displaced rows from where they were to where they now
            // are, so the list visibly opens a gap instead of snapping.
            sibs.forEach((s) => {
              const d = (before.get(s) || 0) - s.getBoundingClientRect().top;
              if (!d) return;
              s.style.transition = 'none';
              s.style.transform = `translateY(${d}px)`;
              requestAnimationFrame(() => {
                s.style.transition = 'transform 0.16s ease';
                s.style.transform = '';
              });
            });
            break;
          }
        }
        li.style.transform = '';
        const now = li.getBoundingClientRect();
        // The slight scale is the "it comes to you" lift: the row you hold
        // sits above the list until you let go.
        li.style.transform = `translateY(${(wantTop - now.top).toFixed(1)}px) scale(1.03)`;
      };

      // Animate the lift in, then go instant so the row tracks the finger 1:1.
      li.style.transition = 'transform var(--t-fast), box-shadow var(--t-fast)';
      place(ev.clientY);
      window.setTimeout(() => { if (li.classList.contains('dragging')) li.style.transition = ''; }, 130);
      const move = (e: PointerEvent) => { e.preventDefault(); place(e.clientY); };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        document.removeEventListener('pointercancel', up);
        // Settle back into the row it landed on.
        li.style.transition = 'transform 0.16s ease';
        li.style.transform = '';
        window.setTimeout(() => { li.style.transition = ''; }, 190);
        li.classList.remove('dragging');
        document.body.classList.remove('dragging-row');
        saveOrderFromDom();
      };
      document.addEventListener('pointermove', move, { passive: false });
      document.addEventListener('pointerup', up);
      document.addEventListener('pointercancel', up);
    });
  }
  function saveOrderFromDom() {
    const o: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const keys: string[] = [];
      group.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
        keys.push(li.getAttribute('data-key') || '');
      });
      o[cat] = keys;
    });
    saveOrder(o);
  }
  function applyOrder() {
    const o = loadOrder();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const order = o[cat]; if (!order || !order.length) return;
      const ul = group.querySelector<HTMLElement>('.tasks'); if (!ul) return;
      const byKey: Record<string, HTMLElement> = {};
      const all = Array.from(ul.querySelectorAll<HTMLElement>('.task[data-key]'));
      all.forEach((li) => { byKey[li.getAttribute('data-key') || ''] = li; });
      const seq: HTMLElement[] = [];
      order.forEach((k) => { if (byKey[k]) { seq.push(byKey[k]); delete byKey[k]; } });
      all.forEach((li) => { if (seq.indexOf(li) === -1) seq.push(li); });
      seq.forEach((li) => ul.appendChild(li));
    });
  }

  /* ----- rename (tap the text, Custom + Edit only) ----- */
  function applyRenames() {
    const r = loadRenames();
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      const k = li.getAttribute('data-key') || '';
      if (r[k]) {
        const span = li.querySelector<HTMLElement>('.task-label');
        if (span) span.textContent = r[k];
      }
    });
  }
  // Antonio asked for an edit pencil on each row because he thought the only
  // way to change an item was delete-and-retype. Tap-the-text rename has
  // existed the whole time; he built this site and did not find it, which is
  // the complete argument for the pencil. An affordance nobody can see is a
  // feature that does not exist. The pencil triggers the exact same flow.
  function makeEditButton(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-edit';
    b.setAttribute('aria-label', 'Rename this item');
    b.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
    b.addEventListener('click', () => {
      const li = b.closest('li.task') as HTMLElement | null;
      const span = li && li.querySelector<HTMLElement>('.task-label');
      if (span) beginRename(span);
    });
    return b;
  }

  function beginRename(span: HTMLElement) {
      if (!(mode === 'custom' && editMode)) return;
      const li = span.closest('li.task') as HTMLElement | null; if (!li) return;
      if (li.querySelector('.task-label-edit')) return;
      const key = li.getAttribute('data-key') || '';
      const input = document.createElement('input');
      input.type = 'text'; input.className = 'task-label-edit';
      input.value = span.textContent || ''; input.maxLength = 80;
      span.replaceWith(input);
      // Cursor at the END, not select-all: with everything selected, the
      // first keystroke replaces the whole text, which reads as the site
      // eating your item. Editing should start where the text stops.
      input.focus();
      const n = input.value.length;
      input.setSelectionRange(n, n);
      const commit = () => {
        const t = (input.value || '').trim() || (span.textContent || '');
        span.textContent = t;
        input.replaceWith(span);
        if (key.indexOf('c-') === 0) {
          const c = loadCustom();
          Object.keys(c).forEach((cat) => { c[cat] = c[cat].map((x) => (x.k === key ? { k: x.k, t } : x)); });
          saveCustom(c);
        } else {
          const r = loadRenames(); r[key] = t; saveRenames(r);
        }
        render();
      };
      input.addEventListener('blur', commit);
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
        if (e.key === 'Escape') { input.value = span.textContent || ''; input.blur(); }
      });
  }
  // Tap the text still works for the people who found it.
  function initRename(span: HTMLElement) {
    span.addEventListener('click', (ev) => {
      if (!(mode === 'custom' && editMode)) return;
      ev.preventDefault();
      beginRename(span);
    });
  }
  // Built-in rows get their pencil, drag handle and rename wiring at startup.
  function ensureRowControls() {
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      if (li.querySelector('.task-drag')) return;
      const rm = li.querySelector('.task-remove');
      const pencil = makeEditButton();
      const drag = makeDragHandle();
      if (rm) { li.insertBefore(pencil, rm); li.insertBefore(drag, rm); }
      else { li.appendChild(pencil); li.appendChild(drag); }
      const span = li.querySelector<HTMLElement>('.task-label');
      if (span) initRename(span);
    });
  }

  function addCustom(cat: string, text: string) {
    const t = text.trim(); if (!t) return;
    const c = loadCustom(); const arr = c[cat] || [];
    const k = 'c-' + cat + '-' + Date.now().toString(36) + Math.floor(Math.random() * 1000);
    arr.push({ k, t }); c[cat] = arr; saveCustom(c);
    renderCustom(); render();
  }

  // Shared by the mode buttons' own press-and-hold/hover explainers (one
  // source of copy per mode). Round 3: this used to also feed the static
  // dismissible hint line via hintHTML(); that line is a permanent slogan
  // now, so the map only needs to answer "what does this mode do" for the
  // explainer popovers.
  const MODE_COPY_MAP: Record<string, { f: string }> = {
    basic: { f: 'Must-brings. The essential checklist every DJ should have before leaving for a gig.' },
    advanced: { f: 'The full kit. Everything in Base, plus backup gear and professional extras for any situation.' },
    custom: { f: 'Your own. Start with Advanced and tailor the checklist to your setup, workflow, and preferences.' },
  };

  // EXPLAINERS (Antonio's ruling, 2026-07-29; mode-toggle reworked round 2
  // same day). Desktop needs no UI at all: hovering a control for a beat is
  // a convention every mouse user already knows, so it just works. Touch
  // has no hover, so it gets an explicit "ⓘ" toggle instead: off by default
  // (gray), tap turns it on (amber) and shows the one-line instruction;
  // while on, tapping any of the six covered controls shows THAT control's
  // explainer instead of performing its normal action. Tap ⓘ again, back to
  // normal. infoModeOn is a plain variable, never persisted, so it can never
  // be left on between visits. A single document-level CAPTURING click
  // listener is what makes intercepting those taps reliable regardless of
  // when each button's own click handler was registered elsewhere in this
  // file: capture-phase listeners on an ancestor always run before ANY
  // listener on the target itself, so ordering here can never race with
  // resetBtn/lsDelBtn/etc.'s own click handlers.
  const EXPLAIN_HOLD_MS = 1000;
  const HAS_HOVER = (() => { try { return window.matchMedia('(hover: hover)').matches; } catch (e) { return false; } })();
  let closeOpenExplain: (() => void) | null = null;
  let openAnchor: HTMLElement | null = null;
  let infoModeOn = false;
  const EXPLAIN_TARGETS = new Map<HTMLElement, () => string>();

  document.addEventListener('click', (e) => {
    if (!infoModeOn) return;
    const target = e.target as HTMLElement | null;
    // Round 11.5 follow-up: list pills are now explain targets too, but a
    // pill's delete ×, rename pencil, drag handle and inline rename input
    // are separate controls living INSIDE it with their own destructive/
    // editing behavior. Without this, tapping any of them while info mode
    // is also on would get swallowed to show the pill's generic "tap to
    // switch" text instead, making Delete/Move mode unusable at the same
    // time as info mode. Same exclusion list the pill's own click handler
    // already uses for the identical reason.
    if (target && (target.classList.contains('ls-x') || target.closest('.ls-drag') || target.closest('.ls-pencil') || target.closest('.ls-name-edit'))) return;
    const el = target && target.closest ? (target.closest('.explain-target') as HTMLElement | null) : null;
    if (!el || !EXPLAIN_TARGETS.has(el)) return;
    e.preventDefault();
    e.stopPropagation();
    showExplain(el, EXPLAIN_TARGETS.get(el)!());
  }, true);

  function closeExplain() {
    if (closeOpenExplain) { closeOpenExplain(); closeOpenExplain = null; }
    if (openAnchor) { openAnchor.classList.remove('is-open'); openAnchor = null; }
  }

  function showExplain(anchor: HTMLElement, text: string) {
    closeExplain();
    const pop = document.createElement('div');
    pop.className = 'explain-pop';
    pop.setAttribute('role', 'status');
    pop.textContent = text;
    document.body.appendChild(pop);
    const r = anchor.getBoundingClientRect();
    const margin = 10;
    const pw = pop.offsetWidth;
    const ph = pop.offsetHeight;
    let left = Math.min(Math.max(r.left, margin), window.innerWidth - pw - margin);
    let top = r.bottom + 8;
    if (top + ph > window.innerHeight - margin) top = r.top - ph - 8;
    if (top < margin) top = margin;
    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
    openAnchor = anchor;
    anchor.classList.add('is-open');

    const onOutside = (e: Event) => { if (!pop.contains(e.target as Node)) closeExplain(); };
    const onScroll = () => closeExplain();
    closeOpenExplain = () => {
      pop.remove();
      document.removeEventListener('pointerdown', onOutside, true);
      window.removeEventListener('scroll', onScroll, true);
    };
    // Deferred: the pointerdown/click that triggered this popover is still
    // bubbling when showExplain runs, listening for "outside" immediately
    // would catch that same event and close the popover it just opened.
    setTimeout(() => {
      document.addEventListener('pointerdown', onOutside, true);
      window.addEventListener('scroll', onScroll, true);
    }, 0);
    try { if (navigator.vibrate) navigator.vibrate(10); } catch (e) { /* not supported */ }
  }

  // Round 8 (Antonio): while info mode is on (either flavor), every covered
  // control should be visibly lit at once, so a DJ can see at a glance what
  // has extra instructions instead of discovering it one hover/tap at a
  // time. Called from both the desktop and touch branches of the ⓘ toggle
  // below.
  function setAllExplainLit(on: boolean) {
    EXPLAIN_TARGETS.forEach((_fn, el) => el.classList.toggle('info-lit', on));
  }

  // Round 11.5 follow-up (Antonio, live review): New and the list pills
  // themselves ("Default and new also must... be yellow") weren't lighting
  // up with everything else under info mode -- they simply had no explainer
  // registered. Pills are rebuilt from scratch on every renderPills() call
  // (rename, drag reorder, create, delete can all trigger one without a full
  // page reload), so a fresh pill needs its lit state applied at creation
  // time, not just at the next ⓘ toggle. Reading the #explainInfoBtn class
  // directly (rather than the infoModeOn/desktopInfoOn variables) sidesteps
  // this file's usual TDZ trap: renderPills() runs during initial page setup,
  // before either of those `let`s further down the script has executed.
  function isInfoLit(): boolean {
    const btn = document.getElementById('explainInfoBtn');
    return !!btn && btn.classList.contains('mode-active');
  }

  function attachExplainer(el: HTMLElement | null, textFn: () => string) {
    if (!el) return;
    el.classList.add('explain-target');
    EXPLAIN_TARGETS.set(el, textFn);
    // Desktop only: hover-a-beat, independent of the mobile info toggle
    // (the toggle never renders on a hover-capable device, so infoModeOn
    // can never be true there).
    if (HAS_HOVER) {
      let hoverTimer: ReturnType<typeof setTimeout> | undefined;
      el.addEventListener('mouseenter', () => {
        hoverTimer = setTimeout(() => showExplain(el, textFn()), EXPLAIN_HOLD_MS);
      });
      el.addEventListener('mouseleave', () => {
        if (hoverTimer) clearTimeout(hoverTimer);
        closeExplain();
      });
    }
  }

  function setMode(m: string) {
    mode = m;
    disarmResetHook();
    if (listEl) listEl.setAttribute('data-mode', m);
    if (m !== 'custom') setEdit(false);
    // The toolbar itself now lives in every mode, because Clear and Download
    // PDF apply everywhere. Only Edit and Email are Custom-mode tools.
    // style.display, NOT the hidden attribute: .btn sets its own display, and
    // author CSS beats the UA's [hidden] rule. On Antonio's iPhone (Basic mode,
    // not unlocked on that device) Edit stayed tappable, which produced edit
    // state in Basic: remove buttons and green outlines with no pencil and no
    // arrows, because those are rightly Custom-only.
    if (customToolbar) {
      customToolbar.hidden = false;
      const custom = m === 'custom';
      // Edit is the only Custom-exclusive button now: Email works in every
      // mode (it emails whatever list the mode shows) and sits last.
      if (editToggle) editToggle.style.display = custom ? '' : 'none';
    }
    modeBtns.forEach((b) => {
      const on = b.dataset.modeSet === m;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    saveMode(m);
    render();
  }

  function setEdit(on: boolean) {
    // Edit exists only in Custom. Belt to the display-none braces above: even
    // if some path makes the button clickable, edit state cannot turn on
    // outside the one mode whose tools exist.
    if (on && mode !== 'custom') on = false;
    editMode = on;
    if (listEl) listEl.setAttribute('data-edit', on ? 'on' : 'off');
    // "Save", not "Done". Antonio's call: Edit then Save is the pair every
    // user already knows, and once accounts exist Save will also be literally
    // true (it will sync the list). Changes persist locally the moment they
    // are made either way, so the label is a promise the site already keeps.
    if (editToggle) {
      // Same full/short span pair as the other buttons, so the label is
      // consistent whichever path set it (it used to show "Edit" or
      // "Edit list" depending on whether setEdit had run yet).
      // "Save list", matching the row: every action names the same object.
      editToggle.innerHTML = on
        ? '<span class="bl-full">Save list</span><span class="bl-short">Save</span>'
        : '<span class="bl-full">Edit list</span><span class="bl-short">Edit</span>';
      editToggle.classList.toggle('editing', on);
    }
  }

  function applyRemoved() {
    const set = loadRemoved();
    document.querySelectorAll<HTMLElement>('.task[data-key]').forEach((li) => {
      li.classList.toggle('removed', set.indexOf(li.getAttribute('data-key') || '') !== -1);
    });
  }

  function setGroupOpen(section: HTMLElement, open: boolean, persist: boolean) {
    section.classList.toggle('collapsed', !open);
    const btn = section.querySelector<HTMLButtonElement>('.group-toggle');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (persist) {
      const o = loadOpen();
      o[section.getAttribute('data-group') || ''] = open;
      saveOpen(o);
    }
  }

  // restore checks (static items)
  const state = load();
  boxes.forEach((b) => {
    const k = b.dataset.key || '';
    if (state[k]) b.checked = true;
    b.addEventListener('change', () => {
      const s = load();
      s[b.dataset.key || ''] = b.checked;
      save(s);
      render();
    });
  });

  // restore from an email link if one is present, then render custom items
  // The confirm email's redirect lands here with ?confirmed=1. It used to be
  // written and never read: no acknowledgment, and the param stuck around in
  // shared URLs. One green line, then gone.
  if (new URLSearchParams(location.search).get('confirmed') === '1') {
    if (backupMsg) { backupMsg.textContent = 'Email confirmed. You are registered on this device.'; backupMsg.className = 'backup-msg ok'; }
    const sp = new URLSearchParams(location.search); sp.delete('confirmed');
    history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp.toString() : '') + location.hash);
  }

  const restored = tryRestore();
  ensureRowControls();
  applyRenames();
  renderSections();
  renderCustom();
  applyRemoved();
  applyHiddenGroups();

  // Category notes on the fixed groups (user sections wire their own).
  document.querySelectorAll<HTMLButtonElement>('[data-notes-btn]').forEach((btn) => {
    const gid = btn.getAttribute('data-notes-btn') || '';
    const area = document.querySelector<HTMLTextAreaElement>(`textarea[data-notes="${gid}"]`);
    if (area) wireNotes(btn, area, gid);
  });

  // Remove a built-in category (Custom + Edit): hides it and everything in
  // it; Reset list is the way back. User sections have their own delete.
  document.querySelectorAll<HTMLButtonElement>('[data-group-hide]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const gid = btn.getAttribute('data-group-hide') || '';
      const h = loadHiddenGroups();
      if (h.indexOf(gid) === -1) h.push(gid);
      saveHiddenGroups(h);
      applyHiddenGroups();
      render();
    });
  });

  // add a whole new section (Custom + Edit)
  const addSectionBtn = document.getElementById('addSectionBtn');
  const addSectionInput = document.getElementById('addSectionInput') as HTMLInputElement | null;
  if (addSectionBtn && addSectionInput) {
    const doAddSection = () => {
      const t = (addSectionInput.value || '').trim();
      if (!t) return;
      const sections = loadSections();
      const id = 'u-' + t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 24) + '-' + Math.random().toString(36).slice(2, 5);
      sections.push({ id, t });
      saveSections(sections);
      addSectionInput.value = '';
      renderSections(); renderCustom(); render();
      // A section you just named opens ready to receive its first item.
      const el = document.querySelector<HTMLElement>(`.task-group[data-group="${id}"]`);
      if (el) { setGroupOpen(el, true, true); el.querySelector<HTMLInputElement>('.add-input')?.focus(); }
    };
    addSectionBtn.addEventListener('click', doAddSection);
    addSectionInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAddSection(); } });
  }

  // edit toggle (custom mode): gates delete and add so nothing goes by accident
  if (editToggle) editToggle.addEventListener('click', () => setEdit(!editMode));

  // email me a copy: sends the list + a load-anywhere link to their inbox
  // Email requires registration (Antonio: "how can you get an email if you
  // are not registered?"). Registered with a stored address: sends straight
  // away. Registered without one (edge): the inline form. Not registered:
  // the same gate as everything else, and registering sends the list to the
  // address they just gave.
  if (backupBtn) backupBtn.addEventListener('click', () => {
    if (!isUnlocked()) {
      pendingWant = 'email';
      openGate();
      return;
    }
    const stored = getEmail();
    if (stored) { sendBackup(stored); }
    else if (backupForm) {
      backupForm.hidden = false;
      const i = backupForm.querySelector('input');
      if (i) (i as HTMLInputElement).focus();
    }
  });
  if (backupForm) {
    backupForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const i = backupForm.querySelector('input[name="email"]') as HTMLInputElement;
      sendBackup(i.value);
    });
  }

  // remove a standard row (only reachable in edit mode)
  document.querySelectorAll<HTMLButtonElement>('.task-remove[data-remove]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-remove') || '';
      const set = loadRemoved();
      if (set.indexOf(key) === -1) { set.push(key); saveRemoved(set); }
      const li = btn.closest('.task'); if (li) li.classList.add('removed');
      render();
    });
  });

  const unlockTitle = document.getElementById('unlockTitle');
  const unlockCopy = document.getElementById('unlockCopy');
  const MODE_TITLE = 'Unlock Advanced & Custom';
  const MODE_COPY = unlockCopy ? unlockCopy.textContent || '' : '';
  const PDF_TITLE = 'Unlock the printable checklist';
  const PDF_COPY = 'Your list, exactly as it stands, as a clean printable PDF. Print it, fold it, keep it in your USB case, or pin it up in the booth.';

  // Opens the gate with copy that matches what the DJ actually reached for.
  function openGate() {
    const gateCopy = {
      pdf: { t: PDF_TITLE, c: PDF_COPY },
      email: {
        t: 'Unlock: email your list',
        c: 'We send your list, exactly as it stands, to your inbox, with a link that loads it back on any device.',
      },
      mode: { t: MODE_TITLE, c: MODE_COPY },
    }[pendingWant] || { t: MODE_TITLE, c: MODE_COPY };
    if (unlockTitle) unlockTitle.textContent = gateCopy.t;
    if (unlockCopy) unlockCopy.textContent = gateCopy.c;
    if (unlockEl) {
      unlockEl.hidden = false;
      unlockEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    const inp = unlockForm && unlockForm.querySelector('input');
    if (inp) (inp as HTMLInputElement).focus();
  }

  // WHAT YOU DOWNLOAD IS WHAT IS ON SCREEN. Antonio's rule, and it is the only
  // honest one: "if it is clear, it's clear. If it is fulfilled, it's
  // fulfilled." The old button served a pre-made static PDF of the default
  // list, which silently ignored every rename, removal, custom item and tick.
  // Email already sent the real list; Download lied. Now the document is built
  // from the live DOM at the moment of the tap: current mode, current order,
  // current names, current ticks. The browser's own print-to-PDF does the
  // rendering, which needs no library and matches paper size to the user.
  function printCurrentList() {
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c));
    const allNotes = mode === 'custom' ? loadNotes() : {};
    const groups: { title: string; notes: string; items: { label: string; done: boolean }[] }[] = [];
    document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => {
      if (getComputedStyle(g).display === 'none') return; // removed category
      const gid = g.getAttribute('data-group') || '';
      const title = (g.querySelector('.group-title')?.textContent || '').trim();
      const items: { label: string; done: boolean }[] = [];
      g.querySelectorAll<HTMLElement>('li.task').forEach((li) => {
        // Hidden rows are hidden for a reason: removed in Custom, or above the
        // current mode's level. But a COLLAPSED section is tidiness, not
        // deletion, so the check is the row's own computed display, which
        // offsetParent got wrong: it silently dropped every collapsed section
        // from the printout.
        if (getComputedStyle(li).display === 'none') return;
        const label = (li.querySelector('.task-label')?.textContent || '').trim();
        const done = !!li.querySelector<HTMLInputElement>('input[type=checkbox]')?.checked;
        if (label) items.push({ label, done });
      });
      const notes = (allNotes[gid] || '').trim();
      if (items.length || notes) groups.push({ title, notes, items });
    });

    const rows = (items: { label: string; done: boolean }[]) => items.map((it) =>
      `<li class="${it.done ? 'done' : ''}"><span class="bx">${it.done ? '&#10003;' : ''}</span>${esc(it.label)}</li>`
    ).join('');
    const sections = groups.map((g) =>
      `<section><h2>${esc(g.title)}</h2><ul>${rows(g.items)}</ul>${g.notes ? `<p class="gnotes">${notesHtml(g.notes).replace(/\n/g, '<br />')}</p>` : ''}</section>`
    ).join('');

    const w = window.open('', '_blank');
    if (!w) return false; // popup blocked; callers tell the user, not silence
    w.document.write(`<!doctype html><html><head><meta charset="utf-8" />
<title>save-my-gig-pre-gig-checklist</title>
<style>
  /* Ink-friendly on purpose: light page, dark text, real boxes to tick by hand. */
  body { font: 14px/1.5 Arial, Helvetica, sans-serif; color: #111; margin: 36px; }
  .brand { color: #d43a1e; font-weight: 800; letter-spacing: 0.14em; font-size: 11px; text-transform: uppercase; }
  h1 { font-size: 26px; margin: 2px 0 2px; text-transform: uppercase; letter-spacing: -0.01em; }
  .sub { color: #666; font-size: 12px; margin: 0 0 18px; }
  section { break-inside: avoid; margin-bottom: 14px; }
  .gnotes { margin: 6px 0 0 26px; padding: 8px 10px; font-size: 12px; color: #444; border-left: 2px solid #d43a1e; background: #f6f5f3; }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #d43a1e; padding-bottom: 4px; margin: 0 0 6px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 4px 0 4px 26px; position: relative; border-bottom: var(--stroke) solid #eee; }
  .bx { position: absolute; left: 0; top: 5px; width: 13px; height: 13px; border: 1.5px solid #444; border-radius: var(--radius); font-size: 11px; line-height: 13px; text-align: center; }
  li.done { color: #888; text-decoration: line-through; }
  li.done .bx { background: #e8f7ee; border-color: #2f9e5f; color: #2f9e5f; }
  .foot { margin-top: 18px; color: #888; font-size: 11px; display: flex; justify-content: space-between; }
</style></head><body>
<div class="brand">Save My Gig</div>
<h1>Pre-gig checklist</h1>
<p class="sub">Your list, exactly as it stood when you downloaded it. savemygig.com/checklist</p>
${sections}
<div class="foot"><span>Something failing at the booth? savemygig.com/emergency</span><span>savemygig.com</span></div>
<script>window.onload = function () { window.print(); };<\/script>
</body></html>`);
    w.document.close();
    return true;
  }

  // The PDF sits behind the same registration as Advanced and Custom. This is
  // a SOFT gate, deliberately: it is a fair ask, not a lock, and nothing
  // safety-critical is ever behind it.
  const pdfBtn = document.getElementById('pdfBtn');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', () => {
      if (isUnlocked()) {
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'Your browser blocked the download window. Allow pop-ups for this site and tap again.';
          backupMsg.className = 'backup-msg err';
        }
        return;
      }
      pendingWant = 'pdf';
      openGate();
    });
  }

  // mode buttons: Advanced and Custom are gated behind an account.
  // Round 7 (Antonio, "final instructions"): this used to open a SEPARATE
  // registration gate (#unlock) with its own copy and its own email form.
  // He wants Advanced, Custom and Sync to all lead to the exact same place:
  // the account card, same "one account, no password, ever" copy, same
  // Google-first flow. So this now just opens #acctCard, exactly like
  // clicking Sync does -- see applyPendingModeIfAny() below for what
  // happens once sign-in actually completes.
  modeBtns.forEach((b) => b.addEventListener('click', () => {
    const target = b.dataset.modeSet || 'basic';
    if ((target === 'advanced' || target === 'custom') && !isUnlocked()) {
      pendingMode = target;
      setPendingMode(target);
      if (acctCard) acctCard.hidden = false;
      if (acctLine) acctLine.setAttribute('aria-expanded', 'true');
      return;
    }
    if (unlockEl) unlockEl.hidden = true;
    setMode(target);
  }));

  // unlock form: instant access, confirmation email fires in the background
  if (unlockForm) {
    let unlockBusy = false;
    unlockForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (unlockBusy) return; // double-tap sends double emails
      const inp = unlockForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (unlockMsg) { unlockMsg.textContent = 'That email does not look right. Check it and try again.'; unlockMsg.className = 'unlock-msg err'; }
        inp.focus();
        return;
      }
      // The form is novalidate (custom messages), so the artist field's
      // required attribute is decorative: THIS is the real check. Antonio
      // caught the hole registering email-only in a private window. The
      // name is required because the homepage greets the DJ by it.
      const artistInp = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      if (artistInp && !artistInp.value.trim()) {
        if (unlockMsg) { unlockMsg.textContent = 'Add your artist name or first name, so we know what to call you.'; unlockMsg.className = 'unlock-msg err'; }
        artistInp.focus();
        return;
      }
      unlockBusy = true;
      setUnlocked();
      setEmail(email);
      if (unlockEl) unlockEl.hidden = true;

      // Give them the thing they actually came for, immediately. The
      // confirmation email fires afterwards in the background: nobody should
      // wait on an inbox while standing in a hurry.
      if (pendingWant === 'pdf') {
        // Popup blockers eat the print view on exactly this path (the user
        // just submitted a form). Dead air after handing over an email address
        // is the worst possible outcome, so say what happened and what to do.
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'You are registered. Your browser blocked the download window: tap Download list again and allow pop-ups.';
          backupMsg.className = 'backup-msg ok';
        }
      }
      else if (pendingWant === 'email') sendBackup(email); // to the address they just registered
      else {
        setMode(pendingMode);
        // Registration done, mode unlocked: put them at the TOP of their
        // new list, ready to work (Antonio), same move as the back-to-top
        // circle, not stranded at the bottom where the gate was.
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      }

      const want = pendingWant === 'pdf' ? 'pdf' : pendingWant === 'email' ? 'email' : pendingMode;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: want });
      }
      const artistEl = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      const igEl = unlockForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
      // The homepage greets a registered DJ by artist name (Antonio). Stored
      // locally only, first word only; the homepage guards length itself.
      const artistName = artistEl ? artistEl.value.trim() : '';
      if (artistName) {
        try { localStorage.setItem('SMG_ARTIST', artistName.split(/\s+/)[0]); } catch (e) { /* blocked */ }
      }
      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'checklist-' + want,
            artist: artistEl ? artistEl.value.trim() : '',
            instagram: igEl ? igEl.value.trim() : '',
          }),
        });
      } catch (e) { /* unlocked anyway; feature is free */ }
      unlockBusy = false;
    });
  }

  // add-your-own inputs (custom mode)
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((btn) => {
    const cat = btn.getAttribute('data-add') || '';
    const input = document.querySelector<HTMLInputElement>('.add-input[data-cat="' + cat + '"]');
    const doAdd = () => { if (input) { addCustom(cat, input.value); input.value = ''; input.focus(); } };
    btn.addEventListener('click', doAdd);
    if (input) input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
  });

  // collapse toggles (restore open state). DEFAULT COLLAPSED (Antonio,
  // collapse doctrine): the three group headers are the index, the page
  // opens compact on any screen, and a group you opened stays open on your
  // next visit because the choice persists.
  const openState = loadOpen();
  toggles.forEach((btn) => {
    const section = btn.closest('.task-group') as HTMLElement;
    const gid = section.getAttribute('data-group') || '';
    const open = openState[gid] === true; // default collapsed
    setGroupOpen(section, open, false);
    btn.addEventListener('click', () => {
      const nowOpen = section.classList.contains('collapsed'); // collapsed -> will open
      setGroupOpen(section, nowOpen, true);
    });
  });

  // restore mode (advanced/custom only if already unlocked on this device)
  let savedMode = 'basic';
  try { savedMode = localStorage.getItem(MODE_KEY) || 'basic'; } catch (e) { /* ignore */ }
  if (restored) savedMode = 'custom';
  if ((savedMode === 'advanced' || savedMode === 'custom') && !isUnlocked()) savedMode = 'basic';
  setMode(savedMode);

  // reset (ticks only, keeps your custom items and mode)
  const resetBtn = document.getElementById('resetBtn');
  if (resetBtn) {
    // Reset = back to factory, per Antonio: "everything goes back to how it
    // was before you edit anything." In Basic/Advanced that is just the ticks;
    // in Custom it also restores deleted items, undoes renames and reorders,
    // and removes added items. Because that now destroys real work, the first
    // tap arms the button and the second one fires; anything else disarms it.
    let resetArmed = false;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    const disarmReset = () => {
      resetArmed = false;
      if (resetTimer) clearTimeout(resetTimer);
      // Labels live in the markup, stacked; only the class flips. Never
      // write innerHTML here again: label swaps changed the button width
      // and reflowed the whole toolbar.
      resetBtn.classList.remove('armed');
    };
    disarmResetHook = disarmReset;
    resetBtn.addEventListener('click', () => {
      if (!resetArmed) {
        resetArmed = true;
        // "Are you sure?" for every mode (Antonio): short enough to share
        // the idle width, and the red border already says this is serious.
        resetBtn.classList.add('armed');
        resetTimer = setTimeout(disarmReset, 4000);
        return;
      }
      disarmReset();
      allBoxes().forEach((b) => { b.checked = false; });
      save({});
      if (mode === 'custom') {
        try {
          localStorage.removeItem('SMG_CHECKLIST_ORDER_V1');
          localStorage.removeItem('SMG_CHECKLIST_RENAME_V1');
          localStorage.removeItem(CUSTOM_KEY);
          localStorage.removeItem(REMOVED_KEY);
          localStorage.removeItem(SECTIONS_KEY);
          localStorage.removeItem(HIDDENG_KEY);
          localStorage.removeItem(NOTES_KEY);
        } catch (e) {}
        // A full rebuild from defaults beats surgically undoing four kinds of
        // edit in place.
        location.reload();
        return;
      }
      render();
    });
  }

  // ======================= ACCOUNTS / SYNC =======================
  // localStorage stays the source of truth (Antonio's ruling); the server
  // holds copies so another signed-in device can pick them up. Conflict
  // policy is last-write-wins per named list, no merging. MODE and OPEN are
  // device-local on purpose: what you keep collapsed on your phone is not a
  // property of the list.

  const acctLine = document.getElementById('acctLine');
  const acctCard = document.getElementById('acctCard');
  const acctOut = document.getElementById('acctOut');
  const acctIn = document.getElementById('acctIn');
  const acctEmailEl = document.getElementById('acctEmail');
  const acctForm = document.getElementById('acctForm') as HTMLFormElement | null;
  const acctMsg = document.getElementById('acctMsg');
  const acctMsg2 = document.getElementById('acctMsg2');
  // Round 9 (Antonio): "Saved." used to sit there forever, which once got in
  // the way of a real tap on Delete account right after. Auto-clear it after
  // a couple seconds -- but only if it is still the same "ok" confirmation
  // when the timer fires, so it never wipes a later error or "Deleting...".
  let acctMsg2ClearTimer: ReturnType<typeof setTimeout> | undefined;
  const listSwitch = document.getElementById('listSwitch');
  const lsPills = document.getElementById('lsPills');
  const lsNewBtn = document.getElementById('lsNewBtn');
  const lsNewForm = document.getElementById('lsNewForm') as HTMLFormElement | null;
  const lsNewName = document.getElementById('lsNewName') as HTMLInputElement | null;
  const lsMsg = document.getElementById('lsMsg');
  // Antonio's cap, revised on his phone review: seven lists total. The row
  // stays tidy at any count because the pills live inside the collapsed
  // "Lists" region (his harmonica), so the cap is about sanity, not layout.
  const MAX_LISTS = 7;

  type RegList = { id: string; n: string; u: number };
  type Registry = { active: string; lists: RegList[] };

  function loadReg(): Registry {
    try {
      const raw = localStorage.getItem(REG_KEY);
      if (raw) {
        const r = JSON.parse(raw);
        if (r && r.active && Array.isArray(r.lists) && r.lists.length) {
          // One-time migration (round 11.5, Antonio: "maybe you don't need to
          // put that name, maybe you can call default"). Only the untouched
          // starter list on 'main' still named exactly the old default text
          // qualifies -- a DJ who deliberately renamed it is, by definition,
          // not this case, whatever they renamed it to.
          let migrated = false;
          r.lists.forEach((l: RegList) => {
            if (l.id === 'main' && l.n === 'My checklist') { l.n = 'Default'; migrated = true; }
          });
          if (migrated) saveReg(r);
          return r;
        }
      }
    } catch (e) { /* fall through */ }
    return { active: 'main', lists: [{ id: 'main', n: 'Default', u: 0 }] };
  }
  function saveReg(r: Registry) { try { localStorage.setItem(REG_KEY, JSON.stringify(r)); } catch (e) { /* blocked */ } }
  function loadDeleted(): string[] {
    try { const raw = localStorage.getItem(DELETED_KEY); return raw ? JSON.parse(raw) : []; } catch (e) { return []; }
  }
  function saveDeleted(a: string[]) { try { localStorage.setItem(DELETED_KEY, JSON.stringify(a)); } catch (e) { /* blocked */ } }

  // The active list IS the live keys; a snapshot is just reading them all.
  function snapshotLive() {
    return {
      ticks: load(), custom: loadCustom(), removed: loadRemoved(),
      renames: loadRenames(), order: loadOrder(), sections: loadSections(),
      hiddenGroups: loadHiddenGroups(), notes: loadNotes(),
    };
  }
  function liveHasContent(): boolean {
    const s = snapshotLive();
    return Object.keys(s.ticks).length > 0 || Object.keys(s.custom).length > 0 ||
      s.removed.length > 0 || Object.keys(s.renames).length > 0 ||
      Object.keys(s.order).length > 0 || s.sections.length > 0 ||
      s.hiddenGroups.length > 0 || Object.keys(s.notes).length > 0;
  }
  // Writes RAW (not through the save* helpers) so applying a pulled or
  // parked blob never re-marks the list as freshly edited.
  function applyBlobStr(str: string) {
    let b: any = {};
    try { b = JSON.parse(str) || {}; } catch (e) { b = {}; }
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(b.ticks || {}));
      localStorage.setItem(CUSTOM_KEY, JSON.stringify(b.custom || {}));
      localStorage.setItem(REMOVED_KEY, JSON.stringify(b.removed || []));
      localStorage.setItem(RENAME_KEY, JSON.stringify(b.renames || {}));
      localStorage.setItem(ORDER_KEY, JSON.stringify(b.order || {}));
      localStorage.setItem(SECTIONS_KEY, JSON.stringify(b.sections || []));
      localStorage.setItem(HIDDENG_KEY, JSON.stringify(b.hiddenGroups || []));
      localStorage.setItem(NOTES_KEY, JSON.stringify(b.notes || {}));
    } catch (e) { /* blocked */ }
  }
  function getParked(id: string): string {
    try { return localStorage.getItem(LIST_DATA_PREFIX + id) || ''; } catch (e) { return ''; }
  }
  function setParked(id: string, blobStr: string) {
    try { localStorage.setItem(LIST_DATA_PREFIX + id, blobStr); } catch (e) { /* blocked */ }
  }
  function dropParked(id: string) { try { localStorage.removeItem(LIST_DATA_PREFIX + id); } catch (e) { /* blocked */ } }

  // Every list-mutating save* helper calls this: stamp the active list as
  // just-edited and queue a push. Cheap and safe when signed out.
  function bumpActive() {
    try {
      const reg = loadReg();
      const a = reg.lists.find((l) => l.id === reg.active);
      if (a) { a.u = Date.now(); saveReg(reg); }
    } catch (e) { /* never let sync bookkeeping break a tick */ }
    if (acct.email) {
      if (pushTimer) clearTimeout(pushTimer);
      pushTimer = setTimeout(() => { pushAll(false); }, 2500);
    }
  }

  function payloadLists() {
    const reg = loadReg();
    return reg.lists
      .filter((l) => (l.u || 0) > 0)
      .map((l) => ({
        id: l.id, name: l.n, updated_at: l.u,
        blob: l.id === reg.active ? JSON.stringify(snapshotLive()) : (getParked(l.id) || JSON.stringify({})),
      }))
      .filter((l) => l.blob && l.blob !== '{}');
  }
  async function pushAll(keepalive: boolean) {
    if (!acct.email) return;
    const lists = payloadLists();
    const deleted = loadDeleted();
    if (!lists.length && !deleted.length) return;
    try {
      const res = await fetch('/api/sync', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ lists, deleted }),
        keepalive,
      });
      if (res.ok) { saveDeleted([]); setDotSynced(true); }
    } catch (e) { /* offline: localStorage already has everything */ }
  }
  // A tab going to background mid-edit should not lose the last change.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden' && pushTimer) {
      clearTimeout(pushTimer); pushTimer = undefined;
      pushAll(true);
    }
  });

  async function syncNow() {
    if (!acct.email) return;
    // Round 7 BUG FIX (Antonio: removed checklist sections were coming
    // back after sync). Root cause: this used to PULL first, then push.
    // Any local edit made in the last few seconds -- still sitting in
    // bumpActive()'s 2.5s debounce, or just made right as a sign-in
    // triggered this same syncNow() call -- had not reached the server
    // yet. If the server happened to hold an older blob for this list
    // (from before that edit) with a HIGHER updated_at than this device's
    // pre-push local `u` -- the ordinary state right after a fresh local
    // edit, before its own push has landed -- the pull branch below would
    // treat that stale server copy as newer and silently overwrite the
    // local edit, including anything removed via the x. Reproduced with a
    // mocked stale-but-newer-timestamp server response; fixed by pushing
    // BEFORE pulling. This is always safe to do in this order: the server
    // enforces strictly-newer on its own end (see sync.js), so an older
    // local push here is just a no-op there, never a rollback of
    // something another device already stored more recently. Pushing
    // first only ever helps: it gives this device's own latest edits a
    // chance to become "the newest" on the server before any pull could
    // mistake "not pushed yet" for "doesn't exist."
    await pushAll(false);
    let server: { id: string; name: string; blob: string; updated_at: number }[] = [];
    try {
      const res = await fetch('/api/sync');
      if (!res.ok) return;
      const d = await res.json();
      server = Array.isArray(d.lists) ? d.lists : [];
    } catch (e) { return; }
    const reg = loadReg();
    const deleted = loadDeleted();
    let activeChanged = false;
    server.forEach((s) => {
      if (deleted.indexOf(s.id) !== -1) return; // deleted here; push will clean the server
      const local = reg.lists.find((l) => l.id === s.id);
      if (!local) {
        reg.lists.push({ id: s.id, n: s.name, u: s.updated_at });
        setParked(s.id, s.blob);
      } else if (s.updated_at > (local.u || 0)) {
        local.n = s.name; local.u = s.updated_at;
        if (reg.active === s.id) { applyBlobStr(s.blob); activeChanged = true; }
        else setParked(s.id, s.blob);
      }
    });
    saveReg(reg);
    setDotSynced(true);
    if (activeChanged) location.reload(); // fresh render from the pulled state; u now matches, so no loop
    else renderPills();
  }

  // Signed-out chip is a dim verb ("Sync"), signed-in is a green state
  // Round 5, fifth pass (Antonio, resolving the round-3 open question
  // himself): "the sync button could just say Sync. If it is gray, it's
  // off. If it is green, it's on." SUPERSEDES the earlier "label must
  // change with the state, not just the colour" ruling above, label now
  // stays "Sync" always, colour alone carries the state. Agreed this is the
  // right call when asked: the chip isn't the only place state shows up
  // (the chevron and, once opened, "Synced with <email>" both reinforce
  // it), and gray-vs-green is one of the safer color pairs for colorblind
  // users since gray reads as desaturated regardless of hue perception ,
  // unlike, say, red/green. Flagged, not silently changed.
  function setDotSynced(on: boolean) {
    const synced = on && !!acct.email;
    if (acctLine) acctLine.classList.toggle('is-synced', synced);
  }

  function updateAcctUI() {
    const signedIn = !!acct.email;
    if (acctOut) acctOut.hidden = signedIn;
    if (acctIn) acctIn.hidden = !signedIn;
    if (acctEmailEl) acctEmailEl.textContent = acct.email || '';
    setDotSynced(signedIn);
    // Completion step: the account asks what the gate asks, until it has a
    // name. Prefilled when this device already greeted the DJ. The card
    // opens itself so the form is actually seen after the sign-in redirect.
    const profileForm = document.getElementById('acctProfile') as HTMLFormElement | null;
    if (profileForm) {
      const needs = signedIn && !acct.artist;
      profileForm.hidden = !needs;
      if (needs) {
        const a = profileForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
        if (a && !a.value) {
          try { a.value = localStorage.getItem('SMG_ARTIST') || ''; } catch (e) { /* blocked */ }
        }
        if (acctCard && acctCard.hidden && acctLine) {
          acctCard.hidden = false;
          acctLine.setAttribute('aria-expanded', 'true');
        }
      }
    }
    updateListSwitch();
  }

  function updateListSwitch() {
    if (!listSwitch) return;
    const show = mode === 'custom' && !!acct.email;
    listSwitch.hidden = !show;
    if (show) renderPills();
  }

  /* ----- list reorder (drag the handle left or right, Lists Delete/Done
     mode only). Same concept as the checklist's own task-drag, but the pills
     live in a horizontal, wrapping row: placement tracks the nearest pill by
     2D center distance instead of just top/bottom, and the shaft+chevrons
     icon lies on its side to match (Antonio, round 9). */
  function makePillDragHandle(pill: HTMLElement, name: string): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'ls-drag';
    b.setAttribute('aria-label', 'Drag to reorder ' + name);
    b.innerHTML = '<svg viewBox="0 0 22 14" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h18"/><path d="M6 3 2 7l4 4"/><path d="M16 3l4 4-4 4"/></svg>';
    initPillDrag(b, pill);
    return b;
  }
  function initPillDrag(handle: HTMLElement, pill: HTMLElement) {
    handle.addEventListener('pointerdown', (ev: PointerEvent) => {
      if (!listSwitch || !listSwitch.classList.contains('moving')) return;
      const ul = lsPills as HTMLElement | null; if (!ul) return;
      ev.preventDefault();
      ev.stopPropagation();
      const grabX = ev.clientX - pill.getBoundingClientRect().left;
      const grabY = ev.clientY - pill.getBoundingClientRect().top;
      pill.classList.add('dragging');
      document.body.classList.add('dragging-row');

      const place = (clientX: number, clientY: number) => {
        pill.style.transform = '';
        const nat = pill.getBoundingClientRect();
        const wantLeft = clientX - grabX;
        const wantTop = clientY - grabY;
        const cx = wantLeft + nat.width / 2;
        const cy = wantTop + nat.height / 2;
        const sibs = Array.from(ul.children).filter((n) => n !== pill) as HTMLElement[];
        let closest: HTMLElement | null = null;
        let closestDist = Infinity;
        sibs.forEach((sib) => {
          const r = sib.getBoundingClientRect();
          const d = Math.hypot(cx - (r.left + r.width / 2), cy - (r.top + r.height / 2));
          if (d < closestDist) { closestDist = d; closest = sib; }
        });
        if (closest) {
          const r = (closest as HTMLElement).getBoundingClientRect();
          const before = new Map<HTMLElement, DOMRect>();
          sibs.forEach((s) => before.set(s, s.getBoundingClientRect()));
          if (cx < r.left + r.width / 2) ul.insertBefore(pill, closest);
          else ul.insertBefore(pill, (closest as HTMLElement).nextSibling);
          sibs.forEach((s) => {
            const before2 = before.get(s); if (!before2) return;
            const after = s.getBoundingClientRect();
            const dx = before2.left - after.left, dy = before2.top - after.top;
            if (!dx && !dy) return;
            s.style.transition = 'none';
            s.style.transform = `translate(${dx}px, ${dy}px)`;
            requestAnimationFrame(() => { s.style.transition = 'transform 0.16s ease'; s.style.transform = ''; });
          });
        }
        pill.style.transform = '';
        const now = pill.getBoundingClientRect();
        pill.style.transform = `translate(${(wantLeft - now.left).toFixed(1)}px, ${(wantTop - now.top).toFixed(1)}px) scale(1.03)`;
      };

      pill.style.transition = 'transform var(--t-fast), box-shadow var(--t-fast)';
      place(ev.clientX, ev.clientY);
      window.setTimeout(() => { if (pill.classList.contains('dragging')) pill.style.transition = ''; }, 130);
      const move = (e: PointerEvent) => { e.preventDefault(); place(e.clientX, e.clientY); };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        document.removeEventListener('pointercancel', up);
        pill.style.transition = 'transform 0.16s ease';
        pill.style.transform = '';
        window.setTimeout(() => { pill.style.transition = ''; }, 190);
        pill.classList.remove('dragging');
        document.body.classList.remove('dragging-row');
        savePillOrderFromDom();
      };
      document.addEventListener('pointermove', move, { passive: false });
      document.addEventListener('pointerup', up);
      document.addEventListener('pointercancel', up);
    });
  }
  function savePillOrderFromDom() {
    if (!lsPills) return;
    const order = Array.from(lsPills.children).map((p) => (p as HTMLElement).dataset.id || '');
    const reg = loadReg();
    reg.lists.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
    saveReg(reg);
  }

  // Round 11.5 (Antonio): real list rename, not just a checklist item rename.
  // Bumps just the ONE list's own timestamp (not bumpActive(), which only
  // ever touches the active list) so a renamed inactive list still gets
  // picked up by the next debounced push.
  function bumpList(id: string) {
    try {
      const reg = loadReg();
      const l = reg.lists.find((x) => x.id === id);
      if (l) { l.u = Date.now(); saveReg(reg); }
    } catch (e) { /* never let sync bookkeeping break a rename */ }
    if (acct.email) {
      if (pushTimer) clearTimeout(pushTimer);
      pushTimer = setTimeout(() => { pushAll(false); }, 2500);
    }
  }
  function renameList(id: string, name: string) {
    const t = (name || '').trim().slice(0, 40);
    if (!t) return;
    const reg = loadReg();
    const l = reg.lists.find((x) => x.id === id);
    if (!l || l.n === t) return;
    l.n = t;
    saveReg(reg);
    bumpList(id);
  }
  // Same click-to-edit-inline flow as the checklist item pencil
  // (makeEditButton/beginRename below), pointed at a list name instead.
  function beginPillRename(pill: HTMLElement, span: HTMLElement, id: string) {
    if (pill.querySelector('.ls-name-edit')) return;
    const input = document.createElement('input');
    input.type = 'text'; input.className = 'ls-name-edit'; input.maxLength = 40;
    input.value = span.textContent || '';
    span.replaceWith(input);
    input.focus();
    const n = input.value.length;
    input.setSelectionRange(n, n);
    // Typing, clicking or dragging inside the field must never switch or
    // reorder the list out from under the DJ mid-edit.
    input.addEventListener('click', (e) => e.stopPropagation());
    input.addEventListener('pointerdown', (e) => e.stopPropagation());
    const commit = () => {
      const t = (input.value || '').trim();
      if (t) renameList(id, t);
      renderPills(); // rebuilds the row either way, restoring the span
    };
    input.addEventListener('blur', commit);
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      if (e.key === 'Escape') { input.value = span.textContent || ''; input.blur(); }
    });
  }
  function makePillPencil(pill: HTMLElement, span: HTMLElement, id: string, name: string): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'ls-pencil';
    b.setAttribute('aria-label', 'Rename ' + name);
    b.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      beginPillRename(pill, span, id);
    });
    return b;
  }

  let pillArmTimer: ReturnType<typeof setTimeout> | undefined;
  function renderPills() {
    if (!lsPills || !acct.email) return;
    const reg = loadReg();
    // The collapsed header names the active list, so no tap is needed just
    // to know where you are.
    const activeName = document.getElementById('lsActiveName');
    if (activeName) {
      const a = reg.lists.find((l) => l.id === reg.active);
      activeName.textContent = a ? a.n : '';
    }
    lsPills.innerHTML = '';
    reg.lists.forEach((l) => {
      const pill = document.createElement('button');
      pill.type = 'button';
      pill.className = 'ls-pill' + (l.id === reg.active ? ' is-on' : '');
      pill.dataset.id = l.id;
      const name = document.createElement('span');
      name.className = 'ls-name';
      name.textContent = l.n;
      pill.appendChild(name);
      // Round 11.5 follow-up: pills are covered controls too now, same as
      // every other button on the page -- so a DJ can see and read what
      // tapping a pill does before they've ever tapped one.
      attachExplainer(pill, () => 'Tap to switch to this list. Ticks, notes and any edits are saved to each list separately.');
      if (isInfoLit()) pill.classList.add('info-lit');
      // Round 11.5: rename lives on every pill, including the active one --
      // the DJ's current list is the one most likely to need a real name.
      // Gated to Move mode, same as the drag handle appended below.
      pill.appendChild(makePillPencil(pill, name, l.id, l.n));
      if (l.id !== reg.active) {
        pill.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          if (t.classList.contains('ls-x') || t.closest('.ls-drag') || t.closest('.ls-pencil') || t.closest('.ls-name-edit')) return;
          switchList(l.id);
        });
        // Deleting a whole list is the most destructive tap on the page:
        // Edit mode only, and the same two-tap contract as Reset.
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'ls-x';
        x.textContent = '×';
        x.setAttribute('aria-label', 'Delete list ' + l.n);
        x.addEventListener('click', (e) => {
          e.stopPropagation();
          if (!x.classList.contains('armed')) {
            x.classList.add('armed');
            if (pillArmTimer) clearTimeout(pillArmTimer);
            pillArmTimer = setTimeout(() => x.classList.remove('armed'), 4000);
            return;
          }
          deleteList(l.id);
        });
        pill.appendChild(x);
      }
      // Round 9 (Antonio): a reorder handle after the delete x, same idea as
      // the checklist's own drag handle, but sideways since pills sit in a
      // horizontal row. Lives in the same Delete/Done mode as the x -- one
      // toggle reveals both, same pattern as the checklist's Edit toggle
      // revealing pencil + drag + remove together. On for every pill,
      // including the active one, so the active list can move too.
      pill.appendChild(makePillDragHandle(pill, l.n));
      lsPills.appendChild(pill);
    });
    // At the cap the "+ New list" affordance disappears entirely: a dead
    // button would just restate the mess the cap exists to prevent.
    if (lsNewBtn && lsNewForm) {
      const atCap = reg.lists.length >= MAX_LISTS;
      if (atCap) { lsNewBtn.hidden = true; lsNewForm.hidden = true; }
      else if (lsNewForm.hidden) lsNewBtn.hidden = false;
    }
  }

  function switchList(id: string) {
    const reg = loadReg();
    if (id === reg.active || !reg.lists.some((l) => l.id === id)) return;
    setParked(reg.active, JSON.stringify(snapshotLive()));
    applyBlobStr(getParked(id) || '{}');
    reg.active = id;
    saveReg(reg);
    // A full rebuild beats surgically re-rendering eight kinds of state
    // (same call Reset makes).
    location.reload();
  }

  function createList(name: string) {
    const t = (name || '').trim();
    if (!t) return;
    const reg = loadReg();
    if (reg.lists.length >= MAX_LISTS) {
      if (lsMsg) { lsMsg.textContent = 'Seven lists is the cap. Delete one you no longer play.'; lsMsg.className = 'acct-msg err'; }
      return;
    }
    const id = 'l-' + t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 24) + '-' + Math.random().toString(36).slice(2, 6);
    // A new list is a fresh Custom baseline: the full Advanced set, nothing
    // ticked, nothing customised yet (that is what Custom means here).
    reg.lists.push({ id, n: t.slice(0, 40), u: Date.now() });
    saveReg(reg);
    setParked(id, JSON.stringify({}));
    switchList(id);
  }

  function deleteList(id: string) {
    const reg = loadReg();
    if (id === reg.active) return; // the UI never offers this
    reg.lists = reg.lists.filter((l) => l.id !== id);
    saveReg(reg);
    dropParked(id);
    const del = loadDeleted();
    if (del.indexOf(id) === -1) { del.push(id); saveDeleted(del); }
    renderPills();
    if (acct.email) pushAll(false);
  }

  function markSignedIn(email: string, artist?: string | null) {
    acct.email = email;
    if (artist !== undefined) acct.artist = artist;
    // Signing in also registers this device (Antonio's ruling 3: same
    // identity, the account is the layer on top).
    setUnlocked();
    if (!getEmail()) setEmail(email);
    // The artist name follows the DJ like the lists do: a new device learns
    // it from the account, so the homepage greeting works there too.
    if (acct.artist) {
      try {
        if (!localStorage.getItem('SMG_ARTIST')) localStorage.setItem('SMG_ARTIST', acct.artist.split(/\s+/)[0]);
      } catch (e) { /* blocked */ }
    }
    // A device that never had a registry gets one now; a list that already
    // has real content on it deserves to reach the account without waiting
    // for the next edit.
    const reg = loadReg();
    const a = reg.lists.find((l) => l.id === reg.active);
    if (a && !a.u && liveHasContent()) a.u = Date.now();
    saveReg(reg);
    updateAcctUI();
    syncNow();
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'account_signin', { placement: 'checklist' });
    }
  }

  // Round 7: if sign-in just completed because Advanced/Custom was locked
  // (not because the DJ opened Sync on its own), hand over the mode the
  // same way the old registration gate used to -- apply it, close the
  // card, scroll to the top. Called from BOTH sign-in paths: the
  // synchronous one (Google from the card) and the one that survives a
  // full page reload (the magic-link redirect), which is exactly why the
  // pending intent has to live in localStorage and not just a JS variable.
  // Also preserves the marketing double opt-in the old gate fired
  // (Antonio's ruling: account sign-in itself does NOT join the marketing
  // list, only a plain CRM contact -- but arriving via a mode-unlock is
  // the same funnel the old gate fed, so that specific path still sends
  // the opt-in email, same as it always did).
  function applyPendingModeIfAny(): boolean {
    const pm = readPendingMode();
    if (!pm) return false;
    clearPendingMode();
    setMode(pm);
    updateListSwitch();
    if (acctCard) acctCard.hidden = true;
    if (acctLine) acctLine.setAttribute('aria-expanded', 'false');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    try {
      fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: acct.email || '', source: 'checklist-' + pm, artist: acct.artist || '', instagram: '' }),
      });
    } catch (e) { /* unlocked anyway; feature is free */ }
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: pm, method: 'account' });
    }
    return true;
  }

  // Google Identity Services: only injected when the server says a client id
  // is configured and nobody is signed in. One Tap on THIS page only. TWO
  // buttons share one callback: the sync card (plain sign-in) and the gate
  // (registration: artist required, joins the list, fulfils what the DJ
  // reached for). Which one was used is tracked by pointerenter on the
  // wrappers, because clicks inside Google's iframe never reach us.
  let gsiFrom: 'card' | 'gate' = 'card';
  function initGoogle() {
    if (!acct.google || acct.email || document.getElementById('gsiScript')) return;
    const s = document.createElement('script');
    s.src = 'https://accounts.google.com/gsi/client';
    s.id = 'gsiScript';
    s.async = true;
    s.defer = true;
    s.onload = () => {
      const g = (window as any).google;
      if (!g || !g.accounts || !g.accounts.id) return;
      g.accounts.id.initialize({
        client_id: acct.google,
        callback: async (resp: { credential: string }) => {
          const fromGate = gsiFrom === 'gate';
          const body: any = { credential: resp.credential };
          if (fromGate && unlockForm) {
            const aInp = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
            const iInp = unlockForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
            body.artist = aInp ? aInp.value.trim() : '';
            body.instagram = iInp ? iInp.value.trim() : '';
            body.register = true;
          }
          try {
            const r = await fetch('/api/auth/google', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(body),
            });
            const d = await r.json();
            if (d && d.ok && d.email) {
              markSignedIn(d.email, d.artist || null);
              if (fromGate) {
                // Same after-registration moves as the email form: hide the
                // gate and hand over what they actually came for.
                if (unlockEl) unlockEl.hidden = true;
                if (pendingWant === 'pdf') {
                  if (!printCurrentList() && backupMsg) {
                    backupMsg.textContent = 'You are registered. Your browser blocked the download window: tap Download list again and allow pop-ups.';
                    backupMsg.className = 'backup-msg ok';
                  }
                } else if (pendingWant === 'email') {
                  sendBackup(d.email);
                } else {
                  setMode(pendingMode);
                  updateListSwitch();
                  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                  window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
                }
                if (typeof (window as any).gtag === 'function') {
                  (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: pendingWant === 'mode' ? pendingMode : pendingWant, method: 'google' });
                }
              } else {
                // Card path (round 7): Google was pressed from the account
                // card, not the (now PDF/email-only) gate. If that card was
                // opened because Advanced/Custom was locked, hand over the
                // mode now; if it was opened by a plain Sync click, this is
                // a no-op and the card just stays open, unchanged.
                applyPendingModeIfAny();
              }
            } else {
              const msgEl = fromGate ? unlockMsg : acctMsg;
              if (msgEl) { msgEl.textContent = 'Google sign-in did not go through. Use your email instead.'; msgEl.className = (fromGate ? 'unlock-msg' : 'acct-msg') + ' err'; }
            }
          } catch (e) {
            const msgEl = fromGate ? unlockMsg : acctMsg;
            if (msgEl) { msgEl.textContent = 'No connection right now. Your list is safe on this device.'; msgEl.className = (fromGate ? 'unlock-msg' : 'acct-msg') + ' err'; }
          }
        },
      });
      const holder = document.getElementById('gsiBtn');
      if (holder) {
        g.accounts.id.renderButton(holder, { theme: 'filled_black', size: 'large', text: 'continue_with', shape: 'rectangular' });
        // Same Google-first collapse as the gate (round 5, fourth pass): once
        // Google actually renders here, hide the email form behind its own
        // toggle instead of showing both paths stacked and undifferentiated.
        if (acctForm) acctForm.hidden = true;
        const cardToggle = document.getElementById('acctEmailToggle');
        if (cardToggle) cardToggle.hidden = false;
      }
      const gateHolder = document.getElementById('gsiGateBtn');
      if (gateHolder) {
        g.accounts.id.renderButton(gateHolder, { theme: 'filled_black', size: 'large', text: 'continue_with', shape: 'rectangular', width: 230 });
        const alt = document.getElementById('unlockAlt');
        if (alt) alt.hidden = false;
        // Google is the default path now (round 5): once it actually
        // renders, collapse the form behind the toggle. Without JS or
        // without a configured client id, none of this runs and the form
        // just stays visible, which is the only path there is.
        if (unlockForm) unlockForm.hidden = true;
        const toggle = document.getElementById('unlockEmailToggle');
        if (toggle) toggle.hidden = false;
      }
      g.accounts.id.prompt();
    };
    document.head.appendChild(s);
  }

  // Which Google button was pressed: clicks inside Google's iframe never
  // reach us, so pointerenter on the wrapper is the tell.
  {
    const gateWrap = document.getElementById('gsiGateWrap');
    const cardWrap = document.getElementById('gsiBtn');
    if (gateWrap) gateWrap.addEventListener('pointerenter', () => { gsiFrom = 'gate'; });
    if (cardWrap) cardWrap.addEventListener('pointerenter', () => { gsiFrom = 'card'; });
  }

  // "No Google? No problem. Use your other email." (Antonio's own phrasing,
  // round 5): reveals the email/artist/instagram form, which starts hidden
  // once Google is the visible default path above.
  {
    const toggle = document.getElementById('unlockEmailToggle');
    if (toggle) toggle.addEventListener('click', () => {
      if (unlockForm) unlockForm.hidden = false;
      toggle.hidden = true;
      const inp = unlockForm && unlockForm.querySelector('input[name="email"]') as HTMLInputElement | null;
      if (inp) inp.focus();
    });
  }
  // Same toggle, on the Sync card's own Google/email choice (round 5,
  // fourth pass), identical reasoning, separate element since the card and
  // the gate are two different forms on the page.
  {
    const cardToggle = document.getElementById('acctEmailToggle');
    if (cardToggle) cardToggle.addEventListener('click', () => {
      if (acctForm) acctForm.hidden = false;
      cardToggle.hidden = true;
      const inp = acctForm && acctForm.querySelector('input[name="email"]') as HTMLInputElement | null;
      if (inp) inp.focus();
    });
  }

  // The sync chip expands and collapses the account card.
  if (acctLine && acctCard) acctLine.addEventListener('click', () => {
    const open = acctCard.hidden;
    acctCard.hidden = !open;
    acctLine.setAttribute('aria-expanded', open ? 'true' : 'false');
    // Round 7: a manual close means "not now" -- drop any pending
    // Advanced/Custom intent so a later, unrelated sign-in never
    // surprise-applies a mode the DJ never got around to confirming.
    if (!open) clearPendingMode();
  });

  // Round 10 (Antonio, live on mobile): tapped a locked Advanced button,
  // the card opened, and he had no way to back out -- the only close
  // control is tapping Sync again, and nothing told him that. "If you
  // click anywhere in the page except for the green box, it's the same
  // as pressing sync." CAPTURE phase, not bubble: it has to run BEFORE
  // whatever was actually clicked handles its own click, or tapping a
  // locked Advanced/Custom button (which opens the card) would see
  // itself land "outside" and immediately close the card it just opened.
  // No preventDefault/stopPropagation -- this only ever closes the card
  // as a side effect and always lets the real click keep going, same as
  // any dropdown/popover that closes when you click away from it.
  document.addEventListener('click', (ev) => {
    if (!acctCard || acctCard.hidden || !acctLine) return;
    const t = ev.target as Node;
    if (acctCard.contains(t) || acctLine.contains(t)) return;
    acctCard.hidden = true;
    acctLine.setAttribute('aria-expanded', 'false');
    clearPendingMode();
  }, true);

  // Typed email: send the one-tap link.
  if (acctForm) {
    let busy = false;
    acctForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (busy) return;
      const inp = acctForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (acctMsg) { acctMsg.textContent = 'That email does not look right. Check it and try again.'; acctMsg.className = 'acct-msg err'; }
        inp.focus();
        return;
      }
      busy = true;
      if (acctMsg) { acctMsg.textContent = 'Sending your link...'; acctMsg.className = 'acct-msg'; }
      try {
        const res = await fetch('/api/auth/email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        if (res.status === 429) {
          if (acctMsg) { acctMsg.textContent = 'A link is already on its way. Check your inbox, or wait a few minutes for a fresh one.'; acctMsg.className = 'acct-msg err'; }
        } else if (res.ok) {
          if (acctMsg) { acctMsg.textContent = 'Sent to ' + email + '. Open it on this device and tap the button: that signs you in here.'; acctMsg.className = 'acct-msg ok'; }
        } else {
          if (acctMsg) { acctMsg.textContent = 'Could not send right now, the problem is on our side. Try again in a minute.'; acctMsg.className = 'acct-msg err'; }
        }
      } catch (e) {
        if (acctMsg) { acctMsg.textContent = 'No connection. Try again when you have signal.'; acctMsg.className = 'acct-msg err'; }
      }
      busy = false;
    });
  }

  // The completion step: artist required (same rule and same error line as
  // the gate), Instagram optional with the follow-back promise.
  const acctProfileForm = document.getElementById('acctProfile') as HTMLFormElement | null;
  const acctProfileMsg = document.getElementById('acctProfileMsg');
  if (acctProfileForm) {
    let profileBusy = false;
    acctProfileForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (profileBusy) return;
      const aInp = acctProfileForm.querySelector('input[name="artist"]') as HTMLInputElement;
      const iInp = acctProfileForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
      const artist = (aInp.value || '').trim();
      const instagram = iInp ? (iInp.value || '').trim() : '';
      if (!artist) {
        if (acctProfileMsg) { acctProfileMsg.textContent = 'Add your artist name or first name, so we know what to call you.'; acctProfileMsg.className = 'acct-msg err'; }
        aInp.focus();
        return;
      }
      profileBusy = true;
      try {
        const res = await fetch('/api/profile', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ artist, instagram }),
        });
        const d = await res.json();
        if (res.ok && d && d.ok) {
          acct.artist = artist;
          try { localStorage.setItem('SMG_ARTIST', artist.split(/\s+/)[0]); } catch (e) { /* blocked */ }
          updateAcctUI();
          if (acctMsg2) {
            acctMsg2.textContent = instagram ? 'Saved. We will happily follow your work.' : 'Saved.';
            acctMsg2.className = 'acct-msg ok';
            if (acctMsg2ClearTimer) clearTimeout(acctMsg2ClearTimer);
            acctMsg2ClearTimer = setTimeout(() => {
              if (acctMsg2 && acctMsg2.classList.contains('ok')) { acctMsg2.textContent = ''; acctMsg2.className = 'acct-msg'; }
            }, 2200);
          }
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'account_profile', { placement: 'checklist' });
          }
        } else if (acctProfileMsg) {
          acctProfileMsg.textContent = 'Could not save right now, the problem is on our side. Try again in a minute.'; acctProfileMsg.className = 'acct-msg err';
        }
      } catch (e) {
        if (acctProfileMsg) { acctProfileMsg.textContent = 'No connection. Try again when you have signal.'; acctProfileMsg.className = 'acct-msg err'; }
      }
      profileBusy = false;
    });
  }

  // Sign out: the session ends, the device keeps everything it has.
  // Round 7 (Antonio): this used to fire on one tap, which was too easy to
  // hit by accident -- same two-tap arm as Delete account and Reset now.
  const signOutBtn = document.getElementById('signOutBtn');
  if (signOutBtn) {
    let soArmed = false;
    let soArmTimer: ReturnType<typeof setTimeout> | undefined;
    const soDisarm = () => {
      soArmed = false;
      if (soArmTimer) clearTimeout(soArmTimer);
      signOutBtn.classList.remove('armed');
    };
    signOutBtn.addEventListener('click', async () => {
      if (!soArmed) {
        soArmed = true;
        signOutBtn.classList.add('armed');
        soArmTimer = setTimeout(soDisarm, 4000);
        return;
      }
      soDisarm();
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch (e) { /* cookie dies server-side next visit */ }
      acct.email = null;
      // Named lists are an account feature: land back on the main list so the
      // page never strands you on a list you can no longer switch away from.
      const reg = loadReg();
      if (reg.active !== 'main' && reg.lists.some((l) => l.id === 'main')) { switchList('main'); return; }
      updateAcctUI();
    });
  }

  // Delete account: two taps, then everything server-side is gone. The
  // device's own list stays, because it is the DJ's device.
  const delAcctBtn = document.getElementById('delAcctBtn');
  if (delAcctBtn) {
    let armed = false;
    let armTimer: ReturnType<typeof setTimeout> | undefined;
    // Round 5, third pass (Antonio): this line only exists at all once
    // Delete account is armed, at rest it's empty and hidden, not a
    // standing warning for something that hasn't happened.
    // Round 7 (Antonio, exact copy supplied): shorter, drops the "this
    // session stays on the device" clause entirely and adds the "!".
    const delFine = document.getElementById('acctDelFine');
    const delFineWarn = "This can't be undone! Your account and synced/saved lists will be deleted.";
    const disarm = () => {
      armed = false;
      if (armTimer) clearTimeout(armTimer);
      delAcctBtn.classList.remove('armed');
      if (delFine) { delFine.hidden = true; delFine.textContent = ''; }
    };
    delAcctBtn.addEventListener('click', async () => {
      if (!armed) {
        armed = true;
        delAcctBtn.classList.add('armed');
        if (delFine) { delFine.hidden = false; delFine.textContent = delFineWarn; }
        armTimer = setTimeout(disarm, 4000);
        return;
      }
      disarm();
      if (acctMsg2) { acctMsg2.textContent = 'Deleting...'; acctMsg2.className = 'acct-msg'; }
      try {
        const res = await fetch('/api/account', { method: 'DELETE' });
        const d = await res.json();
        if (res.ok && d && d.ok) {
          acct.email = null;
          try {
            localStorage.removeItem(UNLOCK_KEY);
            localStorage.removeItem(EMAIL_KEY);
            localStorage.removeItem('SMG_ARTIST');
            localStorage.removeItem(DELETED_KEY);
          } catch (e) { /* blocked */ }
          if (typeof (window as any).gtag === 'function') {
            (window as any).gtag('event', 'account_delete', { placement: 'checklist' });
          }
          const reg = loadReg();
          if (reg.active !== 'main' && reg.lists.some((l) => l.id === 'main')) { switchList('main'); return; }
          updateAcctUI();
          if (acctMsg) { acctMsg.textContent = 'Account deleted. Everything on our side is gone; the list on this device stays yours.'; acctMsg.className = 'acct-msg ok'; }
        } else if (acctMsg2) {
          acctMsg2.textContent = 'Could not delete right now, the problem is on our side. Try again in a minute.'; acctMsg2.className = 'acct-msg err';
        }
      } catch (e) {
        if (acctMsg2) { acctMsg2.textContent = 'No connection. Try again when you have signal.'; acctMsg2.className = 'acct-msg err'; }
      }
    });
  }

  // The lists region folds and unfolds (Antonio: save space, especially on
  // phones). Collapsed on every load: after a switch the page reloads, and
  // arriving folded is exactly the calm he asked for.
  {
    const lsHead = document.getElementById('lsHead');
    const lsBody = document.getElementById('lsBody');
    if (lsHead && lsBody) lsHead.addEventListener('click', () => {
      const open = lsBody.hidden;
      lsBody.hidden = !open;
      lsHead.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  // New-list controls.
  if (lsNewBtn && lsNewForm) lsNewBtn.addEventListener('click', () => {
    lsNewForm.hidden = false;
    lsNewBtn.hidden = true;
    if (lsNewName) lsNewName.focus();
  });
  if (lsNewForm) lsNewForm.addEventListener('submit', (ev) => {
    ev.preventDefault();
    if (lsNewName) createList(lsNewName.value);
  });

  // Round 11.5 (Antonio, live review): Delete and Move are now two separate,
  // single-purpose toggles instead of one "Delete" button that also revealed
  // the reorder handle ("why is the delete button giving me the option to
  // move? it's a little bit strange"). Mutually exclusive: turning one on
  // turns the other off, so a DJ is never in both a destructive mode and a
  // reorganise mode at once. Each toggle's word label lives in its own
  // .ls-btn-label span now (the button also carries an icon), so the label
  // swap targets that span instead of the whole button's textContent.
  const lsDelBtn = document.getElementById('lsDelBtn');
  const lsMoveBtn = document.getElementById('lsMoveBtn');
  const lsDelLabel = lsDelBtn && lsDelBtn.querySelector('.ls-btn-label');
  const lsMoveLabel = lsMoveBtn && lsMoveBtn.querySelector('.ls-btn-label');
  function setListDeleteMode(on: boolean) {
    if (!listSwitch || !lsDelBtn) return;
    listSwitch.classList.toggle('deleting', on);
    lsDelBtn.classList.toggle('active', on);
    if (lsDelLabel) lsDelLabel.textContent = on ? 'Done' : 'Delete';
    if (!on) document.querySelectorAll('.ls-x.armed').forEach((x) => x.classList.remove('armed'));
  }
  function setListMoveMode(on: boolean) {
    if (!listSwitch || !lsMoveBtn) return;
    listSwitch.classList.toggle('moving', on);
    lsMoveBtn.classList.toggle('active', on);
    if (lsMoveLabel) lsMoveLabel.textContent = on ? 'Done' : 'Manage';
  }
  if (lsDelBtn && listSwitch) lsDelBtn.addEventListener('click', () => {
    const on = !listSwitch.classList.contains('deleting');
    if (on) setListMoveMode(false); // the two modes never run together
    setListDeleteMode(on);
  });
  if (lsMoveBtn && listSwitch) lsMoveBtn.addEventListener('click', () => {
    const on = !listSwitch.classList.contains('moving');
    if (on) setListDeleteMode(false);
    setListMoveMode(on);
  });

  // Press-and-hold explainers: the controls Antonio's rule + review actually
  // calls for. Reset, Download and Email are behavioral (what exactly
  // happens is not obvious from a two-word label); Edit reuses the SAME copy
  // as its own dismissible hint, so a DJ who dismissed that hint forever
  // still has a way back to it; the mode buttons reuse MODE_COPY_MAP, the
  // one place that copy lives.
  attachExplainer(resetBtn, () => 'Puts the list back to how it started. In Base and Advanced that clears every tick. In Custom it also undoes renames, reorders, and any items you added or removed.');
  attachExplainer(pdfBtn, () => 'Saves your list exactly as it looks right now, current mode, order, names and ticks, as a printable PDF.');
  attachExplainer(backupBtn, () => 'Emails your list to your inbox: the full list itself, plus a link that loads it back on any device. Needs a quick free registration first.');
  attachExplainer(editToggle, () => 'Add notes, create sections, add items, rename, reorder or delete. Save your list when you’re done!');
  // Round 11.5 follow-up (Antonio): "the person will not understand that if
  // it clicks there, you have a new list below" -- the Lists accordion
  // trigger itself wasn't covered either, so its whole purpose (opens
  // create/rename/reorder/delete) was invisible under info mode too.
  attachExplainer(document.getElementById('lsHead'), () => 'Opens your saved lists. From here you can create a new list, rename or reorder your lists, or delete one.');
  attachExplainer(lsNewBtn, () => 'Creates a new list, so you can plan a different gig separately from this one. Type a name and save it, up to seven lists.');
  attachExplainer(lsMoveBtn, () => 'Turns on rename and reorder for your saved lists. Tap the pencil on a list to rename it, or drag it by the arrow handle to reorder.');
  attachExplainer(lsDelBtn, () => 'Turns on delete mode for your saved lists. Tap the × on a list once to arm it, tap again to delete it. Your active list can’t be deleted this way, switch to another list first.');
  modeBtns.forEach((b) => attachExplainer(b, () => (MODE_COPY_MAP[b.dataset.modeSet || 'basic'] || MODE_COPY_MAP.basic).f));
  // Round 8 (Antonio): Sync used to be deliberately excluded ("tapping it
  // already opens a card that explains itself") -- he asked for it to be
  // covered too, same as everything else, since hovering it in place is
  // faster than opening the card just to remember what it does.
  attachExplainer(acctLine, () => 'Sync lets you sign in once, no password, and keep your list saved to your account. It follows you to any device you sign in on.');

  // The "ⓘ" toggle (round 3: shown on touch AND desktop now, doing two
  // different jobs). Touch: a plain on/off, never persisted. Turning it on
  // arms the document-level click listener above and shows this line once;
  // turning it off closes whatever explainer happens to be open and hands
  // the covered buttons back to their normal click handlers. Desktop: hover-
  // a-beat already always works regardless of this button, so it never
  // touches infoModeOn or the click-swallowing above, it just shows a static
  // reminder that hovering teaches you each control.
  // Round 5, second pass (Antonio): the desktop version used to be a real
  // click-to-toggle (stayed amber/"on" until clicked again), which falsely
  // implied it was a persistent mode like the mobile touch toggle actually
  // is. It never was one on desktop, hover-a-beat already always works
  // regardless of this button's state. Changed to match how every OTHER
  // covered control already behaves: on while you're on it, off the moment
  // you're not. Click still opens it (nothing here is hoverable-only,
  // clicking is the discovery step), but leaving the button with the mouse
  // now closes it automatically, same as attachExplainer's own
  // mouseenter/mouseleave pattern above, no second click required, and it
  // never sits "on" once your cursor has moved away.
  const explainInfoBtn = document.getElementById('explainInfoBtn');
  let desktopInfoOn = false;
  if (explainInfoBtn) {
    explainInfoBtn.addEventListener('click', () => {
      if (HAS_HOVER) {
        desktopInfoOn = true;
        explainInfoBtn.classList.add('mode-active');
        explainInfoBtn.setAttribute('aria-pressed', 'true');
        showExplain(explainInfoBtn, 'Leave your cursor over anything for a second to read its instructions.');
        setAllExplainLit(true);
        return;
      }
      infoModeOn = !infoModeOn;
      explainInfoBtn.classList.toggle('mode-active', infoModeOn);
      explainInfoBtn.setAttribute('aria-pressed', String(infoModeOn));
      if (infoModeOn) showExplain(explainInfoBtn, 'Tap any button to have its function explained. Tap ⓘ again to go back to normal.');
      else closeExplain();
      setAllExplainLit(infoModeOn);
    });
    if (HAS_HOVER) explainInfoBtn.addEventListener('mouseleave', () => {
      if (!desktopInfoOn) return;
      desktopInfoOn = false;
      explainInfoBtn.classList.remove('mode-active');
      explainInfoBtn.setAttribute('aria-pressed', 'false');
      closeExplain();
      setAllExplainLit(false);
    });
  }

  // The sign-in redirect lands here. ?signedin=1: the session cookie is
  // already set, the /api/auth/me call below turns the row green; one line
  // says so and the param goes away. ?signin=expired: the link was dead or
  // used; open the card so asking again is one tap away.
  {
    const sp = new URLSearchParams(location.search);
    if (sp.get('signedin') === '1') {
      if (acctMsg) { acctMsg.textContent = 'Signed in. Your lists follow you now.'; acctMsg.className = 'acct-msg ok'; }
      sp.delete('signedin');
      history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp.toString() : '') + location.hash);
    } else if (sp.get('signin')) {
      if (acctCard && acctLine) { acctCard.hidden = false; acctLine.setAttribute('aria-expanded', 'true'); }
      if (acctMsg) { acctMsg.textContent = 'That sign-in link expired or was already used. Ask for a fresh one below.'; acctMsg.className = 'acct-msg err'; }
      sp.delete('signin');
      history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp.toString() : '') + location.hash);
    }
  }

  // The switcher follows the mode. setMode() runs before this block exists
  // on the timeline, so the hook is a second listener on the same buttons
  // (registered later = runs after setMode has done its work), not a call
  // inside setMode that would trip the TDZ during init.
  modeBtns.forEach((b) => b.addEventListener('click', () => updateListSwitch()));

  // Who is signed in? Asked once per load; offline or on a static test
  // server this fails quietly and the page is exactly what it was before
  // accounts existed.
  (async function initAccount() {
    try {
      const res = await fetch('/api/auth/me');
      const d = await res.json();
      if (d && d.ok) {
        acct.google = d.google || null;
        if (d.email) {
          markSignedIn(d.email, d.artist || null);
          // Round 7: catches the magic-link path, which is a full page
          // reload -- pendingMode (a JS variable) is gone by now, which is
          // exactly why the pending intent lives in localStorage instead.
          applyPendingModeIfAny();
          return;
        }
      }
    } catch (e) { /* signed out is the default state */ }
    updateAcctUI();
    initGoogle();
  })();

  // back to top
  const topBtn = document.getElementById('topBtn');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
