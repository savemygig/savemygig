---
import Base from '../layouts/Base.astro';
import InstallApp from '../components/InstallApp.astro';

/**
 * Interactive pre-gig checklist. Prevention side, outside the tunnel.
 * Tick boxes with a live readiness meter; state persists per device.
 *   - localStorage SMG_CHECKLIST_V1   = { itemKey: true }        (ticks)
 *   - localStorage SMG_CHECKLIST_MODE = 'basic' | 'advanced'     (depth)
 *   - localStorage SMG_CHECKLIST_OPEN = { groupId: false }       (collapsed)
 * Basic/Advanced toggle keeps the default list short on mobile; Advanced
 * reveals the full kit. Each category collapses independently via the arrow.
 * Readiness counts only the items visible in the current mode.
 */

const groups = [
  {
    id: 'basics',
    title: 'The basics',
    blurb: 'Out the door with nothing missing.',
    items: [
      { key: 'usb-two', level: 'basic', label: 'Two identical USB drives, same export on both' },
      { key: 'headphones', level: 'basic', label: 'Headphones' },
      { key: 'phone', level: 'basic', label: 'Phone charged, plus a power bank' },
      { key: 'money', level: 'basic', label: 'Cash and cards' },
      { key: 'address', level: 'basic', label: 'Venue address and set time confirmed' },
      { key: 'contact', level: 'advanced', label: 'Promoter or club contact saved in your phone' },
      { key: 'guestlist', level: 'advanced', label: 'Your name confirmed on the guest list' },
      { key: 'transport', level: 'advanced', label: 'Transport home sorted: parking, ride, or last train' },
      { key: 'running-order', level: 'advanced', label: 'Running order: when you go on and when you come off' },
      { key: 'watch', level: 'advanced', label: 'A watch you can read in a dark booth' },
      { key: 'pen', level: 'advanced', label: 'A pen, for guest lists and split sheets' },
    ],
  },
  {
    id: 'technical',
    title: 'Technical',
    blurb: 'The gear that actually plays your set.',
    items: [
      { key: 'format', level: 'basic', label: 'Both drives are FAT32, not exFAT; MBR recommended over GPT' },
      { key: 'reexport', level: 'basic', label: 'Re-exported after the last library change' },
      { key: 'tested', level: 'basic', label: 'Both drives tested on a player, or reopened in Rekordbox' },
      { key: 'backup', level: 'basic', label: 'Rekordbox library backed up to cloud or a second drive' },
      { key: 'card', level: 'basic', label: 'Emergency Card saved on your phone' },
      { key: 'adapters', level: 'advanced', label: 'USB-C and USB-A adapters for the booth' },
      { key: 'cables', level: 'advanced', label: 'Spare cable and a short USB extension' },
      { key: 'laptop', level: 'advanced', label: 'Laptop, charger and soundcard, if you play from a laptop' },
      { key: 'third-backup', level: 'advanced', label: 'A third backup drive, or an SD card copy' },
      { key: 'labelled', level: 'advanced', label: 'Drives labelled A and B so you know which is which' },
      { key: 'lib-format', level: 'advanced', label: 'Your export matches the club CDJ library format, no OneLibrary surprise' },
      { key: 'cloud-set', level: 'advanced', label: 'A cloud link to your set you can download at the venue' },
      { key: 'multitool', level: 'advanced', label: 'A small multitool or screwdriver for booth fixes' },
    ],
  },
  {
    id: 'extras',
    title: 'Extras and add-ons',
    blurb: 'The life stuff that is easy to forget on the way out.',
    items: [
      { key: 'meds', level: 'basic', label: 'Any medicine you need' },
      { key: 'clothes', level: 'basic', label: 'The right clothes for the venue, and a spare shirt' },
      { key: 'car-keys', level: 'basic', label: 'Car keys' },
      { key: 'home-keys', level: 'basic', label: 'Home keys' },
      { key: 'docs', level: 'basic', label: 'ID and documents, passport and boarding pass if flying' },
      { key: 'earplugs', level: 'advanced', label: 'Earplugs' },
      { key: 'water', level: 'advanced', label: 'Water bottle' },
      { key: 'freshen', level: 'advanced', label: 'Deodorant and a small towel' },
      { key: 'snacks', level: 'advanced', label: 'Snacks for a long night' },
      { key: 'hotel', level: 'advanced', label: 'Hotel address saved offline, if you are staying over' },
      { key: 'adapter', level: 'advanced', label: 'A travel adapter, if you are playing abroad' },
      { key: 'backup-person', level: 'advanced', label: 'Someone to call who can bring a forgotten item' },
    ],
  },
];

const total = groups.reduce((n, g) => n + g.items.length, 0);
---
<Base
  title="The Pre-Gig Checklist for DJs | Save My Gig!"
  description="A tickable pre-gig checklist for DJs: the basics, the technical gear, and the life stuff you forget. Collapse each section, switch basic or full, track your readiness, saves on your device."
  path="/checklist"
>
  <main class="wrap" id="top">
    <div class="status-line">Prevention_Hub</div>

    <h1 style="margin-bottom:1rem">LEAVE HOME <span class="accent">READY</span></h1>
    <p class="dim" style="margin-bottom:1.6rem">Tick it off before you walk out. Nothing forgotten, nothing sent anywhere. This list saves on this device, so it is waiting next time.</p>

    <div class="mode-switch" role="group" aria-label="Checklist depth">
      <button type="button" class="mode-btn is-on" data-mode-set="basic" aria-pressed="true">Basic</button>
      <button type="button" class="mode-btn" data-mode-set="advanced" aria-pressed="false">Advanced</button>
      <button type="button" class="mode-btn" data-mode-set="custom" aria-pressed="false">Custom</button>
    </div>
    <p class="mode-hint dim" id="modeHint">Basic is the must-bring list. Switch to Advanced for the full kit.</p>

    <!-- One gate, two doors. This panel now also serves the PDF download, so
         the title and first line are set from JS depending on what the DJ
         asked for. A second unlock panel with its own copy would have drifted
         from this one within a week. -->
    <div class="unlock" id="unlock" hidden>
      <!-- Antonio's framing, and it is better than what was here. This is NOT
           "your email is the price". That reads like a transaction and it makes
           a professional feel charged for something we call free. It is
           "free for registered users", which is how every real tool works and
           how a working DJ expects to be treated. -->
      <p class="unlock-title" id="unlockTitle">Register to unlock Advanced and Custom</p>
      <p class="dim unlock-copy" id="unlockCopy">Free for registered users. Register with your email and you are in right away.</p>
      <!-- One required field, two optional ones. Antonio wanted name, surname,
           artist name and Instagram, all required, so he can follow every DJ
           who registers. The follow-back idea is genuinely good and stays. The
           required part does not: every mandatory field cuts completion, and a
           DJ in a hurry abandons forms that feel like paperwork. So email is
           the only requirement, and the Instagram field carries the promise
           that makes people WANT to fill it. Optional fields that offer
           something convert; required fields that demand something do not. -->
      <form class="unlock-form" id="unlockForm" novalidate>
        <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@email.com" aria-label="Your best email" required />
        <input type="text" name="artist" autocomplete="nickname" placeholder="Artist name (optional)" aria-label="Artist name, optional" maxlength="80" />
        <input type="text" name="instagram" autocomplete="off" inputmode="text" placeholder="@your.artist.instagram (optional)" aria-label="Artist Instagram, optional" maxlength="80" />
        <p class="unlock-follow dim">Share your Instagram. We will be happy to follow your work.</p>
        <button type="submit" class="btn btn-solid">Register</button>
      </form>
      <p class="unlock-msg" id="unlockMsg" role="status" aria-live="polite"></p>
      <!-- Antonio's anti-spam promise, in his voice, tightened. This doubles as
           the consent line, so it has to stay honest about what we send. -->
      <p class="unlock-note">Relax, this is not a spam list. Once in a while we share something we think is worth your time: news about the site, new tools, or a product or service that helps your career. That is it. Opt out any time, one click. <a href="/privacy">Privacy</a></p>
    </div>

    <section class="readiness" id="readiness" aria-live="polite">
      <div class="readiness-top">
        <span class="readiness-label">Readiness</span>
        <span class="readiness-pct" id="pct">0%</span>
      </div>
      <div class="meter"><div class="meter-fill" id="meterFill"></div></div>
      <p class="readiness-sub" id="sub">0 ready</p>
    </section>

    <!-- One toolbar, four short verbs (Antonio): Edit, Clear, Download PDF,
         Email. The old layout split them across two rows a full page apart,
         with "Download the printable PDF" and "Clear the list" spelling out
         what the short words already say. Edit and Email only make sense in
         Custom mode and hide outside it; Clear and Download work everywhere. -->
    <div class="custom-toolbar" id="customToolbar" hidden>
      <!-- Antonio's order: the two list actions, then the two ways to take the
           list with you. NOT "Email PDF": that button emails the list as text
           with a restore link, no PDF attached, and a label must never promise
           an attachment that does not arrive. EMAIL LIST is what it does. -->
      <button type="button" class="btn btn-neutral" id="editToggle">Edit</button>
      <button type="button" class="btn btn-neutral" id="resetBtn">Clear</button>
      <button type="button" class="btn btn-neutral" id="backupBtn">Email list</button>
      <button type="button" class="btn btn-neutral" id="pdfBtn" data-event="checklist_download" data-placement="checklist_actions">Download PDF</button>
      <span class="edit-hint dim" id="editHint">Add, remove, rename with the pencil, or drag the arrows to reorder. Tap Save when you finish, so nothing gets deleted by accident.</span>
      <form class="backup-form" id="backupForm" hidden>
        <input type="email" name="email" inputmode="email" autocomplete="email" placeholder="you@email.com" aria-label="Your email" />
        <button type="submit" class="btn btn-neutral">Send it</button>
      </form>
      <p class="backup-msg" id="backupMsg" role="status" aria-live="polite"></p>
    </div>

    <div id="list" data-mode="basic" data-edit="off">
      {groups.map((g) => (
        <section class="panel task-group" data-group={g.id}>
          <h3 class="group-h">
            <button type="button" class="group-toggle" data-toggle={g.id} aria-expanded="true" aria-controls={`body-${g.id}`}>
              <span class="group-title">{g.title}</span>
              <span class="group-meta">
                <span class="group-count" data-count={g.id}>0/0</span>
                <span class="chev" aria-hidden="true"></span>
              </span>
            </button>
          </h3>
          <div class="group-body" id={`body-${g.id}`}>
            <p class="dim group-blurb">{g.blurb}</p>
            <ul class="tasks">
              {g.items.map((it) => (
                <li class="task" data-level={it.level} data-key={it.key}>
                  <label>
                    <input type="checkbox" data-key={it.key} data-level={it.level} />
                    <span class="box" aria-hidden="true"></span>
                    <span class="task-label">{it.label}</span>
                  </label>
                  <button type="button" class="task-remove" aria-label="Remove" data-remove={it.key}>&times;</button>
                </li>
              ))}
            </ul>
            <ul class="custom-tasks" data-custom={g.id}></ul>
            <div class="add-own">
              <input type="text" class="add-input" data-cat={g.id} placeholder="Add your own..." aria-label={`Add your own item to ${g.title}`} maxlength="80" />
              <button type="button" class="add-btn" data-add={g.id}>Add</button>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- The bottom actions row is gone: its two buttons moved into the toolbar
         above the list, where Antonio pointed out they belong. -->

    <div class="panel" style="margin-top:1.5rem">
      <h3 style="margin-bottom:0.6rem">Why two drives, why FAT32</h3>
      <p class="dim" style="margin-bottom:0">These are not superstitions, they are the failures we see most. The full reasoning, and the gear worth carrying, live in the <a href="/prepare">prevention system</a> and the <a href="/gear">gear guide</a>.</p>
    </div>

    <div class="panel panel-danger" style="margin-top:1.5rem">
      <h3 style="margin-bottom:0.6rem">Already at the gig and something failed?</h3>
      <a href="/emergency" class="btn btn-solid" data-event="begin_checkout" data-placement="checklist">Start Emergency Mode</a>
    </div>

    <div class="top-actions">
      <button type="button" class="btn btn-neutral" id="topBtn">Back to top</button>
    </div>
    <InstallApp />
  </main>
</Base>

<style is:global>
  .mode-switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    background: var(--surf);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
  }
  .mode-btn {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: transparent;
    border: none;
    border-radius: var(--radius);
    padding: 0.55rem 1.2rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .mode-btn.is-on { background: var(--text); color: #0a0a0b; }
  .mode-btn:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .mode-hint { font-size: 0.85rem; margin: 0 0 1.6rem; }

  /* It is sticky, so it is on screen the whole time you work the list. That
     makes height expensive: one line ("0 of 36 ready" + the percentage) with a
     thin bar under it, on every screen size. The READINESS label was saying
     what the numbers already say. */
  .readiness {
    background: var(--surf-2);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    padding: 0.7rem 1.1rem;
    margin-bottom: 1.6rem;
    position: sticky;
    top: 0.5rem;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.15rem 1rem;
  }
  .readiness-top { display: contents; }
  .readiness-label { display: none; }
  .readiness-pct {
    grid-area: 1 / 2;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.25s ease;
  }
  .readiness.is-ready .readiness-pct { color: var(--green); }
  .meter {
    grid-area: 2 / 1 / 2 / 3;
    height: 6px;
    background: var(--bg);
    border: 1px solid var(--edge);
    border-radius: 999px;
    overflow: hidden;
    margin: 0.25rem 0 0;
  }
  .meter-fill { height: 100%; width: 0%; background: var(--green); border-radius: 999px; transition: width 0.3s ease; }
  .readiness-sub { grid-area: 1 / 1; margin: 0; font-size: 0.9rem; color: var(--text-dim); }
  .readiness.is-ready .readiness-sub { color: var(--green); }

  @media (max-width: 640px) {
    .readiness { padding: 0.6rem 0.8rem; gap: 0.1rem 0.8rem; }
    .readiness-pct { font-size: 1.35rem; }
    .meter { height: 5px; }
  }

  .task-group { padding: 0; overflow: hidden; }
  /* EDIT MODE IS A VISIBLE STATE (Antonio). While editing: the toggle button
     goes green, and so does every group that is open, i.e. the ones whose
     items you can actually touch right now. Collapsed groups stay neutral,
     which quietly says "expand me and I become editable too". Leave edit mode
     and all of it reverts. One colour, one meaning: green marks where editing
     is live. */
  #editToggle.editing {
    border-color: var(--green); color: var(--green);
  }
  #list[data-edit="on"] .task-group:not(.collapsed) {
    border-color: var(--green);
  }

  /* Collapsible header is a full-width button living inside the h3. */
  .group-h { margin: 0; }
  .group-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 1.3rem 1.5rem;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .group-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 3.6vw, 1.35rem);
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .group-meta { display: inline-flex; align-items: center; gap: 0.85rem; flex: 0 0 auto; }
  .group-count {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .group-count.done { color: var(--green); }
  .chev {
    width: 9px; height: 9px;
    border-right: 2px solid var(--text-dim);
    border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg);           /* points down when expanded */
    margin-top: -3px;
    transition: transform 0.2s ease;
    flex: 0 0 auto;
  }
  .group-toggle:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }

  .group-body { padding: 0 1.5rem 1.1rem; }
  .task-group.collapsed .group-body { display: none; }
  .task-group.collapsed .chev { transform: rotate(-45deg); } /* points right when collapsed */

  .group-blurb { margin: 0 0 0.4rem; font-size: 0.92rem; }

  .tasks { list-style: none; margin: 0.4rem 0 0; padding: 0; }
  .task { border-bottom: 1px solid var(--edge-soft); display: flex; align-items: center; }
  .task:last-child { border-bottom: none; }
  .task > label { flex: 1; }
  /* Basic mode hides the advanced items so the mobile list stays short. */
  #list[data-mode="basic"] .task[data-level="advanced"] { display: none; }

  .task label {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem 0.2rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .task input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .box {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border: 1.5px solid var(--text-faint);
    border-radius: var(--radius);
    background: var(--bg);
    position: relative;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .box::after {
    content: '';
    position: absolute;
    left: 8px; top: 4px;
    width: 6px; height: 11px;
    border: solid #0a0a0b;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 0.15s ease;
  }
  .task input:checked + .box { background: var(--green); border-color: var(--green); }
  .task input:checked + .box::after { transform: rotate(45deg) scale(1); }
  .task input:focus-visible + .box { outline: 2px solid var(--green); outline-offset: 2px; }
  .task-label { font-size: 1rem; line-height: 1.45; color: var(--text); transition: color 0.15s ease; }
  .task input:checked ~ .task-label {
    color: var(--text-faint);
    text-decoration: line-through;
    text-decoration-color: var(--text-faint);
  }

  .checklist-actions { margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .checklist-actions .btn { width: auto; display: inline-block; margin: 0; }
  .top-actions { margin-top: 1.5rem; text-align: center; }
  .top-actions .btn { width: auto; display: inline-block; margin: 0; }

  .unlock {
    background: var(--surf-2); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.2rem 1.3rem; margin: 0 0 1.6rem;
  }
  .unlock[hidden] { display: none; }
  .unlock-title {
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    text-transform: uppercase; letter-spacing: -0.01em; margin: 0 0 0.4rem;
  }
  .unlock-copy { font-size: 0.9rem; margin: 0 0 0.9rem; }
  .unlock-form { display: flex; flex-direction: column; gap: 10px; }
  .unlock-follow { font-size: 0.82rem; margin: 0; }
  .unlock-form input {
    width: 100%; padding: 0.9rem 1rem; font-family: inherit; font-size: 16px;
    color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: var(--radius);
  }
  .unlock-form input::placeholder { color: var(--text-faint); }
  .unlock-form input:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .unlock-form .btn { margin: 0; }
  .unlock-msg:empty { display: none; }
  .unlock-msg { margin: 0.8rem 0 0; font-size: 0.88rem; color: var(--text-dim); }
  .unlock-msg.ok { color: var(--green); }
  .unlock-msg.err { color: var(--red); }
  /* The single-row desktop layout died when the form grew optional fields:
     three inputs, a promise line and a button do not fit on one row. Email and
     artist share a row on wide screens, Instagram and its promise get their
     own, button under. */
  @media (min-width: 520px) {
    .unlock-form { flex-direction: row; flex-wrap: wrap; }
    .unlock-form input { flex: 1 1 220px; }
    .unlock-form .unlock-follow { flex: 1 1 100%; }
    .unlock-form .btn { width: auto; white-space: nowrap; }
  }
  .unlock-note { margin: 0.8rem 0 0; font-size: 0.76rem; color: var(--text-faint); }
  .unlock-note a { color: var(--text-dim); }

  /* Custom mode: your own items. Editing (delete/add) is gated behind Edit. */
  .custom-tasks { list-style: none; margin: 0; padding: 0; }
  #list:not([data-mode="custom"]) .custom-tasks { display: none; }
  #list[data-mode="custom"] .task.removed { display: none; }
  /* Custom items now live in the same list as the built-ins so the whole
     group can be reordered as one. Hidden outside Custom mode. */
  #list:not([data-mode="custom"]) .task-custom { display: none; }
  /* Drag handle: only in Custom + Edit. touch-action none so dragging the
     handle reorders instead of scrolling the page. */
  .task-drag {
    display: none; background: none; border: 0; color: var(--text-faint);
    line-height: 0; cursor: grab;
    /* 44x44 minimum, because you have to hit this exactly to start a drag and
       Antonio had to aim for it. The arrow inside is now 15x24, so the padding
       is what gets the target to a thumb-sized 44. */
    padding: 10px 14px;
    min-width: 44px; min-height: 44px;
    display: none; align-items: center; justify-content: center;
    touch-action: none; flex: 0 0 auto;
  }
  .task-drag:hover { color: var(--text-dim); }
  .task-drag:active { cursor: grabbing; color: var(--text); }
  /* The rename pencil. Same recipe as the drag handle: small quiet icon,
     thumb-sized target, visible only where renaming is actually possible. */
  .task-edit {
    display: none; background: none; border: 0; color: var(--text-faint);
    line-height: 0; cursor: pointer;
    padding: 10px; min-width: 40px; min-height: 40px;
    align-items: center; justify-content: center; flex: 0 0 auto;
  }
  .task-edit:hover { color: var(--green); }
  #list[data-mode="custom"][data-edit="on"] .task-edit { display: flex; }
  #list[data-mode="custom"][data-edit="on"] .task-drag { display: flex; }
  /* The row you are holding lifts off the list and follows your finger; the
     rows it displaces slide out of the way. Same on mobile and desktop, it is
     all pointer events. */
  .task.dragging {
    background: var(--surf-2);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    border-bottom-color: transparent;
    position: relative;
    z-index: 6;
    cursor: grabbing;
  }
  .task.dragging .task-drag { color: var(--green); cursor: grabbing; }
  /* No text selection, no long-press callout, no blue highlight while you are
     editing. Putting a finger on a row used to select the words. */
  body.dragging-row { user-select: none; -webkit-user-select: none; }

  /* NOTHING in the list is selectable. The old rules only covered edit mode and
     only certain children, so a drag that started a few pixels off the handle
     ran a range selection straight down the list and painted several rows blue,
     including the remove buttons. A checklist is something you tick and drag,
     never something you highlight, so the whole list opts out. The rename input
     is the one exception and re-enables it below. */
  #list, #list .task, #list .task-label, #list .group-toggle, .task-drag {
    user-select: none; -webkit-user-select: none;
    -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .task { transition: none !important; }
  }
  .task-label-edit {
    flex: 1; min-width: 0; font: inherit; color: var(--text);
    background: var(--surf-2); border: 1px solid var(--green);
    border-radius: 2px; padding: 0.2rem 0.45rem;
    /* The one place selection MUST work: you cannot rename what you cannot
       select. Overrides the blanket rule above. */
    user-select: text; -webkit-user-select: text;
  }
  .task-remove {
    flex: 0 0 auto; display: none; background: transparent; border: none; color: var(--text-faint);
    font-size: 1.4rem; line-height: 1; cursor: pointer; padding: 0 0.2rem 0 0.6rem;
  }
  #list[data-edit="on"] .task-remove { display: block; }
  .task-remove:hover { color: var(--red); }

  .custom-toolbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .custom-toolbar[hidden] { display: none; }
  .custom-toolbar .btn { width: auto; display: inline-block; margin: 0; }
  .edit-hint { font-size: 0.8rem; }

  .add-own { display: none; gap: 8px; margin: 0.6rem 0 0.2rem; }
  #list[data-mode="custom"][data-edit="on"] .add-own { display: flex; }

  .backup-form { display: flex; gap: 8px; flex-basis: 100%; margin-top: 0.3rem; }
  .backup-form[hidden] { display: none; }
  .backup-form input {
    flex: 1; padding: 0.7rem 0.9rem; font-family: inherit; font-size: 16px; color: var(--text);
    background: var(--bg); border: 1px solid var(--edge); border-radius: var(--radius);
  }
  .backup-form input::placeholder { color: var(--text-faint); }
  .backup-form .btn { margin: 0; width: auto; }
  .backup-msg { flex-basis: 100%; margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--text-dim); }
  .backup-msg:empty { display: none; }
  .backup-msg.ok { color: var(--green); }
  .backup-msg.err { color: var(--red); }
  .add-own .add-input {
    flex: 1; padding: 0.75rem 0.9rem; font-family: inherit; font-size: 16px; color: var(--text);
    background: var(--bg); border: 1px dashed var(--edge); border-radius: var(--radius);
  }
  .add-own .add-input::placeholder { color: var(--text-faint); }
  .add-own .add-input:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .add-own .add-btn {
    flex: 0 0 auto; background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    color: var(--text); font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.03em; padding: 0 1rem; cursor: pointer;
  }
  @media (hover: hover) { .add-own .add-btn:hover { border-color: var(--text-dim); } }

  @media (prefers-reduced-motion: reduce) {
    .meter-fill, .box, .box::after, .readiness-pct, .mode-btn, .chev { transition: none; }
  }

  /* Mobile width and alignment (kept last so it wins the cascade).
     The generic .panel padding was stacking on top of the card's own inset,
     so the checkboxes sat 21px right of the Done button and 40px of the card
     was dead space on the right. Zero the panel padding and let the header and
     the body share ONE 1.2rem inset, matched by the toolbar buttons, so the
     group title, the checkboxes and Done all start on the same vertical line. */
  @media (max-width: 640px) {
    main.wrap { padding-left: 0.75rem; padding-right: 0.75rem; }
    .task-group.panel { padding-left: 0; padding-right: 0; }
    .group-toggle { padding: 1.05rem 1.2rem; }
    .group-body { padding: 0 1.2rem 0.95rem; }
    .task > label { padding-left: 0; padding-right: 0; }
    .custom-toolbar .btn { padding-left: 1.2rem; padding-right: 1.2rem; }
  }
</style>

<script>
  const STORE_KEY = 'SMG_CHECKLIST_V1';
  const MODE_KEY = 'SMG_CHECKLIST_MODE';
  const OPEN_KEY = 'SMG_CHECKLIST_OPEN';
  const UNLOCK_KEY = 'SMG_UNLOCKED';
  const CUSTOM_KEY = 'SMG_CHECKLIST_CUSTOM';
  const REMOVED_KEY = 'SMG_CHECKLIST_REMOVED';
  const ORDER_KEY = 'SMG_CHECKLIST_ORDER_V1';
  const RENAME_KEY = 'SMG_CHECKLIST_RENAME_V1';
  const EMAIL_KEY = 'SMG_EMAIL';

  const listEl = document.getElementById('list');
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));
  const pctEl = document.getElementById('pct');
  const fillEl = document.getElementById('meterFill');
  const subEl = document.getElementById('sub');
  const readinessEl = document.getElementById('readiness');
  const hintEl = document.getElementById('modeHint');
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode-btn'));
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.group-toggle'));
  const unlockEl = document.getElementById('unlock') as HTMLElement | null;
  const unlockForm = document.getElementById('unlockForm') as HTMLFormElement | null;
  const unlockMsg = document.getElementById('unlockMsg');
  const customToolbar = document.getElementById('customToolbar') as HTMLElement | null;
  const editToggle = document.getElementById('editToggle');
  const backupBtn = document.getElementById('backupBtn');
  const backupForm = document.getElementById('backupForm') as HTMLFormElement | null;
  const backupMsg = document.getElementById('backupMsg');

  let mode: string = 'basic';
  let pendingMode: string = 'advanced';
  // What the DJ was reaching for when the gate appeared: a mode, or the PDF.
  let pendingWant: 'mode' | 'pdf' = 'mode';
  // The old static PDF stays on disk for the email flow, but the Download
  // button no longer serves it: it prints the live list instead.
  let editMode = false;

  const allBoxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));

  function load(): Record<string, boolean> {
    try { const raw = localStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function save(state: Record<string, boolean>) {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* storage blocked */ }
  }
  function saveMode(m: string) { try { localStorage.setItem(MODE_KEY, m); } catch (e) { /* blocked */ } }
  function loadOpen(): Record<string, boolean> {
    try { const raw = localStorage.getItem(OPEN_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveOpen(o: Record<string, boolean>) {
    try { localStorage.setItem(OPEN_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ }
  }
  function isUnlocked(): boolean { try { return localStorage.getItem(UNLOCK_KEY) === '1'; } catch (e) { return false; } }
  function setUnlocked() { try { localStorage.setItem(UNLOCK_KEY, '1'); } catch (e) { /* blocked */ } }
  function loadCustom(): Record<string, { k: string; t: string }[]> {
    try { const raw = localStorage.getItem(CUSTOM_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveCustom(c: Record<string, { k: string; t: string }[]>) {
    try { localStorage.setItem(CUSTOM_KEY, JSON.stringify(c)); } catch (e) { /* blocked */ }
  }
  function loadRemoved(): string[] {
    try { const raw = localStorage.getItem(REMOVED_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function saveRemoved(a: string[]) { try { localStorage.setItem(REMOVED_KEY, JSON.stringify(a)); } catch (e) { /* blocked */ } }
  function loadOrder(): Record<string, string[]> {
    try { const raw = localStorage.getItem(ORDER_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveOrder(o: Record<string, string[]>) { try { localStorage.setItem(ORDER_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ } }
  function loadRenames(): Record<string, string> {
    try { const raw = localStorage.getItem(RENAME_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveRenames(r: Record<string, string>) { try { localStorage.setItem(RENAME_KEY, JSON.stringify(r)); } catch (e) { /* blocked */ } }
  function getEmail(): string { try { return localStorage.getItem(EMAIL_KEY) || ''; } catch (e) { return ''; } }
  function setEmail(v: string) { try { localStorage.setItem(EMAIL_KEY, v); } catch (e) { /* blocked */ } }

  function b64urlToStr(s: string): string {
    let t = s.replace(/-/g, '+').replace(/_/g, '/');
    while (t.length % 4) t += '=';
    const bin = atob(t);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function tryRestore(): boolean {
    const m = location.hash.match(/[#&]r=([^&]+)/);
    if (!m) return false;
    try {
      const data = JSON.parse(b64urlToStr(decodeURIComponent(m[1])));
      if (data && data.c) saveCustom(data.c);
      if (data && Array.isArray(data.x)) saveRemoved(data.x);
      setUnlocked();
      history.replaceState(null, '', location.pathname + location.search);
      return true;
    } catch (e) { return false; }
  }
  function getListByCat(): Record<string, string[]> {
    const out: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const labels: string[] = [];
      group.querySelectorAll<HTMLElement>('.task').forEach((li) => {
        if (li.classList.contains('removed')) return;
        const el = li.querySelector<HTMLElement>('.task-label');
        const t = el && el.textContent ? el.textContent.trim() : '';
        if (t) labels.push(t);
      });
      out[cat] = labels;
    });
    return out;
  }
  async function sendBackup(email: string) {
    email = (email || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      if (backupMsg) { backupMsg.textContent = 'That email does not look right.'; backupMsg.className = 'backup-msg err'; }
      return;
    }
    if (backupMsg) { backupMsg.textContent = 'Sending...'; backupMsg.className = 'backup-msg'; }
    try {
      const res = await fetch('/api/backup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, listByCat: getListByCat(), custom: loadCustom(), removed: loadRemoved() }),
      });
      const data = await res.json();
      if (data && data.ok) {
        setEmail(email);
        if (backupForm) backupForm.hidden = true;
        if (backupMsg) { backupMsg.textContent = 'Sent to ' + email + '. Check your inbox for the copy and a link to load it anywhere.'; backupMsg.className = 'backup-msg ok'; }
      } else if (backupMsg) {
        backupMsg.textContent = 'Could not send right now. Try again in a minute.'; backupMsg.className = 'backup-msg err';
      }
    } catch (e) {
      if (backupMsg) { backupMsg.textContent = 'No connection. Try again when you have signal.'; backupMsg.className = 'backup-msg err'; }
    }
  }

  function isVisible(box: HTMLInputElement): boolean {
    const lvl = box.dataset.level;
    if (mode === 'custom' && loadRemoved().indexOf(box.dataset.key || '') !== -1) return false;
    if (mode === 'basic') return lvl === 'basic';
    if (mode === 'advanced') return lvl !== 'custom';
    return true; // custom mode shows everything, minus what you removed
  }

  function render() {
    const visible = allBoxes().filter(isVisible);
    const done = visible.filter((b) => b.checked).length;
    const totalV = visible.length;
    const pct = totalV ? Math.round((done / totalV) * 100) : 0;

    if (pctEl) pctEl.textContent = pct + '%';
    if (fillEl) fillEl.style.width = pct + '%';
    if (subEl) subEl.textContent = pct === 100 ? 'Ready. Go play.' : `${done} of ${totalV} ready`;
    if (readinessEl) readinessEl.classList.toggle('is-ready', pct === 100 && totalV > 0);

    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const inGroup = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')).filter(isVisible);
      const gid = group.getAttribute('data-group');
      const countEl = document.querySelector<HTMLElement>(`.group-count[data-count="${gid}"]`);
      const gdone = inGroup.filter((b) => b.checked).length;
      if (countEl) {
        countEl.textContent = `${gdone}/${inGroup.length}`;
        countEl.classList.toggle('done', gdone === inGroup.length && inGroup.length > 0);
      }
    });
  }

  function attachBox(input: HTMLInputElement) {
    const ticks = load();
    if (ticks[input.dataset.key || '']) input.checked = true;
    input.addEventListener('change', () => {
      const s = load(); s[input.dataset.key || ''] = input.checked; save(s); render();
    });
  }

  // Custom items render into the SAME ul as the built-ins, so a group is one
  // reorderable list. The old .custom-tasks ul stays empty (markup untouched).
  function renderCustom() {
    const custom = loadCustom();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const ul = group.querySelector<HTMLElement>('.tasks');
      if (!ul) return;
      ul.querySelectorAll('.task-custom').forEach((li) => li.remove());
      const items = custom[cat] || [];
      items.forEach((it) => {
        const li = document.createElement('li');
        li.className = 'task task-custom';
        li.setAttribute('data-level', 'custom');
        li.setAttribute('data-key', it.k);
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox'; input.dataset.key = it.k; input.dataset.level = 'custom';
        const box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span'); span.className = 'task-label'; span.textContent = it.t;
        label.appendChild(input); label.appendChild(box); label.appendChild(span);
        const drag = makeDragHandle();
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'task-remove'; rm.setAttribute('aria-label', 'Remove'); rm.innerHTML = '&times;';
        rm.addEventListener('click', () => {
          const c = loadCustom(); c[cat] = (c[cat] || []).filter((x) => x.k !== it.k); saveCustom(c);
          const t = load(); delete t[it.k]; save(t); renderCustom(); render();
        });
        li.appendChild(label); li.appendChild(makeEditButton()); li.appendChild(drag); li.appendChild(rm);
        attachBox(input);
        initRename(span);
        ul.appendChild(li);
      });
    });
    applyOrder();
  }

  /* ----- reorder (drag the handle up or down, Custom + Edit only) ----- */
  function makeDragHandle(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-drag';
    b.setAttribute('aria-label', 'Drag to reorder');
    // An SVG, not the "↕" character: iOS renders that codepoint as a blue
    // EMOJI, so the handles looked nothing like the desktop ones.
    // Third iteration, both bounds set by Antonio. 16x16 read as a smudge
    // ("too glued"), 15x24 shouted louder than the checkbox next to it ("too
    // big, I don't like it"). 11x18 with a thinner stroke keeps the clear
    // shaft-and-heads shape that fixed the first complaint at a weight that
    // sits quietly in the row. The 44x44 tap target is padding, unchanged.
    b.innerHTML = '<svg viewBox="0 0 14 22" width="11" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v18"/><path d="m3 6 4-4 4 4"/><path d="m3 16 4 4 4-4"/></svg>';
    initDrag(b);
    return b;
  }
  function initDrag(handle: HTMLElement) {
    handle.addEventListener('pointerdown', (ev: PointerEvent) => {
      if (!(mode === 'custom' && editMode)) return;
      const li = handle.closest('li.task') as HTMLElement | null; if (!li) return;
      const ul = li.parentElement as HTMLElement | null; if (!ul) return;
      ev.preventDefault();
      // NO setPointerCapture here: reordering moves the li (and the handle
      // inside it) in the DOM, which silently destroys pointer capture and
      // eats the pointerup. Document-level listeners survive the move.
      const grabOffset = ev.clientY - li.getBoundingClientRect().top;
      li.classList.add('dragging');
      document.body.classList.add('dragging-row');

      // Put the row where the finger is, reorder if it has crossed a
      // neighbour, then re-anchor to the finger so it never jumps.
      const place = (clientY: number) => {
        li.style.transform = '';
        const nat = li.getBoundingClientRect();
        const wantTop = clientY - grabOffset;
        const visCenter = wantTop + nat.height / 2;
        const sibs = Array.from(ul.children)
          .filter((n) => n !== li && !(n as HTMLElement).classList.contains('removed')) as HTMLElement[];
        for (const sib of sibs) {
          const r = sib.getBoundingClientRect();
          if (visCenter > r.top && visCenter < r.bottom) {
            const before = new Map<HTMLElement, number>();
            sibs.forEach((s) => before.set(s, s.getBoundingClientRect().top));
            if (visCenter < r.top + r.height / 2) ul.insertBefore(li, sib);
            else ul.insertBefore(li, sib.nextSibling);
            // Slide the displaced rows from where they were to where they now
            // are, so the list visibly opens a gap instead of snapping.
            sibs.forEach((s) => {
              const d = (before.get(s) || 0) - s.getBoundingClientRect().top;
              if (!d) return;
              s.style.transition = 'none';
              s.style.transform = `translateY(${d}px)`;
              requestAnimationFrame(() => {
                s.style.transition = 'transform 0.16s ease';
                s.style.transform = '';
              });
            });
            break;
          }
        }
        li.style.transform = '';
        const now = li.getBoundingClientRect();
        // The slight scale is the "it comes to you" lift: the row you hold
        // sits above the list until you let go.
        li.style.transform = `translateY(${(wantTop - now.top).toFixed(1)}px) scale(1.03)`;
      };

      // Animate the lift in, then go instant so the row tracks the finger 1:1.
      li.style.transition = 'transform 0.12s ease, box-shadow 0.12s ease';
      place(ev.clientY);
      window.setTimeout(() => { if (li.classList.contains('dragging')) li.style.transition = ''; }, 130);
      const move = (e: PointerEvent) => { e.preventDefault(); place(e.clientY); };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        document.removeEventListener('pointercancel', up);
        // Settle back into the row it landed on.
        li.style.transition = 'transform 0.16s ease';
        li.style.transform = '';
        window.setTimeout(() => { li.style.transition = ''; }, 190);
        li.classList.remove('dragging');
        document.body.classList.remove('dragging-row');
        saveOrderFromDom();
      };
      document.addEventListener('pointermove', move, { passive: false });
      document.addEventListener('pointerup', up);
      document.addEventListener('pointercancel', up);
    });
  }
  function saveOrderFromDom() {
    const o: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const keys: string[] = [];
      group.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
        keys.push(li.getAttribute('data-key') || '');
      });
      o[cat] = keys;
    });
    saveOrder(o);
  }
  function applyOrder() {
    const o = loadOrder();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const order = o[cat]; if (!order || !order.length) return;
      const ul = group.querySelector<HTMLElement>('.tasks'); if (!ul) return;
      const byKey: Record<string, HTMLElement> = {};
      const all = Array.from(ul.querySelectorAll<HTMLElement>('.task[data-key]'));
      all.forEach((li) => { byKey[li.getAttribute('data-key') || ''] = li; });
      const seq: HTMLElement[] = [];
      order.forEach((k) => { if (byKey[k]) { seq.push(byKey[k]); delete byKey[k]; } });
      all.forEach((li) => { if (seq.indexOf(li) === -1) seq.push(li); });
      seq.forEach((li) => ul.appendChild(li));
    });
  }

  /* ----- rename (tap the text, Custom + Edit only) ----- */
  function applyRenames() {
    const r = loadRenames();
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      const k = li.getAttribute('data-key') || '';
      if (r[k]) {
        const span = li.querySelector<HTMLElement>('.task-label');
        if (span) span.textContent = r[k];
      }
    });
  }
  // Antonio asked for an edit pencil on each row because he thought the only
  // way to change an item was delete-and-retype. Tap-the-text rename has
  // existed the whole time; he built this site and did not find it, which is
  // the complete argument for the pencil. An affordance nobody can see is a
  // feature that does not exist. The pencil triggers the exact same flow.
  function makeEditButton(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-edit';
    b.setAttribute('aria-label', 'Rename this item');
    b.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
    b.addEventListener('click', () => {
      const li = b.closest('li.task') as HTMLElement | null;
      const span = li && li.querySelector<HTMLElement>('.task-label');
      if (span) beginRename(span);
    });
    return b;
  }

  function beginRename(span: HTMLElement) {
      if (!(mode === 'custom' && editMode)) return;
      const li = span.closest('li.task') as HTMLElement | null; if (!li) return;
      if (li.querySelector('.task-label-edit')) return;
      const key = li.getAttribute('data-key') || '';
      const input = document.createElement('input');
      input.type = 'text'; input.className = 'task-label-edit';
      input.value = span.textContent || ''; input.maxLength = 80;
      span.replaceWith(input);
      input.focus(); input.select();
      const commit = () => {
        const t = (input.value || '').trim() || (span.textContent || '');
        span.textContent = t;
        input.replaceWith(span);
        if (key.indexOf('c-') === 0) {
          const c = loadCustom();
          Object.keys(c).forEach((cat) => { c[cat] = c[cat].map((x) => (x.k === key ? { k: x.k, t } : x)); });
          saveCustom(c);
        } else {
          const r = loadRenames(); r[key] = t; saveRenames(r);
        }
        render();
      };
      input.addEventListener('blur', commit);
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
        if (e.key === 'Escape') { input.value = span.textContent || ''; input.blur(); }
      });
  }
  // Tap the text still works for the people who found it.
  function initRename(span: HTMLElement) {
    span.addEventListener('click', (ev) => {
      if (!(mode === 'custom' && editMode)) return;
      ev.preventDefault();
      beginRename(span);
    });
  }
  // Built-in rows get their pencil, drag handle and rename wiring at startup.
  function ensureRowControls() {
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      if (li.querySelector('.task-drag')) return;
      const rm = li.querySelector('.task-remove');
      const pencil = makeEditButton();
      const drag = makeDragHandle();
      if (rm) { li.insertBefore(pencil, rm); li.insertBefore(drag, rm); }
      else { li.appendChild(pencil); li.appendChild(drag); }
      const span = li.querySelector<HTMLElement>('.task-label');
      if (span) initRename(span);
    });
  }

  function addCustom(cat: string, text: string) {
    const t = text.trim(); if (!t) return;
    const c = loadCustom(); const arr = c[cat] || [];
    const k = 'c-' + cat + '-' + Date.now().toString(36) + Math.floor(Math.random() * 1000);
    arr.push({ k, t }); c[cat] = arr; saveCustom(c);
    renderCustom(); render();
  }

  function setMode(m: string) {
    mode = m;
    if (listEl) listEl.setAttribute('data-mode', m);
    if (m !== 'custom') setEdit(false);
    // The toolbar itself now lives in every mode, because Clear and Download
    // PDF apply everywhere. Only Edit and Email are Custom-mode tools.
    if (customToolbar) {
      customToolbar.hidden = false;
      const custom = m === 'custom';
      if (editToggle) editToggle.hidden = !custom;
      const bk = document.getElementById('backupBtn');
      if (bk) bk.hidden = !custom;
    }
    modeBtns.forEach((b) => {
      const on = b.dataset.modeSet === m;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (hintEl) {
      if (m === 'advanced') hintEl.textContent = 'The full kit. Switch back to Basic for the essentials.';
      else if (m === 'custom') hintEl.textContent = 'Your list. Add your own items to any section below.';
      else hintEl.textContent = isUnlocked()
        ? 'Basic is the must-brings. Advanced is the full kit, Custom is your own.'
        : 'Basic is the must-brings. Advanced and Custom unlock with your email.';
    }
    saveMode(m);
    render();
  }

  function setEdit(on: boolean) {
    editMode = on;
    if (listEl) listEl.setAttribute('data-edit', on ? 'on' : 'off');
    // "Save", not "Done". Antonio's call: Edit then Save is the pair every
    // user already knows, and once accounts exist Save will also be literally
    // true (it will sync the list). Changes persist locally the moment they
    // are made either way, so the label is a promise the site already keeps.
    if (editToggle) {
      editToggle.textContent = on ? 'Save' : 'Edit list';
      editToggle.classList.toggle('editing', on);
    }
  }

  function applyRemoved() {
    const set = loadRemoved();
    document.querySelectorAll<HTMLElement>('.task[data-key]').forEach((li) => {
      li.classList.toggle('removed', set.indexOf(li.getAttribute('data-key') || '') !== -1);
    });
  }

  function setGroupOpen(section: HTMLElement, open: boolean, persist: boolean) {
    section.classList.toggle('collapsed', !open);
    const btn = section.querySelector<HTMLButtonElement>('.group-toggle');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (persist) {
      const o = loadOpen();
      o[section.getAttribute('data-group') || ''] = open;
      saveOpen(o);
    }
  }

  // restore checks (static items)
  const state = load();
  boxes.forEach((b) => {
    const k = b.dataset.key || '';
    if (state[k]) b.checked = true;
    b.addEventListener('change', () => {
      const s = load();
      s[b.dataset.key || ''] = b.checked;
      save(s);
      render();
    });
  });

  // restore from an email link if one is present, then render custom items
  const restored = tryRestore();
  ensureRowControls();
  applyRenames();
  renderCustom();
  applyRemoved();

  // edit toggle (custom mode): gates delete and add so nothing goes by accident
  if (editToggle) editToggle.addEventListener('click', () => setEdit(!editMode));

  // email me a copy: sends the list + a load-anywhere link to their inbox
  if (backupBtn) backupBtn.addEventListener('click', () => {
    const stored = getEmail();
    if (stored) { sendBackup(stored); }
    else if (backupForm) {
      backupForm.hidden = false;
      const i = backupForm.querySelector('input');
      if (i) (i as HTMLInputElement).focus();
    }
  });
  if (backupForm) {
    backupForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const i = backupForm.querySelector('input[name="email"]') as HTMLInputElement;
      sendBackup(i.value);
    });
  }

  // remove a standard row (only reachable in edit mode)
  document.querySelectorAll<HTMLButtonElement>('.task-remove[data-remove]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-remove') || '';
      const set = loadRemoved();
      if (set.indexOf(key) === -1) { set.push(key); saveRemoved(set); }
      const li = btn.closest('.task'); if (li) li.classList.add('removed');
      render();
    });
  });

  const unlockTitle = document.getElementById('unlockTitle');
  const unlockCopy = document.getElementById('unlockCopy');
  const MODE_TITLE = 'Unlock Advanced and Custom';
  const MODE_COPY = unlockCopy ? unlockCopy.textContent || '' : '';
  const PDF_TITLE = 'Register to download the printable checklist';
  const PDF_COPY = 'Free for registered users. Your list, exactly as it stands, as a clean printable PDF. Print it, fold it, keep it in your USB case, or pin it up in the booth.';

  // Opens the gate with copy that matches what the DJ actually reached for.
  function openGate() {
    if (unlockTitle) unlockTitle.textContent = pendingWant === 'pdf' ? PDF_TITLE : MODE_TITLE;
    if (unlockCopy) unlockCopy.textContent = pendingWant === 'pdf' ? PDF_COPY : MODE_COPY;
    if (unlockEl) {
      unlockEl.hidden = false;
      unlockEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    const inp = unlockForm && unlockForm.querySelector('input');
    if (inp) (inp as HTMLInputElement).focus();
  }

  // WHAT YOU DOWNLOAD IS WHAT IS ON SCREEN. Antonio's rule, and it is the only
  // honest one: "if it is clear, it's clear. If it is fulfilled, it's
  // fulfilled." The old button served a pre-made static PDF of the default
  // list, which silently ignored every rename, removal, custom item and tick.
  // Email already sent the real list; Download lied. Now the document is built
  // from the live DOM at the moment of the tap: current mode, current order,
  // current names, current ticks. The browser's own print-to-PDF does the
  // rendering, which needs no library and matches paper size to the user.
  function printCurrentList() {
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c));
    const groups: { title: string; items: { label: string; done: boolean }[] }[] = [];
    document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => {
      const title = (g.querySelector('.group-title')?.textContent || '').trim();
      const items: { label: string; done: boolean }[] = [];
      g.querySelectorAll<HTMLElement>('li.task').forEach((li) => {
        // Hidden rows are hidden for a reason: removed in Custom, or above the
        // current mode's level. The printout must match the screen exactly.
        if (li.offsetParent === null) return;
        const label = (li.querySelector('.task-label')?.textContent || '').trim();
        const done = !!li.querySelector<HTMLInputElement>('input[type=checkbox]')?.checked;
        if (label) items.push({ label, done });
      });
      if (items.length) groups.push({ title, items });
    });

    const rows = (items: { label: string; done: boolean }[]) => items.map((it) =>
      `<li class="${it.done ? 'done' : ''}"><span class="bx">${it.done ? '&#10003;' : ''}</span>${esc(it.label)}</li>`
    ).join('');
    const sections = groups.map((g) =>
      `<section><h2>${esc(g.title)}</h2><ul>${rows(g.items)}</ul></section>`
    ).join('');

    const w = window.open('', '_blank');
    if (!w) return; // popup blocked; the button simply does nothing rather than erroring
    w.document.write(`<!doctype html><html><head><meta charset="utf-8" />
<title>save-my-gig-pre-gig-checklist</title>
<style>
  /* Ink-friendly on purpose: light page, dark text, real boxes to tick by hand. */
  body { font: 14px/1.5 Arial, Helvetica, sans-serif; color: #111; margin: 36px; }
  .brand { color: #d43a1e; font-weight: 800; letter-spacing: 0.14em; font-size: 11px; text-transform: uppercase; }
  h1 { font-size: 26px; margin: 2px 0 2px; text-transform: uppercase; letter-spacing: -0.01em; }
  .sub { color: #666; font-size: 12px; margin: 0 0 18px; }
  section { break-inside: avoid; margin-bottom: 14px; }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #d43a1e; padding-bottom: 4px; margin: 0 0 6px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 4px 0 4px 26px; position: relative; border-bottom: 1px solid #eee; }
  .bx { position: absolute; left: 0; top: 5px; width: 13px; height: 13px; border: 1.5px solid #444; border-radius: 2px; font-size: 11px; line-height: 13px; text-align: center; }
  li.done { color: #888; text-decoration: line-through; }
  li.done .bx { background: #e8f7ee; border-color: #2f9e5f; color: #2f9e5f; }
  .foot { margin-top: 18px; color: #888; font-size: 11px; display: flex; justify-content: space-between; }
</style></head><body>
<div class="brand">Save My Gig</div>
<h1>Pre-gig checklist</h1>
<p class="sub">Your list, exactly as it stood when you downloaded it. savemygig.com/checklist</p>
${sections}
<div class="foot"><span>Something failing at the booth? savemygig.com/emergency</span><span>savemygig.com</span></div>
<script>window.onload = function () { window.print(); };<\/script>
</body></html>`);
    w.document.close();
  }

  // The PDF sits behind the same registration as Advanced and Custom. This is
  // a SOFT gate, deliberately: it is a fair ask, not a lock, and nothing
  // safety-critical is ever behind it.
  const pdfBtn = document.getElementById('pdfBtn');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', () => {
      if (isUnlocked()) { printCurrentList(); return; }
      pendingWant = 'pdf';
      openGate();
    });
  }

  // mode buttons: Advanced and Custom are gated behind an email
  modeBtns.forEach((b) => b.addEventListener('click', () => {
    const target = b.dataset.modeSet || 'basic';
    if ((target === 'advanced' || target === 'custom') && !isUnlocked()) {
      pendingMode = target;
      pendingWant = 'mode';
      openGate();
      return;
    }
    if (unlockEl) unlockEl.hidden = true;
    setMode(target);
  }));

  // unlock form: instant access, confirmation email fires in the background
  if (unlockForm) {
    unlockForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const inp = unlockForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (unlockMsg) { unlockMsg.textContent = 'That email does not look right. Check it and try again.'; unlockMsg.className = 'unlock-msg err'; }
        inp.focus();
        return;
      }
      setUnlocked();
      setEmail(email);
      if (unlockEl) unlockEl.hidden = true;

      // Give them the thing they actually came for, immediately. The
      // confirmation email fires afterwards in the background: nobody should
      // wait on an inbox while standing in a hurry.
      if (pendingWant === 'pdf') printCurrentList();
      else setMode(pendingMode);

      const want = pendingWant === 'pdf' ? 'pdf' : pendingMode;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: want });
      }
      const artistEl = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      const igEl = unlockForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'checklist-' + want,
            artist: artistEl ? artistEl.value.trim() : '',
            instagram: igEl ? igEl.value.trim() : '',
          }),
        });
      } catch (e) { /* unlocked anyway; feature is free */ }
    });
  }

  // add-your-own inputs (custom mode)
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((btn) => {
    const cat = btn.getAttribute('data-add') || '';
    const input = document.querySelector<HTMLInputElement>('.add-input[data-cat="' + cat + '"]');
    const doAdd = () => { if (input) { addCustom(cat, input.value); input.value = ''; input.focus(); } };
    btn.addEventListener('click', doAdd);
    if (input) input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
  });

  // collapse toggles (restore open state, default open)
  const openState = loadOpen();
  toggles.forEach((btn) => {
    const section = btn.closest('.task-group') as HTMLElement;
    const gid = section.getAttribute('data-group') || '';
    const open = openState[gid] !== false; // default true
    setGroupOpen(section, open, false);
    btn.addEventListener('click', () => {
      const nowOpen = section.classList.contains('collapsed'); // collapsed -> will open
      setGroupOpen(section, nowOpen, true);
    });
  });

  // restore mode (advanced/custom only if already unlocked on this device)
  let savedMode = 'basic';
  try { savedMode = localStorage.getItem(MODE_KEY) || 'basic'; } catch (e) { /* ignore */ }
  if (restored) savedMode = 'custom';
  if ((savedMode === 'advanced' || savedMode === 'custom') && !isUnlocked()) savedMode = 'basic';
  setMode(savedMode);

  // reset (ticks only, keeps your custom items and mode)
  const resetBtn = document.getElementById('resetBtn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      allBoxes().forEach((b) => { b.checked = false; });
      save({});
      render();
    });
  }

  // back to top
  const topBtn = document.getElementById('topBtn');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
