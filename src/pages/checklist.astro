  function getEmail(): string { try { return localStorage.getItem(EMAIL_KEY) || ''; } catch (e) { return ''; } }
  function setEmail(v: string) { try { localStorage.setItem(EMAIL_KEY, v); } catch (e) { /* blocked */ } }

  function b64urlToStr(s: string): string {
    let t = s.replace(/-/g, '+').replace(/_/g, '/');
    while (t.length % 4) t += '=';
    const bin = atob(t);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function tryRestore(): boolean {
    const m = location.hash.match(/[#&]r=([^&]+)/);
    if (!m) return false;
    try {
      const data = JSON.parse(b64urlToStr(decodeURIComponent(m[1])));
      if (data && data.c) saveCustom(data.c);
      if (data && Array.isArray(data.x)) saveRemoved(data.x);
      // Renames and order joined the payload later; older links simply lack
      // the keys and restore what they carry.
      if (data && data.r && typeof data.r === 'object') saveRenames(data.r);
      if (data && data.o && typeof data.o === 'object') saveOrder(data.o);
      if (data && Array.isArray(data.s)) saveSections(data.s);
      if (data && Array.isArray(data.h)) saveHiddenGroups(data.h);
      setUnlocked();
      history.replaceState(null, '', location.pathname + location.search);
      return true;
    } catch (e) { return false; }
  }
  function getListByCat(): Record<string, string[]> {
    const out: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      // A category the DJ removed (or one empty in this mode) stays out of
      // the email and the printout entirely.
      if (getComputedStyle(group).display === 'none') return;
      const cat = group.getAttribute('data-group') || '';
      const labels: string[] = [];
      group.querySelectorAll<HTMLElement>('.task').forEach((li) => {
        // Rows hidden by the current MODE (or removal) stay out: emailing from
        // Basic must email the Basic list, not all 37 items. Computed display
        // is checked on the row itself, so items inside a COLLAPSED section
        // still count; collapsing a group is tidiness, not deletion.
        if (getComputedStyle(li).display === 'none') return;
        const el = li.querySelector<HTMLElement>('.task-label');
        const t = el && el.textContent ? el.textContent.trim() : '';
        if (t) labels.push(t);
      });
      out[cat] = labels;
    });
    return out;
  }
  let backupBusy = false;
  async function sendBackup(email: string) {
    if (backupBusy) return; // double-tap sends double emails
    email = (email || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      if (backupMsg) { backupMsg.textContent = 'That email does not look right.'; backupMsg.className = 'backup-msg err'; }
      return;
    }
    if (backupMsg) { backupMsg.textContent = 'Sending...'; backupMsg.className = 'backup-msg'; }
    backupBusy = true;
    try {
      const res = await fetch('/api/backup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email, listByCat: getListByCat(), custom: loadCustom(), removed: loadRemoved(),
          renames: loadRenames(), order: loadOrder(),
          // User sections travel too: the email needs their titles and the
          // restore link needs their definitions. Hidden categories travel
          // so the second device matches the first.
          sections: loadSections(),
          hiddenGroups: loadHiddenGroups(),
          catNames: (() => { const m: Record<string, string> = {}; document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => { const t = g.querySelector('.group-title'); if (t) m[g.getAttribute('data-group') || ''] = t.textContent || ''; }); return m; })(),
        }),
      });
      // A non-2xx is a SERVER problem. It used to fall through res.json()
      // into the catch and tell a DJ on solid venue Wi-Fi "no connection,
      // find signal", which misdiagnoses the failure at them.
      if (!res.ok) {
        if (backupMsg) { backupMsg.textContent = 'Could not send right now, the problem is on our side. Try again in a minute.'; backupMsg.className = 'backup-msg err'; }
        backupBusy = false;
        return;
      }
      const data = await res.json();
      if (data && data.ok) {
        setEmail(email);
        if (backupForm) backupForm.hidden = true;
        if (backupMsg) { backupMsg.textContent = 'Sent to ' + email + '. Check your inbox for the copy and a link to load it anywhere.'; backupMsg.className = 'backup-msg ok'; }
      } else if (backupMsg) {
        backupMsg.textContent = 'Could not send right now. Try again in a minute.'; backupMsg.className = 'backup-msg err';
      }
    } catch (e) {
      if (backupMsg) { backupMsg.textContent = 'No connection. Try again when you have signal.'; backupMsg.className = 'backup-msg err'; }
    }
    backupBusy = false;
  }

  function isVisible(box: HTMLInputElement): boolean {
    const lvl = box.dataset.level;
    if (mode === 'custom') {
      if (loadRemoved().indexOf(box.dataset.key || '') !== -1) return false;
      // Items inside a category the DJ removed do not exist for the meter.
      const g = box.closest('.task-group');
      if (g && loadHiddenGroups().indexOf(g.getAttribute('data-group') || '') !== -1) return false;
    }
    if (mode === 'basic') return lvl === 'basic';
    if (mode === 'advanced') return lvl !== 'custom';
    return true; // custom mode shows everything, minus what you removed
  }

  function render() {
    const visible = allBoxes().filter(isVisible);
    const done = visible.filter((b) => b.checked).length;
    const totalV = visible.length;
    const pct = totalV ? Math.round((done / totalV) * 100) : 0;

    if (pctEl) pctEl.textContent = pct + '%';
    if (fillEl) fillEl.style.width = pct + '%';
    if (subEl) subEl.textContent = pct === 100 ? 'Ready. Go play.' : `${done} of ${totalV} ready`;
    if (readinessEl) readinessEl.classList.toggle('is-ready', pct === 100 && totalV > 0);

    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const inGroup = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')).filter(isVisible);
      const gid = group.getAttribute('data-group');
      const countEl = document.querySelector<HTMLElement>(`.group-count[data-count="${gid}"]`);
      const gdone = inGroup.filter((b) => b.checked).length;
      if (countEl) {
        countEl.textContent = `${gdone}/${inGroup.length}`;
        countEl.classList.toggle('done', gdone === inGroup.length && inGroup.length > 0);
      }
      // Groups with nothing to show in this mode disappear entirely: in
      // Basic, the all-Pro groups (Backups, Technical Kit, Recovery,
      // Travel) would otherwise sit as empty shells. Custom always shows
      // every group, the DJ needs the empty ones to add into.
      group.hidden = mode !== 'custom' && inGroup.length === 0;
    });
  }

  function attachBox(input: HTMLInputElement) {
    const ticks = load();
    if (ticks[input.dataset.key || '']) input.checked = true;
    input.addEventListener('change', () => {
      const s = load(); s[input.dataset.key || ''] = input.checked; save(s); render();
    });
  }

  /* ----- the DJ's own sections (Custom mode, Antonio's spec) ----- */
  // A named section picks its own icon (Antonio: "it has to be intelligent
  // and understand that medicine is medicine"). Keyword match on the title,
  // in English, Portuguese and Spanish; the bulb is the fallback. All
  // monochrome stroke, per the standing no-emoji rule.
  const SECTION_ICONS: Record<string, string> = {
    health: '<path d="M12 3a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-3v3a2 2 0 0 1-2 2h-0a2 2 0 0 1-2-2v-3H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h3V5a2 2 0 0 1 2-2z"/>',
    disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/>',
    usb: '<rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/>',
    plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
    cup: '<path d="M17 8h1a3 3 0 0 1 0 6h-1"/><path d="M3 8h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M7 2v2"/><path d="M11 2v2"/>',
    shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    star: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
    bulb: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/>',
  };
  const SECTION_ICON_WORDS: [string, string[]][] = [
    ['health', ['medic', 'remed', 'pill', 'pharma', 'farmac', 'health', 'saude', 'salud', 'first aid', 'aid kit']],
    ['disc', ['music', 'musica', 'track', 'vinyl', 'record', 'playlist', 'set ']],
    ['usb', ['cable', 'cabo', 'adapter', 'adaptador', 'usb', 'tech', 'charger', 'carregador', 'cargador']],
    ['plane', ['travel', 'viagem', 'viaje', 'flight', 'voo', 'vuelo', 'hotel', 'tour', 'passport', 'passaporte']],
    ['cup', ['food', 'comida', 'snack', 'drink', 'bebida', 'agua', 'water', 'coffee', 'cafe']],
    ['shield', ['key', 'chave', 'llave', 'secur', 'segur', 'lock', 'backup']],
    ['star', ['cloth', 'roupa', 'ropa', 'wear', 'shirt', 'camis', 'merch', 'style', 'estilo']],
  ];
  function pickSectionIcon(title: string): string {
    const t = ' ' + title.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') + ' ';
    let body = SECTION_ICONS.bulb;
    for (const [icon, words] of SECTION_ICON_WORDS) {
      if (words.some((w) => t.indexOf(w) !== -1)) { body = SECTION_ICONS[icon]; break; }
    }
    return '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + body + '</svg>';
  }
  // User sections are real .task-group elements built here with the same
  // anatomy as the fixed ones, so every existing mechanism (counts, custom
  // items, order, print, email) sees them for free. They render only in
  // Custom mode (they contain only custom-level items, and render() hides
  // empty groups outside Custom).
  function renderSections() {
    document.querySelectorAll('.task-group[data-user-section]').forEach((el) => el.remove());
    const listRoot = document.getElementById('list');
    if (!listRoot) return;
    loadSections().forEach((sec) => {
      const section = document.createElement('section');
      section.className = 'panel task-group';
      section.setAttribute('data-group', sec.id);
      section.setAttribute('data-user-section', '1');
      const h3 = document.createElement('h3'); h3.className = 'group-h';
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'group-toggle';
      btn.setAttribute('data-toggle', sec.id); btn.setAttribute('aria-expanded', 'true');
      const ic = document.createElement('span'); ic.className = 'group-ic'; ic.setAttribute('aria-hidden', 'true');
      ic.innerHTML = pickSectionIcon(sec.t);
      const title = document.createElement('span'); title.className = 'group-title'; title.textContent = sec.t;
      const meta = document.createElement('span'); meta.className = 'group-meta';
      const count = document.createElement('span'); count.className = 'group-count'; count.setAttribute('data-count', sec.id); count.textContent = '0/0';
      const chev = document.createElement('span'); chev.className = 'chev'; chev.setAttribute('aria-hidden', 'true');
      meta.appendChild(count); meta.appendChild(chev);
      btn.appendChild(ic); btn.appendChild(title); btn.appendChild(meta);
      // Delete (Edit mode only): takes the section and its items with it.
      const del = document.createElement('button');
      del.type = 'button'; del.className = 'group-remove';
      del.setAttribute('aria-label', 'Delete section ' + sec.t); del.innerHTML = '&times;';
      del.addEventListener('click', (e) => {
        e.stopPropagation();
        const c = loadCustom();
        (c[sec.id] || []).forEach((it) => { const t = load(); delete t[it.k]; save(t); });
        delete c[sec.id]; saveCustom(c);
        saveSections(loadSections().filter((s) => s.id !== sec.id));
        renderSections(); renderCustom(); render();
      });
      h3.appendChild(btn); h3.appendChild(del);
      const body = document.createElement('div'); body.className = 'group-body'; body.id = 'body-' + sec.id;
      const ul = document.createElement('ul'); ul.className = 'tasks';
      const addRow = document.createElement('div'); addRow.className = 'add-own';
      const addInput = document.createElement('input');
      addInput.type = 'text'; addInput.className = 'add-input';
      addInput.setAttribute('data-cat', sec.id); addInput.placeholder = 'Add your own...';
      addInput.setAttribute('aria-label', 'Add your own item to ' + sec.t); addInput.maxLength = 80;
      const addBtn = document.createElement('button');
      addBtn.type = 'button'; addBtn.className = 'add-btn'; addBtn.setAttribute('data-add', sec.id); addBtn.textContent = 'Add';
      const doAdd = () => { addCustom(sec.id, addInput.value); addInput.value = ''; addInput.focus(); };
      addBtn.addEventListener('click', doAdd);
      addInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
      addRow.appendChild(addInput); addRow.appendChild(addBtn);
      body.appendChild(ul); body.appendChild(addRow);
      section.appendChild(h3); section.appendChild(body);
      // Collapse behaviour, same rules as the fixed groups.
      const open = loadOpen()[sec.id] === true;
      section.classList.toggle('collapsed', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.addEventListener('click', () => {
        const nowOpen = section.classList.contains('collapsed');
        setGroupOpen(section, nowOpen, true);
      });
      listRoot.appendChild(section);
    });
  }

  // Custom items render into the SAME ul as the built-ins, so a group is one
  // reorderable list. The old .custom-tasks ul stays empty (markup untouched).
  function renderCustom() {
    const custom = loadCustom();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const ul = group.querySelector<HTMLElement>('.tasks');
      if (!ul) return;
      ul.querySelectorAll('.task-custom').forEach((li) => li.remove());
      const items = custom[cat] || [];
      items.forEach((it) => {
        const li = document.createElement('li');
        li.className = 'task task-custom';
        li.setAttribute('data-level', 'custom');
        li.setAttribute('data-key', it.k);
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox'; input.dataset.key = it.k; input.dataset.level = 'custom';
        const box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span'); span.className = 'task-label'; span.textContent = it.t;
        label.appendChild(input); label.appendChild(box); label.appendChild(span);
        const drag = makeDragHandle();
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'task-remove'; rm.setAttribute('aria-label', 'Remove'); rm.innerHTML = '&times;';
        rm.addEventListener('click', () => {
          const c = loadCustom(); c[cat] = (c[cat] || []).filter((x) => x.k !== it.k); saveCustom(c);
          const t = load(); delete t[it.k]; save(t); renderCustom(); render();
        });
        li.appendChild(label); li.appendChild(makeEditButton()); li.appendChild(drag); li.appendChild(rm);
        attachBox(input);
        initRename(span);
        ul.appendChild(li);
      });
    });
    applyOrder();
  }

  /* ----- reorder (drag the handle up or down, Custom + Edit only) ----- */
  function makeDragHandle(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-drag';
    b.setAttribute('aria-label', 'Drag to reorder');
    // An SVG, not the "↕" character: iOS renders that codepoint as a blue
    // EMOJI, so the handles looked nothing like the desktop ones.
    // Third iteration, both bounds set by Antonio. 16x16 read as a smudge
    // ("too glued"), 15x24 shouted louder than the checkbox next to it ("too
    // big, I don't like it"). 11x18 with a thinner stroke keeps the clear
    // shaft-and-heads shape that fixed the first complaint at a weight that
    // sits quietly in the row. The 44x44 tap target is padding, unchanged.
    b.innerHTML = '<svg viewBox="0 0 14 22" width="11" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v18"/><path d="m3 6 4-4 4 4"/><path d="m3 16 4 4 4-4"/></svg>';
    initDrag(b);
    return b;
  }
  function initDrag(handle: HTMLElement) {
    handle.addEventListener('pointerdown', (ev: PointerEvent) => {
      if (!(mode === 'custom' && editMode)) return;
      // An open rename must commit before rows start moving: preventDefault
      // below suppresses the focus change, and moving a focused element in
      // the DOM drops focus WITHOUT firing blur, which orphaned the input.
      const openEdit = document.querySelector('.task-label-edit') as HTMLInputElement | null;
      if (openEdit) openEdit.blur();
      const li = handle.closest('li.task') as HTMLElement | null; if (!li) return;
      const ul = li.parentElement as HTMLElement | null; if (!ul) return;
      ev.preventDefault();
      // NO setPointerCapture here: reordering moves the li (and the handle
      // inside it) in the DOM, which silently destroys pointer capture and
      // eats the pointerup. Document-level listeners survive the move.
      const grabOffset = ev.clientY - li.getBoundingClientRect().top;
      li.classList.add('dragging');
      document.body.classList.add('dragging-row');

      // Put the row where the finger is, reorder if it has crossed a
      // neighbour, then re-anchor to the finger so it never jumps.
      const place = (clientY: number) => {
        li.style.transform = '';
        const nat = li.getBoundingClientRect();
        const wantTop = clientY - grabOffset;
        const visCenter = wantTop + nat.height / 2;
        const sibs = Array.from(ul.children)
          .filter((n) => n !== li && !(n as HTMLElement).classList.contains('removed')) as HTMLElement[];
        for (const sib of sibs) {
          const r = sib.getBoundingClientRect();
          if (visCenter > r.top && visCenter < r.bottom) {
            const before = new Map<HTMLElement, number>();
            sibs.forEach((s) => before.set(s, s.getBoundingClientRect().top));
            if (visCenter < r.top + r.height / 2) ul.insertBefore(li, sib);
            else ul.insertBefore(li, sib.nextSibling);
            // Slide the displaced rows from where they were to where they now
            // are, so the list visibly opens a gap instead of snapping.
            sibs.forEach((s) => {
              const d = (before.get(s) || 0) - s.getBoundingClientRect().top;
              if (!d) return;
              s.style.transition = 'none';
              s.style.transform = `translateY(${d}px)`;
              requestAnimationFrame(() => {
                s.style.transition = 'transform 0.16s ease';
                s.style.transform = '';
              });
            });
            break;
          }
        }
        li.style.transform = '';
        const now = li.getBoundingClientRect();
        // The slight scale is the "it comes to you" lift: the row you hold
        // sits above the list until you let go.
        li.style.transform = `translateY(${(wantTop - now.top).toFixed(1)}px) scale(1.03)`;
      };

      // Animate the lift in, then go instant so the row tracks the finger 1:1.
      li.style.transition = 'transform 0.12s ease, box-shadow 0.12s ease';
      place(ev.clientY);
      window.setTimeout(() => { if (li.classList.contains('dragging')) li.style.transition = ''; }, 130);
      const move = (e: PointerEvent) => { e.preventDefault(); place(e.clientY); };
      const up = () => {
        document.removeEventListener('pointermove', move);
        document.removeEventListener('pointerup', up);
        document.removeEventListener('pointercancel', up);
        // Settle back into the row it landed on.
        li.style.transition = 'transform 0.16s ease';
        li.style.transform = '';
        window.setTimeout(() => { li.style.transition = ''; }, 190);
        li.classList.remove('dragging');
        document.body.classList.remove('dragging-row');
        saveOrderFromDom();
      };
      document.addEventListener('pointermove', move, { passive: false });
      document.addEventListener('pointerup', up);
      document.addEventListener('pointercancel', up);
    });
  }
  function saveOrderFromDom() {
    const o: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const keys: string[] = [];
      group.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
        keys.push(li.getAttribute('data-key') || '');
      });
      o[cat] = keys;
    });
    saveOrder(o);
  }
  function applyOrder() {
    const o = loadOrder();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const order = o[cat]; if (!order || !order.length) return;
      const ul = group.querySelector<HTMLElement>('.tasks'); if (!ul) return;
      const byKey: Record<string, HTMLElement> = {};
      const all = Array.from(ul.querySelectorAll<HTMLElement>('.task[data-key]'));
      all.forEach((li) => { byKey[li.getAttribute('data-key') || ''] = li; });
      const seq: HTMLElement[] = [];
      order.forEach((k) => { if (byKey[k]) { seq.push(byKey[k]); delete byKey[k]; } });
      all.forEach((li) => { if (seq.indexOf(li) === -1) seq.push(li); });
      seq.forEach((li) => ul.appendChild(li));
    });
  }

  /* ----- rename (tap the text, Custom + Edit only) ----- */
  function applyRenames() {
    const r = loadRenames();
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      const k = li.getAttribute('data-key') || '';
      if (r[k]) {
        const span = li.querySelector<HTMLElement>('.task-label');
        if (span) span.textContent = r[k];
      }
    });
  }
  // Antonio asked for an edit pencil on each row because he thought the only
  // way to change an item was delete-and-retype. Tap-the-text rename has
  // existed the whole time; he built this site and did not find it, which is
  // the complete argument for the pencil. An affordance nobody can see is a
  // feature that does not exist. The pencil triggers the exact same flow.
  function makeEditButton(): HTMLButtonElement {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'task-edit';
    b.setAttribute('aria-label', 'Rename this item');
    b.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>';
    b.addEventListener('click', () => {
      const li = b.closest('li.task') as HTMLElement | null;
      const span = li && li.querySelector<HTMLElement>('.task-label');
      if (span) beginRename(span);
    });
    return b;
  }

  function beginRename(span: HTMLElement) {
      if (!(mode === 'custom' && editMode)) return;
      const li = span.closest('li.task') as HTMLElement | null; if (!li) return;
      if (li.querySelector('.task-label-edit')) return;
      const key = li.getAttribute('data-key') || '';
      const input = document.createElement('input');
      input.type = 'text'; input.className = 'task-label-edit';
      input.value = span.textContent || ''; input.maxLength = 80;
      span.replaceWith(input);
      // Cursor at the END, not select-all: with everything selected, the
      // first keystroke replaces the whole text, which reads as the site
      // eating your item. Editing should start where the text stops.
      input.focus();
      const n = input.value.length;
      input.setSelectionRange(n, n);
      const commit = () => {
        const t = (input.value || '').trim() || (span.textContent || '');
        span.textContent = t;
        input.replaceWith(span);
        if (key.indexOf('c-') === 0) {
          const c = loadCustom();
          Object.keys(c).forEach((cat) => { c[cat] = c[cat].map((x) => (x.k === key ? { k: x.k, t } : x)); });
          saveCustom(c);
        } else {
          const r = loadRenames(); r[key] = t; saveRenames(r);
        }
        render();
      };
      input.addEventListener('blur', commit);
      input.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
        if (e.key === 'Escape') { input.value = span.textContent || ''; input.blur(); }
      });
  }
  // Tap the text still works for the people who found it.
  function initRename(span: HTMLElement) {
    span.addEventListener('click', (ev) => {
      if (!(mode === 'custom' && editMode)) return;
      ev.preventDefault();
      beginRename(span);
    });
  }
  // Built-in rows get their pencil, drag handle and rename wiring at startup.
  function ensureRowControls() {
    document.querySelectorAll<HTMLElement>('.tasks .task[data-key]').forEach((li) => {
      if (li.querySelector('.task-drag')) return;
      const rm = li.querySelector('.task-remove');
      const pencil = makeEditButton();
      const drag = makeDragHandle();
      if (rm) { li.insertBefore(pencil, rm); li.insertBefore(drag, rm); }
      else { li.appendChild(pencil); li.appendChild(drag); }
      const span = li.querySelector<HTMLElement>('.task-label');
      if (span) initRename(span);
    });
  }

  function addCustom(cat: string, text: string) {
    const t = text.trim(); if (!t) return;
    const c = loadCustom(); const arr = c[cat] || [];
    const k = 'c-' + cat + '-' + Date.now().toString(36) + Math.floor(Math.random() * 1000);
    arr.push({ k, t }); c[cat] = arr; saveCustom(c);
    renderCustom(); render();
  }

  function setMode(m: string) {
    mode = m;
    disarmResetHook();
    if (listEl) listEl.setAttribute('data-mode', m);
    if (m !== 'custom') setEdit(false);
    // The toolbar itself now lives in every mode, because Clear and Download
    // PDF apply everywhere. Only Edit and Email are Custom-mode tools.
    // style.display, NOT the hidden attribute: .btn sets its own display, and
    // author CSS beats the UA's [hidden] rule. On Antonio's iPhone (Basic mode,
    // not unlocked on that device) Edit stayed tappable, which produced edit
    // state in Basic: remove buttons and green outlines with no pencil and no
    // arrows, because those are rightly Custom-only.
    if (customToolbar) {
      customToolbar.hidden = false;
      const custom = m === 'custom';
      // Edit is the only Custom-exclusive button now: Email works in every
      // mode (it emails whatever list the mode shows) and sits last.
      if (editToggle) editToggle.style.display = custom ? '' : 'none';
      // The tip explains pencil/arrows/x, which only exist in Custom. It was
      // leaking into Basic and Advanced, describing controls that are not
      // there. Dismissal state still wins over mode.
      const hint = document.getElementById('editHint');
      if (hint) hint.style.display = custom && !hint.hasAttribute('data-gone') ? '' : 'none';
    }
    modeBtns.forEach((b) => {
      const on = b.dataset.modeSet === m;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (hintEl) {
      if (m === 'advanced') hintEl.innerHTML = '<span class="mh-s">The full kit.</span><span class="mh-f">The full kit. Everything in Base, plus backup gear and professional extras for any situation.</span>';
      else if (m === 'custom') hintEl.innerHTML = '<span class="mh-s">Your own, built from Advanced.</span><span class="mh-f">Your own. Start with Advanced and tailor the checklist to your setup, workflow, and preferences.</span>';
      else hintEl.innerHTML = '<span class="mh-s">The must-brings.</span><span class="mh-f">Must-brings. The essential checklist every DJ should have before leaving for a gig.</span>';
    }
    saveMode(m);
    render();
  }

  function setEdit(on: boolean) {
    // Edit exists only in Custom. Belt to the display-none braces above: even
    // if some path makes the button clickable, edit state cannot turn on
    // outside the one mode whose tools exist.
    if (on && mode !== 'custom') on = false;
    editMode = on;
    if (listEl) listEl.setAttribute('data-edit', on ? 'on' : 'off');
    // "Save", not "Done". Antonio's call: Edit then Save is the pair every
    // user already knows, and once accounts exist Save will also be literally
    // true (it will sync the list). Changes persist locally the moment they
    // are made either way, so the label is a promise the site already keeps.
    if (editToggle) {
      // Same full/short span pair as the other buttons, so the label is
      // consistent whichever path set it (it used to show "Edit" or
      // "Edit list" depending on whether setEdit had run yet).
      // "Save list", matching the row: every action names the same object.
      editToggle.innerHTML = on
        ? '<span class="bl-full">Save list</span><span class="bl-short">Save</span>'
        : '<span class="bl-full">Edit list</span><span class="bl-short">Edit</span>';
      editToggle.classList.toggle('editing', on);
    }
  }

  function applyRemoved() {
    const set = loadRemoved();
    document.querySelectorAll<HTMLElement>('.task[data-key]').forEach((li) => {
      li.classList.toggle('removed', set.indexOf(li.getAttribute('data-key') || '') !== -1);
    });
  }

  function setGroupOpen(section: HTMLElement, open: boolean, persist: boolean) {
    section.classList.toggle('collapsed', !open);
    const btn = section.querySelector<HTMLButtonElement>('.group-toggle');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (persist) {
      const o = loadOpen();
      o[section.getAttribute('data-group') || ''] = open;
      saveOpen(o);
    }
  }

  // restore checks (static items)
  const state = load();
  boxes.forEach((b) => {
    const k = b.dataset.key || '';
    if (state[k]) b.checked = true;
    b.addEventListener('change', () => {
      const s = load();
      s[b.dataset.key || ''] = b.checked;
      save(s);
      render();
    });
  });

  // restore from an email link if one is present, then render custom items
  // The confirm email's redirect lands here with ?confirmed=1. It used to be
  // written and never read: no acknowledgment, and the param stuck around in
  // shared URLs. One green line, then gone.
  if (new URLSearchParams(location.search).get('confirmed') === '1') {
    if (backupMsg) { backupMsg.textContent = 'Email confirmed. You are registered on this device.'; backupMsg.className = 'backup-msg ok'; }
    const sp = new URLSearchParams(location.search); sp.delete('confirmed');
    history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp.toString() : '') + location.hash);
  }

  const restored = tryRestore();
  ensureRowControls();
  applyRenames();
  renderSections();
  renderCustom();
  applyRemoved();
  applyHiddenGroups();

  // Remove a built-in category (Custom + Edit): hides it and everything in
  // it; Reset list is the way back. User sections have their own delete.
  document.querySelectorAll<HTMLButtonElement>('[data-group-hide]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const gid = btn.getAttribute('data-group-hide') || '';
      const h = loadHiddenGroups();
      if (h.indexOf(gid) === -1) h.push(gid);
      saveHiddenGroups(h);
      applyHiddenGroups();
      render();
    });
  });

  // add a whole new section (Custom + Edit)
  const addSectionBtn = document.getElementById('addSectionBtn');
  const addSectionInput = document.getElementById('addSectionInput') as HTMLInputElement | null;
  if (addSectionBtn && addSectionInput) {
    const doAddSection = () => {
      const t = (addSectionInput.value || '').trim();
      if (!t) return;
      const sections = loadSections();
      const id = 'u-' + t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 24) + '-' + Math.random().toString(36).slice(2, 5);
      sections.push({ id, t });
      saveSections(sections);
      addSectionInput.value = '';
      renderSections(); renderCustom(); render();
      // A section you just named opens ready to receive its first item.
      const el = document.querySelector<HTMLElement>(`.task-group[data-group="${id}"]`);
      if (el) { setGroupOpen(el, true, true); el.querySelector<HTMLInputElement>('.add-input')?.focus(); }
    };
    addSectionBtn.addEventListener('click', doAddSection);
    addSectionInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAddSection(); } });
  }

  // edit toggle (custom mode): gates delete and add so nothing goes by accident
  if (editToggle) editToggle.addEventListener('click', () => setEdit(!editMode));

  // email me a copy: sends the list + a load-anywhere link to their inbox
  // Email requires registration (Antonio: "how can you get an email if you
  // are not registered?"). Registered with a stored address: sends straight
  // away. Registered without one (edge): the inline form. Not registered:
  // the same gate as everything else, and registering sends the list to the
  // address they just gave.
  if (backupBtn) backupBtn.addEventListener('click', () => {
    if (!isUnlocked()) {
      pendingWant = 'email';
      openGate();
      return;
    }
    const stored = getEmail();
    if (stored) { sendBackup(stored); }
    else if (backupForm) {
      backupForm.hidden = false;
      const i = backupForm.querySelector('input');
      if (i) (i as HTMLInputElement).focus();
    }
  });
  if (backupForm) {
    backupForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const i = backupForm.querySelector('input[name="email"]') as HTMLInputElement;
      sendBackup(i.value);
    });
  }

  // remove a standard row (only reachable in edit mode)
  document.querySelectorAll<HTMLButtonElement>('.task-remove[data-remove]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-remove') || '';
      const set = loadRemoved();
      if (set.indexOf(key) === -1) { set.push(key); saveRemoved(set); }
      const li = btn.closest('.task'); if (li) li.classList.add('removed');
      render();
    });
  });

  // The edit-instructions tip: read once, dismiss forever on this device.
  const HINT_KEY = 'SMG_HINT_EDIT_DISMISSED';
  const hintEl2 = document.getElementById('editHint');
  const hintClose = document.getElementById('hintClose');
  try { if (localStorage.getItem(HINT_KEY) === '1' && hintEl2) hintEl2.setAttribute('data-gone', '1'); } catch (e) {}
  if (hintClose) hintClose.addEventListener('click', () => {
    if (hintEl2) hintEl2.setAttribute('data-gone', '1');
    try { localStorage.setItem(HINT_KEY, '1'); } catch (e) {}
  });

  const unlockTitle = document.getElementById('unlockTitle');
  const unlockCopy = document.getElementById('unlockCopy');
  const MODE_TITLE = 'Register free to unlock Advanced and Custom modes';
  const MODE_COPY = unlockCopy ? unlockCopy.textContent || '' : '';
  const PDF_TITLE = 'Register free to download the printable checklist';
  const PDF_COPY = 'Your list, exactly as it stands, as a clean printable PDF. Print it, fold it, keep it in your USB case, or pin it up in the booth.';

  // Opens the gate with copy that matches what the DJ actually reached for.
  function openGate() {
    const gateCopy = {
      pdf: { t: PDF_TITLE, c: PDF_COPY },
      email: {
        t: 'Register free to email your list',
        c: 'We send your list, exactly as it stands, to your inbox, with a link that loads it back on any device.',
      },
      mode: { t: MODE_TITLE, c: MODE_COPY },
    }[pendingWant] || { t: MODE_TITLE, c: MODE_COPY };
    if (unlockTitle) unlockTitle.textContent = gateCopy.t;
    if (unlockCopy) unlockCopy.textContent = gateCopy.c;
    if (unlockEl) {
      unlockEl.hidden = false;
      unlockEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    const inp = unlockForm && unlockForm.querySelector('input');
    if (inp) (inp as HTMLInputElement).focus();
  }

  // WHAT YOU DOWNLOAD IS WHAT IS ON SCREEN. Antonio's rule, and it is the only
  // honest one: "if it is clear, it's clear. If it is fulfilled, it's
  // fulfilled." The old button served a pre-made static PDF of the default
  // list, which silently ignored every rename, removal, custom item and tick.
  // Email already sent the real list; Download lied. Now the document is built
  // from the live DOM at the moment of the tap: current mode, current order,
  // current names, current ticks. The browser's own print-to-PDF does the
  // rendering, which needs no library and matches paper size to the user.
  function printCurrentList() {
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c));
    const groups: { title: string; items: { label: string; done: boolean }[] }[] = [];
    document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => {
      if (getComputedStyle(g).display === 'none') return; // removed category
      const title = (g.querySelector('.group-title')?.textContent || '').trim();
      const items: { label: string; done: boolean }[] = [];
      g.querySelectorAll<HTMLElement>('li.task').forEach((li) => {
        // Hidden rows are hidden for a reason: removed in Custom, or above the
        // current mode's level. But a COLLAPSED section is tidiness, not
        // deletion, so the check is the row's own computed display, which
        // offsetParent got wrong: it silently dropped every collapsed section
        // from the printout.
        if (getComputedStyle(li).display === 'none') return;
        const label = (li.querySelector('.task-label')?.textContent || '').trim();
        const done = !!li.querySelector<HTMLInputElement>('input[type=checkbox]')?.checked;
        if (label) items.push({ label, done });
      });
      if (items.length) groups.push({ title, items });
    });

    const rows = (items: { label: string; done: boolean }[]) => items.map((it) =>
      `<li class="${it.done ? 'done' : ''}"><span class="bx">${it.done ? '&#10003;' : ''}</span>${esc(it.label)}</li>`
    ).join('');
    const sections = groups.map((g) =>
      `<section><h2>${esc(g.title)}</h2><ul>${rows(g.items)}</ul></section>`
    ).join('');

    const w = window.open('', '_blank');
    if (!w) return false; // popup blocked; callers tell the user, not silence
    w.document.write(`<!doctype html><html><head><meta charset="utf-8" />
<title>save-my-gig-pre-gig-checklist</title>
<style>
  /* Ink-friendly on purpose: light page, dark text, real boxes to tick by hand. */
  body { font: 14px/1.5 Arial, Helvetica, sans-serif; color: #111; margin: 36px; }
  .brand { color: #d43a1e; font-weight: 800; letter-spacing: 0.14em; font-size: 11px; text-transform: uppercase; }
  h1 { font-size: 26px; margin: 2px 0 2px; text-transform: uppercase; letter-spacing: -0.01em; }
  .sub { color: #666; font-size: 12px; margin: 0 0 18px; }
  section { break-inside: avoid; margin-bottom: 14px; }
  h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #d43a1e; padding-bottom: 4px; margin: 0 0 6px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 4px 0 4px 26px; position: relative; border-bottom: 1px solid #eee; }
  .bx { position: absolute; left: 0; top: 5px; width: 13px; height: 13px; border: 1.5px solid #444; border-radius: 2px; font-size: 11px; line-height: 13px; text-align: center; }
  li.done { color: #888; text-decoration: line-through; }
  li.done .bx { background: #e8f7ee; border-color: #2f9e5f; color: #2f9e5f; }
  .foot { margin-top: 18px; color: #888; font-size: 11px; display: flex; justify-content: space-between; }
</style></head><body>
<div class="brand">Save My Gig</div>
<h1>Pre-gig checklist</h1>
<p class="sub">Your list, exactly as it stood when you downloaded it. savemygig.com/checklist</p>
${sections}
<div class="foot"><span>Something failing at the booth? savemygig.com/emergency</span><span>savemygig.com</span></div>
<script>window.onload = function () { window.print(); };<\/script>
</body></html>`);
    w.document.close();
    return true;
  }

  // The PDF sits behind the same registration as Advanced and Custom. This is
  // a SOFT gate, deliberately: it is a fair ask, not a lock, and nothing
  // safety-critical is ever behind it.
  const pdfBtn = document.getElementById('pdfBtn');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', () => {
      if (isUnlocked()) {
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'Your browser blocked the download window. Allow pop-ups for this site and tap again.';
          backupMsg.className = 'backup-msg err';
        }
        return;
      }
      pendingWant = 'pdf';
      openGate();
    });
  }

  // mode buttons: Advanced and Custom are gated behind an email
  modeBtns.forEach((b) => b.addEventListener('click', () => {
    const target = b.dataset.modeSet || 'basic';
    if ((target === 'advanced' || target === 'custom') && !isUnlocked()) {
      pendingMode = target;
      pendingWant = 'mode';
      openGate();
      return;
    }
    if (unlockEl) unlockEl.hidden = true;
    setMode(target);
  }));

  // unlock form: instant access, confirmation email fires in the background
  if (unlockForm) {
    let unlockBusy = false;
    unlockForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (unlockBusy) return; // double-tap sends double emails
      const inp = unlockForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (unlockMsg) { unlockMsg.textContent = 'That email does not look right. Check it and try again.'; unlockMsg.className = 'unlock-msg err'; }
        inp.focus();
        return;
      }
      // The form is novalidate (custom messages), so the artist field's
      // required attribute is decorative: THIS is the real check. Antonio
      // caught the hole registering email-only in a private window. The
      // name is required because the homepage greets the DJ by it.
      const artistInp = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      if (artistInp && !artistInp.value.trim()) {
        if (unlockMsg) { unlockMsg.textContent = 'Add your artist name or first name, so we know what to call you.'; unlockMsg.className = 'unlock-msg err'; }
        artistInp.focus();
        return;
      }
      unlockBusy = true;
      setUnlocked();
      setEmail(email);
      if (unlockEl) unlockEl.hidden = true;

      // Give them the thing they actually came for, immediately. The
      // confirmation email fires afterwards in the background: nobody should
      // wait on an inbox while standing in a hurry.
      if (pendingWant === 'pdf') {
        // Popup blockers eat the print view on exactly this path (the user
        // just submitted a form). Dead air after handing over an email address
        // is the worst possible outcome, so say what happened and what to do.
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'You are registered. Your browser blocked the download window: tap Download list again and allow pop-ups.';
          backupMsg.className = 'backup-msg ok';
        }
      }
      else if (pendingWant === 'email') sendBackup(email); // to the address they just registered
      else {
        setMode(pendingMode);
        // Registration done, mode unlocked: put them at the TOP of their
        // new list, ready to work (Antonio) — same move as the back-to-top
        // circle, not stranded at the bottom where the gate was.
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      }

      const want = pendingWant === 'pdf' ? 'pdf' : pendingWant === 'email' ? 'email' : pendingMode;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: want });
      }
      const artistEl = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      const igEl = unlockForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
      // The homepage greets a registered DJ by artist name (Antonio). Stored
      // locally only, first word only; the homepage guards length itself.
      const artistName = artistEl ? artistEl.value.trim() : '';
      if (artistName) {
        try { localStorage.setItem('SMG_ARTIST', artistName.split(/\s+/)[0]); } catch (e) { /* blocked */ }
      }
      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'checklist-' + want,
            artist: artistEl ? artistEl.value.trim() : '',
            instagram: igEl ? igEl.value.trim() : '',
          }),
        });
      } catch (e) { /* unlocked anyway; feature is free */ }
      unlockBusy = false;
    });
  }

  // add-your-own inputs (custom mode)
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((btn) => {
    const cat = btn.getAttribute('data-add') || '';
    const input = document.querySelector<HTMLInputElement>('.add-input[data-cat="' + cat + '"]');
    const doAdd = () => { if (input) { addCustom(cat, input.value); input.value = ''; input.focus(); } };
    btn.addEventListener('click', doAdd);
    if (input) input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
  });

  // collapse toggles (restore open state). DEFAULT COLLAPSED (Antonio,
  // collapse doctrine): the three group headers are the index, the page
  // opens compact on any screen, and a group you opened stays open on your
  // next visit because the choice persists.
  const openState = loadOpen();
  toggles.forEach((btn) => {
    const section = btn.closest('.task-group') as HTMLElement;
    const gid = section.getAttribute('data-group') || '';
    const open = openState[gid] === true; // default collapsed
    setGroupOpen(section, open, false);
    btn.addEventListener('click', () => {
      const nowOpen = section.classList.contains('collapsed'); // collapsed -> will open
      setGroupOpen(section, nowOpen, true);
    });
  });

  // restore mode (advanced/custom only if already unlocked on this device)
  let savedMode = 'basic';
  try { savedMode = localStorage.getItem(MODE_KEY) || 'basic'; } catch (e) { /* ignore */ }
  if (restored) savedMode = 'custom';
  if ((savedMode === 'advanced' || savedMode === 'custom') && !isUnlocked()) savedMode = 'basic';
  setMode(savedMode);

  // reset (ticks only, keeps your custom items and mode)
  const resetBtn = document.getElementById('resetBtn');
  if (resetBtn) {
    // Reset = back to factory, per Antonio: "everything goes back to how it
    // was before you edit anything." In Basic/Advanced that is just the ticks;
    // in Custom it also restores deleted items, undoes renames and reorders,
    // and removes added items. Because that now destroys real work, the first
    // tap arms the button and the second one fires; anything else disarms it.
    let resetArmed = false;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    const disarmReset = () => {
      resetArmed = false;
      if (resetTimer) clearTimeout(resetTimer);
      // Labels live in the markup, stacked; only the class flips. Never
      // write innerHTML here again: label swaps changed the button width
      // and reflowed the whole toolbar.
      resetBtn.classList.remove('armed');
    };
    disarmResetHook = disarmReset;
    resetBtn.addEventListener('click', () => {
      if (!resetArmed) {
        resetArmed = true;
        // "Are you sure?" for every mode (Antonio): short enough to share
        // the idle width, and the red border already says this is serious.
        resetBtn.classList.add('armed');
        resetTimer = setTimeout(disarmReset, 4000);
        return;
      }
      disarmReset();
      allBoxes().forEach((b) => { b.checked = false; });
      save({});
      if (mode === 'custom') {
        try {
          localStorage.removeItem('SMG_CHECKLIST_ORDER_V1');
          localStorage.removeItem('SMG_CHECKLIST_RENAME_V1');
          localStorage.removeItem(CUSTOM_KEY);
          localStorage.removeItem(REMOVED_KEY);
          localStorage.removeItem(SECTIONS_KEY);
          localStorage.removeItem(HIDDENG_KEY);
        } catch (e) {}
        // A full rebuild from defaults beats surgically undoing four kinds of
        // edit in place.
        location.reload();
        return;
      }
      render();
    });
  }

  // back to top
  const topBtn = document.getElementById('topBtn');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
