    catch (e) { return {}; }
  }
  function saveOrder(o: Record<string, string[]>) { try { localStorage.setItem(ORDER_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ } }
  function loadRenames(): Record<string, string> {
