  // Wire one category's notes trio (button + textarea + hint + preview).
  // Used for the fixed groups at load and for user sections as they render.
  function wireNotes(btn: HTMLButtonElement, area: HTMLTextAreaElement, gid: string) {
    const existing = loadNotes()[gid] || '';
    if (existing) { area.value = existing; area.hidden = false; btn.hidden = true; }
    const hint = area.parentElement ? area.parentElement.querySelector<HTMLElement>('.notes-hint') : null;
    btn.addEventListener('click', () => {
      btn.hidden = true; area.hidden = false; area.focus();
    });
    // No save button exists; the hint says so exactly while it matters.
    area.addEventListener('focus', () => { if (hint) hint.hidden = false; });
    area.addEventListener('blur', () => { if (hint) hint.hidden = true; });
    area.addEventListener('input', () => {
      const n = loadNotes();
      if (area.value.trim()) n[gid] = area.value; else delete n[gid];
      saveNotes(n);
      updateNotesPreview(gid);
    });
    // Tapping the preview = straight into editing: expand, focus, cursor at
    // the end. A tap on a LINK inside it navigates instead.
    const prev = document.querySelector<HTMLElement>(`[data-notes-prev="${gid}"]`);
    if (prev) prev.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const section = prev.closest('.task-group') as HTMLElement;
      if (section) setGroupOpen(section, true, true);
      btn.hidden = true; area.hidden = false;
      area.focus();
      const end = area.value.length;
      area.setSelectionRange(end, end);
    });
    updateNotesPreview(gid);
  }
