    border-radius: 2px;
  }
  .edit-hint[data-gone] { display: none; }
  #hintClose {
    position: absolute; right: 2px; top: 50%; transform: translateY(-50%);
    background: none; border: 0; color: var(--text-faint); cursor: pointer;
    font-size: 1.1rem; line-height: 1; padding: 8px 10px;
