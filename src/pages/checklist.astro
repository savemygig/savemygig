---
import Base from '../layouts/Base.astro';
import InstallApp from '../components/InstallApp.astro';

/**
 * Interactive pre-gig checklist. Prevention side, outside the tunnel.
 * Tick boxes with a live readiness meter; state persists per device.
 *   - localStorage SMG_CHECKLIST_V1   = { itemKey: true }        (ticks)
 *   - localStorage SMG_CHECKLIST_MODE = 'basic' | 'advanced'     (depth)
 *   - localStorage SMG_CHECKLIST_OPEN = { groupId: false }       (collapsed)
 * Basic/Advanced toggle keeps the default list short on mobile; Advanced
 * reveals the full kit. Each category collapses independently via the arrow.
 * Readiness counts only the items visible in the current mode.
 */

const groups = [
  {
    id: 'basics',
    title: 'The basics',
    blurb: 'Out the door with nothing missing.',
    items: [
      { key: 'usb-two', level: 'basic', label: 'Two identical USB drives, same export on both' },
      { key: 'headphones', level: 'basic', label: 'Headphones' },
      { key: 'phone', level: 'basic', label: 'Phone charged, plus a power bank' },
      { key: 'money', level: 'basic', label: 'Cash and cards' },
      { key: 'address', level: 'basic', label: 'Venue address and set time confirmed' },
      { key: 'contact', level: 'advanced', label: 'Promoter or club contact saved in your phone' },
      { key: 'guestlist', level: 'advanced', label: 'Your name confirmed on the guest list' },
      { key: 'transport', level: 'advanced', label: 'Transport home sorted: parking, ride, or last train' },
      { key: 'running-order', level: 'advanced', label: 'Running order: when you go on and when you come off' },
      { key: 'watch', level: 'advanced', label: 'A watch you can read in a dark booth' },
      { key: 'pen', level: 'advanced', label: 'A pen, for guest lists and split sheets' },
    ],
  },
  {
    id: 'technical',
    title: 'Technical',
    blurb: 'The gear that actually plays your set.',
    items: [
      { key: 'format', level: 'basic', label: 'Both drives are FAT32, not exFAT; MBR recommended over GPT' },
      { key: 'reexport', level: 'basic', label: 'Re-exported after the last library change' },
      { key: 'tested', level: 'basic', label: 'Both drives tested on a player, or reopened in Rekordbox' },
      { key: 'backup', level: 'basic', label: 'Rekordbox library backed up to cloud or a second drive' },
      { key: 'card', level: 'basic', label: 'Emergency Card saved on your phone' },
      { key: 'adapters', level: 'advanced', label: 'USB-C and USB-A adapters for the booth' },
      { key: 'cables', level: 'advanced', label: 'Spare cable and a short USB extension' },
      { key: 'laptop', level: 'advanced', label: 'Laptop, charger and soundcard, if you play from a laptop' },
      { key: 'third-backup', level: 'advanced', label: 'A third backup drive, or an SD card copy' },
      { key: 'labelled', level: 'advanced', label: 'Drives labelled A and B so you know which is which' },
      { key: 'lib-format', level: 'advanced', label: 'Your export matches the club CDJ library format, no OneLibrary surprise' },
      { key: 'cloud-set', level: 'advanced', label: 'A cloud link to your set you can download at the venue' },
      { key: 'multitool', level: 'advanced', label: 'A small multitool or screwdriver for booth fixes' },
    ],
  },
  {
    id: 'extras',
    title: 'Extras and add-ons',
    blurb: 'The life stuff that is easy to forget on the way out.',
    items: [
      { key: 'meds', level: 'basic', label: 'Any medicine you need' },
      { key: 'clothes', level: 'basic', label: 'The right clothes for the venue, and a spare shirt' },
      { key: 'car-keys', level: 'basic', label: 'Car keys' },
      { key: 'home-keys', level: 'basic', label: 'Home keys' },
      { key: 'docs', level: 'basic', label: 'ID and documents, passport and boarding pass if flying' },
      { key: 'earplugs', level: 'advanced', label: 'Earplugs' },
      { key: 'water', level: 'advanced', label: 'Water bottle' },
      { key: 'freshen', level: 'advanced', label: 'Deodorant and a small towel' },
      { key: 'snacks', level: 'advanced', label: 'Snacks for a long night' },
      { key: 'hotel', level: 'advanced', label: 'Hotel address saved offline, if you are staying over' },
      { key: 'adapter', level: 'advanced', label: 'A travel adapter, if you are playing abroad' },
      { key: 'backup-person', level: 'advanced', label: 'Someone to call who can bring a forgotten item' },
    ],
  },
];

const total = groups.reduce((n, g) => n + g.items.length, 0);
---
<Base
  title="The Pre-Gig Checklist for DJs | Save My Gig!"
  description="A tickable pre-gig checklist for DJs: the basics, the technical gear, and the life stuff you forget. Collapse each section, switch basic or full, track your readiness, saves on your device."
  path="/checklist"
>
  <main class="wrap" id="top">
    <div class="status-line">Prevention_Hub</div>

    <h1 style="margin-bottom:1rem">LEAVE HOME <span class="accent">READY</span></h1>
    <p class="dim" style="margin-bottom:1.6rem">Tick it off before you walk out. Nothing forgotten, nothing sent anywhere. This list saves on this device, so it is waiting next time.</p>

    <div class="mode-switch" role="group" aria-label="Checklist depth">
      <button type="button" class="mode-btn is-on" data-mode-set="basic" aria-pressed="true">Basic</button>
      <button type="button" class="mode-btn" data-mode-set="advanced" aria-pressed="false">Advanced</button>
      <button type="button" class="mode-btn" data-mode-set="custom" aria-pressed="false">Custom</button>
    </div>
    <p class="mode-hint dim" id="modeHint">Basic is the must-bring list. Switch to Advanced for the full kit.</p>

    <div class="unlock" id="unlock" hidden>
      <p class="unlock-title">Unlock Advanced and Custom</p>
      <p class="dim unlock-copy">The full kit and your own custom lists are free. The only price is your email, call it a tiny tip that keeps this project alive. You also get Save My Gig news and the odd cool thing for your DJ career, never spam. Drop the email you actually open and you are in right away, one quick confirm and done.</p>
      <form class="unlock-form" id="unlockForm" novalidate>
        <input type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@email.com" aria-label="Your best email" required />
        <button type="submit" class="btn btn-solid">Join and unlock</button>
      </form>
      <p class="unlock-msg" id="unlockMsg" role="status" aria-live="polite"></p>
      <p class="unlock-note">By joining you agree we can email you Save My Gig news and partner offers, DJ world only, never spam. One time on this device. <a href="/privacy">Privacy</a></p>
    </div>

    <section class="readiness" id="readiness" aria-live="polite">
      <div class="readiness-top">
        <span class="readiness-label">Readiness</span>
        <span class="readiness-pct" id="pct">0%</span>
      </div>
      <div class="meter"><div class="meter-fill" id="meterFill"></div></div>
      <p class="readiness-sub" id="sub">0 ready</p>
    </section>

    <div class="custom-toolbar" id="customToolbar" hidden>
      <button type="button" class="btn btn-neutral" id="editToggle">Edit list</button>
      <button type="button" class="btn btn-neutral" id="backupBtn">Email me a copy</button>
      <span class="edit-hint dim" id="editHint">Add or remove items. Tap Done when you finish, so nothing gets deleted by accident.</span>
      <form class="backup-form" id="backupForm" hidden>
        <input type="email" name="email" inputmode="email" autocomplete="email" placeholder="you@email.com" aria-label="Your email" />
        <button type="submit" class="btn btn-neutral">Send it</button>
      </form>
      <p class="backup-msg" id="backupMsg" role="status" aria-live="polite"></p>
    </div>

    <div id="list" data-mode="basic" data-edit="off">
      {groups.map((g) => (
        <section class="panel task-group" data-group={g.id}>
          <h3 class="group-h">
            <button type="button" class="group-toggle" data-toggle={g.id} aria-expanded="true" aria-controls={`body-${g.id}`}>
              <span class="group-title">{g.title}</span>
              <span class="group-meta">
                <span class="group-count" data-count={g.id}>0/0</span>
                <span class="chev" aria-hidden="true"></span>
              </span>
            </button>
          </h3>
          <div class="group-body" id={`body-${g.id}`}>
            <p class="dim group-blurb">{g.blurb}</p>
            <ul class="tasks">
              {g.items.map((it) => (
                <li class="task" data-level={it.level} data-key={it.key}>
                  <label>
                    <input type="checkbox" data-key={it.key} data-level={it.level} />
                    <span class="box" aria-hidden="true"></span>
                    <span class="task-label">{it.label}</span>
                  </label>
                  <button type="button" class="task-remove" aria-label="Remove" data-remove={it.key}>&times;</button>
                </li>
              ))}
            </ul>
            <ul class="custom-tasks" data-custom={g.id}></ul>
            <div class="add-own">
              <input type="text" class="add-input" data-cat={g.id} placeholder="Add your own..." aria-label={`Add your own item to ${g.title}`} maxlength="80" />
              <button type="button" class="add-btn" data-add={g.id}>Add</button>
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="checklist-actions">
      <a href="/downloads/save-my-gig-pre-gig-checklist.pdf" class="btn btn-neutral" download data-event="checklist_download" data-placement="checklist_actions">Download as PDF</a>
      <button type="button" class="btn btn-neutral" id="resetBtn">Clear the list</button>
    </div>

    <div class="panel" style="margin-top:1.5rem">
      <h3 style="margin-bottom:0.6rem">Why two drives, why FAT32</h3>
      <p class="dim" style="margin-bottom:0">These are not superstitions, they are the failures we see most. The full reasoning, and the gear worth carrying, live in the <a href="/prepare">prevention system</a> and the <a href="/gear">gear guide</a>.</p>
    </div>

    <div class="panel panel-danger" style="margin-top:1.5rem">
      <h3 style="margin-bottom:0.6rem">Already at the gig and something failed?</h3>
      <a href="/emergency" class="btn btn-solid" data-event="begin_checkout" data-placement="checklist">Start Emergency Mode</a>
    </div>

    <div class="top-actions">
      <button type="button" class="btn btn-neutral" id="topBtn">Back to top</button>
    </div>
    <InstallApp />
  </main>
</Base>

<style is:global>
  .mode-switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    background: var(--surf);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    margin-bottom: 0.6rem;
  }
  .mode-btn {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: transparent;
    border: none;
    border-radius: var(--radius);
    padding: 0.55rem 1.2rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .mode-btn.is-on { background: var(--text); color: #0a0a0b; }
  .mode-btn:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .mode-hint { font-size: 0.85rem; margin: 0 0 1.6rem; }

  .readiness {
    background: var(--surf-2);
    border: 1px solid var(--edge);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    margin-bottom: 1.6rem;
    position: sticky;
    top: 0.5rem;
    z-index: 5;
  }
  .readiness-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .readiness-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .readiness-pct {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.25s ease;
  }
  .readiness.is-ready .readiness-pct { color: var(--green); }
  .meter {
    height: 10px;
    background: var(--bg);
    border: 1px solid var(--edge);
    border-radius: 999px;
    overflow: hidden;
    margin: 0.9rem 0 0.7rem;
  }
  .meter-fill { height: 100%; width: 0%; background: var(--green); border-radius: 999px; transition: width 0.3s ease; }
  .readiness-sub { margin: 0; font-size: 0.85rem; color: var(--text-dim); }
  .readiness.is-ready .readiness-sub { color: var(--green); }

  .task-group { padding: 0; overflow: hidden; }

  /* Collapsible header is a full-width button living inside the h3. */
  .group-h { margin: 0; }
  .group-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 1.3rem 1.5rem;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  .group-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.1rem, 3.6vw, 1.35rem);
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .group-meta { display: inline-flex; align-items: center; gap: 0.85rem; flex: 0 0 auto; }
  .group-count {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .group-count.done { color: var(--green); }
  .chev {
    width: 9px; height: 9px;
    border-right: 2px solid var(--text-dim);
    border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg);           /* points down when expanded */
    margin-top: -3px;
    transition: transform 0.2s ease;
    flex: 0 0 auto;
  }
  .group-toggle:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }

  .group-body { padding: 0 1.5rem 1.1rem; }
  .task-group.collapsed .group-body { display: none; }
  .task-group.collapsed .chev { transform: rotate(-45deg); } /* points right when collapsed */

  .group-blurb { margin: 0 0 0.4rem; font-size: 0.92rem; }

  .tasks { list-style: none; margin: 0.4rem 0 0; padding: 0; }
  .task { border-bottom: 1px solid var(--edge-soft); display: flex; align-items: center; }
  .task:last-child { border-bottom: none; }
  .task > label { flex: 1; }
  /* Basic mode hides the advanced items so the mobile list stays short. */
  #list[data-mode="basic"] .task[data-level="advanced"] { display: none; }

  .task label {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem 0.2rem;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .task input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .box {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border: 1.5px solid var(--text-faint);
    border-radius: var(--radius);
    background: var(--bg);
    position: relative;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .box::after {
    content: '';
    position: absolute;
    left: 8px; top: 4px;
    width: 6px; height: 11px;
    border: solid #0a0a0b;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 0.15s ease;
  }
  .task input:checked + .box { background: var(--green); border-color: var(--green); }
  .task input:checked + .box::after { transform: rotate(45deg) scale(1); }
  .task input:focus-visible + .box { outline: 2px solid var(--green); outline-offset: 2px; }
  .task-label { font-size: 1rem; line-height: 1.45; color: var(--text); transition: color 0.15s ease; }
  .task input:checked ~ .task-label {
    color: var(--text-faint);
    text-decoration: line-through;
    text-decoration-color: var(--text-faint);
  }

  .checklist-actions { margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .checklist-actions .btn { width: auto; display: inline-block; margin: 0; }
  .top-actions { margin-top: 1.5rem; text-align: center; }
  .top-actions .btn { width: auto; display: inline-block; margin: 0; }

  .unlock {
    background: var(--surf-2); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.2rem 1.3rem; margin: 0 0 1.6rem;
  }
  .unlock[hidden] { display: none; }
  .unlock-title {
    font-family: var(--font-display); font-weight: 800; font-size: 1.05rem;
    text-transform: uppercase; letter-spacing: -0.01em; margin: 0 0 0.4rem;
  }
  .unlock-copy { font-size: 0.9rem; margin: 0 0 0.9rem; }
  .unlock-form { display: flex; flex-direction: column; gap: 10px; }
  .unlock-form input {
    width: 100%; padding: 0.9rem 1rem; font-family: inherit; font-size: 16px;
    color: var(--text); background: var(--bg); border: 1px solid var(--edge); border-radius: var(--radius);
  }
  .unlock-form input::placeholder { color: var(--text-faint); }
  .unlock-form input:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .unlock-form .btn { margin: 0; }
  .unlock-msg:empty { display: none; }
  .unlock-msg { margin: 0.8rem 0 0; font-size: 0.88rem; color: var(--text-dim); }
  .unlock-msg.ok { color: var(--green); }
  .unlock-msg.err { color: var(--red); }
  @media (min-width: 520px) {
    .unlock-form { flex-direction: row; }
    .unlock-form input { flex: 1; }
    .unlock-form .btn { width: auto; white-space: nowrap; }
  }
  .unlock-note { margin: 0.8rem 0 0; font-size: 0.76rem; color: var(--text-faint); }
  .unlock-note a { color: var(--text-dim); }

  /* Custom mode: your own items. Editing (delete/add) is gated behind Edit. */
  .custom-tasks { list-style: none; margin: 0; padding: 0; }
  #list:not([data-mode="custom"]) .custom-tasks { display: none; }
  #list[data-mode="custom"] .task.removed { display: none; }
  .task-remove {
    flex: 0 0 auto; display: none; background: transparent; border: none; color: var(--text-faint);
    font-size: 1.4rem; line-height: 1; cursor: pointer; padding: 0 0.2rem 0 0.6rem;
  }
  #list[data-edit="on"] .task-remove { display: block; }
  .task-remove:hover { color: var(--red); }

  .custom-toolbar { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .custom-toolbar[hidden] { display: none; }
  .custom-toolbar .btn { width: auto; display: inline-block; margin: 0; }
  .edit-hint { font-size: 0.8rem; }

  .add-own { display: none; gap: 8px; margin: 0.6rem 0 0.2rem; }
  #list[data-mode="custom"][data-edit="on"] .add-own { display: flex; }

  .backup-form { display: flex; gap: 8px; flex-basis: 100%; margin-top: 0.3rem; }
  .backup-form[hidden] { display: none; }
  .backup-form input {
    flex: 1; padding: 0.7rem 0.9rem; font-family: inherit; font-size: 16px; color: var(--text);
    background: var(--bg); border: 1px solid var(--edge); border-radius: var(--radius);
  }
  .backup-form input::placeholder { color: var(--text-faint); }
  .backup-form .btn { margin: 0; width: auto; }
  .backup-msg { flex-basis: 100%; margin: 0.4rem 0 0; font-size: 0.85rem; color: var(--text-dim); }
  .backup-msg:empty { display: none; }
  .backup-msg.ok { color: var(--green); }
  .backup-msg.err { color: var(--red); }
  .add-own .add-input {
    flex: 1; padding: 0.75rem 0.9rem; font-family: inherit; font-size: 16px; color: var(--text);
    background: var(--bg); border: 1px dashed var(--edge); border-radius: var(--radius);
  }
  .add-own .add-input::placeholder { color: var(--text-faint); }
  .add-own .add-input:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .add-own .add-btn {
    flex: 0 0 auto; background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    color: var(--text); font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;
    text-transform: uppercase; letter-spacing: 0.03em; padding: 0 1rem; cursor: pointer;
  }
  @media (hover: hover) { .add-own .add-btn:hover { border-color: var(--text-dim); } }

  @media (prefers-reduced-motion: reduce) {
    .meter-fill, .box, .box::after, .readiness-pct, .mode-btn, .chev { transition: none; }
  }
</style>

<script>
  const STORE_KEY = 'SMG_CHECKLIST_V1';
  const MODE_KEY = 'SMG_CHECKLIST_MODE';
  const OPEN_KEY = 'SMG_CHECKLIST_OPEN';
  const UNLOCK_KEY = 'SMG_UNLOCKED';
  const CUSTOM_KEY = 'SMG_CHECKLIST_CUSTOM';
  const REMOVED_KEY = 'SMG_CHECKLIST_REMOVED';
  const EMAIL_KEY = 'SMG_EMAIL';

  const listEl = document.getElementById('list');
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));
  const pctEl = document.getElementById('pct');
  const fillEl = document.getElementById('meterFill');
  const subEl = document.getElementById('sub');
  const readinessEl = document.getElementById('readiness');
  const hintEl = document.getElementById('modeHint');
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode-btn'));
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.group-toggle'));
  const unlockEl = document.getElementById('unlock') as HTMLElement | null;
  const unlockForm = document.getElementById('unlockForm') as HTMLFormElement | null;
  const unlockMsg = document.getElementById('unlockMsg');
  const customToolbar = document.getElementById('customToolbar') as HTMLElement | null;
  const editToggle = document.getElementById('editToggle');
  const backupBtn = document.getElementById('backupBtn');
  const backupForm = document.getElementById('backupForm') as HTMLFormElement | null;
  const backupMsg = document.getElementById('backupMsg');

  let mode: string = 'basic';
  let pendingMode: string = 'advanced';
  let editMode = false;

  const allBoxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));

  function load(): Record<string, boolean> {
    try { const raw = localStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function save(state: Record<string, boolean>) {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* storage blocked */ }
  }
  function saveMode(m: string) { try { localStorage.setItem(MODE_KEY, m); } catch (e) { /* blocked */ } }
  function loadOpen(): Record<string, boolean> {
    try { const raw = localStorage.getItem(OPEN_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveOpen(o: Record<string, boolean>) {
    try { localStorage.setItem(OPEN_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ }
  }
  function isUnlocked(): boolean { try { return localStorage.getItem(UNLOCK_KEY) === '1'; } catch (e) { return false; } }
  function setUnlocked() { try { localStorage.setItem(UNLOCK_KEY, '1'); } catch (e) { /* blocked */ } }
  function loadCustom(): Record<string, { k: string; t: string }[]> {
    try { const raw = localStorage.getItem(CUSTOM_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveCustom(c: Record<string, { k: string; t: string }[]>) {
    try { localStorage.setItem(CUSTOM_KEY, JSON.stringify(c)); } catch (e) { /* blocked */ }
  }
  function loadRemoved(): string[] {
    try { const raw = localStorage.getItem(REMOVED_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function saveRemoved(a: string[]) { try { localStorage.setItem(REMOVED_KEY, JSON.stringify(a)); } catch (e) { /* blocked */ } }
  function getEmail(): string { try { return localStorage.getItem(EMAIL_KEY) || ''; } catch (e) { return ''; } }
  function setEmail(v: string) { try { localStorage.setItem(EMAIL_KEY, v); } catch (e) { /* blocked */ } }

  function b64urlToStr(s: string): string {
    let t = s.replace(/-/g, '+').replace(/_/g, '/');
    while (t.length % 4) t += '=';
    const bin = atob(t);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function tryRestore(): boolean {
    const m = location.hash.match(/[#&]r=([^&]+)/);
    if (!m) return false;
    try {
      const data = JSON.parse(b64urlToStr(decodeURIComponent(m[1])));
      if (data && data.c) saveCustom(data.c);
      if (data && Array.isArray(data.x)) saveRemoved(data.x);
      setUnlocked();
      history.replaceState(null, '', location.pathname + location.search);
      return true;
    } catch (e) { return false; }
  }
  function getListByCat(): Record<string, string[]> {
    const out: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const cat = group.getAttribute('data-group') || '';
      const labels: string[] = [];
      group.querySelectorAll<HTMLElement>('.task').forEach((li) => {
        if (li.classList.contains('removed')) return;
        const el = li.querySelector<HTMLElement>('.task-label');
        const t = el && el.textContent ? el.textContent.trim() : '';
        if (t) labels.push(t);
      });
      out[cat] = labels;
    });
    return out;
  }
  async function sendBackup(email: string) {
    email = (email || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      if (backupMsg) { backupMsg.textContent = 'That email does not look right.'; backupMsg.className = 'backup-msg err'; }
      return;
    }
    if (backupMsg) { backupMsg.textContent = 'Sending...'; backupMsg.className = 'backup-msg'; }
    try {
      const res = await fetch('/api/backup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, listByCat: getListByCat(), custom: loadCustom(), removed: loadRemoved() }),
      });
      const data = await res.json();
      if (data && data.ok) {
        setEmail(email);
        if (backupForm) backupForm.hidden = true;
        if (backupMsg) { backupMsg.textContent = 'Sent to ' + email + '. Check your inbox for the copy and a link to load it anywhere.'; backupMsg.className = 'backup-msg ok'; }
      } else if (backupMsg) {
        backupMsg.textContent = 'Could not send right now. Try again in a minute.'; backupMsg.className = 'backup-msg err';
      }
    } catch (e) {
      if (backupMsg) { backupMsg.textContent = 'No connection. Try again when you have signal.'; backupMsg.className = 'backup-msg err'; }
    }
  }

  function isVisible(box: HTMLInputElement): boolean {
    const lvl = box.dataset.level;
    if (mode === 'custom' && loadRemoved().indexOf(box.dataset.key || '') !== -1) return false;
    if (mode === 'basic') return lvl === 'basic';
    if (mode === 'advanced') return lvl !== 'custom';
    return true; // custom mode shows everything, minus what you removed
  }

  function render() {
    const visible = allBoxes().filter(isVisible);
    const done = visible.filter((b) => b.checked).length;
    const totalV = visible.length;
    const pct = totalV ? Math.round((done / totalV) * 100) : 0;

    if (pctEl) pctEl.textContent = pct + '%';
    if (fillEl) fillEl.style.width = pct + '%';
    if (subEl) subEl.textContent = pct === 100 ? 'Ready. Go play.' : `${done} of ${totalV} ready`;
    if (readinessEl) readinessEl.classList.toggle('is-ready', pct === 100 && totalV > 0);

    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const inGroup = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')).filter(isVisible);
      const gid = group.getAttribute('data-group');
      const countEl = document.querySelector<HTMLElement>(`.group-count[data-count="${gid}"]`);
      const gdone = inGroup.filter((b) => b.checked).length;
      if (countEl) {
        countEl.textContent = `${gdone}/${inGroup.length}`;
        countEl.classList.toggle('done', gdone === inGroup.length && inGroup.length > 0);
      }
    });
  }

  function attachBox(input: HTMLInputElement) {
    const ticks = load();
    if (ticks[input.dataset.key || '']) input.checked = true;
    input.addEventListener('change', () => {
      const s = load(); s[input.dataset.key || ''] = input.checked; save(s); render();
    });
  }

  function renderCustom() {
    const custom = loadCustom();
    document.querySelectorAll<HTMLElement>('.custom-tasks').forEach((ul) => {
      const cat = ul.getAttribute('data-custom') || '';
      const items = custom[cat] || [];
      ul.innerHTML = '';
      items.forEach((it) => {
        const li = document.createElement('li');
        li.className = 'task task-custom';
        li.setAttribute('data-level', 'custom');
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox'; input.dataset.key = it.k; input.dataset.level = 'custom';
        const box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span'); span.className = 'task-label'; span.textContent = it.t;
        label.appendChild(input); label.appendChild(box); label.appendChild(span);
        const rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'task-remove'; rm.setAttribute('aria-label', 'Remove'); rm.innerHTML = '&times;';
        rm.addEventListener('click', () => {
          const c = loadCustom(); c[cat] = (c[cat] || []).filter((x) => x.k !== it.k); saveCustom(c);
          const t = load(); delete t[it.k]; save(t); renderCustom(); render();
        });
        li.appendChild(label); li.appendChild(rm);
        attachBox(input);
        ul.appendChild(li);
      });
    });
  }

  function addCustom(cat: string, text: string) {
    const t = text.trim(); if (!t) return;
    const c = loadCustom(); const arr = c[cat] || [];
    const k = 'c-' + cat + '-' + Date.now().toString(36) + Math.floor(Math.random() * 1000);
    arr.push({ k, t }); c[cat] = arr; saveCustom(c);
    renderCustom(); render();
  }

  function setMode(m: string) {
    mode = m;
    if (listEl) listEl.setAttribute('data-mode', m);
    if (m !== 'custom') setEdit(false);
    if (customToolbar) customToolbar.hidden = m !== 'custom';
    modeBtns.forEach((b) => {
      const on = b.dataset.modeSet === m;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (hintEl) {
      if (m === 'advanced') hintEl.textContent = 'The full kit. Switch back to Basic for the essentials.';
      else if (m === 'custom') hintEl.textContent = 'Your list. Add your own items to any section below.';
      else hintEl.textContent = isUnlocked()
        ? 'Basic is the must-brings. Advanced is the full kit, Custom is your own.'
        : 'Basic is the must-brings. Advanced and Custom unlock with your email.';
    }
    saveMode(m);
    render();
  }

  function setEdit(on: boolean) {
    editMode = on;
    if (listEl) listEl.setAttribute('data-edit', on ? 'on' : 'off');
    if (editToggle) editToggle.textContent = on ? 'Done' : 'Edit list';
  }

  function applyRemoved() {
    const set = loadRemoved();
    document.querySelectorAll<HTMLElement>('.task[data-key]').forEach((li) => {
      li.classList.toggle('removed', set.indexOf(li.getAttribute('data-key') || '') !== -1);
    });
  }

  function setGroupOpen(section: HTMLElement, open: boolean, persist: boolean) {
    section.classList.toggle('collapsed', !open);
    const btn = section.querySelector<HTMLButtonElement>('.group-toggle');
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (persist) {
      const o = loadOpen();
      o[section.getAttribute('data-group') || ''] = open;
      saveOpen(o);
    }
  }

  // restore checks (static items)
  const state = load();
  boxes.forEach((b) => {
    const k = b.dataset.key || '';
    if (state[k]) b.checked = true;
    b.addEventListener('change', () => {
      const s = load();
      s[b.dataset.key || ''] = b.checked;
      save(s);
      render();
    });
  });

  // restore from an email link if one is present, then render custom items
  const restored = tryRestore();
  renderCustom();
  applyRemoved();

  // edit toggle (custom mode): gates delete and add so nothing goes by accident
  if (editToggle) editToggle.addEventListener('click', () => setEdit(!editMode));

  // email me a copy: sends the list + a load-anywhere link to their inbox
  if (backupBtn) backupBtn.addEventListener('click', () => {
    const stored = getEmail();
    if (stored) { sendBackup(stored); }
    else if (backupForm) {
      backupForm.hidden = false;
      const i = backupForm.querySelector('input');
      if (i) (i as HTMLInputElement).focus();
    }
  });
  if (backupForm) {
    backupForm.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const i = backupForm.querySelector('input[name="email"]') as HTMLInputElement;
      sendBackup(i.value);
    });
  }

  // remove a standard row (only reachable in edit mode)
  document.querySelectorAll<HTMLButtonElement>('.task-remove[data-remove]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-remove') || '';
      const set = loadRemoved();
      if (set.indexOf(key) === -1) { set.push(key); saveRemoved(set); }
      const li = btn.closest('.task'); if (li) li.classList.add('removed');
      render();
    });
  });

  // mode buttons: Advanced and Custom are gated behind an email
  modeBtns.forEach((b) => b.addEventListener('click', () => {
    const target = b.dataset.modeSet || 'basic';
    if ((target === 'advanced' || target === 'custom') && !isUnlocked()) {
      pendingMode = target;
      if (unlockEl) unlockEl.hidden = false;
      const inp = unlockForm && unlockForm.querySelector('input');
      if (inp) (inp as HTMLInputElement).focus();
      return;
    }
    if (unlockEl) unlockEl.hidden = true;
    setMode(target);
  }));

  // unlock form: instant access, confirmation email fires in the background
  if (unlockForm) {
    unlockForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const inp = unlockForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (unlockMsg) { unlockMsg.textContent = 'That email does not look right. Check it and try again.'; unlockMsg.className = 'unlock-msg err'; }
        inp.focus();
        return;
      }
      setUnlocked();
      setEmail(email);
      if (unlockEl) unlockEl.hidden = true;
      setMode(pendingMode);
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: pendingMode });
      }
      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source: 'checklist-' + pendingMode }),
        });
      } catch (e) { /* unlocked anyway; feature is free */ }
    });
  }

  // add-your-own inputs (custom mode)
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((btn) => {
    const cat = btn.getAttribute('data-add') || '';
    const input = document.querySelector<HTMLInputElement>('.add-input[data-cat="' + cat + '"]');
    const doAdd = () => { if (input) { addCustom(cat, input.value); input.value = ''; input.focus(); } };
    btn.addEventListener('click', doAdd);
    if (input) input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
  });

  // collapse toggles (restore open state, default open)
  const openState = loadOpen();
  toggles.forEach((btn) => {
    const section = btn.closest('.task-group') as HTMLElement;
    const gid = section.getAttribute('data-group') || '';
    const open = openState[gid] !== false; // default true
    setGroupOpen(section, open, false);
    btn.addEventListener('click', () => {
      const nowOpen = section.classList.contains('collapsed'); // collapsed -> will open
      setGroupOpen(section, nowOpen, true);
    });
  });

  // restore mode (advanced/custom only if already unlocked on this device)
  let savedMode = 'basic';
  try { savedMode = localStorage.getItem(MODE_KEY) || 'basic'; } catch (e) { /* ignore */ }
  if (restored) savedMode = 'custom';
  if ((savedMode === 'advanced' || savedMode === 'custom') && !isUnlocked()) savedMode = 'basic';
  setMode(savedMode);

  // reset (ticks only, keeps your custom items and mode)
  const resetBtn = document.getElementById('resetBtn');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      allBoxes().forEach((b) => { b.checked = false; });
      save({});
      render();
    });
  }

  // back to top
  const topBtn = document.getElementById('topBtn');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
