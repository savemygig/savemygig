---
import Base from '../layouts/Base.astro';
import { BRANDS, modelsOfBrand, modelPath } from '../data/facts.js';

/**
 * /equipment. THE TOP-LEVEL EQUIPMENT ENTRY POINT.
 *
 * WHY IT EXISTS (Antonio, 2026-08-07). Equipment was four levels deep:
 * Knowledge, then Equipment, then Pioneer DJ / AlphaTheta, then the model. His
 * argument, and it is the right one: nobody thinks "I want to browse the
 * knowledge base". They think "I need information about my CDJ-3000" or "I am
 * playing on Pioneer gear tonight". Search traffic arrives with a model number,
 * not with a taxonomy.
 *
 * SO THIS PAGE LISTS THE MODELS THEMSELVES, not just the manufacturer. A brand
 * hub that only linked to another brand hub would have removed one click out of
 * three and left the actual problem in place. From the nav it is now two clicks
 * to any model page instead of four.
 *
 * WHY IT IS BRAND-AGNOSTIC AND NOT /pioneer-dj. Antonio's own reasoning, which
 * settled it: a single top-level Equipment entry gives the discoverability
 * without over-promoting one manufacturer, and it scales the day Denon DJ,
 * Allen & Heath or RANE arrive. Those get a section here, not a nav entry each.
 *
 * IT DOES NOT DUPLICATE /knowledge/pioneer-dj. That page is the FULL catalogue
 * including every model still queued and visibly labelled "Coming soon", plus
 * all-in-ones, turntables, effectors and controllers. This page is the fast
 * path: the models that actually have a researched page today, nothing else,
 * because a landing page whose job is speed should not be padded with cards
 * that go nowhere. The link to the full catalogue is at the foot of each brand.
 *
 * THE MODEL LIST IS READ FROM THE EQUIPMENT GRAPH, so a new model appears here
 * the moment it is added to facts.js and nobody has to remember this file.
 */

// BRANDS COME FROM THE REGISTRY NOW, and EQUIPMENT is already in canonical
// display order, so the ORDER array and its rank() function are GONE.
//
// That array was a second copy of an ordering that facts.js already knew, and it
// rotted within one commit of being written: three new models were added to
// EQUIPMENT and sorted last here because nobody remembered the duplicate. The fix
// was a thrown error; the better fix is not having the duplicate. EQUIPMENT is
// ordered brand, then category, then family, then descending model number, and
// this page simply preserves that order.
//
// One lead sentence per brand lives here because it is COPY, and copy belongs in
// the page that renders it rather than in the data layer, which is language
// neutral. A brand with no lead still renders.
const LEADS = {
  'pioneer-dj': 'The gear in most professional booths. Documented faults, the firmware version that fixed each one, and what to do when it happens to you mid-set.',
  'allen-heath': 'The analogue side of the professional booth, built around the Xone filter. Different rules to a CDJ booth: no firmware to check on one of them, and traps that live on the back panel.',
};

const brands = BRANDS.map((b) => ({
  ...b,
  lead: LEADS[b.key],
  groups: [
    { label: 'Players', items: modelsOfBrand(b.key, 'player') },
    { label: 'Mixers', items: modelsOfBrand(b.key, 'mixer') },
  ].filter((g) => g.items.length > 0),
}));

const allModels = brands.flatMap((b) => b.groups.flatMap((g) => g.items));

const liveCount = allModels.length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/equipment#collection',
  name: 'DJ equipment reference',
  description: 'Operational references for the DJ players and mixers installed in professional booths, by model.',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  about: [
    { '@type': 'Thing', name: 'Pioneer DJ' },
    { '@type': 'Thing', name: 'AlphaTheta' },
    { '@type': 'Thing', name: 'CDJ and DJM equipment' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: 'DJ equipment references by model',
    numberOfItems: liveCount,
    itemListElement: allModels.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: m.name,
      url: `https://www.savemygig.com${modelPath(m)}`,
    })),
  },
};
---
<Base
  title="DJ Equipment: CDJ and DJM References | Save My Gig"
  description="Operational references for the CDJs and DJMs installed in professional booths. Find your model, see the documented faults, and know what to do mid-set."
  path="/equipment"
  crumbName="Equipment"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <div class="status-line">EQUIPMENT</div>
    <h1 style="margin-bottom:0.8rem">Find <span class="accent">your model</span></h1>
    <p class="dim kb-lead">
      You are probably here because of one specific unit, either the one in front
      of you or the one you are playing on tonight. Every reference below is
      built from the manufacturer's own documentation: what is known to go wrong,
      which firmware version fixed it, and what to do when it happens with a room
      watching.
    </p>

    <!-- TWO LEVELS OF ACCORDION (Antonio, 2026-08-07): "you click on equipment,
         you have to have an accordion with the brands. You click expands, and then
         you have players, mixers. But it has to be accordion and accordion and
         accordion. Otherwise, starts to become too big."
         He is right, and he is solving a problem that does not exist yet: with two
         brands and seventeen cards this page is already long on a phone, and every
         manufacturer added makes it worse linearly. Nesting makes the phone view a
         list of BRANDS, which stays one screen however many brands arrive.
         Desktop opens everything before paint, so nothing is hidden where there is
         room, exactly as the knowledge hub already does at the same 641px
         breakpoint. Native details and summary, no framework, works with no JS. -->
    {brands.map((b) => (
      <details class="kb-cat eq-brand-cat">
        <summary>
          <h2 class="kb-h">{b.name}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        <p class="dim eq-lead">{b.lead}</p>

        {b.groups.map((g) => (
          <details class="kb-cat eq-group-cat">
            <summary>
              <h3 class="kb-h eq-group-h">{g.label}</h3>
              <span class="kb-chev" aria-hidden="true"></span>
            </summary>
            <div class="kb-grid">
              {g.items.map((m) => (
                <a class="kb-card kb-live" href={modelPath(m)}>
                  <span class="kb-name">{m.name}</span>
                  <span class="kb-go">Open the guide &rarr;</span>
                </a>
              ))}
            </div>
          </details>
        ))}

        <p class="eq-more">
          <a href={b.hub}>Every {b.name} model, including what is still coming</a>
        </p>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every brand AND every category before first
      // interaction, so a wide screen reads exactly as it did before nesting.
      // Phones keep them collapsed, which is the whole point.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.eq-brand-cat, .eq-group-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <!-- Cross-model entry point, the same one the manufacturer hub promotes.
         It belongs here too: "what is broken on this deck" is a question that
         comes BEFORE "which model am I looking at", and a DJ who does not know
         the model name can still read a version number off the screen. -->
    <a class="pdj-matrix" href="/knowledge/pioneer-dj/firmware">
      <span class="pdj-matrix-k">Across every model</span>
      <span class="pdj-matrix-t">What's broken on that deck, by firmware version &rarr;</span>
      <span class="pdj-matrix-b">Read the version off the unit and see which documented faults are still live on it.</span>
    </a>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">Another manufacturer?</h2>
      <p class="dim" style="margin-bottom:1rem">
        Pioneer DJ and AlphaTheta came first because that is what is installed in
        most booths. Denon DJ and RANE are the ones asked for
        most often after it. Tell us what you actually run and it moves up.
      </p>
      <a href="/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Tell us what you use</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      Looking for library and export questions instead? <a href="/knowledge/pioneer-dj/rekordbox">The rekordbox reference</a> covers that.
      Looking for drives rather than decks? <a href="/gear">USB drives worth trusting</a>.
    </p>
  </main>
</Base>

<style>
  /* Reuses .kb-grid, .kb-card, .kb-live, .kb-name, .kb-go and .kb-h from
     global.css so this page cannot drift from the manufacturer hub it feeds.
     Only the brand and group wrappers are new. */
  .eq-brand { margin-top: 2rem; }
  .eq-lead { margin-bottom: 1.25rem; }
  .eq-group {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 1.5rem 0 0.75rem;
    color: var(--ink-dim);
  }
  .eq-more { margin: 1.25rem 0 0; font-size: 0.9rem; }

  /* The brand level reuses .kb-cat wholesale so it behaves and looks like the
     knowledge hub's categories. The group level nests inside it and needs to be
     visibly subordinate: smaller heading, indented, and no top border of its own
     so two hairlines never stack. */
  .eq-group-cat { margin-left: 0.75rem; }
  .eq-group-h {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin: 0;
    border-bottom: 0;
    padding-bottom: 0;
    flex: 1 1 auto;
  }
  @media (min-width: 641px) {
    /* Open on desktop, so the chevrons would be decoration and the summary
       should not look clickable. Same treatment the knowledge hub uses. */
    .eq-brand-cat > summary, .eq-group-cat > summary { cursor: default; }
    .eq-brand-cat > summary .kb-chev, .eq-group-cat > summary .kb-chev { display: none; }
    .eq-group-cat { margin-left: 0; }
  }
</style>
