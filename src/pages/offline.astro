---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
// Shown when a page is requested that was never cached and there is no signal.
// Deliberately points at the parts that DO work offline.
---
<Base
  title="You are offline | Save My Gig"
  description="No connection right now."
  path="/offline"
  noindex={true}
>
  <main class="wrap">
    <div class="status-line">NO_SIGNAL</div>
    <h1 style="margin-bottom:1rem">No connection.<br /><span class="accent">The rescue still works.</span></h1>
    <p class="dim" style="margin-bottom:2rem">
      This page was not saved to your device, but the emergency flow and the
      checklist were. They work with no signal at all.
    </p>

    <a href="/emergency" class="btn btn-solid"><Icon name="siren" /> Emergency mode</a>
    <a href="/checklist" class="btn btn-neutral">Pre-gig checklist</a>
    <a href="/" class="btn btn-neutral">Home</a>

    <p class="dim" style="margin-top:2rem;font-size:0.9rem">
      Reconnect and everything else comes back.
    </p>
  </main>
</Base>
