---
import Base from '../layouts/Base.astro';
import PromoBanner from '../components/PromoBanner.astro';

// Homepage = simple "pick your pain" chooser. Rescue AND prevention, balanced:
// three equal, neutral doors; colour lives only in the LED dots and comes up
// on tap/hover. Emergency is never a permanently red box.
//
// The H1 asks what you want to DO, not what your situation is, and the doors
// are actions rather than states. That is deliberate and it is about who
// actually lands here: DJs mid-crisis arrive on /fix/* and /emergency straight
// from search, so homepage traffic skews COLD (social, word of mouth, someone
// typing the name). A cold visitor does not need sorting by situation, they
// need to see what this place can do for them. Actions tell them; states do not.
//
// The H1 is otherwise FIXED. It is the brand anchor, and a stable headline reads
// as reliability. Personality rotates in the SUBLINE instead: same functional
// facts every time (free, no account), different warmth. The first line renders
// server-side so it works with JavaScript disabled and is what crawlers index.
//
// Sublines are capped at ~52 characters on purpose. The block reserves height
// for the LONGEST one so the doors don't jump when it rotates, so a single
// three-line subline was silently pushing the third door off every small phone.
const SUBLINES = [
  'Pick what you came for. Free, no account.',
  'Breathe. Pick a door. Free, no account.',
  'Three ways in, no wrong answer. Free, no account.',
  'Start anywhere. Free, no account.',
  'Whatever you need, it is free. No account.',
];
---
<Base
  title="Save My Gig! | DJ Rescue and Prevention for CDJ, XDJ & USB"
  description="DJ rescue and prevention. In an emergency with a CDJ, XDJ or USB, getting gig-ready, or building a bulletproof setup? Pick your path. Free, no account, step by step."
  path="/"
>

  <main class="landing">
    <h1 class="ask">WHAT DO YOU WANT TO DO, <span class="accent">DJ?</span></h1>
    <p class="sub" id="sub">
      {SUBLINES.map((line, i) => (
        <span class="sub-line" data-sub={i} hidden={i !== 0}>{line}</span>
      ))}
    </p>

    <nav class="doors" aria-label="Choose your path">
      <a class="door d-ready" href="/checklist" data-event="step_completed" data-placement="home_door_checklist">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <span class="door-title">RUN PRE-GIG CHECKLIST</span>
          <span class="door-desc"><span class="dd-full">Playing soon? Tick it off before you walk out.</span><span class="dd-short">Playing soon? Tick it off first.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <a class="door d-emergency" href="/emergency" data-event="begin_checkout" data-placement="home_door_emergency">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <span class="door-title">FIX A PROBLEM NOW</span>
          <span class="door-desc"><span class="dd-full">USB or player failing. Get playing again, fast.</span><span class="dd-short">USB or player failing? Fix it fast.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <a class="door d-prevent" href="/prepare" data-event="step_completed" data-placement="home_door_prevention">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <span class="door-title">GET BULLETPROOF</span>
          <span class="door-desc"><span class="dd-full">The seven rules that make USB failure a non-event.</span><span class="dd-short">Seven rules. No more USB disasters.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </nav>

    <p class="known dim">
      Straight to the fix:
      <a href="/fix/usb-not-recognized-cdj">USB not recognized</a> ·
      <a href="/fix/playlists-not-showing-cdj">Playlists not showing</a> ·
      <a href="/fix/cdj-error-e-8302">E-8302</a> ·
      <a href="/fix/rekordbox-export-failed">Export failed</a> ·
      <a href="/fix/exfat-vs-fat32-cdj">exFAT vs FAT32</a>
    </p>

    <PromoBanner exclude="/emergency" />
  </main>
</Base>

<style>
  .landing { max-width: var(--site-w); margin: 0 auto; padding: 2rem var(--site-pad) 1rem; }
  .ask { font-size: clamp(2rem, 9vw, 3.2rem); margin-bottom: 0.6rem; }
  /* min-height reserves space for the longest rotating subline so the doors
     never jump. Now that every subline is capped at ~52 characters they all fit
     on one line at desktop widths, so reserving two lines was pure dead space
     between the headline and the first door. */
  .sub { color: var(--text-dim); margin-bottom: 1.5rem; max-width: 42rem; text-wrap: balance; min-height: 1.7rem; }
  .sub-line[hidden] { display: none; }

  .doors { display: flex; flex-direction: column; gap: 1rem; }

  /* All three doors are equal and neutral. Colour lives in the LED, and the
     accent only comes up on hover/tap. Rescue and prevention, balanced. */
  .door {
    display: flex; align-items: center; gap: 1.1rem;
    background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.4rem 1.5rem; text-decoration: none; color: var(--text);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.08s ease;
  }
  .door:active { transform: scale(0.995); }

  .door-led {
    flex: 0 0 auto; width: 13px; height: 13px; border-radius: 50%;
    background: var(--text-faint); transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .d-emergency .door-led { background: var(--red); }
  .d-ready .door-led { background: var(--green); }
  .d-prevent .door-led { background: var(--amber); }

  /* One-time staggered outline glow: walks the eye down the three doors.
     Animating opacity on an overlay instead of box-shadow/border-color keeps
     the whole thing on the compositor: no paint, no main-thread work. */
  .door { position: relative; }
  .door::after {
    content: ''; position: absolute; inset: -1px; border-radius: var(--radius);
    pointer-events: none; opacity: 0; will-change: opacity;
    box-shadow: 0 0 22px 1px var(--glow); border: 1px solid var(--glow);
    animation: doorGlow 1.2s ease-in-out both;
  }
  .d-emergency { --glow: rgba(255,77,46,0.7); }
  .d-ready { --glow: rgba(58,216,132,0.65); }
  .d-prevent { --glow: rgba(217,164,65,0.65); }
  /* Delays follow the doors top to bottom: checklist, emergency, prevention. */
  .d-ready::after { animation-delay: 0.42s; }
  .d-emergency::after { animation-delay: 1.14s; }
  .d-prevent::after { animation-delay: 1.86s; }
  @keyframes doorGlow { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .door::after { animation: none; } }

  .door-body { flex: 1; }
  .door-title {
    display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 0.25rem; color: var(--text);
  }
  .door-desc { display: block; color: var(--text-dim); font-size: 0.92rem; line-height: 1.45; }
  /* Two lengths, one message. Desktop has room for the full line; phones get a
     short version that lands on ONE line, which keeps the three doors above
     the fold and stops them reading as a wall of grey. Both stay in the HTML,
     so search engines and AI crawlers still read the full text. */
  .dd-short { display: none; }
  .door-arrow { flex: 0 0 auto; font-size: 1.4rem; color: var(--text-faint); transition: color 0.15s ease; }

  /* Colour comes up on interaction, per door. */
  .d-emergency:hover, .d-emergency:active, .d-emergency:focus-visible { border-color: var(--red); }
  .d-emergency:hover .door-led, .d-emergency:active .door-led { box-shadow: 0 0 12px var(--red); }
  .d-emergency:hover .door-arrow, .d-emergency:active .door-arrow { color: var(--red); }

  .d-ready:hover, .d-ready:active, .d-ready:focus-visible { border-color: var(--green); }
  .d-ready:hover .door-led, .d-ready:active .door-led { box-shadow: 0 0 12px rgba(58,216,132,0.7); }
  .d-ready:hover .door-arrow, .d-ready:active .door-arrow { color: var(--green); }

  .d-prevent:hover, .d-prevent:active, .d-prevent:focus-visible { border-color: var(--amber); }
  .d-prevent:hover .door-led, .d-prevent:active .door-led { box-shadow: 0 0 12px rgba(217,164,65,0.7); }
  .d-prevent:hover .door-arrow, .d-prevent:active .door-arrow { color: var(--amber); }

  .known { margin-top: 1.2rem; font-size: 0.9rem; }

  /* All three doors have to be readable on load, on every phone, without
     scrolling. Phones vary too much for one fixed set of numbers (a Galaxy
     S10e is 360x740, an iPhone Pro Max is 430x932), so the vertical rhythm is
     tied to the viewport HEIGHT and the type to the viewport WIDTH. Short
     phones compress, tall phones breathe, and the layout never has to be
     re-tuned per device.

     svh (small viewport height) is the right unit here, not vh: svh is the
     height with the browser's URL bar EXPANDED, which is exactly the state on
     first load. Sizing to vh would fit the doors only after the bar collapses,
     i.e. only after the user already scrolled. Each svh line is preceded by a
     static fallback for browsers that don't support it. */
  @media (max-width: 640px) {
    .landing { padding-top: 1.1rem; }
    .landing { padding-top: clamp(0.6rem, 2svh, 1.5rem); }

    .ask { font-size: clamp(1.7rem, 7.6vw, 2.4rem); margin-bottom: 0.4rem; line-height: 1.06; }

    .sub { font-size: 0.94rem; line-height: 1.5; margin-bottom: 1.1rem; min-height: 2.9rem; }
    .sub { margin-bottom: clamp(0.7rem, 2.2svh, 1.4rem); }

    .doors { gap: 0.7rem; }
    .doors { gap: clamp(0.5rem, 1.5svh, 1rem); }

    .door { padding: 0.95rem 1.05rem; gap: 0.8rem; }
    .door { padding-block: clamp(0.75rem, 2svh, 1.15rem); }

    /* The door title is the loudest thing on a phone, so it leads. It used to
       be 0.96rem, SMALLER than the desktop 1.2rem, which flattened it against
       the 0.85rem description and made the three doors read as one grey block.
       Narrow and short screens step down (rules below) so the longest title
       never wraps and the third door stays above the fold. */
    .door-title {
      font-size: clamp(1.02rem, calc(6.4vw - 6px), 1.45rem);
      margin-bottom: 0.2rem; letter-spacing: -0.015em;
    }
    .door-desc { font-size: clamp(0.79rem, calc(3.4vw + 0.3px), 1rem); line-height: 1.35; }
    .dd-full { display: none; }
    .dd-short { display: inline; }
    .door-arrow { font-size: 1.2rem; }
    .known { margin-top: 1.15rem; font-size: 0.85rem; }
  }

  /* Wide enough that even the longest subline fits one line, so stop reserving
     two. That reserved band was dead space between the headline and door one. */
  @media (min-width: 401px) and (max-width: 640px) {
    .sub { min-height: 1.6rem; }
  }

  /* Very short screens (older/compact phones in landscape-ish aspect, or a
     phone with a large accessibility font). Trade headline size for the third
     door: the choice matters more than the typography. */
  @media (max-width: 640px) and (max-height: 700px) {
    .ask { font-size: clamp(1.5rem, 6.8vw, 1.95rem); }
    .sub { font-size: 0.88rem; min-height: 2.5rem; }
    .door-title { font-size: 1.1rem; }
    .door-desc { font-size: 0.82rem; }
    /* Budget Androids (360x740 and similar) are the tightest real case, and
       they are common in Brazil. Tighter door padding keeps the third door
       comfortably above the fold at the bigger title size. */
    .door { padding-block: clamp(0.6rem, 1.6svh, 0.95rem); }
  }

  /* Shortest phones still in real use. Everything tightens one more notch so
     the third door clears the consent banner on a first visit. */
  @media (max-width: 640px) and (max-height: 620px) {
    .landing { padding-top: 0.4rem; }
    .ask { font-size: clamp(1.38rem, 6.2vw, 1.7rem); margin-bottom: 0.28rem; }
    .sub { font-size: 0.84rem; margin-bottom: 0.6rem; min-height: 2.2rem; line-height: 1.42; }
    .doors { gap: 0.34rem; }
    .door { padding-block: 0.56rem; }
    .door-title { font-size: 1.02rem; }
    .door-desc { font-size: 0.8rem; line-height: 1.33; }
  }
  .known a { color: var(--text-dim); }
  .known a:hover { color: var(--red); }

  @media (prefers-reduced-motion: reduce) { .door, .door-led, .door-arrow { transition: none; } }
</style>

<script is:inline>
  (function () {
    var lines = document.querySelectorAll('#sub .sub-line');
    if (lines.length < 2) return;
    var pick = Math.floor(Math.random() * lines.length);
    for (var i = 0; i < lines.length; i++) lines[i].hidden = (i !== pick);
  })();
</script>
