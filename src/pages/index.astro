---
import Base from '../layouts/Base.astro';
import PromoBanner from '../components/PromoBanner.astro';
import InstallApp from '../components/InstallApp.astro';
import Search from '../components/Search.astro';
import { DISCOVERY } from '../data/discovery.js';

// Homepage = simple "pick your pain" chooser. Rescue AND prevention, balanced:
// three equal, neutral doors; colour lives only in the LED dots and comes up
// on tap/hover. Emergency is never a permanently red box.
//
// The H1 asks what you want to DO, not what your situation is, and the doors
// are actions rather than states. That is deliberate and it is about who
// actually lands here: DJs mid-crisis arrive on /fix/* and /emergency straight
// from search, so homepage traffic skews COLD (social, word of mouth, someone
// typing the name). A cold visitor does not need sorting by situation, they
// need to see what this place can do for them. Actions tell them; states do not.
//
// The H1 is otherwise FIXED. It is the brand anchor, and a stable headline reads
// as reliability. Personality rotates in the SUBLINE instead: same functional
// facts every time (free, no account), different warmth. The first line renders
// server-side so it works with JavaScript disabled and is what crawlers index.
//
// Sublines are capped at ~52 characters on purpose. The block reserves height
// for the LONGEST one so the doors don't jump when it rotates, so a single
// three-line subline was silently pushing the third door off every small phone.
//
// 2026-07-27, Antonio's homepage review: "Pick a door" told the visitor what
// to do but not why to trust the place. Every subline now leads with the
// credibility claim (real booths, not rewritten manuals) and keeps the two
// functional facts (free, no account) as the closer. Same cap, same rotation.
// "DJ booth", spelled out, in every slogan that mentions the booth: Antonio
// is seeding the phrase for what comes next, the DJ BOOTH BIBLE. Never
// shorten back to plain "booth" in slogans. Still ≤52 chars each.
const SUBLINES = [
  'Real fixes from real DJ booths. Free, no account.',
  "Built by DJs who've been there. Free, no account.",
  'From the DJ booth, not the manual. Free, no account.',
  'Fast answers for real DJ booth problems. Free.',
  'Solved in real DJ booths first. Free, no account.',
];
---
<Base
  title="Save My Gig! | DJ Rescue and Prevention for CDJ, XDJ & USB"
  description="DJ rescue and prevention. In an emergency with a CDJ, XDJ or USB, getting gig-ready, or building a bulletproof setup? Pick your path. Free, no account, step by step."
  path="/"
>

  <main class="landing">
    <!-- "DJ?" becomes the registered visitor's artist name (first word),
         swapped client-side so crawlers and first-timers always see the
         brand line. Guarded to 10 chars: a long name must never wrap the
         H1 and push the third door under the fold. -->
    <h1 class="ask">WHAT DO YOU WANT TO DO, <span class="accent" id="askWho">DJ?</span></h1>
    <p class="sub" id="sub">
      {SUBLINES.map((line, i) => (
        <span class="sub-line" data-sub={i} hidden={i !== 0}>{line}</span>
      ))}
    </p>

    <nav class="doors" aria-label="Choose your path">
      <a class="door d-ready" href="/checklist" data-event="step_completed" data-placement="home_door_checklist">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <!-- "RUN" was answering a question the h1 already asked. The headline
               is "What do you want to do, DJ?", so the doors are the answers
               and do not need to repeat the verb. "NOW" on the emergency door
               stays: that one is not redundancy, it is the only word telling a
               DJ which of the three doors is the 2am one. -->
          <span class="door-title">PRE-GIG CHECKLIST</span>
          <span class="door-desc"><span class="dd-full">Playing soon? Tick it off before you walk out.</span><span class="dd-short">Playing soon? Tick it off first.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <a class="door d-emergency" href="/emergency" data-event="begin_checkout" data-placement="home_door_emergency">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <!-- Antonio, launch refinements 2026-07-27: "mixer" added because the
               no-sound branch behind this door is mixer territory, and "fast"
               dropped because it promised a speed nobody can guarantee. Same
               rule as everywhere else: never write a promise into copy. -->
          <span class="door-title">FIX A PROBLEM NOW</span>
          <span class="door-desc"><span class="dd-full">USB, player or mixer failing. Get playing again.</span><span class="dd-short">USB, player or mixer failing? Fix it.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>

      <a class="door d-prevent" href="/prepare" data-event="step_completed" data-placement="home_door_prevention">
        <span class="door-led" aria-hidden="true"></span>
        <span class="door-body">
          <!-- Reviewed 2026-07-27 per Antonio's homepage audit: "GET
               BULLETPROOF" stays. The title carries the personality and the
               description directly beneath does the explaining, so a
               first-time visitor never sees the title without its meaning
               attached. A plainer title ("PREVENT FAILURES") would be clearer
               alone but weaker as a brand, and it is never alone.
               Second pass, same audit: no COUNT in the promise ("seven rules"
               becomes "mandatory rules") because a count is a snapshot that
               breaks the day a rule is added, and no "USB" because prevention
               now covers players and mixers too. Same anti-snapshot doctrine
               as the content lint. Do not reintroduce a number here. -->
          <span class="door-title">GET BULLETPROOF</span>
          <span class="door-desc"><span class="dd-full">The mandatory rules that make gig failure a non-event.</span><span class="dd-short">Mandatory rules. No more disasters.</span></span>
        </span>
        <span class="door-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </nav>

    <!-- Label history: "Straight to the fix:" promised adjacency to the
         emergency door that the layout does not have. "Common searches:" was
         honest but 16 characters, and on a phone it pushed five links onto a
         third line. "Top fixes:" bought the line back. Antonio's homepage
         review preferred "Popular fixes" (says these are problems DJs hit
         every day, not our editorial picks); measured at 360/375/393px and it
         holds two lines, so the better label wins. If a sixth link is ever
         added, re-measure at 360 first. -->
    <!-- ONE LINE, always (Antonio): the script below measures the row and
         hides links from the end until it fits a single line, the same
         self-measuring pattern as the H1 greeting. Order matters: the links
         most worth keeping come first. -->
    <p class="known dim" id="popularRow">
      <!-- "Popular:" on phones (Antonio): the shorter label buys back the
           width for a third link on the one-line row. -->
      <span class="pf-label-full">Popular fixes:</span><span class="pf-label-short">Popular:</span>
      <span class="pf-item"><a href="/fix/usb-not-recognized-cdj">USB not recognized</a></span><span class="pf-item"> · <a href="/fix/cdj-error-e-8302">E-8302</a></span><span class="pf-item"> · <a href="/fix/playlists-not-showing-cdj"><span class="pf-label-full">Playlists not showing</span><span class="pf-label-short">No playlists</span></a></span><span class="pf-item"> · <a href="/fix/rekordbox-export-failed">Export failed</a></span><span class="pf-item"> · <a href="/fix/exfat-vs-fat32-cdj">exFAT vs FAT32</a></span>
    </p>

    <!-- A REAL search box (Antonio, third pass): it used to be an <a> styled
         as an input that bounced you into the nav overlay, which felt like a
         trick next to the /faq box that searches in place. This is the same
         live component as /faq: focus turns the border red, results appear
         right under the box as you type, no overlay jump. The nav magnifier
         overlay stays for every other page.
         DISCOVERY ROTATION (Antonio's spec): the placeholder is not static,
         it rotates through src/data/discovery.js, mixing categories so a
         visitor who never types still learns the breadth of the site. The
         Popular fixes row above owns the urgent problems; this box owns
         everything else, and the gate (check-discovery.mjs) proves every
         rotating term returns real results and never duplicates that row.
         The static placeholder below is the no-JS fallback only. -->
    <div class="home-srch">
      <Search placeholder="Search anything: no sound, waveforms missing, DJM-900, what is OneLibrary…" />
    </div>

    <PromoBanner exclude="/emergency" />

    <!-- The install offer lives HERE only (Antonio): one page, one look,
         dismissible for good via the X. It reveals below the fold, so the
         doors and their gate stay untouched. -->
    <InstallApp />
  </main>
</Base>

<style>
  .landing { max-width: var(--site-w); margin: 0 auto; padding: 2rem var(--site-pad) 1rem; }
  .ask { font-size: clamp(2rem, 9vw, 3.2rem); margin-bottom: 0.6rem; }
  /* min-height reserves space for the longest rotating subline so the doors
     never jump. Now that every subline is capped at ~52 characters they all fit
     on one line at desktop widths, so reserving two lines was pure dead space
     between the headline and the first door. */
  .sub { color: var(--text-dim); margin-bottom: 1.5rem; max-width: 42rem; text-wrap: balance; min-height: 1.7rem; }
  .sub-line[hidden] { display: none; }

  .doors { display: flex; flex-direction: column; gap: 1rem; }

  /* All three doors are equal and neutral. Colour lives in the LED, and the
     accent only comes up on hover/tap. Rescue and prevention, balanced. */
  .door {
    display: flex; align-items: center; gap: 1.1rem;
    background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.4rem 1.5rem; text-decoration: none; color: var(--text);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.08s ease;
  }
  .door:active { transform: scale(0.995); }

  .door-led {
    flex: 0 0 auto; width: 13px; height: 13px; border-radius: 50%;
    background: var(--text-faint); transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .d-emergency .door-led { background: var(--red); }
  .d-ready .door-led { background: var(--green); }
  .d-prevent .door-led { background: var(--amber); }

  /* One-time staggered outline glow: walks the eye down the three doors.
     Animating opacity on an overlay instead of box-shadow/border-color keeps
     the whole thing on the compositor: no paint, no main-thread work. */
  .door { position: relative; }
  .door::after {
    content: ''; position: absolute; inset: -1px; border-radius: var(--radius);
    pointer-events: none; opacity: 0; will-change: opacity;
    box-shadow: 0 0 22px 1px var(--glow); border: 1px solid var(--glow);
    /* ONE pass on load, then done (Antonio tried repeating at 3s, then 10s,
       then called it: once was right). The stagger walks the eye down the
       three doors and the page goes quiet. */
    animation: doorGlow 1.2s ease-in-out both;
  }
  .d-emergency { --glow: rgba(255,77,46,0.7); }
  .d-ready { --glow: rgba(58,216,132,0.65); }
  .d-prevent { --glow: rgba(217,164,65,0.65); }
  /* Delays follow the doors top to bottom: checklist, emergency, prevention. */
  .d-ready::after { animation-delay: 0.42s; }
  .d-emergency::after { animation-delay: 1.14s; }
  .d-prevent::after { animation-delay: 1.86s; }
  @keyframes doorGlow { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .door::after { animation: none; } }

  .door-body { flex: 1; }
  .door-title {
    display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
    text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 0.25rem; color: var(--text);
  }
  .door-desc { display: block; color: var(--text-dim); font-size: 0.92rem; line-height: 1.45; }
  /* Two lengths, one message. Desktop has room for the full line; phones get a
     short version that lands on ONE line, which keeps the three doors above
     the fold and stops them reading as a wall of grey. Both stay in the HTML,
     so search engines and AI crawlers still read the full text. */
  .dd-short { display: none; }
  .door-arrow { flex: 0 0 auto; font-size: 1.4rem; color: var(--text-faint); transition: color 0.15s ease; }

  /* Colour comes up on interaction, per door. */
  .d-emergency:hover, .d-emergency:active, .d-emergency:focus-visible { border-color: var(--red); }
  .d-emergency:hover .door-led, .d-emergency:active .door-led { box-shadow: 0 0 12px var(--red); }
  .d-emergency:hover .door-arrow, .d-emergency:active .door-arrow { color: var(--red); }

  .d-ready:hover, .d-ready:active, .d-ready:focus-visible { border-color: var(--green); }
  .d-ready:hover .door-led, .d-ready:active .door-led { box-shadow: 0 0 12px rgba(58,216,132,0.7); }
  .d-ready:hover .door-arrow, .d-ready:active .door-arrow { color: var(--green); }

  .d-prevent:hover, .d-prevent:active, .d-prevent:focus-visible { border-color: var(--amber); }
  .d-prevent:hover .door-led, .d-prevent:active .door-led { box-shadow: 0 0 12px rgba(217,164,65,0.7); }
  .d-prevent:hover .door-arrow, .d-prevent:active .door-arrow { color: var(--amber); }

  .known { margin-top: 1.2rem; font-size: 0.9rem; }

  /* All three doors have to be readable on load, on every phone, without
     scrolling. Phones vary too much for one fixed set of numbers (a Galaxy
     S10e is 360x740, an iPhone Pro Max is 430x932), so the vertical rhythm is
     tied to the viewport HEIGHT and the type to the viewport WIDTH. Short
     phones compress, tall phones breathe, and the layout never has to be
     re-tuned per device.

     svh (small viewport height) is the right unit here, not vh: svh is the
     height with the browser's URL bar EXPANDED, which is exactly the state on
     first load. Sizing to vh would fit the doors only after the bar collapses,
     i.e. only after the user already scrolled. Each svh line is preceded by a
     static fallback for browsers that don't support it. */
  @media (max-width: 640px) {
    .landing { padding-top: 1.1rem; }
    .landing { padding-top: clamp(0.6rem, 2svh, 1.5rem); }

    .ask { font-size: clamp(1.7rem, 7.6vw, 2.4rem); margin-bottom: 0.4rem; line-height: 1.06; }

    .sub { font-size: 0.94rem; line-height: 1.5; margin-bottom: 1.1rem; min-height: 2.9rem; }
    .sub { margin-bottom: clamp(0.7rem, 2.2svh, 1.4rem); }

    .doors { gap: 0.7rem; }
    .doors { gap: clamp(0.5rem, 1.5svh, 1rem); }

    .door { padding: 0.95rem 1.05rem; gap: 0.8rem; }
    .door { padding-block: clamp(0.75rem, 2svh, 1.15rem); }

    /* The door title is the loudest thing on a phone, so it leads. It used to
       be 0.96rem, SMALLER than the desktop 1.2rem, which flattened it against
       the 0.85rem description and made the three doors read as one grey block.
       Narrow and short screens step down (rules below) so the longest title
       never wraps and the third door stays above the fold. */
    /* Antonio, second pass: still too small on a phone. Roughly +12% across
       the range: 17.0 -> 19.2px on a 360 Android, 19.2 -> 21.6px on an iPhone
       15/16, 21.5 -> 24.1px on a Pro Max. Desktop is untouched, he likes it. */
    /* Antonio, third pass: on a Pro Max that cap read SUPER big; normal
       iPhone is right. Cap lowered ~10% (1.56 -> 1.4rem = 22.4px): a 390px
       iPhone (21.6px) never reaches it, only the widest phones feel it. */
    .door-title {
      font-size: clamp(1.14rem, calc(7.2vw - 6.5px), 1.4rem);
      margin-bottom: 0.2rem; letter-spacing: -0.015em;
    }
    .door-desc { font-size: clamp(0.79rem, calc(3.4vw + 0.3px), 1rem); line-height: 1.35; }
    .dd-full { display: none; }
    .dd-short { display: inline; }
    .door-arrow { font-size: 1.2rem; }
    .known { margin-top: 1.15rem; font-size: 0.85rem; }
  }

  /* Wide enough that even the longest subline fits one line, so stop reserving
     two. That reserved band was dead space between the headline and door one. */
  @media (min-width: 401px) and (max-width: 640px) {
    .sub { min-height: 1.6rem; }
  }

  /* Very short screens (older/compact phones in landscape-ish aspect, or a
     phone with a large accessibility font). Trade headline size for the third
     door: the choice matters more than the typography. */
  @media (max-width: 640px) and (max-height: 700px) {
    .ask { font-size: clamp(1.5rem, 6.8vw, 1.95rem); }
    .sub { font-size: 0.88rem; min-height: 2.5rem; }
    .door-title { font-size: 1.2rem; }
    .door-desc { font-size: 0.82rem; }
    /* Budget Androids (360x740 and similar) are the tightest real case, and
       they are common in Brazil. Tighter door padding keeps the third door
       comfortably above the fold at the bigger title size. */
    .door { padding-block: clamp(0.6rem, 1.6svh, 0.95rem); }
  }

  /* Shortest phones still in real use. Everything tightens one more notch so
     the third door clears the consent banner on a first visit. */
  @media (max-width: 640px) and (max-height: 620px) {
    .landing { padding-top: 0.4rem; }
    .ask { font-size: clamp(1.38rem, 6.2vw, 1.7rem); margin-bottom: 0.28rem; }
    .sub { font-size: 0.84rem; margin-bottom: 0.6rem; min-height: 2.2rem; line-height: 1.42; }
    .doors { gap: 0.34rem; }
    .door { padding-block: 0.56rem; }
    .door-title { font-size: 1.1rem; }
    .door-desc { font-size: 0.8rem; line-height: 1.33; }
  }
  .known a { color: var(--text-dim); }
  .known a:hover { color: var(--red); }
  .pf-label-short { display: none; }
  @media (max-width: 640px) {
    .pf-label-full { display: none; }
    .pf-label-short { display: inline; }
  }
  /* Homepage flavour of the shared search component: transparent on the page
     background (per Antonio, it reads as part of the page, not a widget) and
     full landing width, unlike the 34rem default. */
  .home-srch { margin-top: 0.9rem; }
  .home-srch :global(.srch) { max-width: none; }
  .home-srch :global(.srch-box) { background: transparent; position: relative; }
  /* Fourth stop of the one-time load glow (Antonio): the eye walks the three
     doors, then lands here. Neutral white and a notch softer than the doors,
     because this is the catch-all, not a fourth door. Same one-pass rule. */
  .home-srch :global(.srch-box)::after {
    content: ''; position: absolute; inset: -1px; border-radius: var(--radius);
    pointer-events: none; opacity: 0; will-change: opacity;
    box-shadow: 0 0 18px 1px rgba(243, 241, 236, 0.35);
    border: 1px solid rgba(243, 241, 236, 0.55);
    animation: doorGlow 1.2s ease-in-out both;
    animation-delay: 2.58s;
  }
  @media (prefers-reduced-motion: reduce) { .home-srch :global(.srch-box)::after { animation: none; } }
  @media (max-width: 640px) {
    .home-srch { margin-top: 0.8rem; }
    .home-srch :global(.srch-input) { font-size: 16px; }
  }
  /* The rotating discovery hint: a span painted over the input where the
     placeholder would sit (real placeholders cannot animate). JS-created, so
     :global. Hidden the moment the input has focus or text. */
  .home-srch :global(.disc-hint) {
    position: absolute; top: 50%; transform: translateY(-50%);
    left: calc(0.85rem + 17px + 0.6rem); right: 2.2rem;
    color: var(--text-faint); font-size: 16px; line-height: 1.2;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    pointer-events: none; opacity: 1; transition: opacity 0.35s ease;
  }
  .home-srch :global(.disc-hint.out) { opacity: 0; }

  @media (prefers-reduced-motion: reduce) { .door, .door-led, .door-arrow { transition: none; } }
</style>

<script is:inline>
  (function () {
    var lines = document.querySelectorAll('#sub .sub-line');
    if (lines.length >= 2) {
      var pick = Math.floor(Math.random() * lines.length);
      for (var i = 0; i < lines.length; i++) lines[i].hidden = (i !== pick);
    }
    // Registered visitors with an artist name get greeted by it. textContent
    // only (never HTML), first word. The fit check is the LAYOUT ITSELF
    // (Antonio's "characters or pixels" call): try the name, measure whether
    // the H1 grew a line, revert to the brand line if it did. So a name shows
    // wherever it genuinely fits and can never push the doors under the fold.
    try {
      var who = localStorage.getItem('SMG_ARTIST');
      var el = document.getElementById('askWho');
      var h1 = document.querySelector('.ask');
      if (who && el && h1) {
        who = who.split(/\s+/)[0];
        if (who.length >= 2 && who.length <= 14) {
          var before = h1.getBoundingClientRect().height;
          el.textContent = who.toUpperCase() + '?';
          if (h1.getBoundingClientRect().height > before + 1) el.textContent = 'DJ?';
        }
      }
    } catch (e) { /* storage blocked, brand line stays */ }
    // Tapping the search box HANDS OFF to the top overlay (Antonio): same
    // full content width, results appear at the top of the screen where the
    // list view breathes, instead of a dropdown pinned low on the page. The
    // overlay opener focuses its own input, so typing lands there. Without
    // JS the box is still a working inline search via the component itself.
    var homeIn = document.querySelector('.home-srch .srch-input');
    var navBtn = document.getElementById('navSearchBtn');
    if (homeIn && navBtn) homeIn.addEventListener('focus', function () { navBtn.click(); });

    // Popular fixes: ONE line, never two (Antonio). The layout measures
    // itself: hide links from the end until the row height is a single
    // line. Re-run on resize/rotation. No-JS shows all five, which only
    // wraps on phones, an acceptable fallback.
    var row = document.getElementById('popularRow');
    if (row) {
      var fitRow = function () {
        var items = row.querySelectorAll('.pf-item');
        for (var i = 0; i < items.length; i++) items[i].hidden = false;
        var oneLine = parseFloat(getComputedStyle(row).lineHeight) * 1.5;
        for (var j = items.length - 1; j > 0 && row.getBoundingClientRect().height > oneLine; j--) {
          items[j].hidden = true;
        }
      };
      fitRow();
      var rT;
      window.addEventListener('resize', function () { clearTimeout(rT); rT = setTimeout(fitRow, 150); });
    }
  })();
</script>

<script is:inline define:vars={{ POOL: DISCOVERY }}>
  // Discovery rotation (Antonio's spec): the search box quietly showcases
  // the breadth of the site. Terms come from src/data/discovery.js (gate-
  // checked: every one returns real results). Categories are interleaved
  // round-robin so two of a kind never show consecutively. The hint is a
  // painted span, not the placeholder attribute (placeholders cannot fade);
  // the static placeholder stays as the no-JS fallback and is cleared here.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var box = document.querySelector('.home-srch .srch-box');
    var input = document.querySelector('.home-srch .srch-input');
    if (!box || !input) return;

    // Shuffle within each category, then round-robin across categories.
    var cats = Object.keys(POOL).map(function (k) {
      var a = POOL[k].slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = a[i]; a[i] = a[j]; a[j] = t;
      }
      return a;
    }).filter(function (a) { return a.length; });
    var seq = [];
    for (var round = 0; cats.some(function (a) { return round < a.length; }); round++) {
      for (var c = 0; c < cats.length; c++) if (round < cats[c].length) seq.push(cats[c][round]);
    }
    if (!seq.length) return;

    var hint = document.createElement('span');
    hint.className = 'disc-hint';
    hint.setAttribute('aria-hidden', 'true');
    var at = 0;
    hint.textContent = 'Search anything: ' + seq[0];
    input.placeholder = '';
    box.appendChild(hint);

    function idle() { return document.activeElement !== input && !input.value; }
    input.addEventListener('focus', function () { hint.hidden = true; });
    input.addEventListener('blur', function () { if (!input.value) hint.hidden = false; });
    input.addEventListener('input', function () { hint.hidden = !!input.value || document.activeElement === input; });

    setInterval(function () {
      if (document.hidden || !idle()) return;
      hint.classList.add('out');
      setTimeout(function () {
        at = (at + 1) % seq.length;
        hint.textContent = 'Search anything: ' + seq[at];
        hint.classList.remove('out');
      }, 380);
    }, 3600);
  })();
</script>
