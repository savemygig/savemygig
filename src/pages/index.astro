---
import Base from '../layouts/Base.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does CDJ Error E-8302 mean?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Error E-8302 on Pioneer CDJs means the player cannot read the data on your USB drive, usually a corrupt Rekordbox database or an unsupported file system. It can often be fixed on-site by re-exporting from Rekordbox or reformatting the drive as FAT32 with an MBR partition map.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why is my USB not recognized on a CDJ or XDJ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The most common causes are: the drive is formatted as NTFS or exFAT instead of FAT32, the partition map is GPT instead of MBR, the Rekordbox export is corrupt, or the USB hardware itself is failing. Save My Gig walks you through the fastest fix depending on how much time you have before you play.',
      },
    },
    {
      '@type': 'Question',
      name: 'How should I format a USB drive for Pioneer CDJs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Format the drive as FAT32 with a Master Boot Record (MBR) partition scheme. Use a quality 32-64 GB drive and export your music with Rekordbox in Export mode.',
      },
    },
  ],
};
---
<Base
  title="Save My Gig! | CDJ, XDJ & USB Emergency Help for DJs"
  description="USB failed on a CDJ or XDJ? Error E-8302? Rekordbox export problem? Save My Gig walks you through the exact steps to get music playing again, fast, free, step by step."
  path="/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <header class="hero">
    <img src="/images/pioneer-cdj-2000-cdj-3000-xdj-usb-not-detected-error.webp" alt="Pioneer CDJ setup showing USB not detected error" class="hero-img" fetchpriority="high" />
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1>SAVE MY <span class="accent">GIG!</span></h1>
      <p style="font-size:clamp(15px,3.5vw,17px);color:#f5f5f5;line-height:1.5;margin-bottom:35px">
        Emergency guidance for DJs when USB drives fail, Rekordbox breaks,
        or CDJ/XDJ players refuse to cooperate.
      </p>

      <nav class="action-stack" aria-label="Primary actions">
        <a href="/emergency" class="btn-heartbeat" data-event="begin_checkout" data-placement="home_hero">
          <span class="led led-g" aria-hidden="true"></span>
          START EMERGENCY MODE
        </a>

        <div class="alert-card" role="note">
          <div style="font-size:20px" aria-hidden="true">⚠️</div>
          <div>USB not responding minutes before your set? Stay calm. This site exists exactly for this moment, free, no account, step by step.</div>
        </div>
      </nav>
    </div>
  </header>

  <main style="max-width:860px;margin:auto;padding:10px 20px 40px">

    <section class="section" style="margin-top:2rem">
      <h2 style="font-size:18px;text-transform:uppercase;letter-spacing:1px;margin:0 0 16px 0;border-bottom:1px solid #333;padding-bottom:8px">The errors that kill gigs</h2>
      <div class="grid grid-2">
        <a class="pad pad-red" href="/fix/usb-not-recognized-cdj">
          <div class="pad-header"><div class="led led-r"></div><div class="pad-title" style="font-size:16px">USB NOT RECOGNIZED</div></div>
          <div class="pad-desc">The player won't see your drive at all. The fastest checks, in order.</div>
        </a>
        <a class="pad pad-red" href="/fix/cdj-error-e-8302">
          <div class="pad-header"><div class="led led-r"></div><div class="pad-title" style="font-size:16px">ERROR E-8302</div></div>
          <div class="pad-desc">"Cannot read data." Usually a corrupt database, fixable on-site.</div>
        </a>
        <a class="pad pad-yellow" href="/fix/rekordbox-export-failed">
          <div class="pad-header"><div class="led led-y"></div><div class="pad-title" style="font-size:16px">EXPORT FAILED</div></div>
          <div class="pad-desc">Rekordbox export won't finish, or finished but the player shows nothing.</div>
        </a>
        <a class="pad pad-yellow" href="/fix/emergency-loop-mode">
          <div class="pad-header"><div class="led led-y"></div><div class="pad-title" style="font-size:16px">EMERGENCY LOOP</div></div>
          <div class="pad-desc">The player loops to protect the audio. What it means, what to do.</div>
        </a>
      </div>
      <p style="margin-top:1rem"><a href="/fix/format-usb-for-cdj" class="dim">→ How to format a USB for CDJ (FAT32 + MBR), step by step</a></p>
    </section>

    <section class="section panel">
      <h3 style="margin-bottom:0.75rem">Works with</h3>
      <p class="dim" style="margin-bottom:0">
        Pioneer CDJ-2000 / 2000NXS / 2000NXS2 · CDJ-3000 / 3000X ·
        XDJ-1000 / 1000MK2 · XDJ-700 · XDJ-RX / RX2 / RX3 · XDJ-XZ ·
        and most Rekordbox-compatible players.
      </p>
    </section>

    <section class="section panel">
      <h3 style="margin-bottom:0.75rem">The safe setup</h3>
      <ul class="checklist">
        <li>Format: <span class="mono">FAT32</span> · Partition map: <span class="mono">MBR</span></li>
        <li>Capacity: 32-64 GB from a quality brand</li>
        <li>Exported with Rekordbox in <span class="mono">EXPORT</span> mode</li>
        <li>Always carry a second, identical USB - <a href="/prepare">see the prevention checklist</a></li>
      </ul>
    </section>

    <section class="section center">
      <h2 style="margin-bottom:1rem">Never live this night again</h2>
      <p class="dim" style="max-width:34rem;margin:0 auto 1.5rem">
        USB failures aren't bad luck, they're a missing system.
        Set it up once and this site becomes a page you never need.
      </p>
      <a href="/prepare" class="btn-quiet" style="max-width:22rem;margin:0 auto" data-event="step_completed" data-step="prepare_click" data-placement="home">
        🛡 GET THE PREVENTION SYSTEM
      </a>
    </section>

    <p class="dim center" style="font-size:0.9rem">
      A personal side project built by a DJ who's been there.
      Free, no account, no tricks. <a href="/about">The story →</a>
    </p>
  </main>
</Base>
