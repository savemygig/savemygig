---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT
---
<Tunnel title="Repair the Device | Save My Gig!" status="Quick_Fix">
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Step 3</div>
  <h2 style="margin-bottom:1rem">Refresh the export</h2>

      <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px" aria-hidden="true">⚠️</div>
    <div>
      <strong>Check your Collection first.</strong> If this is a borrowed or
      venue computer and the Collection is empty, do NOT delete anything. There
      would be nothing to put back. Use the music you just backed up instead.
    </div>
  </div>

  <ul class="checklist">
    <li>In Rekordbox, on the <strong>device</strong>: delete tonight's playlists.</li>
    <li>Drag tonight's playlists from your collection onto the device again (fresh sync).</li>
    <li>Wait for the sync to finish completely.</li>
    <li>Eject with the <strong>eject button in Rekordbox</strong>, never pull the drive.</li>
  </ul>

  <p class="question">Did the sync finish without errors?</p>

  <Choice step="qf_repair"
    a={{ href: '/protocol/quick-fix/verify', label: 'YES, SYNC DONE' }}
    b={{ href: '/protocol/quick-fix/format', label: 'NO, SYNC ERRORS', desc: 'Deeper corruption. We rebuild the drive clean.' }}
  />
</Tunnel>
