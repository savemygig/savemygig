---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT
---
<Tunnel title="Rekordbox Check | Save My Gig!" status="Quick_Fix">
  <div class="review-flag">DRAFT — review pending.</div>
  <div class="step-label">Step 2</div>
  <h2 style="margin-bottom:1rem">Open Rekordbox in EXPORT mode</h2>

  <ul class="checklist">
    <li>Open Rekordbox with the USB connected.</li>
    <li>Top-left mode selector: <span class="mono">EXPORT</span>.</li>
    <li>Look for your USB under <strong>Devices</strong> in the left sidebar.</li>
  </ul>

  <p class="question">Does the device show up with your playlists?</p>

  <Choice step="qf_rb_check"
    a={{ href: '/protocol/quick-fix/repair', label: 'YES — DEVICE + PLAYLISTS SHOW' }}
    b={{ href: '/protocol/quick-fix/backup', label: 'NO — MISSING OR ERRORS', desc: 'The database is corrupt. We rebuild it clean.' }}
  />
</Tunnel>
