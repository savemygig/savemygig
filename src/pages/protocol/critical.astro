---
import Tunnel from '../../layouts/Tunnel.astro';
import Choice from '../../components/Choice.astro';

// Entry to the critical branch. This asks what is WRONG before it asks what
// equipment you have. The previous order sent a DJ whose drive mounted but
// showed no playlists straight down the format route, destroying a healthy
// drive to fix something FOLDER view solves in 15 seconds.
---
<Tunnel title="Critical Protocol | Save My Gig!" status="Critical_Path" red>
  <h2 style="margin-bottom:0.75rem">Goal right now: play a set.</h2>
  <p class="dim" style="margin-bottom:1.5rem">Not fix the USB. That comes after the gig.</p>

  <p class="question">On the player: does the USB show up at all?</p>

  <Choice step="critical_symptom"
    a={{ href: '/protocol/critical/symptom', label: 'IT SHOWS UP' }}
    b={{ href: '/protocol/critical/no-laptop', label: 'NOTHING - IT IS NOT DETECTED', desc: 'We start with the free checks in the booth.' }}
  />

  <!-- Liability padding carrying no instruction, on two screens. The real
       disclaimer already sits in the tunnel footer on every one of these. -->


  <p style="margin-top:1.25rem"><a href="/emergency" class="dim" style="text-decoration:none">&larr; Back to triage</a></p>
</Tunnel>
