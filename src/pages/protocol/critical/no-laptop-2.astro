---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT — Antonio review pending
---
<Tunnel title="No Computer — Restart Player | Save My Gig!" status="Critical · No Laptop" red>
  <div class="review-flag">DRAFT — review pending.</div>
  <div class="step-label">Step 2 of 3</div>
  <h2 style="margin-bottom:1rem">Restart the player</h2>

  <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px">⚠️</div>
    <div><strong>Only if nobody is playing on this player right now.</strong> If another DJ is on, skip to the next step.</div>
  </div>

  <ul class="checklist">
    <li>Remove your USB first — press <span class="mono">USB STOP</span>, wait for the light to stop blinking.</li>
    <li>Power the player off. Wait 20 seconds.</li>
    <li>Power back on, let it fully boot.</li>
    <li>Insert the USB and wait — some drives take 30+ seconds to mount.</li>
  </ul>

  <p class="question">Does the player read the USB now?</p>

  <Choice step="no_laptop_2"
    a={{ href: '/saved?path=critical&branch=no_laptop', label: "YES — IT'S READING", event: 'outcome_reached', data: { outcome: 'saved', path: 'critical' } }}
    b={{ href: '/protocol/critical/no-laptop-3', label: 'NO — STILL DEAD' }}
  />
</Tunnel>
