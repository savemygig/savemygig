---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
---
<Tunnel title="Second USB? | Save My Gig!" status="Critical · Laptop" red>
  <div class="step-label">Decision point</div>
  <h2 style="margin-bottom:1rem">One more question</h2>

  <p class="question">Do you have another USB you can use right now?</p>
  <p class="dim">If yes, we use that one and your original stays untouched. Safer and faster.</p>

  <Choice step="second_usb"
    a={{ href: '/protocol/critical/second-usb-format', label: 'YES - I HAVE ANOTHER USB' }}
    b={{ href: '/protocol/critical/copy', label: 'NO - I ONLY HAVE THIS ONE' }}
  />
</Tunnel>
