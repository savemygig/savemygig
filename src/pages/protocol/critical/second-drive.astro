---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';

// THE FASTEST FIX ON THE SITE, AND IT WAS MISSING.
//
// Rule one on /prepare is "Two identical USBs, every gig. Same export on both.
// One in the bag, one in your pocket." Both DJ-education sources in
// claude/top-10-dj-problems-2026-07-27.md name carrying two drives as the
// primary defence. Yet the rescue used to go booth checks -> restart the
// player -> survival mode ("borrow a USB from another DJ") without EVER asking
// whether the DJ was carrying the backup we told them to bring.
//
// It sits here, after the free booth checks and BEFORE restarting a player,
// because a swap is ten seconds and a player restart is a minute you may not
// have (and is impossible if someone is playing on it).
---
<Tunnel title="Your Second USB | Save My Gig!" status="Critical · Fastest fix" red>
  <div class="step-label">10 seconds</div>
  <h2 style="margin-bottom:1rem">Your backup drive</h2>

  <p class="dim" style="margin-bottom:1.25rem">
    If you carry two, this is over. Swap it in and play.
  </p>

  <p class="question">Do you have your second USB with you?</p>

  <Choice step="second_drive"
    a={{ href: '/saved?path=critical&branch=second_drive', label: 'YES, I HAVE IT', desc: 'Load it and play. Deal with the other drive tomorrow.', event: 'outcome_reached', data: { outcome: 'saved', path: 'critical' } }}
    b={{ href: '/protocol/critical/no-laptop-2', label: 'NO, ONLY THIS ONE' }}
  />
</Tunnel>
