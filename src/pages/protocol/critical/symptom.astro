---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';

// Symptom triage. The flow used to open with "do you have a computer?", a
// logistics question, and never asked what was actually wrong. That routed the
// most common 2026 failure (mounts, but no playlists) into the format funnel.
---
<Tunnel title="What is the player showing? | Save My Gig!" status="Critical_Path" red>
  <div class="step-label">Diagnostic</div>
  <h2 style="margin-bottom:1rem">The drive is being read</h2>

  <p class="dim" style="margin-bottom:1.25rem">
    That is good news. It rules out the worst case. Now we find out what the
    player cannot read.
  </p>

  <p class="question">Can you see your playlists on the player?</p>

  <Choice step="symptom"
    a={{ href: '/protocol/critical/folder-view', label: 'NO - MY PLAYLISTS ARE GONE', desc: 'Very common, and usually a 15-second fix.' }}
    b={{ href: '/protocol/critical/have-computer', label: "PLAYLISTS SHOW, TRACKS WON'T LOAD", desc: 'Error codes, or tracks that refuse to play.' }}
  />
</Tunnel>
