---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT - Antonio review pending
---
<Tunnel title="Format the Second USB | Save My Gig!" status="Critical · Second USB" red>
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Step 1 of 2</div>
  <h2 style="margin-bottom:1rem">Format the second USB</h2>

  <p>Your original drive stays untouched. We prepare the second drive for the CDJ.</p>

  <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px">⚠️</div>
    <div><strong>This erases everything on the SECOND drive.</strong> Make sure nothing important is on it.</div>
  </div>

  <ul class="checklist">
    <li>Plug the <strong>second</strong> USB into the computer.</li>
    <li>Right-click → <strong>Format</strong> (or Disk Utility on Mac).</li>
    <li>Format: <span class="mono">FAT32</span> · Scheme: <span class="mono">MBR</span> · Quick format: OK</li>
  </ul>

  <p class="question">Is the second USB formatted?</p>

  <Choice step="second_usb_format"
    a={{ href: '/protocol/critical/second-usb-copy', label: 'YES - FORMATTED' }}
    b={{ href: '/protocol/critical/copy', label: "NO - IT WON'T FORMAT", desc: 'Back to plan A: temporary copy with your original drive.' }}
  />
</Tunnel>
