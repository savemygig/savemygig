---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT - Antonio review pending
---
<Tunnel title="Last Options | Save My Gig!" status="Critical · Fallback" red>
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Fallback</div>
  <h2 style="margin-bottom:1rem">One thing left before survival mode</h2>

  <!-- Was two bullets, the first being "try the other player or the other USB
       slot", offered to someone five screens deep who was told on screen one
       that we assume they did exactly that. Contradicting our own assumed line
       is worse than never having written it. -->
  <ul class="checklist">
    <li><strong>Re-do the format once</strong>, choosing <span class="mono">FAT32</span> explicitly (not exFAT) and <span class="mono">MBR</span>. A GPT drive is a common cause of "formatted but unreadable".</li>
  </ul>

  <p class="question">Is it reading now?</p>

  <Choice step="fallback"
    a={{ href: '/saved?path=critical&branch=fallback', label: "YES - I'M PLAYING", event: 'outcome_reached', data: { outcome: 'saved', path: 'critical' } }}
    b={{ href: '/protocol/critical/no-laptop-3', label: 'NO - SURVIVAL MODE' }}
  />
</Tunnel>
