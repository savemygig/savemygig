---
import Tunnel from '../../../layouts/Tunnel.astro';
---
<Tunnel title="Step 2 — Prepare the USB | Save My Gig!" status="Critical_Path · Recovery" red>
  <div class="step-label">Step 2 of 5</div>
  <h2 style="margin-bottom:1rem">Prepare the USB</h2>

  <p>Your files are now temporarily safe on this computer.</p>

  <div class="panel panel-danger">
    <p style="margin:0">⚠️ <strong>The next step will ERASE your USB.</strong> This is irreversible. Only the tracks you copied to the computer will remain.</p>
  </div>

  <p>You are about to format the USB so it can be read again by CDJs.</p>

  <p class="question">Are you ready to erase the USB and continue?</p>

  <a href="/protocol/critical/format" class="btn btn-go" data-event="step_completed" data-step="erase_consent" data-answer="yes">
    🟢 Yes — erase the USB and continue
  </a>
  <a href="/protocol/critical/no-erase" class="btn btn-stop" data-event="step_completed" data-step="erase_consent" data-answer="no">
    🔴 No — stop here
  </a>
</Tunnel>
