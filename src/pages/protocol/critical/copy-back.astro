---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
---
<Tunnel title="Step 4 - Copy Music Back | Save My Gig!" status="Critical · Recovery" red>
  <div class="step-label">Step 4 of 5</div>
  <h2 style="margin-bottom:1rem">Copy music back to the USB</h2>

    <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px">⚠️</div>
    <div><strong>Do not remove the USB whilst copying.</strong> Interrupting this step may cause data loss.</div>
  </div>

  <p class="dim">Only what you need to play tonight.</p>

  <p class="question">Are the tracks now on the USB?</p>

  <Choice step="copy_back"
    a={{ href: '/protocol/critical/load', label: 'YES - TRACKS ARE ON USB' }}
    b={{ href: '/protocol/critical/fallback', label: "NO - IT'S NOT WORKING" }}
  />
</Tunnel>
