---
import Tunnel from '../../../layouts/Tunnel.astro';
import {
  RUNLIST, RUNLIST_HEAD, RUNLIST_ASSUMED, RUNLIST_NEVER, RUNLIST_LAST_RESORT,
} from '../../../data/runlist.js';

// THE SIX MOVES. NOT A DECISION TREE, AND NOT A TUTORIAL EITHER.
//
// Antonio pushed this one step further than the first version and he is right:
// a DJ with ten minutes is not reading, they are REMEMBERING. So the screen is
// built to be recognised, not consumed. Six words at a size you can read from
// arm's length in a dark booth, one line of jog text each, and every word of
// explanation folded away behind a tap for the one person who needs it.
//
// The list is deliberately six and not ten. Ten is a document. Six is a thing
// you can still recite with a room watching you.
//
// The list itself lives in src/data/runlist.js because it also has to appear,
// word for word, on the printable card and in prevention. If the wording drifts
// between surfaces the DJ never memorises it, and memorising it is the whole
// point.
---
<Tunnel title="The Six Moves | Save My Gig!" status="Critical · Do this now" red srHeading="Six moves, in order, until it plays">
  <!-- NOT "do not panic" and NOT "stay calm". Telling a working DJ to calm down
       is the same insult as telling them to try the other deck: it assumes they
       are losing it. They are not, they are working. State what is left. -->
  <h2 style="margin-bottom:0.5rem">Four moves you have not tried.</h2>
  <p class="dim" style="margin-bottom:0.9rem">{RUNLIST_HEAD}</p>
  <p class="assumed">{RUNLIST_ASSUMED}</p>

  <ol class="moves">
    {RUNLIST.map((s) => (
      <li>
        <span class="move-verb">{s.verb}</span>
        <span class="move-action">{s.action}</span>
        <details class="move-more">
          <summary>Why, and how</summary>
          <p>{s.detail}</p>
        </details>
      </li>
    ))}
  </ol>

  <div class="alert-card" style="margin:1.6rem 0 1.2rem">
    <div style="font-size:20px" aria-hidden="true">⚠️</div>
    <div>{RUNLIST_NEVER}</div>
  </div>

  <!-- Deliberately NOT numbered. It is not a move, it is what is left when the
       moves are gone, and it depends on a cable that lives in prevention. -->
  <details class="move-more last-resort">
    <summary>{RUNLIST_LAST_RESORT.title}</summary>
    <p>{RUNLIST_LAST_RESORT.body}</p>
  </details>

  <nav class="pad-grid" aria-label="What next">
    <a href="/saved?path=critical&branch=runlist" class="pad pad-green" data-event="outcome_reached" data-outcome="saved" data-path="critical">
      <div class="pad-header">
        <div class="led led-g"></div>
        <div class="pad-title">I AM PLAYING</div>
      </div>
    </a>
    <a href="/protocol/critical" class="pad pad-neutral" data-event="step_completed" data-step="runlist_to_tree">
      <div class="pad-header">
        <div class="led led-n"></div>
        <div class="pad-title">NOTHING WORKED, AND I HAVE TIME</div>
      </div>
      <div class="pad-desc">Step by step diagnosis, one question at a time.</div>
    </a>
  </nav>

  <p class="tunnel-note" style="margin-top:1.6rem">
    None of this is needed by the DJ who walked in with a cloned second drive in
    the other pocket. That version of tonight is ten seconds long.
    <a href="/prepare">The prevention rules</a>.
  </p>
</Tunnel>

<style>
  /* Sized to be READ AT ARM'S LENGTH IN A DARK BOOTH. The verb is the memory
     hook and carries the weight; the action line is a jog; the detail is folded
     away so it can never compete with either. */
  /* .assumed is in global.css: it is house style now, not one page's trick. */
  .moves { list-style: none; counter-reset: mv; margin: 0; padding: 0; }
  .moves li {
    counter-increment: mv;
    position: relative;
    padding: 1rem 0 1rem 3rem;
    border-bottom: 1px solid var(--edge-soft);
  }
  .moves li:last-child { border-bottom: none; }
  .moves li::before {
    content: counter(mv);
    position: absolute;
    left: 0;
    top: 0.95rem;
    width: 2.15rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-faint);
  }
  .move-verb {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 7vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .move-action {
    display: block;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--text-dim);
  }
  /* .move-more is in global.css: two pages use it now, and a shared class in a
     page's scoped block is exactly the bug that shipped twice today. */
  .last-resort { margin: 0 0 1.6rem; }
  .last-resort > summary { text-transform: none; letter-spacing: 0; font-size: 0.88rem; }
</style>
