---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
---
<Tunnel title="Files Are Visible | Save My Gig!" status="Critical · Laptop" red>
  <div class="step-label">Decision point</div>
  <h2 class="accent" style="margin-bottom:1rem">FILES ARE VISIBLE</h2>

  <p>Your music is still there.</p>

  <!-- A consent card that named no risk. The DJ was being asked to agree to
       something we would not tell them. Name the actual consequence, or do not
       show a warning at all. -->
  <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px" aria-hidden="true">⚠️</div>
    <div>
      <strong>You will erase this drive.</strong> Anything that does not copy
      off cleanly first is gone until you can work on it properly at home.
    </div>
  </div>

  <p class="question">Are you willing to temporarily copy your files to this computer and erase your USB so you can play?</p>

  <Choice step="risk_consent"
    a={{ href: '/protocol/critical/second-usb', label: 'YES - TEMPORARY COPY IS OK' }}
    b={{ href: '/protocol/critical/no-erase', label: "NO - I CAN'T RISK THAT" }}
  />
</Tunnel>
