---
import Tunnel from '../../layouts/Tunnel.astro';
import { TREE } from '../../data/emergency-tree.js';
import {
  RUNLIST, RUNLIST_HEAD, RUNLIST_ASSUMED, RUNLIST_NEVER, RUNLIST_LAST_RESORT,
} from '../../data/runlist.js';

// THE TUNNEL RENDERER. Every emergency screen is generated from one node in
// src/data/emergency-tree.js (see that file's header for the node model and
// the architecture doc in project memory). This file owns the LOOK of a
// screen; the tree owns the FLOW. Neither can drift from the other, and
// scripts/check-tree.mjs proves the flow's integrity in the gate.
//
// The one-question rule (Antonio, 2026-07-28): every screen answers exactly
// one question or requests exactly one action. That is enforced here
// structurally: a node renders ONE question and ONE pad group, nothing else.
//
// The pads mirror components/Choice.astro (kept for non-tunnel pages) but
// honor per-option tones from the data, which Choice's a/b green/red
// convention cannot express (e.g. a time fork where neither answer is the
// "good" one renders neutral).

export function getStaticPaths() {
  // Screens that instruct or consent to formatting, erasing or deleting. Only
  // these print the data-destruction warning at the foot (polish audit C5,
  // 2026-08-03). Kept HERE rather than in the tree so emergency-tree.js stays
  // untouched under the launch freeze: this is presentation, not flow.
  // Declared inside getStaticPaths because Astro hoists this function out of
  // the frontmatter scope, so a module-level const is not visible to it.
  // If you add a destructive screen, add its id here.
  const RISK_NODES = new Set([
    'rebuild/risk',
    'rebuild/erase',
    'rebuild/format',
    'rebuild/second-format',
    'export/erase',
    'export/format',
    'export/fresh',
  ]);
  return Object.keys(TREE).map((id) => ({
    params: { slug: id },
    props: { node: TREE[id], risk: RISK_NODES.has(id) },
  }));
}

const { node, risk } = Astro.props;

const toneOf = (o, i) => {
  if (o.tone) return o.tone;
  if (node.neutral || node.options.length > 2) return 'neutral';
  return i === 0 ? 'green' : 'red';
};
const padClass = (t) => (t === 'green' ? 'pad-green' : t === 'red' ? 'pad-red' : 'pad-neutral');
const ledClass = (t) => (t === 'green' ? 'led-g' : t === 'red' ? 'led-r' : 'led-n');
const hrefOf = (to) => (to.startsWith('/') ? to : `/protocol/${to}`);
const answerKey = (i) => ['a', 'b', 'c', 'd'][i];
const dataAttrs = (o, i) => {
  const out = {
    'data-event': o.event ?? 'step_completed',
    'data-step': (o.data && o.data.step) ?? node.step ?? 'step',
    'data-answer': answerKey(i),
  };
  for (const [k, v] of Object.entries(o.data ?? {})) if (k !== 'step') out[`data-${k}`] = v;
  return out;
};
---
<Tunnel
  title={`${node.title} | Save My Gig!`}
  status={node.status}
  red={node.red}
  heading={node.srHeading}
  risk={risk}
>
  {node.draft && <div class="review-flag">DRAFT, review pending.</div>}
  {node.label && <div class="step-label">{node.label}</div>}
  <h2 class={node.headingClass} style="margin-bottom:1rem" set:html={node.heading} />

  {node.moves ? (
    <Fragment>
      <p class="dim" style="margin-bottom:0.9rem">{RUNLIST_HEAD}</p>
      <p class="assumed">{RUNLIST_ASSUMED}</p>
      <ol class="moves">
        {RUNLIST.map((s) => (
          <li>
            <span class="move-verb">{s.verb}</span>
            <span class="move-action">{s.action}</span>
            <details class="move-more">
              <summary>Why, and how</summary>
              <p>{s.detail}</p>
            </details>
          </li>
        ))}
      </ol>
      {/* The emoji is gone, 2026-08-03. Every OTHER alert card in the tunnel
          stopped rendering one in the polish sprint, under the design system
          rule that says monochrome stroke icons always; this card was
          hand written rather than tree driven, so the sweep missed it and it
          became the only emoji left in the flow. The card's red rule and tint
          already carry the weight. */}
      <div class="alert-card" style="margin:1.6rem 0 1.2rem">
        <div>{RUNLIST_NEVER}</div>
      </div>
      <details class="move-more last-resort">
        <summary>{RUNLIST_LAST_RESORT.title}</summary>
        <p>{RUNLIST_LAST_RESORT.body}</p>
      </details>
    </Fragment>
  ) : (
    node.blocks.map((b) =>
      b.t === 'check' ? (
        <ul class="checklist">{b.items.map((it) => <li set:html={it} />)}</ul>
      ) : b.t === 'alert' ? (
        /* The emoji (⚠️ and 💡) is deliberately NOT rendered any more, polish
           sprint 2026-08-03. The design system says monochrome stroke icons
           always, and emoji were stripped from /gear and /files-lost headers
           under that rule; the tunnel was exempted by accident. The card's red
           rule and tint already carry the weight, and a lightbulb sitting in a
           danger-coloured box was telling two different stories at once. The
           emoji stays in the tree data, unused, so nothing in the frozen flow
           had to change to remove it. */
        <div class="alert-card" style="margin-bottom:1.25rem">
          <div set:html={b.html} />
        </div>
      ) : b.t === 'details' ? (
        <details class="move-more" style="margin-bottom:1.25rem">
          <summary set:html={b.summary} />
          <div set:html={b.html} />
        </details>
      ) : b.t === 'assumed' ? (
        <p class="assumed" set:html={b.html} />
      ) : b.t === 'note' ? (
        <p class="tunnel-note" style="margin-bottom:1.5rem" set:html={b.html} />
      ) : (
        <p class="dim" style="margin-bottom:1.25rem" set:html={b.html} />
      )
    )
  )}

  {node.question && <p class="question">{node.question}</p>}

  <nav class="pad-grid" aria-label={node.question ?? 'What next'}>
    {node.options.map((o, i) => {
      const tone = toneOf(o, i);
      return (
        <a href={hrefOf(o.to)} class:list={['pad', padClass(tone)]} {...dataAttrs(o, i)}>
          <div class="pad-header">
            <div class:list={['led', ledClass(tone)]}></div>
            <div class="pad-title">{o.label}</div>
          </div>
          {o.desc && <div class="pad-desc">{o.desc}</div>}
        </a>
      );
    })}
  </nav>

  {node.moves && (
    <p class="tunnel-note" style="margin-top:1.6rem">
      None of this is needed by the DJ who walked in with a cloned second drive in
      the other pocket. That version of tonight is ten seconds long.
      <a href="/prepare">The prevention rules</a>.
    </p>
  )}
</Tunnel>

<style>
  /* REBUILT 2026-08-03. Antonio, reviewing staging: "this whole section looks
     amateur." He was right, and the reasons were nameable rather than taste.

     WHAT WAS WRONG. The four moves sat on bare hairlines with no surface,
     while every other list in this product sits on a card. A 1.5rem grey
     numeral hung in the left margin at nearly the weight of the verb beside
     it, so two display elements fought on every row. And the disclosure read
     "+ WHY, AND HOW", a plus and minus prefix that exists nowhere else on the
     site: a SEVENTH accordion pattern, and the most used one, since it is on
     every tunnel screen.

     WHAT IS DELIBERATE AND STAYS. The verb is still large. That is not
     decoration, it is the arm's length legibility requirement for a dark
     booth and it is part of the frozen engine spec. Guardrail 2: intentional
     hierarchy does not get standardised away. What changed is the things that
     were competing with it. */
  .moves {
    list-style: none; counter-reset: mv; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .moves li {
    counter-increment: mv;
    position: relative;
    /* The shared surface: same tokens as every card and every pad. */
    background: var(--surf);
    border: var(--stroke) solid var(--edge);
    border-radius: var(--radius);
    padding: var(--sp-5) var(--sp-5) var(--sp-4) 3.1rem;
  }
  /* The number is a LABEL now, not a display element. It marks the order and
     then gets out of the way of the verb. */
  .moves li::before {
    content: counter(mv);
    position: absolute;
    left: var(--sp-5);
    top: calc(var(--sp-5) + 0.2rem);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--text-faint);
  }
  .move-verb {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    /* Still big, still readable at arm's length, but the ceiling comes down
       from 2rem: at 32px it was outrunning the screen's own heading. */
    font-size: clamp(1.35rem, 6vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .move-action {
    display: block;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--text-dim);
  }
  .last-resort { margin: 0 0 1.6rem; }
  .last-resort > summary { text-transform: none; letter-spacing: 0; font-size: 0.88rem; }
</style>
