---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT
---
<Tunnel title="How Valuable Are the Files? | Save My Gig" status="Full_Recovery">
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Decision point</div>
  <h2 style="margin-bottom:1rem">How valuable is what's stuck on the drive?</h2>

  <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px" aria-hidden="true">⚠️</div>
    <div><strong>Do not format the drive yet.</strong> Formatting can kill the recovery chances. And if the computer offers to format it, say no.</div>
  </div>

  <p class="question">Are there files on it you can't replace, your own edits, unreleased tracks, purchases you can't re-download?</p>

  <Choice step="fr_value"
    a={{ href: '/files-lost?path=full_recovery', label: 'YES, IRREPLACEABLE', desc: 'Recovery route: software first, lab if the drive is physically dead.', event: 'outcome_reached', data: { outcome: 'lost', path: 'full_recovery' } }}
    b={{ href: '/protocol/full-recovery/health', label: 'NO, I CAN REPLACE IT', desc: 'Then we sacrifice the data and rebuild the drive clean.' }}
  />
</Tunnel>
