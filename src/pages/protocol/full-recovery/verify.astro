---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT
---
<Tunnel title="Final Verification | Save My Gig" status="Full_Recovery">
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Final step</div>
  <h2 style="margin-bottom:1rem">Verify like it's gig day</h2>

  <ul class="checklist">
    <li>Eject, unplug, plug back in.</li>
    <li>Device loads in Rekordbox with all playlists.</li>
    <li>Test on a player: tracks load, waveforms show, cues fire.</li>
  </ul>

  <p class="question">Everything solid?</p>

  <!-- The NO description used to read "Your music is already safe on the
       computer." That is TRUE only for the DJ who came through /rescue. A DJ
       who answered "I can replace it" back on /value was routed straight to
       /health and never copied anything anywhere. Telling that person their
       music is safe, on the screen where we tell them the drive is not
       trustworthy, is the most expensive kind of error this site can make. -->
  <Choice step="fr_verify"
    a={{ href: '/saved?path=full_recovery', label: 'YES, SOLID', event: 'outcome_reached', data: { outcome: 'saved', path: 'full_recovery' } }}
    b={{ href: '/protocol/full-recovery/retire', label: 'NO, PROBLEMS REMAIN', desc: 'The drive is not trustworthy. Do not put a gig on it.' }}
  />
</Tunnel>
