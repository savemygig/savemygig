---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// DRAFT
---
<Tunnel title="Retire the Drive | Save My Gig" status="Full_Recovery">
  <div class="review-flag">DRAFT, review pending.</div>
  <div class="step-label">Step 2b</div>
  <h2 style="margin-bottom:1rem">This drive is done. Retire it.</h2>

  <p>A drive that fails a full format will fail a gig. No exceptions, no second chances.</p>

  <p class="question">Do you have another USB drive to rebuild on right now?</p>

  <Choice step="fr_retire"
    a={{ href: '/protocol/full-recovery/rebuild', label: 'YES, REBUILDING CLEAN' }}
    b={{ href: '/prepare?from=retire', label: 'NO, I NEED DRIVES', desc: 'Go to the prevention hub: the drives worth buying and the system to run them.', event: 'outcome_reached', data: { outcome: 'prepare', path: 'full_recovery' } }}
  />
</Tunnel>
