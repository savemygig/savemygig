<Tunnel title="Quick Fix Protocol (1-3 hours) | Save My Gig!" status="Quick_Fix">
  <div class="review-flag">DRAFT, review pending.</div>
  <h1 style="margin-bottom:1rem">RAPID <span class="accent">DIAGNOSTIC</span></h1>

  <div class="alert-card" style="margin-bottom:1.5rem">
    <div style="font-size:20px">🕐</div>
    <div><strong>You have 1-3 hours.</strong> Enough time to fix it properly instead of working around it. We repair the USB and the Rekordbox database for real.</div>
  </div>

  <p class="question">Do you have access to a computer with Rekordbox on it?</p>

  <Choice step="qf_computer"
    a={{ href: '/protocol/quick-fix/usb-check', label: 'YES, WITH REKORDBOX' }}
    b={{ href: '/protocol/quick-fix/no-computer', label: 'NO, NOT RIGHT NOW' }}
  />

  <p style="margin-top:1.5rem"><a href="/emergency" class="dim" style="text-decoration:none">← Back to triage</a></p>
</Tunnel>
