---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// The crossfader assign is the number one silent-channel cause and it is the
// first thing checked. True on every mixer with a crossfader.
---
<Tunnel title="Silent Channel | Save My Gig!" status="No_Sound · Channel" red>
  <div class="step-label">Check this first</div>
  <h2 style="margin-bottom:1rem">Check the crossfader</h2>

  <ul class="checklist">
    <li>Move the crossfader fully away from your channel, then back.</li>
    <li>Find the crossfader <strong>ASSIGN</strong> for that channel (A / B / THRU). Set it to <strong>THRU</strong>.</li>
  </ul>

  <p class="tunnel-note" style="margin-top:0;margin-bottom:1.5rem">
    On some newer mixers the assign is a menu setting, not a switch. If you see
    no switch, check the mixer's channel settings.
  </p>

  <p class="question">Is the sound back?</p>

  <Choice step="ns_channel"
    a={{ href: '/saved?path=no_sound&branch=crossfader', label: 'YES, IT PLAYS', event: 'outcome_reached', data: { outcome: 'saved', path: 'no_sound' } }}
    b={{ href: '/protocol/no-sound/channel-2', label: 'NO, STILL SILENT' }}
  />
</Tunnel>
