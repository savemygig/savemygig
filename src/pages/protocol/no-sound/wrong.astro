---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
---
<Tunnel title="Sound But Wrong | Save My Gig!" status="No_Sound · Quality" red>
  <div class="step-label">Quiet, distorted or one-sided</div>
  <h2 style="margin-bottom:1rem">Quiet, distorted or one side only</h2>

  <ul class="checklist">
    <li>Reseat every jack in the path. Half-inserted causes one-sided sound.</li>
    <li>Set <strong>TRIM</strong> so the channel meter peaks orange, never red.</li>
    <li>Swap the suspect cable. Cables fail more often than gear.</li>
  </ul>

  <p class="question">Clean now?</p>

  <Choice step="ns_wrong"
    a={{ href: '/saved?path=no_sound&branch=quality', label: 'YES, SOUNDS RIGHT', event: 'outcome_reached', data: { outcome: 'saved', path: 'no_sound' } }}
    b={{ href: '/protocol/no-sound/wrong-2', label: 'NO, STILL WRONG' }}
  />
</Tunnel>
