---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';

// NO SOUND: entry. Triage by WHERE the signal dies, because that is the only
// question a DJ can actually answer while staring at a silent mixer.
// PHASE 1 IS MODEL-AGNOSTIC ON PURPOSE. Every instruction here is true on any
// mixer ever made. Model-specific behaviour (XDJ-AZ software crossfader
// assign, DJM-V10 headphone jacks) is deliberately NOT here until it is
// verified against the official manual for that exact model. See
// claude/no-sound-expansion-plan.md.
---
<Tunnel title="No Sound | Save My Gig!" status="No_Sound" red srHeading="No sound: where is it missing?">
  <h2 style="margin-bottom:0.75rem">Your music is fine. This is routing.</h2>
  <p class="dim" style="margin-bottom:1.25rem">Nothing is broken on your drive. Something is not passing the signal.</p>

  <p class="question">Where is the sound missing?</p>

  <Choice step="ns_entry"
    a={{ href: '/protocol/no-sound/channel', label: 'ONE CHANNEL, OTHERS FINE' }}
    b={{ href: '/protocol/no-sound/master', label: 'EVERYTHING IS SILENT' }}
    c={{ href: '/protocol/no-sound/phones', label: 'ONLY MY HEADPHONES' }}
    d={{ href: '/protocol/no-sound/wrong', label: 'SOUND IS THERE BUT WRONG' }}
  />
</Tunnel>
