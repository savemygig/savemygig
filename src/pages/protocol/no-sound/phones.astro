---
import Tunnel from '../../../layouts/Tunnel.astro';
import Choice from '../../../components/Choice.astro';
// Cue routing before the jack: it is the more common cause and costs nothing.
---
<Tunnel title="No Cue In Headphones | Save My Gig!" status="No_Sound · Headphones" red>
  <div class="step-label">Cue first</div>
  <h2 style="margin-bottom:1rem">Check the cue, not the jack</h2>

  <!-- "Press CUE on the channel you want to hear" was the reflex: pressing cue
       is HOW they discovered there was no cue. MIX and LEVEL are the two that
       actually get missed. -->
  <p class="assumed">CUE is lit. That is how you found this.</p>

  <ul class="checklist">
    <li>Headphone <strong>MIX</strong> knob fully to CUE, not to MASTER.</li>
    <li>Headphone <strong>LEVEL</strong> up halfway.</li>
  </ul>

  <p class="question">Hearing it now?</p>

  <Choice step="ns_phones"
    a={{ href: '/saved?path=no_sound&branch=cue', label: 'YES, I HEAR IT', event: 'outcome_reached', data: { outcome: 'saved', path: 'no_sound' } }}
    b={{ href: '/protocol/no-sound/phones-2', label: 'NO, STILL NOTHING' }}
  />
</Tunnel>
