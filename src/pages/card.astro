---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { RUNLIST } from '../data/runlist.js';
// THE EMERGENCY CARD, the printable/screenshot-able one-pager promised on /saved and /prepare.
//
// The booth block is rendered from src/data/runlist.js, the same source the
// emergency screen uses. It used to be a separate hand written list with
// different wording and a different order, which is the worst possible outcome:
// a DJ who screenshots this card and then opens the site mid-gig would see two
// versions of the same advice and trust neither. One list, one order, one set
// of words, everywhere.
---
<Base
  title="The DJ Emergency Card - Screenshot This | Save My Gig!"
  description="The one-page USB emergency reference for DJs. Screenshot it, print it, keep it in your gig bag. Free."
  path="/card"
>
  <main class="wrap">
    <div class="status-line">Emergency_Card</div>
    <h1 style="margin-bottom:0.5rem">THE EMERGENCY <span class="accent">CARD</span></h1>
    <p class="dim" style="margin-bottom:1.5rem">📱 Screenshot this page now, it works with no signal, in any booth, at 3am.</p>

    <div class="panel" style="border-color:rgba(0,255,102,0.3)">
      <h3 style="margin-bottom:0.4rem">⚡ USB DEAD AT THE BOOTH</h3>
      <p class="dim" style="font-size:0.85rem;margin-bottom:0.9rem">
        Assumes you have already reseated it and tried the other deck. These are
        the four a good DJ still forgets under pressure.
      </p>
      <ol class="card-moves">
        {RUNLIST.map((s) => (
          <li><strong>{s.verb}</strong> <span>{s.action}</span></li>
        ))}
      </ol>
    </div>

    <div class="panel" style="border-color:rgba(255,176,32,0.3)">
      <h3 style="margin-bottom:0.75rem">🔧 THE SACRED SETTINGS</h3>
      <ul class="checklist">
        <li>Format: <span class="mono">FAT32</span> · Scheme: <span class="mono">MBR</span> · Size: 32-64 GB</li>
        <li>Mac: Disk Utility → Show All Devices → select the DRIVE → MS-DOS (FAT) + Master Boot Record</li>
        <li>Music onto gig drives ONLY via Rekordbox EXPORT mode</li>
        <li>Eject from Rekordbox AND the player (USB STOP). Every time.</li>
      </ul>
    </div>

    <div class="panel panel-danger">
      <h3 style="margin-bottom:0.75rem">🚫 NEVER (under pressure)</h3>
      <ul class="checklist">
        <li>Never format a drive that still holds unrescued files.</li>
        <li>Never say YES when a computer offers to format your gig drive.</li>
        <li>Never keep re-plugging a drive that's failing, each mount can make recovery harder.</li>
        <li>Never leave home with one drive. <strong>Two identical drives, two pockets.</strong></li>
      </ul>
    </div>

    <div style="text-align:left;margin:2rem 0 1rem">
      <EmailCapture source="card" title="Want this as a printable PDF?"
        blurb="This page is free forever, screenshot it right now. If you would rather have the printable version saved in your inbox, we will send it." />
    </div>
    <p class="dim" style="font-size:0.85rem">savemygig.com/emergency, the full guided rescue, free · Print this page: it's ink-friendly.</p>
  </main>
</Base>

<style>
  /* Compact on screen, still legible in a screenshot on a phone at arm's
     length, and it prints. The verb leads so the eye finds the step it is on
     without reading the sentence. */
  .card-moves { list-style: none; counter-reset: cm; margin: 0; padding: 0; }
  .card-moves li {
    counter-increment: cm;
    position: relative;
    padding: 0.42rem 0 0.42rem 1.75rem;
    line-height: 1.4;
  }
  .card-moves li::before {
    content: counter(cm);
    position: absolute; left: 0; top: 0.42rem;
    width: 1.25rem; text-align: center;
    font-family: var(--font-display); font-weight: 800;
    color: var(--text-faint);
  }
  .card-moves strong {
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.01em;
  }
  .card-moves span { color: var(--text-dim); }
</style>
