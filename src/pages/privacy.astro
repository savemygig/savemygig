---
import Base from '../layouts/Base.astro';
---
<Base
  title="Privacy | Save My Gig!"
  description="What Save My Gig collects (very little), why, and your choices."
  path="/privacy"
  noindex
>
  <main class="wrap">
    <div class="status-line">Privacy</div>
    <h1 style="margin-bottom:1.5rem">PRIVACY, <span class="accent">PLAINLY</span></h1>

    <div class="panel">
      <h3 style="margin-bottom:0.6rem">What we collect</h3>
      <p class="dim" style="margin-bottom:0">Save My Gig has no accounts and no logins. We use Google Analytics 4 to understand anonymous usage, which pages help, where people get stuck. That involves cookies set by Google. We never see names, emails, or files.</p>
    </div>

    <div class="panel">
      <h3 style="margin-bottom:0.6rem">What we don't do</h3>
      <p class="dim" style="margin-bottom:0">No ads inside the emergency flow. No selling of data. No tracking beyond standard analytics. If you email us, your address is used only to reply.</p>
    </div>

    <div class="panel">
      <h3 style="margin-bottom:0.6rem">Your choices</h3>
      <p class="dim" style="margin-bottom:0">Block analytics with any content blocker and the site works exactly the same. Questions: <a href="mailto:savemygig@gmail.com">savemygig@gmail.com</a>.</p>
    </div>

    <p class="dim" style="font-size:0.85rem">Last updated: July 2026 · Operated from Brazil · Some outbound links on gear and recovery pages may become affiliate links; they never change what you pay.</p>
  </main>
</Base>
