---
import Base from '../layouts/Base.astro';
---
<Base
  title="Wrong Cable | Save My Gig!"
  description="This page doesn't exist. But your gig can still be saved."
  path="/404"
  noindex
>
  <main class="wrap center" style="padding-top:4rem">
    <div class="status-line red" style="justify-content:center">Signal_Lost</div>
    <h1 class="danger" style="margin-bottom:1rem">404 — WRONG CABLE</h1>
    <p class="dim" style="max-width:30rem;margin:0 auto 2rem">This page isn't plugged in. But if your USB just died before a gig, you're two taps from the fix.</p>
    <a href="/emergency" class="btn btn-solid" style="max-width:24rem;margin:0 auto">🚨 Start Emergency Mode</a>
    <p style="margin-top:1.5rem"><a href="/" class="dim" style="text-decoration:none">← Home</a></p>
  </main>
</Base>
