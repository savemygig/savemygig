---
import Base from '../../layouts/Base.astro';
import { DJM_A9, DJM_V10 } from '../../data/facts.js';

// THE DICTIONARY (Antonio's idea). Every term a DJ meets on this site or in a
// booth, one tap deep. Two rules:
//   1. Definitions come ONLY from material already verified on this site
//      (manufacturer docs, the facts files, the mixed-audience explainers).
//      Nothing is defined here that the site cannot back.
//   2. Same collapse pattern as the FAQ: the term list IS the index, the
//      reader expands what they came for.
// Terms are grouped the way a DJ meets them, not alphabetically: drives and
// formats, the library, the players, the mixer and sound.
const groups = [
  {
    // AUDIO FILES (Antonio, 2026-08-02). Deliberately its own group rather
    // than folded into "Drives and formats" above: that group is about FILE
    // SYSTEMS (FAT32, exFAT, MBR), and a DJ meets both kinds of "format"
    // while preparing the same drive. Keeping them apart is the point.
    //
    // SOURCES, per the fact-discipline rule: the per-format table comes from
    // AlphaTheta's own CDJ-3000X instruction manual (DRI1956B, "Supported
    // file formats"), and the CDJ-2000NXS2 high-resolution figures from
    // AlphaTheta support article 4405915074969, which also states the DSD
    // incompatibility. Nothing here is claimed for a model we have not
    // checked; where support is unverified the entry says to confirm rather
    // than guessing.
    title: 'Audio files',
    terms: [
      { id: 'lossy-vs-lossless', t: 'Lossy vs lossless', d: 'The distinction underneath every other entry here. Lossy formats (MP3, AAC) permanently discard audio data to save space. Lossless formats (WAV, AIFF, FLAC, Apple Lossless) keep all of it. Converting one into the other does not restore anything: an MP3 saved as WAV is a much larger file of exactly the same audio.' },
      { t: 'MP3', d: 'The format most DJ libraries are built on. It is lossy, so data was thrown away to shrink the file and it does not come back. Players read it from 32 to 320 kbps at 44.1 or 48 kHz, which makes 320 the ceiling worth exporting. Its real advantage is that it plays on every player ever made.' },
      { t: 'AAC', d: 'Lossy like MP3 but more efficient, so it holds up better at the same file size. Players read it from 16 to 320 kbps. One trap worth knowing: AAC and Apple Lossless both use the .m4a extension, so two completely different files look identical in a folder.' },
      { t: 'WAV', d: 'Uncompressed audio, nothing discarded and nothing packed down, which is why it is the largest file on the drive. Players read it at 16 or 24 bit and up to 96 kHz. Its weakness is housekeeping: artist and title travel less reliably inside a WAV than in other formats, which is why WAV libraries so often show blanks where the track information should be.' },
      { t: 'AIFF', d: 'Apple’s uncompressed format. The audio is equivalent to WAV, the difference is that AIFF carries track information reliably, which is why DJs preparing large libraries often choose it over WAV.' },
      { t: 'FLAC', d: 'Lossless compression: noticeably smaller than WAV, with nothing discarded, so it decodes back to the original. Documented on the CDJ-3000X up to 96 kHz, and on the CDJ-2000NXS2 up to 96 kHz and 24 bit. Older players predate the format, so confirm the deck reads it before building a booth library around it.' },
      { id: 'alac', t: 'Apple Lossless (ALAC)', d: 'Apple’s equivalent of FLAC: compressed, nothing thrown away. Documented alongside FLAC on the CDJ-2000NXS2 and CDJ-3000X. It shares the .m4a extension with AAC, so the extension alone never tells you whether a file is lossless.' },
      { t: 'Bit rate', d: 'How much data a lossy file spends per second, written in kbps. Higher means less was discarded and the file is bigger. For MP3 the players stop at 320 kbps, which is why that number is everywhere in DJ libraries. Bit rate says nothing about WAV, AIFF, FLAC or Apple Lossless, which are not discarding anything to begin with.' },
      { id: 'sample-rate', t: 'Sample rate and bit depth', d: 'The two numbers describing how finely the audio was captured, for example 44.1 kHz and 16 bit, which is CD standard. Players handle up to 96 kHz and 24 bit on the formats that carry it. Higher is not automatically better in a club: the room, the system and the mix decide far more than these two numbers do.' },
      { id: 'dsd', t: 'DSD (.dsf and .dff)', d: 'A high-resolution format from the audiophile world, and one of the few that simply does not play. AlphaTheta states the CDJ-2000NXS2 is not compatible with DSF or DFF files. If a track arrives in one, convert it before the gig rather than in the booth.' },
    ],
  },
  {
    title: 'Library and export',
    terms: [
      { t: 'rekordbox database', d: 'The hidden index rekordbox writes onto your USB next to the music: playlists, cues, grids, waveforms. When a player mounts your drive but shows no playlists, this is usually what died or mismatched, not your music. The audio files sit untouched in their folders.' },
      { t: 'Device Library', d: 'The classic database format rekordbox exports to USB, the one older CDJs and XDJs read.' },
      { id: 'onelibrary', t: 'OneLibrary (Device Library Plus)', d: 'The newer database format, two names for the same thing, read by CDJ-3000X, CDJ-1500X, XDJ-AZ, XDJ-AN, OPUS-QUAD and OMNIS-DUO. Since rekordbox 7.2.13 a standard export writes BOTH formats to the stick, which is why this site anchors on that version: one export, every player.' },
      { t: 'EXPORT mode', d: 'The rekordbox mode that prepares USB drives. Officially free, no subscription, confirmed by rekordbox’s own plans FAQ. PERFORMANCE mode is the other one, for playing from the laptop.' },
      { t: 'FOLDER view', d: 'The player’s file browser. It reads your audio files directly, folder by folder, ignoring the database entirely. You lose playlists, cues and prepared waveforms; you keep the music and the gig. It is move one of the emergency list for a reason: most DJs have never tried it and do not know the audio still plays with the database gone.' },
      { t: 'Library backup', d: 'File > Library > Backup Library in rekordbox 7, to a different drive or cloud. The USB in your pocket is an export, not a backup: lose the laptop library and the cues and playlists on it are the only copy left.' },
    ],
  },
  {
    title: 'Drives and file systems',
    terms: [
      { t: 'FAT32', d: 'The file system that every Pioneer and AlphaTheta player reads, old and new, which is why this site recommends it. Its one real limit is 4GB per FILE, not per drive, and no DJ track approaches that.' },
      { t: 'exFAT', d: 'A newer file system. Officially supported on CDJ-3000, CDJ-3000X, CDJ-1500X, XDJ-RX3, XDJ-XZ, XDJ-AZ, XDJ-AN, OPUS-QUAD and OMNIS-DUO, refused by every CDJ-2000 including the NXS2. Most drives over 32GB ship with it from the factory, which is why a brand-new stick can fail on an older player out of the box. rekordbox writes exFAT to USB drives only, never SD cards.' },
      { t: 'NTFS', d: 'A Windows file system. No player reads it, and rekordbox will not export to it. If a drive is NTFS, it gets reformatted before it ever sees a booth.' },
      { id: 'mbr', t: 'MBR (Master Boot Record)', d: 'One of two ways a drive describes its own layout, and the one players expect. AlphaTheta documents that the CDJ-3000 does not support the GUID scheme, so when a format tool asks, pick MBR. On a Mac this means erasing the DEVICE, not the volume, in Disk Utility.' },
      { id: 'gpt', t: 'GPT (GUID Partition Table)', d: 'The other layout scheme, and a recurring cause of "it formatted fine but the player refuses it". You get GPT by accident on a Mac when you erase the volume instead of the device.' },
      { id: 'quick-vs-full-format', t: 'Quick format vs full format', d: 'Quick format rebuilds the drive’s index and is fine on a healthy drive. A full format works the whole drive, not just the index, which makes it a stress test: it is what you run on a SUSPECT drive, and a drive that fails one is retired, not trusted with a gig.' },
      // The physical media entries (Antonio, 2026-08-02). Deliberately kept to
      // what the site can back: the SD limits come from rekordbox's own
      // documented behaviour and the CDJ-3000X port list, and the UASP
      // thresholds come from the AlphaTheta change histories already in
      // facts.js. The SSD and HDD entries stay on physics and power, with no
      // per-model support claims, because we have not checked those.
      { id: 'usb-stick', t: 'USB stick (pen drive)', d: 'The drive nearly every gig runs on, and the one piece of equipment you actually control in someone else’s booth. FAT32 with an MBR scheme, and almost nothing surprises you. Capacity is not the thing to optimise: a drive that fails a full format is retired, and two identical smaller drives beat one big one, because the second is what saves the gig.' },
      { t: 'SD card', d: 'A second slot on some players and missing entirely on others: the CDJ-3000X has no SD slot at all, which strands a workflow built on cards. One limit applies even where the slot exists: rekordbox exports exFAT to USB drives only, never to an SD card. On SD it is FAT32 or nothing.' },
      { id: 'ssd', t: 'SSD (solid state drive)', d: 'A drive with no moving parts. As an external USB drive it is the sturdier thing to carry into a booth, because there is nothing inside to be disturbed by bass or by a knock. The catch is not speed, it is power and protocol: a bus-powered drive asks more of a player’s USB port than a stick does, and see UASP below.' },
      { id: 'hdd', t: 'HDD (hard disk drive)', d: 'The older kind, with a platter spinning and a head moving inside while it runs. It works, but it is the wrong body for a booth: physically vulnerable exactly when it is in use, thirstier on bus power than a stick, and one knock at the wrong moment is a different class of problem from a dropped USB. If a large library has to travel, put it on an SSD.' },
      { t: 'UASP', d: `The faster protocol modern USB drives use to talk to the device they are plugged into. Worth knowing because AlphaTheta documented it as a genuine fault, not a theory: UASP-compatible drives were not recognised at all on the DJM-A9 before firmware ${DJM_A9.uaspFix}, or on the DJM-V10 before ${DJM_V10.uaspFix}. A drive that works everywhere and gets refused by one desk can be this, rather than the drive.` },
    ],
  },
  {
    title: 'Players',
    terms: [
      { t: 'PRO DJ LINK', d: 'The network that connects players and mixer. Over LINK, any player can browse and load from a drive that is physically in another player, officially supported since the CDJ-900/2000 generation. If your drive dies mid-set, the drive in the other deck is still reachable.' },
      { t: 'USB STOP', d: 'The button you hold before pulling a drive. The manual is blunt: removing a drive (or cutting power) while the USB indicator is blinking can delete management data or make the drive unreadable. Every time, both directions: player and rekordbox.' },
      // Emergency Loop wording verified against the CDJ-3000X manual (DRI1956B):
      // "The unit automatically plays a Beat Loop if it can't start playing the
      // next track when the end of the current track is reached."
      { t: 'Emergency Loop', d: 'Official AlphaTheta behaviour, and officially named: the player automatically plays a Beat Loop if it cannot start the next track when the end of the current one is reached, instead of going silent. If nothing was loaded, it is doing its job; load something. If your next track WAS ready and it still fired, the player could not read it: treat the drive as suspect.' },
      { id: 'e-8302', t: 'E-8302 (CANNOT PLAY TRACK)', d: 'CDJ-3000 and CDJ-3000X error meaning the track data on the drive cannot be read correctly. The official response: try the track on another player, and re-import the file to the drive if possible. Usually a corrupt export or wrong file system, not dead hardware.' },
      { t: 'HID mode', d: 'The mode where a player becomes a controller for software on a laptop instead of playing from its own drive. A booth surprise on older players: not all of them support it for every software.' },
      { t: 'Firmware', d: 'The player’s own software, and part of your rig whether you like it or not. Known freezes and dropouts have official fixed-in versions; check the version in UTILITY at soundcheck. And never update anything, yours or the booth’s, on gig day.' },
      { t: 'NFC login', d: 'A way into a booth without carrying a drive at all. The CDJ-3000X carries an NFC touchpoint on its front panel: hold a phone running rekordbox for iOS or Android over the reader and it pulls up your online music. The CDJ-1500X supports the same login, by NFC or by QR code. It signs you in, it is not a way to play audio off the handset, and what arrives afterwards is your cloud library over the venue’s network.' },
    ],
  },
  {
    title: 'Mixer and sound',
    terms: [
      { id: 'trim-gain', t: 'TRIM / GAIN', d: 'Two names for the same top-of-strip knob: how loud the source arrives in the channel, before the fader. First suspect when one channel is quiet with the fader up.' },
      // The EQ trio, added 2026-08-02. Deliberately NOT a frequency table: a
      // working DJ knows the low knob is the kick, and printing "20 to 60 Hz
      // gives weight" at a professional is the condescension the lint bans.
      // What actually catches people in a booth is that the same knob does
      // different things on different desks, and that the switch deciding
      // which was set by somebody else. Sources: DJM-900NXS2 operating
      // instructions (the EQ CURVE selector, and the -26 dB floor in EQ
      // mode), DJM-V10 product specifications (4-band channel EQ, a SEPARATE
      // 3-band master isolator, booth EQ), and AlphaTheta's DJM-V5 page
      // ("4-Band EQ on each channel, inherited from the DJM-V10", 2-band
      // booth EQ).
      { id: 'channel-eq', t: 'Channel EQ (EQ / ISO)', d: 'The band knobs on each channel strip: three on most desks, four on the DJM-V10 and DJM-V5, which split the middle in two. The part worth knowing is what the bottom of the travel actually does, because it is not always silence. On the DJM-900NXS2 the published floor in EQ mode is -26 dB, a deep cut with the track still alive underneath it. If you reach for a full kill and the kick is still there, the desk is doing exactly what it is documented to do.' },
      { t: 'Isolator', d: 'One name, two different pieces of gear, and which one you are standing at decides how the knobs behave. On the DJM-900NXS2 it is a mode: an EQ CURVE (ISOLATOR, EQ) switch on the panel, the same three knobs acting as tone controls in one position and as an isolator in the other. On the DJM-V10 it is separate hardware, a three-band master isolator sitting across the whole mix with its own crossover points. Either way, that setting is not yours. It is however the last DJ or the tech left it, and the first place you find out is the first cut you make in front of a full room.' },
      // OPUS-QUAD has a physical CROSSFADER ASSIGN (A, THRU, B) selector per its
      // manual (DRI1795D); the old "on-screen settings" claim was wrong and the
      // "number one cause" superlative was unsourced. Corrected 2026-08-02.
      { t: 'Crossfader assign', d: 'The per-channel switch (A / THRU / B) deciding whether the crossfader controls that channel. Assigned to the wrong side, the channel is silent with every fader up: a classic silent-channel cause. Some mixers have no crossfader at all (DJM-V10-LF, DJM-V5); on those every channel behaves as THRU.' },
      { id: 'cue-pfl', t: 'CUE / PFL', d: 'The DJ’s word and the tech’s word for the same thing: listening to a channel in your headphones before it reaches the room. If your headphones are silent, check the MIX knob is toward CUE, not MASTER, before blaming the jack.' },
      { t: 'BOOTH output', d: 'The mixer’s second output, feeding the DJ’s own monitors, separate from MASTER which feeds the room. Two knobs, two destinations. In a pinch the booth output pair can substitute for a dead master pair.' },
      { t: 'Booth EQ', d: 'A second EQ, on the booth output only, on the desks that carry one: the DJM-V10 and the DJM-V5 among them. It shapes what you hear in your monitors and touches nothing the room hears. Worth a look before you decide a system is broken, because a booth low left dumped by whoever played before you makes the monitor sound thin and lifeless while the floor is completely fine.' },
      { t: 'Master insert', d: 'A patch point on the back of some mixers where an outboard processor sits in the master signal. If something is plugged in and nothing sends audio back, the master goes silent with every fader up. If you find one patched, it is almost certainly the venue’s: ask before pulling it.' },
      { t: 'Signal chain', d: 'The ordered path audio takes after your mixer: house processor, amplifiers, speakers. Past the booth output it belongs to the venue, and the fastest fix is the exact sentence: "Mixer master is up, master meters are moving. Nothing after the booth output."' },
      // Added 2026-08-02 to answer the question people actually mean when they
      // ask about "connecting a phone". Players do not read a phone over NFC;
      // this and rekordbox on the device are the real paths.
      { t: 'Bluetooth audio in', d: 'Some desks take wireless audio from a phone or laptop directly, the DJM-A9 among them. Genuinely useful for a handover, or for keeping the room alive between sets. It is not a performance path: latency and connection stability make it a convenience input, not a deck to mix on. Not to be confused with NFC login on the newer players, which signs you into a cloud library rather than sending any audio.' },
      // The converter trio (Antonio, 2026-08-02). His question was where an
      // analogue-to-digital converter belongs, and the answer is here: it is
      // where a DJ actually meets the term, because mixer spec sheets
      // advertise converter bit depth and nobody explains what it buys you.
      // Soundcard and DVS sit alongside because on a modern DJM they are the
      // same piece of silicon doing the same job, and a DJ who understands
      // one understands all three.
      { id: 'converters', t: 'A/D and D/A converter', d: 'The two translations every sound in a booth goes through. A/D turns an analogue signal into numbers, D/A turns numbers back into something a speaker can move air with. Mixer spec sheets advertise these, usually as a bit depth like 32-bit, because the conversion is where a desk either preserves the recording or quietly flattens it. Nothing you operate, and nothing you can fix in the booth, but it is the honest answer to why two mixers playing the same file do not sound identical.' },
      { id: 'soundcard', t: 'Soundcard (audio interface)', d: 'The hardware doing that conversion. On a laptop setup it is a separate box or one built into the controller. On a professional DJM it is built into the mixer, which is why a laptop can plug straight into the desk over USB and needs nothing else in between. When someone says the mixer "is" the soundcard, this is what they mean.' },
      { id: 'dvs', t: 'DVS (Digital Vinyl System)', d: 'Playing digital files from a laptop while controlling them with real turntables or CDJs, using timecode: a special record or CD carrying a control signal rather than music. The mixer reads that signal through its own soundcard and the laptop follows it. It is why a DVS setup cares so much about the phono inputs and the USB connection to the computer, and why a wrong input selector kills it instantly.' },
    ],
  },
  {
    // CABLES AND PLUGS (Antonio, 2026-08-02). Its own group for the same
    // reason Audio files is: a DJ meets connectors as a separate class of
    // problem from drives, formats or the library. Scope rule applies, this
    // is booth wiring only. What you meet plugging in, what silences a
    // channel, and the one connector you will only ever see on the speaker
    // end. Phono vs Line leads the group because a wrong input selector is
    // one of the classic silent-channel causes and it is not covered
    // anywhere else on the site.
    title: 'Cables and connectors',
    terms: [
      { t: 'Phono vs Line', d: 'The single most useful thing in this group. A mixer channel expects either a turntable (phono, a very quiet signal that needs extra amplification) or anything else (line: CDJs, laptops, players). Feed a line source into a phono input and it distorts horribly. Feed a turntable into a line input and it is almost silent. If a channel is dead or sounds wrong with every fader up, check this selector before you blame the cable.' },
      { id: 'rca', t: 'RCA (phono connector)', d: 'The two-plug pair, usually red and white, that carries stereo between most DJ equipment: player to mixer, mixer to amplifier. Unbalanced, so it does not like long runs, but it is what nearly every booth is wired with. Red is right, white or black is left. A single dead channel with a working fader is very often just this plug not fully seated.' },
      { id: 'coaxial', t: 'Coaxial (digital out)', d: 'The trap in this group: a coaxial digital output uses the same connector as an RCA plug and carries something completely different. It is a single cable of DIGITAL audio, found on some mixers as DIGITAL OUT, and it will not work plugged into an ordinary analogue RCA input. If a connection looks like a normal phono lead and produces nothing but noise or silence, check whether one end of it is digital.' },
      { id: 'jack', t: 'Jack (6.35mm / quarter inch)', d: 'The big headphone plug, and the connector for booth outputs and many balanced connections. Comes in two shapes that look nearly identical: TRS has two black rings and carries stereo or a balanced signal, TS has one ring and carries a single unbalanced channel. Plugging TS where TRS is expected is a quiet way to lose half your audio.' },
      { id: 'mini-jack', t: 'Mini jack (3.5mm)', d: 'The small version, on phones, laptops and consumer headphones. Common in a booth only as an adapter, and adapters are exactly where handovers go wrong. If a phone has to reach the mixer, know before doors whether that adapter exists and where it is.' },
      { id: 'xlr', t: 'XLR (also called Canon)', d: 'The three-pin locking connector, balanced, used for the mixer’s master output to the house system and for microphones. Balanced means it rejects interference over long cable runs, which is why the room is fed with it and your booth is not. Many DJs, especially outside the English-speaking world, call it a Canon: same connector, older brand name.' },
      { t: 'Balanced vs unbalanced', d: 'Why two kinds of cable exist at all. A balanced connection (XLR, TRS jack) carries the signal twice, inverted, so noise picked up along the way cancels itself at the other end. Unbalanced (RCA, TS jack) does not, so it collects hum and interference over distance. Short runs inside the booth, unbalanced is fine. Anything crossing a stage should be balanced.' },
      { t: 'Speakon', d: 'The chunky twist-lock speaker connector. Worth knowing precisely because you will NOT find it on DJ equipment: it lives between amplifiers and speakers, which is the venue’s side of the signal chain. If you are looking at Speakon, you are past the booth output and past where your responsibility ends.' },
      { id: 'ground-terminal', t: 'Ground (earth) terminal', d: 'The small screw post on a mixer for a turntable’s thin ground wire. Unconnected, a turntable channel hums audibly. If a deck is buzzing on a vinyl setup and the fader is doing nothing about it, this is the first thing to look at.' },
      { t: 'IEC power cable', d: 'The standard three-pin kettle lead every player and mixer takes. Unglamorous and the most common cause of a unit that "will not turn on". They work loose in a rack, and venues borrow them. A spare in the bag costs almost nothing and has saved plenty of sets.' },
      { id: 'ethernet-cable', t: 'Ethernet / LAN cable', d: 'How players and mixer talk to each other over PRO DJ LINK, and how a laptop joins that network. Ordinary network cable, nothing special about it. If LINK is refusing to connect and the settings look right, the cable and the port are worth ruling out before the settings.' },
      { id: 'usb-connectors', t: 'USB-A, USB-B, USB-C', d: 'Three different shapes doing different jobs on the same desk. USB-A is the flat one your drive plugs into. USB-B is the squarer one that connects a mixer to a computer for DVS or recording. USB-C appears on newer players for both storage and computer connection. The CDJ-3000X, for instance, carries one USB-A and two USB-C and no SD slot at all.' },
    ],
  },

];

// STABLE ANCHORS (2026-08-03). Every term and every group is addressable, so
// anything on the site can link straight to an explanation instead of dropping
// the reader at the top of a 59-term page to hunt for it.
//
// The id is stored EXPLICITLY on the awkward labels rather than always derived,
// because a derived slug changes the moment a label is edited and would break
// every link pointing at it, silently. Clean labels fall back to the slug.
// scripts/check-concepts.mjs fails the build if any registry destination points
// at an anchor that does not exist in the built page.
const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const termId = (x) => x.id ?? slug(x.t);
const groupId = (g) => g.id ?? slug(g.title);

const SITE = 'https://www.savemygig.com';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${SITE}/knowledge/dictionary#terms`,
  name: 'The DJ reliability dictionary',
  // Each term now carries its own @id and url, so the anchors are
  // machine-readable too: a search or answer engine can cite one definition
  // instead of the whole page.
  hasDefinedTerm: groups.flatMap((g) => g.terms.map((x) => ({
    '@type': 'DefinedTerm',
    '@id': `${SITE}/knowledge/dictionary#${termId(x)}`,
    url: `${SITE}/knowledge/dictionary#${termId(x)}`,
    name: x.t,
    description: x.d,
    inDefinedTermSet: `${SITE}/knowledge/dictionary#terms`,
  }))),
};
---
<Base
  title="The DJ Dictionary - MBR, OneLibrary, Emergency Loop, Explained | Save My Gig!"
  description="Every term that decides whether your USB plays: FAT32, MBR, OneLibrary, PRO DJ LINK, Emergency Loop, crossfader assign. Plain definitions, manufacturer-verified."
  path="/knowledge/dictionary"
  crumbName="Dictionary"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <p class="crumb"><a href="/knowledge">Knowledge base</a> / Dictionary</p>
    <div class="status-line">DICTIONARY</div>
    <h1 style="margin-bottom:0.8rem">The words that <span class="accent">save gigs</span></h1>
    <p class="dim" style="max-width:42rem;margin-bottom:2rem;line-height:1.6">
      Every term on this site and in the booth, one tap deep. Defined from
      manufacturer documentation and the facts this site has verified, nothing
      folklore.
    </p>

    {/* A FILTER, NOT A SEARCH (Antonio, 2026-08-03): "can this search box be
        specific to search inside the dictionary only?"
        WHY THE SHARED SEARCH COMPONENT CANNOT DO THIS. The site index is
        PER PAGE, and all 60 terms live on this one page, so the dictionary is
        exactly ONE entry in search-index.json. Scoping that box to the
        dictionary would return a single result: this page, the one you are
        already on.
        SO IT FILTERS INSTEAD. Every term is already in the DOM, so typing
        narrows the list in place: non-matching terms hide, groups with no
        match hide, groups with a match open themselves, and a single match
        opens its own definition. No navigation, no index, no request, works
        offline like the rest of the rescue kit.
        His follow-up question, "how are you going to open an accordion with a
        search box, is it possible?", has two answers. Here, nothing navigates
        so there is nothing to open across a page load. And for LINKS into the
        dictionary (/knowledge/dictionary#mbr from the prevention page) the
        existing deep-link script already opens both accordion levels and
        scrolls the term into view; measured at 393.
        Deliberately the same BOX as the site search so it reads as the same
        tool. Same border, radius, focus ring, icon and clear button. */}
    <div class="dict-filter" data-dict-filter>
      <div class="srch-box">
        <svg class="srch-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <label class="sr-only" for="dictFilter">Filter the dictionary</label>
        <input id="dictFilter" type="search" class="srch-input" autocomplete="off"
               placeholder="Filter terms: FAT32, MBR, PRO DJ LINK..."
               aria-describedby="dictFilterCount" />
        <button type="button" class="srch-clear" id="dictFilterClear" aria-label="Clear filter" hidden>&times;</button>
      </div>
      {/* Live region: a filter that silently reorders the page is invisible to
          a screen reader without one. */}
      <p class="dict-filter-count" id="dictFilterCount" role="status" aria-live="polite"></p>
    </div>

    {/* Two levels of accordion (Antonio, 2026-08-02). At 60 terms the flat
        list was an enormous scroll, so the GROUP is now collapsible too:
        pick the area, then pick the term. The group names are the index and
        the whole dictionary fits on one screen closed.
        Groups are deliberately NOT an exclusive `name=` set: comparing a
        cable term against a format term is a real thing to want, and the
        cost of leaving two open is nothing. Terms inside a group stay
        independent for the same reason.
        Collapsed content is still in the HTML, so the search index (built
        from dist) and crawlers read every definition regardless. */}
    {groups.map((g) => (
      <details class="dict-cat" id={groupId(g)}>
        <summary>
          <h2 class="dict-h">{g.title}</h2>
          <span class="dict-count">{g.terms.length}</span>
          <span class="dict-chev dict-cat-chev" aria-hidden="true"></span>
        </summary>
        <div class="dict-cat-body">
          {g.terms.map((x) => (
            <details class="panel dict-term" id={termId(x)}>
              <summary>
                <h3 class="dict-t">{x.t}</h3>
                <span class="dict-chev" aria-hidden="true"></span>
              </summary>
              <div class="acc-body"><p class="dim dict-d">{x.d}</p></div>
            </details>
          ))}
        </div>
      </details>
    ))}

    <p class="dim" style="margin-top:2rem;font-size:0.9rem">
      Missing a word that confused you in a booth? <a href="/feedback">Tell us</a>
      and it gets added.
    </p>
  </main>

  <script is:inline>
    /*
     * DEEP LINKING INTO THE DICTIONARY.
     *
     * A link like /knowledge/dictionary#fat32 has to do three things, and the
     * browser only sometimes does the first: open the TERM, open the GROUP
     * that contains it (this is a nested accordion, so one is not enough),
     * and land the reader on it rather than under the sticky header.
     *
     * Chromium auto-expands a <details> when you navigate to a fragment inside
     * it; Safari and Firefox have been inconsistent about it, and none of them
     * handle the nested case or the scroll offset. So this walks up the tree
     * opening every <details> ancestor. Without JS the anchor still resolves
     * and the content is still in the HTML, it just may land closed.
     *
     * hashchange matters as much as load: a link to another term FROM the
     * dictionary changes only the fragment, which fires no navigation.
     */
    (function () {
      function reveal(hash) {
        if (!hash || hash.length < 2) return;
        var el;
        try { el = document.getElementById(decodeURIComponent(hash.slice(1))); }
        catch (e) { return; }
        if (!el) return;

        for (var n = el; n && n !== document.body; n = n.parentNode) {
          if (n.tagName === 'DETAILS') n.open = true;
        }

        // Let the accordions finish expanding before measuring where to scroll.
        requestAnimationFrame(function () {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          el.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
          // Announce it: without this a screen reader stays where it was.
          var s = el.querySelector('summary');
          if (s) {
            s.setAttribute('tabindex', '-1');
            s.focus({ preventScroll: true });
          }
        });
      }
      reveal(window.location.hash);
      window.addEventListener('hashchange', function () { reveal(window.location.hash); });
    })();
  </script>

  <script is:inline>
    /**
     * THE DICTIONARY FILTER (Antonio, 2026-08-03).
     *
     * NOT the site search. The site index is per PAGE and all 60 terms live
     * on this one, so scoping the shared search box here would return a single
     * result: this page. Everything needed is already in the DOM, so this
     * filters in place instead. No index, no request, works offline.
     *
     * WHAT IT DOES, as you type:
     *   term does not match      -> hidden
     *   group has no match       -> hidden
     *   group has a match        -> shown and OPENED, so matches are visible
     *                               without a second tap
     *   exactly one match        -> its definition opens too, because at that
     *                               point the definition IS the answer
     *   empty                    -> everything restored to the shipped state,
     *                               closed, in original order
     *
     * It matches the TERM and its DEFINITION, not just the term, so somebody
     * who half-remembers the idea ("partition") finds MBR without knowing the
     * acronym, which is the whole reason a beginner is on this page.
     *
     * STATE IS RESTORED, NOT REMEMBERED. The filter records which accordions
     * it opened and closes exactly those on clear, so a term the reader had
     * opened by hand stays open. `data-hide` is an attribute, never an inline
     * style, so the page returns to precisely how it shipped.
     */
    (function () {
      var wrap = document.querySelector('[data-dict-filter]');
      var input = document.getElementById('dictFilter');
      var clear = document.getElementById('dictFilterClear');
      var count = document.getElementById('dictFilterCount');
      if (!wrap || !input) return;

      var groups = [].slice.call(document.querySelectorAll('.dict-cat'));
      var opened = [];

      function textOf(el) {
        return (el.textContent || '').toLowerCase().replace(/\s+/g, ' ');
      }

      // Cached once: 60 terms re-read on every keystroke is wasted work, and
      // the content is static.
      var index = groups.map(function (g) {
        return {
          group: g,
          terms: [].slice.call(g.querySelectorAll('.dict-term')).map(function (t) {
            return { el: t, hay: textOf(t) };
          }),
        };
      });

      function restore() {
        index.forEach(function (g) {
          g.group.removeAttribute('data-hide');
          g.terms.forEach(function (t) { t.el.removeAttribute('data-hide'); });
        });
        opened.forEach(function (el) { el.open = false; });
        opened = [];
      }

      function apply(q) {
        q = q.trim().toLowerCase();
        if (clear) clear.hidden = !q;

        if (!q) {
          restore();
          if (count) count.textContent = '';
          return;
        }

        restore();
        var hits = 0;
        var lastTerm = null;

        index.forEach(function (g) {
          var groupHits = 0;
          g.terms.forEach(function (t) {
            if (t.hay.indexOf(q) === -1) {
              t.el.setAttribute('data-hide', '');
            } else {
              groupHits++; hits++; lastTerm = t.el;
            }
          });
          if (!groupHits) {
            g.group.setAttribute('data-hide', '');
          } else if (!g.group.open) {
            g.group.open = true;
            opened.push(g.group);
          }
        });

        // One result: the definition is the answer, so show it.
        if (hits === 1 && lastTerm && !lastTerm.open) {
          lastTerm.open = true;
          opened.push(lastTerm);
        }

        if (count) {
          count.textContent = hits === 0
            ? 'No terms match "' + q + '". Try a shorter word, or tell us and it gets added.'
            : hits + (hits === 1 ? ' term' : ' terms');
        }
      }

      var t;
      input.addEventListener('input', function () {
        clearTimeout(t);
        t = setTimeout(function () { apply(input.value); }, 90);
      });

      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { input.value = ''; apply(''); }
      });

      if (clear) clear.addEventListener('click', function () {
        input.value = ''; apply(''); input.focus();
      });

      // A deep link must never land on a term the filter is hiding.
      window.addEventListener('hashchange', function () {
        if (input.value) { input.value = ''; apply(''); }
      });
    })();
  </script>
</Base>

<style>
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  /* Group level. The summary keeps the old .dict-h look (uppercase label with
     a rule under it) so the page reads the same closed as it did open, and
     gains a term count plus a chevron. */
  /* Design language sprint, 2026-08-03: the chevron geometry, the focus ring,
     the marker hiding and the open-state timing were all redeclared here, a
     copy of the same code in /faq, the Pioneer hub and Detail.astro. They now
     live once in global.css. Only what is genuinely about a dictionary stays
     local: the term count, the target rule, the uppercase group label. */
  /* FULL WIDTH (Antonio: "can you make the box as wide as the text below?
     otherwise it looks quite strange, the box being so small"). He is right:
     the shared .srch caps at 34rem, which is correct under a homepage hero
     and wrong above a full-width list, where a short box reads as a stray
     element rather than the control for the page. The cap is NOT overridden
     globally, because the homepage and /faq both want it. This is a
     dictionary-only control that borrows the search BOX styling. */
  .dict-filter { width: 100%; margin-bottom: 2rem; }
  .dict-filter-count {
    font-size: 0.82rem; color: var(--text-faint);
    margin-top: 0.6rem; min-height: 1.2em;
  }
  /* Hidden by the filter. A plain attribute so the script never touches
     inline styles and the page restores exactly as it shipped. */
  .dict-cat[data-hide], .dict-term[data-hide] { display: none; }

  .dict-cat { margin-bottom: 0.9rem; }
  .dict-cat > summary {
    display: flex; align-items: center; gap: 0.7rem;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
  .dict-cat[open] > summary { margin-bottom: 1rem; }
  .dict-h {
    flex: 1 1 auto;
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0;
  }
  .dict-count {
    flex: 0 0 auto; font-size: 0.75rem; font-weight: 700;
    color: var(--text-faint); font-variant-numeric: tabular-nums;
  }
  .dict-cat-body { margin-bottom: 1.8rem; }
  /* scroll-margin keeps a deep-linked term clear of the sticky header. CSS
     does this correctly at every zoom level; JavaScript arithmetic does not.
     Padding is NOT set here any more: the shared accordion supplies it, so a
     dictionary term and an FAQ answer are now the same box. */
  .dict-term { margin-bottom: 0.6rem; padding: 0; scroll-margin-top: 88px; }
  .dict-cat { scroll-margin-top: 88px; }
  /* A term arrived at by link gets a brief accent rule so the eye lands on the
     right row in a long group instead of hunting. */
  .dict-term:target { border-left: 2px solid var(--red); }
  .dict-t { font-size: 1rem; font-weight: 800; margin: 0; letter-spacing: -0.01em; text-transform: none; }
  /* Padding comes from the shared .acc-body wrapper, the same one the FAQ and
     the reference pages use, so a definition sits exactly where an answer
     does. */
  .dict-d { margin: 0; line-height: 1.6; font-size: 0.95rem; }
</style>
