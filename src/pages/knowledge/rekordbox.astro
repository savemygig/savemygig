<script is:inline>
  // Deep links must still work with the sections closed: a link to
  // #which-player (the exfat article sends people here) opens that section
  // before scrolling to it. Same on hash changes within the page. Because
  // every <details> shares name="rb-acc", opening one closes the rest.
  (function () {
    function openTarget() {
      var id = location.hash.slice(1);
      if (!id) return;
      var el = document.getElementById(id);
      if (!el) return;
      var box = el.closest ? el.closest('details') : null;
      if (el.tagName === 'DETAILS') box = el;
      if (box && !box.open) box.open = true;
      el.scrollIntoView();
    }
    window.addEventListener('hashchange', openTarget);
    openTarget();
  })();
</script>
