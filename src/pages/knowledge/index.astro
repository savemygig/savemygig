---
import Base from '../../layouts/Base.astro';
import { VENDOR_LINKS } from '../../data/facts.js';

// Knowledge hub, restructured on Antonio's call: "Master your tools", split
// into SOFTWARE and HARDWARE, because a DJ's tools are both. Focus stays on
// rekordbox + Pioneer DJ / AlphaTheta, which is most of the world's booths;
// everything else lands later without re-architecting anything: each tool
// gets its own page under /knowledge/<name>.
//
// Split into three on Antonio's call (2026-07-31): "Hardware" for the CDJs
// and mixers read as DJ equipment to a normal visitor, not hardware, the
// same confusion that got "Gear" pulled from the mobile nav that same day.
// "Hardware" now means what people actually mean by it: drives, SSDs, audio
// interfaces, the DJ's computer. The old hardware list becomes Equipment,
// same content, same URLs, only the label changes.
const software = [
  {
    name: 'rekordbox',
    href: '/knowledge/pioneer-dj/rekordbox',
    blurb: 'Export, Device Library vs OneLibrary, library moves, and every error a CDJ throws at you.',
  },
  {
    name: 'Serato DJ',
    href: null,
    blurb: 'Crates, offline library, and playing on club CDJs from a Serato setup.',
  },
  {
    name: 'DJM-REC',
    href: '/knowledge/pioneer-dj/djm-rec',
    blurb: 'AlphaTheta’s recording and live-streaming app: one USB cable into a DJM mixer, auto time-stamped track lists.',
  },
  {
    name: 'Engine DJ',
    href: null,
    blurb: 'Engine library prep, SC Live and Prime players, and the crossover to Pioneer booths.',
  },
];
const equipment = [
  {
    name: 'Pioneer DJ / AlphaTheta',
    href: '/knowledge/pioneer-dj',
    blurb: 'CDJs, XDJs, DJM mixers and all-in-ones: known issues by firmware version, and the habits that prevent them.',
  },
  {
    name: 'Denon DJ',
    href: null,
    blurb: 'SC players and Prime hardware, once the AlphaTheta reference is complete.',
  },
  {
    name: 'Allen & Heath',
    href: null,
    blurb: 'The Xone mixers DJs are loyal to: filters, known quirks, and pairing them with CDJ booths and turntables.',
  },
  {
    name: 'Technics',
    href: null,
    blurb: 'The turntables that never left. Vinyl is not our core, but the booth standard earns its place here.',
  },
];
// Hardware lists BRANDS, not categories, exactly like Equipment above
// (Antonio, 2026-08-01). The old list named categories ("USB drives", "SSDs",
// "Laptops") and pointed the first one at /gear, which mixed two different
// jobs: /gear RECOMMENDS across brands, the knowledge base DOCUMENTS one
// product at a time under its maker. Buying guidance stays on /gear; this
// section is the reference layer, so it follows the same
// /knowledge/<brand>/<product> rule as everything else on the site.
const hardware = [
  {
    name: 'SanDisk',
    href: null,
    blurb: 'The Extreme Pro and the official AlphaTheta DJ Flash Drive: what they do in a booth, and where they fail.',
  },
  {
    name: 'Samsung',
    href: null,
    blurb: 'BAR Plus and the portable SSD line, the drives that survive a bag full of cables.',
  },
  {
    name: 'Kingston',
    href: null,
    blurb: 'DataTraveler and the budget end of the booth, where reliability is won or lost.',
  },
  {
    name: 'Apple',
    href: null,
    blurb: 'MacBooks in the booth: what actually matters for uptime under a set, not raw specs.',
  },
];

// COLLECTIONPAGE, REPAIRED 2026-08-04.
//
// Three defects fixed together. It had no @id, so it was an anonymous node
// nothing in the graph could point at, sitting alongside the WebPage node
// Base.astro emits for the same URL: two page entities on one page. It now
// shares that node's @id (#webpage), so a consumer flattens them into one
// page that is BOTH a WebPage and a CollectionPage, which is what it is.
// `about` pointed at the Organization, saying this page is about the company;
// it is about DJ software and hardware, and naming those is what lets an
// answer engine match it to a question.
//
// And a collection with no mainEntity told a crawler nothing about what it
// collects. The ItemList below carries only the entries that HAVE a page.
// The "Coming soon" brands stay out on purpose: on screen they sit under a
// visible label a human reads, and in a machine-readable list, with no label
// to carry, they would read as a promise of content that does not exist.
const collected = [...software, ...equipment, ...hardware].filter((x) => x.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/knowledge#webpage',
  url: 'https://www.savemygig.com/knowledge',
  name: 'DJ software, equipment and hardware knowledge base',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  inLanguage: 'en',
  about: [
    { '@type': 'Thing', name: 'rekordbox' },
    { '@type': 'Thing', name: 'Pioneer DJ and AlphaTheta DJ equipment' },
    { '@type': 'Thing', name: 'DJ USB drives and storage' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    '@id': 'https://www.savemygig.com/knowledge#list',
    name: 'Reference pages in the Save My Gig knowledge base',
    numberOfItems: collected.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: collected.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: x.name,
      description: x.blurb,
      url: `https://www.savemygig.com${x.href}`,
    })),
  },
};
---
<Base
  title="DJ Software, Equipment and Hardware Reference | Save My Gig"
  description="Reference for the tools that run your set: rekordbox export and library formats, DJM-REC, Pioneer DJ and AlphaTheta players and mixers, and the drives."
  path="/knowledge"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <div class="status-line">KNOWLEDGE_BASE</div>
    <h1 style="margin-bottom:0.8rem">Master your <span class="accent">tools</span></h1>
    <p class="dim kb-lead">
      Your tools are the software that runs your library, the equipment that
      plays it, and the hardware that backs it up. This is the reference layer
      for all three: what each one actually does, where it breaks, and how to
      keep it from ruining your gig.
    </p>

    <h2 class="kb-h">Software</h2>
    <div class="kb-grid">
      {software.map(s => (
        s.href ? (
          <a class="kb-card kb-live" href={s.href}>
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-go">Open the guide &rarr;</span>
          </a>
        ) : (
          <div class="kb-card kb-soon">
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-tag">Coming soon</span>
          </div>
        )
      ))}
    </div>

    <h2 class="kb-h" style="margin-top:2rem">Equipment</h2>
    <div class="kb-grid">
      {equipment.map(s => (
        s.href ? (
          <a class="kb-card kb-live" href={s.href}>
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-go">Open the guide &rarr;</span>
          </a>
        ) : (
          <div class="kb-card kb-soon">
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-tag">Coming soon</span>
          </div>
        )
      ))}
    </div>

    <h2 class="kb-h" style="margin-top:2rem">Hardware</h2>
    <p class="dim kb-sub">
      Looking for what to buy rather than how it behaves? The drives we trust
      are on <a href="/gear">the gear page</a>.
    </p>
    <div class="kb-grid">
      {hardware.map(s => (
        s.href ? (
          <a class="kb-card kb-live" href={s.href}>
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-go">Open the guide &rarr;</span>
          </a>
        ) : (
          <div class="kb-card kb-soon">
            <span class="kb-name">{s.name}</span>
            <span class="kb-blurb">{s.blurb}</span>
            <span class="kb-tag">Coming soon</span>
          </div>
        )
      ))}
    </div>

    <!-- Audit fix: a visitor in look-it-up mode used to dead-end here. The
         site's actual reference depth lives in the fix articles and the FAQ,
         so the hub now points at them. -->
    <p class="dim" style="margin-top:1.6rem">
      Looking for a specific failure? The <a href="/faq">FAQ answers every
      common question</a> and links the full fix library. Just met a word you
      do not know? <a href="/knowledge/dictionary">The dictionary</a> defines
      every term that decides whether your USB plays.
    </p>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">Which tool is missing from this list?</h2>
      <p class="dim" style="margin-bottom:1rem">We build what DJs actually ask for. Tell us what you run and it moves up the list.</p>
      <a href="/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Tell us what you use</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">Official downloads and release notes: {VENDOR_LINKS.map((v, i) => (<Fragment>{i > 0 ? ' · ' : ''}<a href={v.url} rel="noopener">{v.name}</a></Fragment>))}</p>
  </main>
</Base>

<style>
  .kb-lead { max-width: 42rem; margin-bottom: 2rem; line-height: 1.6; }
  /* Sits between a section heading and its card grid. The Hardware section
     uses it to send buying-intent visitors to /gear, keeping the knowledge
     base itself purely about how a product behaves. */
  .kb-sub { max-width: 42rem; margin: -0.4rem 0 1rem; font-size: 0.92rem; line-height: 1.6; }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
  }
  /* Design language sprint, 2026-08-03: the card, the grid, the title, the
     blurb, the go-link and the coming-soon tag all moved to global.css. They
     were duplicated here, in the Pioneer hub, in /legal and in /partners, and
     the four copies had already drifted apart. */
</style>
