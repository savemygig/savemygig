     See the long note in djm-v10.astro for why a flex row was wrong. */
  .hw-head { position: relative; padding-right: 216px; display: flow-root; }
  .hw-thumb {
    position: absolute; bottom: 0; right: 0; width: 200px; height: 200px;
    display: flex; align-items: flex-end; justify-content: flex-end; z-index: 3;
  }
  .hw-thumb img { max-width: 100%; max-height: 100%; width: auto; height: auto; display: block; }
  @media (max-width: 640px) {
    .hw-head { padding-right: 0; }
    .hw-thumb {
      position: relative; width: 200px; height: 200px; margin: 0.5rem auto 0;
      align-items: center; justify-content: center;
    }
  }
  main p { color: var(--text-dim); line-height: 1.65; }
  main p strong { color: var(--text); }
  .rb-errors { margin-bottom: 0; }
  .rb-errors dt { font-weight: 700; color: var(--text); margin-top: 0.9rem; }
  .rb-errors dd { margin: 0.25rem 0 0; color: var(--text-dim); line-height: 1.6; }
  .rb-sources { font-size: 0.78rem; line-height: 1.6; margin-top: 2rem; padding-top: 1rem; border-top: var(--stroke) solid var(--edge-soft); }
  [id] { scroll-margin-top: 1.5rem; }
</style>
