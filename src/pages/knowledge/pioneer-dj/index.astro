---
import Base from '../../../layouts/Base.astro';

// Pioneer DJ / AlphaTheta hardware hub. This is the reusable pattern for
// every future manufacturer hub (Denon DJ, Allen & Heath, RANE...): a flat
// list of models by category, each either a live page or "Coming soon".
// Antonio's brief (2026-07-27): a professional field manual for the gear DJs
// actually meet in booths, not a rewritten product manual. Two pages are
// live and fully researched so far (the two most common club units); the
// rest are queued and should not be filled with unverified content, see the
// project doc on hardware-reference rollout for the priority order.
// Catalog per Antonio, 2026-07-27 evening pass: XDJ-700 joins the older
// players still working every week; DJM-V5 and euphonia join the mixers;
// all-in-ones trimmed to the four still very used (his list); Turntables
// added with the PLX-1000 only (the one with real booth presence, the
// PLX-500 is a home unit and the PLX-CRSS12 is niche); Effectors added
// with the RMX-1000 (the classic) and RMX-IGNITE (its successor).
const players = [
  { name: 'CDJ-3000X', href: '/knowledge/pioneer-dj/cdj-3000x' },
  { name: 'CDJ-3000', href: '/knowledge/pioneer-dj/cdj-3000' },
  { name: 'CDJ-2000NXS2', href: '/knowledge/pioneer-dj/cdj-2000nxs2' },
  { name: 'CDJ-2000NXS', href: null },
  { name: 'CDJ-1500X', href: null },
  { name: 'XDJ-1000MK2', href: null },
  { name: 'XDJ-700', href: null },
];
// Order inside each category is top of the line down to entry, Antonio's
// rule, matching how the players were already sorted. V10 and V10-LF are
// one card: same desk, the LF swaps in long channel faders and drops the
// crossfader, so a separate page would be a duplicate.
const mixers = [
  { name: 'DJM-V10 / V10-LF', href: '/knowledge/pioneer-dj/djm-v10' },
  { name: 'DJM-V5', href: null },
  { name: 'DJM-A9', href: '/knowledge/pioneer-dj/djm-a9' },
  { name: 'DJM-900NXS2', href: '/knowledge/pioneer-dj/djm-900nxs2' },
  { name: 'DJM-900NXS', href: null },
  { name: 'euphonia', href: null },
];
const allInOne = [
  { name: 'OPUS-QUAD', href: null },
  { name: 'XDJ-AZ', href: null },
  { name: 'XDJ-XZ', href: null },
  { name: 'XDJ-RX3', href: null },
];
const turntables = [
  { name: 'PLX-1000', href: null },
];
const effectors = [
  { name: 'RMX-1000', href: null },
  { name: 'RMX-IGNITE', href: null },
];
const controllers = [
  { name: 'DDJ-FLX10', href: null },
  { name: 'DDJ-1000', href: null },
  { name: 'DDJ-REV7', href: null },
  { name: 'DDJ-FLX4', href: null },
];

const categories = [
  { label: 'Players', items: players },
  { label: 'Mixers', items: mixers },
  { label: 'All-in-one systems', items: allInOne },
  { label: 'Turntables', items: turntables, note: 'The professional deck venues actually install. Vinyl coverage grows here as it earns it.' },
  { label: 'Effectors', items: effectors },
  { label: 'Controllers', items: controllers, note: 'Rare in clubs, but the standard for home preparation and mobile gigs.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pioneer DJ / AlphaTheta equipment reference',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  about: { '@id': 'https://www.savemygig.com/#org' },
};
---
<Base
  title="Pioneer DJ / AlphaTheta Equipment Reference | Save My Gig!"
  description="CDJs, XDJs, DJM mixers and DDJ controllers: the field manual for the gear you actually meet in professional DJ booths, not a rewritten product manual."
  path="/knowledge/pioneer-dj"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/knowledge">Knowledge base</a> <span aria-hidden="true">/</span> <span>Pioneer DJ / AlphaTheta</span>
    </nav>

    <div class="status-line">PIONEER_DJ</div>
    <h1 style="margin-bottom:0.8rem">Pioneer DJ / <span class="accent">AlphaTheta</span></h1>
    <p class="dim kb-lead">
      Not a rewritten product manual. This is the operational reference: what
      goes wrong, how to fix it fast, how experienced DJs actually run this
      gear, and how to stop the same failure happening at your next gig.
    </p>

    <!-- Cross-model entry point (2026-08-01). The firmware data was already on
         every model page but locked inside closed accordions, so nobody found
         it. Promoted here because "what is broken on this deck" is a question
         that comes before "which model am I looking at". -->
    <a class="pdj-matrix" href="/knowledge/pioneer-dj/firmware">
      <span class="pdj-matrix-k">Across every model</span>
      <span class="pdj-matrix-t">What's broken on that deck, by firmware version &rarr;</span>
      <span class="pdj-matrix-b">Read the version off the unit and see which documented faults are still live on it.</span>
    </a>

    <!-- Collapsible categories (Antonio): on a phone the six category
         headers ARE the index, tap one to expand it. On desktop there is
         room, so the inline script below opens everything before paint and
         the page reads as before. Native details/summary, no framework. -->
    {categories.map(cat => (
      <details class="kb-cat">
        <summary>
          <h2 class="kb-h">{cat.label}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        {cat.note && <p class="dim" style="margin-bottom:0.9rem;font-size:0.85rem">{cat.note}</p>}
        <div class="kb-grid">
          {cat.items.map(m => (
            m.href ? (
              <a class="kb-card kb-live" href={m.href}>
                <span class="kb-name">{m.name}</span>
                <span class="kb-go">Open the guide &rarr;</span>
              </a>
            ) : (
              <div class="kb-card kb-soon">
                <span class="kb-name">{m.name}</span>
                <span class="kb-tag">Coming soon</span>
              </div>
            )
          ))}
        </div>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every category before first interaction.
      // Phones keep them collapsed so the category list is the index.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.kb-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">Which tool is missing from this list?</h2>
      <p class="dim" style="margin-bottom:1rem">We build what DJs actually ask for. Tell us what you run and it moves up the list.</p>
      <a href="/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Tell us what you use</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      Looking for library and export questions instead? <a href="/knowledge/pioneer-dj/rekordbox">The rekordbox reference</a> covers that.
    </p>
  </main>
</Base>

<style>
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  .kb-lead { max-width: 42rem; margin-bottom: 1.5rem; line-height: 1.6; }
  /* Firmware matrix promo. Green (the site's "you are fine / go" tone) rather
     than red: this is a prevention tool, not an alarm. */
  .pdj-matrix {
    display: block; text-decoration: none;
    background: var(--green-dim); border: 1px solid var(--green-border);
    border-radius: var(--radius); padding: 1.1rem 1.25rem; margin-bottom: 1.8rem;
  }
  .pdj-matrix-k {
    display: block; font-family: var(--font-display); font-size: 0.68rem;
    font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-faint); margin-bottom: 0.35rem;
  }
  .pdj-matrix-t {
    display: block; color: var(--text); font-weight: 700;
    font-size: 1.02rem; line-height: 1.3; margin-bottom: 0.3rem;
  }
  .pdj-matrix-b { display: block; color: var(--text-dim); font-size: 0.88rem; line-height: 1.55; }
  .pdj-matrix:hover .pdj-matrix-t { color: var(--red); }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0; flex: 1;
  }
  .kb-cat { margin-top: 1.6rem; }
  .kb-cat > summary {
    display: flex; align-items: center; gap: 0.8rem;
    border-bottom: 1px solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
  .kb-cat > summary::-webkit-details-marker { display: none; }
  .kb-cat > summary:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
  .kb-chev {
    flex: 0 0 auto; width: 8px; height: 8px; margin-top: -3px;
    border-right: 2px solid var(--text-dim); border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg); transition: transform 0.2s ease;
  }
  .kb-cat[open] > summary .kb-chev { transform: rotate(225deg); }
  @media (prefers-reduced-motion: reduce) { .kb-chev { transition: none; } }
  .kb-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.9rem; }
  .kb-card {
    display: flex; flex-direction: column; gap: 0.4rem;
    background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.1rem 1.2rem; text-decoration: none;
  }
  .kb-live { transition: border-color 0.15s ease; }
  .kb-live:hover { border-color: var(--red); }
  .kb-soon { opacity: 0.62; }
  .kb-name {
    font-family: var(--font-display); font-weight: 800; font-size: 1.02rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: var(--text);
  }
  .kb-go { color: var(--red); font-size: 0.82rem; font-weight: 600; margin-top: 0.2rem; }
  .kb-tag {
    font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-faint); margin-top: 0.2rem;
  }
</style>
