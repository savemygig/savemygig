---
import Base from '../layouts/Base.astro';
// Emergency landing (the browsable entry, not the sealed rescue tunnel).
// Now uses the shared Base layout so it carries the site menu + footer and
// lines up on the same content width as every other page. The step-by-step
// panic flow (/protocol/*) stays deliberately menu-free.

---
<Base
  title="USB Not Detected? CDJ 2000, CDJ 3000 & XDJ Emergency Fix | Save My Gig"
  description="USB not detected on Pioneer CDJ-3000, CDJ-2000 or XDJ? Rekordbox export failed? Emergency guidance for DJs during live sets or file recovery. Stay calm. Save your gig."
  path="/emergency"
>
  <meta slot="head" name="apple-mobile-web-app-capable" content="yes" />
  <meta slot="head" name="format-detection" content="telephone=no" />

  <main class="wrap emerg">
    <p class="status-line red">EMERGENCY_MODE</p>
    <h1 class="emerg-h1">USB not detected<br />or <span class="accent">fail?</span></h1>
    <p class="emerg-lead">
      Emergency guidance when USB drives fail on Pioneer CDJ-3000, CDJ-2000, XDJ units or during Rekordbox export.
    </p>

    <div class="action-stack emerg-actions">
      <a href="#triage" class="btn-heartbeat" data-event="generate_lead" data-label="enter_emergency_mode">
        <span class="led led-g" aria-hidden="true"></span>
        ENTER EMERGENCY MODE
      </a>

      <div class="alert-card" role="alert">
        <div style="font-size:20px" aria-hidden="true">⚠️</div>
        <div>
          If your USB isn't responding or tracks won't load, stay calm. This guide helps you continue playing or recover your files safely later.
        </div>
      </div>

      <a href="https://buymeacoffee.com/savemygig" class="btn-quiet" data-event="affiliate_click" data-program="bmc" data-placement="emergency_hero">
        SUPPORT THE PROJECT ☕
      </a>
    </div>

    <section id="triage" class="emerg-triage">
      <h2 class="emerg-triage-h">How long until you play?</h2>
      <p class="dim emerg-triage-sub">Select your emergency status to begin.</p>

      <nav class="pad-grid">
        <a href="/protocol/critical" class="pad pad-red" data-event="triage_selected" data-path="critical">
          <div class="pad-header">
            <div class="led led-r"></div>
            <div class="pad-title">&lt; 60 MINUTES</div>
          </div>
          <div class="pad-desc">Critical triage. Immediate hardware workarounds and bypasses to get the music playing now.</div>
        </a>

        <a href="/protocol/quick-fix" class="pad pad-yellow" data-event="triage_selected" data-path="quick_fix">
          <div class="pad-header">
            <div class="led led-y"></div>
            <div class="pad-title">1 TO 3 HOURS</div>
          </div>
          <div class="pad-desc">Rapid diagnostic. Library repair and database reconstruction before soundcheck.</div>
        </a>

        <a href="/protocol/full-recovery" class="pad pad-green" data-event="triage_selected" data-path="full_recovery">
          <div class="pad-header">
            <div class="led led-g"></div>
            <div class="pad-title">TOMORROW / LATER</div>
          </div>
          <div class="pad-desc">Deep maintenance. Comprehensive formatting and Rekordbox stabilization protocol.</div>
        </a>
      </nav>
    </section>

    <p class="dim emerg-note">
      Designed for professional and semi-professional DJs facing USB errors, emergency loop mode, Rekordbox export issues or corrupted pen drives.
    </p>

    <section class="emerg-problems">
      <h2 class="emerg-problems-h">Common CDJ &amp; XDJ USB problems</h2>
      <ul class="problem-list">
        <li><a href="/fix/usb-not-recognized-cdj">USB not detected on CDJ 2000/3000 &amp; XDJ</a></li>
        <li><a href="/fix/cdj-error-e-8302">Error E-8302, E-8305, E-8306</a></li>
        <li><a href="/fix/playlists-not-showing-cdj">Playlists not showing</a></li>
        <li><a href="/fix/waveforms-not-loading-cdj">Waveforms not loading</a></li>
        <li><a href="/fix/emergency-loop-mode">Emergency Loop mode triggered</a></li>
        <li><a href="/fix/rekordbox-export-failed">Rekordbox export failure</a></li>
        <li><a href="/fix/rekordbox-not-detecting-usb">Rekordbox not detecting the USB</a></li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .emerg-h1 { font-size: clamp(2.1rem, 8vw, 3.4rem); margin-bottom: 0.9rem; }
  .emerg-lead { color: var(--text-dim); font-size: 1rem; line-height: 1.6; max-width: 40rem; margin-bottom: 2rem; }
  .emerg-actions { max-width: 100%; margin: 0 0 2.6rem; }
  .emerg-triage { margin-top: 1rem; }
  .emerg-triage-h { font-size: clamp(1.5rem, 5vw, 2rem); text-transform: none; letter-spacing: -0.01em; margin-bottom: 0.4rem; border: none; }
  .emerg-triage-sub { font-size: 0.95rem; margin-bottom: 1.4rem; }
  .emerg-note { font-size: 0.95rem; line-height: 1.6; margin: 2.4rem 0; }
  .emerg-problems { margin-top: 1rem; }
  .emerg-problems-h { font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--edge); padding-bottom: 0.6rem; margin-bottom: 1rem; }
  .problem-list a { color: var(--text); text-decoration: none; }
  .problem-list a:hover { color: var(--red); }
</style>
