---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
// Layout replicated from original emergency.html (v.B) + choose.html triage,
// evolved: triage lives on this page, the old extra click is gone.

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Why is my USB not detected on CDJ 2000 or CDJ 3000?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most USB detection issues on Pioneer CDJ players are caused by incorrect formatting, corrupted files or improper Rekordbox export.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I fix Rekordbox export problems?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Reformat the USB drive to FAT32 using MBR partition style and re-export your library using Rekordbox Export Mode.',
      },
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="format-detection" content="telephone=no" />
  <title>USB Not Detected? CDJ 2000, CDJ 3000 & XDJ Emergency Fix | Save My Gig</title>
  <meta name="description" content="USB not detected on Pioneer CDJ-3000, CDJ-2000 or XDJ? Rekordbox export failed? Emergency guidance for DJs during live sets or file recovery. Stay calm. Save your gig." />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="canonical" href="https://www.savemygig.com/emergency" />
  <meta property="og:title" content="Emergency DJ Rescue - USB Not Detected?" />
  <meta property="og:description" content="Emergency guidance for DJs when USB drives fail on Pioneer units. Stay calm and save your gig." />
  <meta property="og:url" content="https://www.savemygig.com/emergency" />
  <meta property="og:image" content="https://www.savemygig.com/images/dj-usb-not-detected-emergency.webp" />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" as="image" href="/images/dj-usb-not-detected-emergency.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@300;400;500;600&display=swap" />
  <Analytics />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</head>
<body>

<header class="hero">
  <img src="/images/dj-usb-not-detected-emergency.webp" alt="Pioneer CDJ USB error background" class="hero-img" />
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <h1>USB NOT DETECTED OR FAIL?</h1>
    <p class="dim" style="font-size:clamp(15px,3.5vw,17px);color:#f5f5f5;line-height:1.5;margin-bottom:35px">
      Emergency guidance when USB drives fail on Pioneer CDJ-3000, CDJ-2000, XDJ units or during Rekordbox export.
    </p>

    <nav class="action-stack" aria-label="Primary actions">
      <a href="#triage" class="btn-heartbeat" data-event="generate_lead" data-label="enter_emergency_mode">
        <span class="led led-g" aria-hidden="true"></span>
        ENTER EMERGENCY MODE
      </a>

      <div class="alert-card" role="alert">
        <div style="font-size:20px" aria-hidden="true">⚠️</div>
        <div>
          If your USB isn't responding or tracks won't load, stay calm. This guide helps you continue playing or recover your files safely later.
        </div>
      </div>

      <a href="https://buymeacoffee.com/savemygig" class="btn-quiet" data-event="affiliate_click" data-program="bmc" data-placement="emergency_hero">
        SUPPORT THE PROJECT ☕
      </a>
    </nav>
  </div>
</header>

<main style="max-width:600px;margin:auto;padding:10px 20px calc(80px + env(safe-area-inset-bottom))">

  <section id="triage" style="padding-top:30px">
    <div style="margin:20px 0 25px">
      <h2 style="font-size:24px;margin:0 0 6px 0;border:none;text-transform:none;letter-spacing:0.04em">How long until you play?</h2>
      <p class="dim" style="font-size:15px">Select your emergency status to begin.</p>
    </div>

    <nav class="pad-grid">
      <a href="/protocol/critical" class="pad pad-red" data-event="triage_selected" data-path="critical">
        <div class="pad-header">
          <div class="led led-r"></div>
          <div class="pad-title">&lt; 60 MINUTES</div>
        </div>
        <div class="pad-desc">Critical triage. Immediate hardware workarounds and bypasses to get the music playing now.</div>
      </a>

      <a href="/protocol/quick-fix" class="pad pad-yellow" data-event="triage_selected" data-path="quick_fix">
        <div class="pad-header">
          <div class="led led-y"></div>
          <div class="pad-title">1 TO 3 HOURS</div>
        </div>
        <div class="pad-desc">Rapid diagnostic. Library repair and database reconstruction before soundcheck.</div>
      </a>

      <a href="/protocol/full-recovery" class="pad pad-green" data-event="triage_selected" data-path="full_recovery">
        <div class="pad-header">
          <div class="led led-g"></div>
          <div class="pad-title">TOMORROW / LATER</div>
        </div>
        <div class="pad-desc">Deep maintenance. Comprehensive formatting and Rekordbox stabilization protocol.</div>
      </a>
    </nav>
  </section>

  <section>
    <p class="dim" style="font-size:15px;line-height:1.6;margin-bottom:30px">
      Designed for professional and semi-professional DJs facing USB errors, emergency loop mode, Rekordbox export issues or corrupted pen drives.
    </p>
  </section>

  <section>
    <h2 style="font-size:18px;text-transform:uppercase;letter-spacing:1px;margin:0 0 16px 0;border-bottom:1px solid #333;padding-bottom:8px">Common CDJ &amp; XDJ USB Problems</h2>
    <ul class="problem-list">
      <li><a href="/fix/usb-not-recognized-cdj" style="color:inherit;text-decoration:none">USB not detected on CDJ 2000/3000 &amp; XDJ</a></li>
      <li><a href="/fix/cdj-error-e-8302" style="color:inherit;text-decoration:none">Error E-8302, E-8305, E-8306</a></li>
      <li>Playlists not showing</li>
      <li>Waveforms not loading</li>
      <li><a href="/fix/emergency-loop-mode" style="color:inherit;text-decoration:none">Emergency Loop mode triggered</a></li>
      <li><a href="/fix/rekordbox-export-failed" style="color:inherit;text-decoration:none">Rekordbox export failure</a></li>
    </ul>
  </section>

  <footer style="text-align:center;margin-top:50px;color:#555;font-size:12px;line-height:1.8">
    <a href="/" style="color:#888">← Home</a> · <a href="/prepare" style="color:#888">Prevention</a> · <a href="mailto:savemygig@gmail.com" style="color:#888">Contact</a><br />
    All rights reserved. · 2026 savemygig.com
  </footer>

</main>
</body>
</html>
