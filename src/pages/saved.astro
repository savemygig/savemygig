---
import Base from '../layouts/Base.astro';
import InstallNudge from '../components/InstallNudge.astro';
import EmailCapture from '../components/EmailCapture.astro';
import Icon from '../components/Icon.astro';
// Affiliate/product links: placeholders marked TODO until accounts exist.
---
<Base
  title="You're Back On! | Save My Gig"
  description="You made it. Your set is saved. Here's how to make sure this never happens again."
  path="/saved"
  noindex
>
  <main class="wrap">
    <div class="status-line" >Ready_To_Play</div>

    <h1 class="accent" style="margin-bottom:1rem">YOU'RE BACK ON.</h1>
    <p style="margin-bottom:0.5rem">The room is playing again. <strong>The rest is your set.</strong></p>
    <p class="dim" style="margin-bottom:3rem">After the gig: delete the temporary files from any computer you used.</p>

    {/* THE INSTALL RECOMMENDATION, IN THE BEST SLOT ON THE SITE.
        This is the screen a DJ reaches when the rescue WORKED, so it is the one
        moment the product has already earned the ask. It sits directly after
        the payoff and BEFORE the prevention panel on purpose: "keep this on
        your phone" is a thirty second ask and "spend an hour building a
        prevention system" is not, and the smaller ask earns the earlier slot.
        See src/components/InstallNudge.astro for why an install, specifically,
        is what makes the offline promise durable on iOS. */}
    <InstallNudge path="/saved" placement="saved_primary" />

    <section class="panel panel-go" style="margin-bottom:1.5rem">
      <h2 style="margin-bottom:0.75rem">Never live this emergency again</h2>
      <p class="dim">This one had a happy ending. The next is not guaranteed, unless you make it guaranteed. The prevention system takes about an hour to set up.</p>
      <a href="/prepare" class="btn btn-solid" data-event="step_completed" data-step="prepare_click" data-placement="saved_hero"><Icon name="shield" /> Set up the prevention system
      </a>
    </section>

    <!-- Hidden for the no-sound arrivals: their whole branch premise was
         "nothing is broken on your drive" (a crossfader assign, a cable, a cue
         mix). Telling that DJ to retire a drive that never failed reads as a
         site that was not listening, on the page where trust pays out. -->
    <section class="panel" id="retirePanel" style="margin-bottom:1.5rem">
      <h3 style="margin-bottom:0.75rem">Retire the drive that betrayed you</h3>
      <p class="dim">A USB that failed once will fail again. These are the drives that don't do this:</p>
      <a href="/gear" class="btn btn-neutral" data-event="affiliate_click" data-program="gear_page" data-placement="saved"><Icon name="usb" /> See the approved drives
      </a>
    </section>
    <script>
      if (new URLSearchParams(location.search).get('path') === 'no_sound') {
        const p = document.getElementById('retirePanel');
        if (p) p.remove();
      }
    </script>

    <div style="margin-bottom:1.5rem">
      <EmailCapture
        source="saved"
        title="Keep the Emergency Card"
        blurb="The one-page quick reference for USB disasters. It is free to read any time, and we will email you the printable version so it is on your phone for the next dark booth."
      />
    </div>

    <p class="dim" style="margin-top:2rem">
      Did this save your gig? <a href="https://buymeacoffee.com/savemygig" data-event="affiliate_click" data-program="bmc" data-placement="saved">Buy us a coffee</a>
      · or just <a href="mailto:info@savemygig.com">tell us it worked</a>
    </p>
  </main>
</Base>
