---
import Base from '../layouts/Base.astro';

// Partners page (Antonio's spec, 2026-07-28). Ships empty but structurally
// final: the card grid below is the layout real partners drop into, no
// redesign needed later. NOINDEX until the first real partner is published,
// then remove the noindex prop AND the /partners entries in astro.config.mjs
// and search-index.json.js EXCLUDE lists.
//
// A future partner card is one object here. Every field maps to the card
// template in the grid below:
//   {
//     name: 'Company',                          // company name
//     logo: '/images/partners/company.png',     // OUR asset, licensed/provided. Never scraped.
//     blurb: 'One or two lines on why DJs should care.',
//     href: 'https://...',                      // outbound (affiliate ok, disclose per /legal/disclaimer)
//     cta: 'Visit',                             // Visit / Learn more / Get discount
//   }
const partners = [];
---
<Base
  title="Partners | Save My Gig!"
  description="Trusted companies, services, products and resources across the DJ ecosystem: gear, software, education, music, accessories and professional services."
  path="/partners"
  noindex
>
  <main class="wrap">
    <div class="status-line">PARTNERS</div>
    <h1 style="margin-bottom:0.8rem">Trusted <span class="accent">partners</span></h1>
    <p class="dim pt-lead">
      Save My Gig recommends trusted companies, services, products, and
      resources that help DJs perform at their best. From gear and software to
      education, music, accessories, and professional services, every partner
      on this page is selected because it brings real value to DJs and the
      electronic music community.
    </p>
    <p class="dim pt-lead">
      Every recommendation earns its place the same way everything else on this
      site does: it has to be genuinely useful, trustworthy, and relevant.
      Nothing here ever appears inside the emergency rescue flow.
    </p>

    {partners.length > 0 ? (
      <div class="pt-grid">
        {partners.map(p => (
          <div class="pt-card">
            <img class="pt-logo" src={p.logo} alt={`${p.name} logo`} loading="lazy" />
            <span class="pt-name">{p.name}</span>
            <span class="pt-blurb">{p.blurb}</span>
            <a class="btn btn-neutral pt-cta" href={p.href} rel="noopener sponsored">{p.cta}</a>
          </div>
        ))}
      </div>
    ) : (
      <div class="panel pt-empty">
        <p style="margin:0">Our trusted partners will be listed here soon.</p>
      </div>
    )}

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      Represent a company that belongs here? Write to
      <a href="mailto:info@savemygig.com">info@savemygig.com</a>.
    </p>
  </main>
</Base>

<style>
  .pt-lead { max-width: 42rem; margin-bottom: 2rem; line-height: 1.6; }
  .pt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.9rem; }
  .pt-card {
    display: flex; flex-direction: column; gap: 0.5rem;
    background: var(--surf); border: 1px solid var(--edge); border-radius: var(--radius);
    padding: 1.2rem 1.3rem;
    transition: border-color 0.15s ease;
  }
  .pt-card:hover { border-color: var(--red); }
  .pt-logo { width: 48px; height: 48px; object-fit: contain; margin-bottom: 0.3rem; }
  .pt-name {
    font-family: var(--font-display); font-weight: 800; font-size: 1.1rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: var(--text);
  }
  .pt-blurb { color: var(--text-dim); font-size: 0.88rem; line-height: 1.5; flex: 1; }
  .pt-cta { width: auto; align-self: flex-start; padding: 0.55rem 1.3rem; margin-top: 0.4rem; }
  .pt-empty { text-align: center; color: var(--text-dim); padding: 2.2rem 1.3rem; }
</style>
