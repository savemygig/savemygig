  // WHAT YOU DOWNLOAD IS WHAT IS ON SCREEN. Antonio's rule, and it is the only
  // honest one: "if it is clear, it's clear. If it is fulfilled, it's
  // fulfilled." The old button served a pre-made static PDF of the default
  // list, which silently ignored every rename, removal, custom item and tick.
  // Email already sent the real list; Download lied. Now the document is built
  // from the live DOM at the moment of the tap: current mode, current order,
  // current names, current ticks. The browser's own print-to-PDF does the
  // rendering, which needs no library and matches paper size to the user.
  function printCurrentList() {
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c));
    const allNotes = mode === 'custom' ? loadNotes() : {};
    const groups: { title: string; notes: string; items: { label: string; done: boolean }[] }[] = [];
    document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => {
      if (getComputedStyle(g).display === 'none') return; // removed category
      const gid = g.getAttribute('data-group') || '';
      const title = (g.querySelector('.group-title')?.textContent || '').trim();
      const items: { label: string; done: boolean }[] = [];
      g.querySelectorAll<HTMLElement>('li.task').forEach((li) => {
        // Hidden rows are hidden for a reason: removed in Custom, or above the
        // current mode's level. But a COLLAPSED section is tidiness, not
        // deletion, so the check is the row's own computed display, which
        // offsetParent got wrong: it silently dropped every collapsed section
        // from the printout.
        if (getComputedStyle(li).display === 'none') return;
        const label = (li.querySelector('.task-label')?.textContent || '').trim();
        const done = !!li.querySelector<HTMLInputElement>('input[type=checkbox]')?.checked;
        if (label) items.push({ label, done });
      });
      const notes = (allNotes[gid] || '').trim();
      if (items.length || notes) groups.push({ title, notes, items });
    });

    const total = groups.reduce((n, g) => n + g.items.length, 0);
    const done = groups.reduce((n, g) => n + g.items.filter((i) => i.done).length, 0);

    const rows = (items: { label: string; done: boolean }[]) => items.map((it) =>
      `<li class="${it.done ? 'done' : ''}"><span class="bx">${it.done ? '&#10003;' : ''}</span>${esc(it.label)}</li>`
    ).join('');
    const sectionHtml = (g: typeof groups[number]) =>
      `<section><h2>${esc(g.title)}</h2><ul>${rows(g.items)}</ul>${g.notes ? `<p class="gnotes">${notesHtml(g.notes).replace(/\n/g, '<br />')}</p>` : ''}</section>`;

    // COLUMN BALANCING IN JS, NOT IN CSS (2026-08-04).
    // The first rebuild used `column-count: 2`, which is the obvious answer
    // and the wrong one: CSS multicol inside paged media fragments badly in
    // Chrome. With the 48-item Advanced list it pushed EVERY section past the
    // first column and printed a completely blank page one. So the split is
    // computed here instead, greedily, by estimated height (one unit per row
    // plus two for the heading and two more for a notes block). Two plain
    // blocks side by side cannot fragment the way a multicol container does,
    // and because each column ends up roughly half as tall, nothing needs to
    // break in the first place.
    const weight = (g: typeof groups[number]) => g.items.length + 2 + (g.notes ? 2 : 0);
    const colA: typeof groups = [];
    const colB: typeof groups = [];
    let wA = 0, wB = 0;
    groups.forEach((g) => {
      // Keep source order within each column: a DJ reads Music before Logistics.
      if (wA <= wB) { colA.push(g); wA += weight(g); } else { colB.push(g); wB += weight(g); }
    });
    // Short lists go SINGLE column. Two columns is what makes a 48-row
    // Advanced sheet fit, but it made the 19-row Base sheet sit in the top
    // half of the paper with the bottom half blank, which looks like the
    // print failed rather than like a designed sheet. Above 22 rows the page
    // needs the second column; below it, one roomy column fills the sheet.
    const twoUp = groups.length > 1 && total > 22;
    const sections = twoUp
      ? `<div class="col">${colA.map(sectionHtml).join('')}</div><div class="col">${colB.map(sectionHtml).join('')}</div>`
      : `<div class="col">${groups.map(sectionHtml).join('')}</div>`;

    // DENSITY. A 19-item Base list set at the density a 48-item Advanced list
    // needs would leave half the sheet blank, which reads as unfinished. The
    // sheet picks one of three densities from the row count so every mode
    // fills its page instead of floating at the top of it.
    const density = total <= 22 ? 'roomy' : total <= 40 ? 'normal' : 'tight';

    const modeLabel = mode === 'advanced' ? 'Avanzada' : mode === 'custom' ? 'Personal' : 'Base';
    const d = new Date();
    const stamp = d.toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric' });
    const fileStamp = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    const art = (id: string) => (document.getElementById(id) as HTMLTemplateElement | null)?.innerHTML || '';

    const w = window.open('', '_blank');
    if (!w) return false; // popup blocked; callers tell the user, not silence
    w.document.write(`<!doctype html><html lang="es"><head><meta charset="utf-8" />
<title>save-my-gig-checklist-${fileStamp}</title>
<style>
  /* THE PRINTED SHEET, rebuilt 2026-08-04: better organized, better
     publicity, and one page.
     NOTE FOR WHOEVER EDITS THIS NEXT: everything between these backticks is
     DATA, not source. It is written into the print window verbatim, so a
     comment here ships to the visitor and no minifier will ever strip it.
     The faceless check caught a first name in this very block.

     WHY IT USED TO SPILL ONTO A SECOND PAGE CARRYING ONE LINE OF TEXT:
     nothing here controlled the page box. The old sheet set body{margin:36px}
     and left the rest to whatever the browser chose, so the real height
     depended on the visitor's paper size, default print margins and font
     metrics. It cleared an A4 page by about 20px, which is not a margin, it
     is luck. Letter paper is 18mm shorter than A4, macOS renders Arial
     slightly wider than Linux, and Advanced mode adds rows: any one of those
     pushed the footer alone onto page two.

     THREE THINGS MAKE ONE PAGE STRUCTURAL NOW, not lucky:
       1. @page owns the margin, so the sheet is the same on every machine
          and every paper size, and no browser default gets a vote.
       2. The columns halve the height. Even Custom with every row showing
          fits, and Base now clears the page with room to spare instead of
          20px.
       3. The footer is position:fixed, so in paged media it is painted into
          the page margin. A fixed element CANNOT generate a page of its own,
          which is the specific bug he saw. Worst case it repeats on page two
          of a very long Custom list, which is correct behaviour for a
          running footer. */
  @page { margin: 11mm 12mm 14mm; }
  * { box-sizing: border-box; }
  body {
    font: 10.5pt/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    color: #111; margin: 0;
    /* The footer is fixed, so it is painted OVER the content box. Reserve its
       height here or the last row of a full sheet is printed under it: the
       48-row Advanced list lost the word "Deodorant" to exactly that. */
    padding: 0 0 13mm;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }

  /* Masthead. The lockup is the real brand asset, recoloured for ink: the
     off-white becomes near-black, the warm grey becomes mid-grey, and GIG
     keeps the brand red, so a printed sheet and the screen agree. */
  .mast { display: flex; align-items: flex-end; justify-content: space-between; gap: 10mm;
          border-bottom: 2px solid #ff4d2e; padding-bottom: 3mm; margin-bottom: 5mm; }
  .mast-lock svg { display: block; width: 46mm; height: auto; }
  .mast-meta { text-align: right; font-size: 8pt; line-height: 1.5; color: #666; white-space: nowrap; }
  .mast-meta b { display: block; font-size: 9pt; color: #111; letter-spacing: 0.08em; text-transform: uppercase; }

  h1 { font-size: 17pt; line-height: 1.1; margin: 0 0 1mm; text-transform: uppercase; letter-spacing: -0.01em; }
  .sub { color: #666; font-size: 8.5pt; margin: 0 0 5mm; }
  .sub b { color: #111; }

  /* Two plain blocks side by side, balanced in JS. Not multicol: see the
     note in the builder for why that printed a blank first page.
     Density is picked from the row count so a 19-item Base sheet and a
     48-item Advanced sheet both fill their page instead of one of them
     floating in the top third. */
  .cols { display: flex; align-items: flex-start; gap: 9mm; }
  .col { flex: 1 1 0; min-width: 0; }
  /* Tuned against LETTER, not A4: US paper is 18mm shorter, so a sheet that
     fits Letter fits both, and a sheet tuned on A4 spills in the US. Measured
     empirically at 933px of content against Letter's ~960px box, so the Base
     sheet fills its page and still has nowhere to overflow to. */
  body.roomy  { --rowpad: 1.5mm; --rowsize: 9.8pt;  --seclead: 4.4mm; --bx: 3.9mm; }
  body.normal { --rowpad: 1.2mm; --rowsize: 9.4pt;  --seclead: 4mm;   --bx: 3.6mm; }
  /* The 48-row Advanced list cleared A4 at 1.0mm/9.2pt but needed a second
     Letter page. 0.9mm/9pt fits BOTH, and 9pt is still comfortably above the
     8pt floor where a checklist stops being readable in booth light. */
  body.tight  { --rowpad: 0.8mm; --rowsize: 8.8pt;  --seclead: 3.3mm; --bx: 3.3mm; }
  section { break-inside: avoid; margin: 0 0 var(--seclead); }
  h2 { font-size: 8.5pt; text-transform: uppercase; letter-spacing: 0.1em; color: #111;
       border-bottom: 1px solid #cfcbc4; padding-bottom: 1.2mm; margin: 0 0 2.5mm; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { position: relative; padding: var(--rowpad) 0 var(--rowpad) 7mm;
       font-size: var(--rowsize); line-height: 1.35; break-inside: avoid; }
  /* Real boxes, big enough to tick with a pen in a dark booth. The old sheet
     wrote var(--stroke) and var(--radius) here, which are defined in the
     site's stylesheet and do NOT exist in this document: both declarations
     were invalid, so the boxes had no radius and the rows had no rule. */
  .bx { position: absolute; left: 0; top: 1.5mm; width: var(--bx); height: var(--bx);
        border: 0.9pt solid #555; border-radius: 0.6mm; font-size: 8pt;
        line-height: calc(var(--bx) - 0.4mm); text-align: center; }
  li.done { color: #8a8a8a; }
  li.done .bx { border-color: #2f9e5f; color: #2f9e5f; }
  .gnotes { margin: 1.5mm 0 0 6.5mm; padding: 1.8mm 2.5mm; font-size: 8.5pt; color: #444;
            border-left: 2px solid #ff4d2e; background: #f6f5f3; break-inside: avoid; }

  /* Fixed, therefore painted in the page margin, therefore incapable of
     creating the orphan page this replaced. */
  .foot { position: fixed; left: 0; right: 0; bottom: 0;
          display: flex; align-items: center; justify-content: space-between; gap: 6mm;
          border-top: 1px solid #ddd; padding-top: 2mm; font-size: 7.5pt; color: #666; }
  .foot-l b { color: #111; }
  .foot-r { display: flex; align-items: center; gap: 2.5mm; text-align: right; }
  /* 16mm, not 13: at 33 modules a 13mm code is 0.39mm per module, which is
     under the ~0.5mm most phone cameras want off paper in booth light. */
  .foot-r svg { display: block; width: 16mm; height: 16mm; }
  .qr-cap { line-height: 1.35; }
  .qr-cap b { display: block; color: #111; font-size: 8pt; }
</style></head><body class="${density}">
<div class="mast">
  <div class="mast-lock">${art('printLockup')}</div>
  <div class="mast-meta"><b>Lista ${esc(modeLabel)}</b>${esc(stamp)}</div>
</div>
<h1>Checklist pre-gig</h1>
<p class="sub"><b>${done} de ${total} listos</b> cuando se imprimió esto. Marca el resto antes de salir.</p>
<div class="cols">${sections}</div>
<div class="foot">
  <div class="foot-l">¿Algo falla en el booth? <b>savemygig.com/es/emergency</b></div>
  <div class="foot-r">
    <div class="qr-cap"><b>savemygig.com</b>Escanea para tu propio checklist.<br />Gratis, sin registro.</div>
    ${art('printQr')}
  </div>
</div>
<script>window.onload = function () { window.print(); };<\/script>
</body></html>`);
    w.document.close();
    return true;
  }

  // The PDF sits behind the same registration as Advanced and Custom. This is
  // a SOFT gate, deliberately: it is a fair ask, not a lock, and nothing
  // safety-critical is ever behind it.
  const pdfBtn = document.getElementById('pdfBtn');
  if (pdfBtn) {
    pdfBtn.addEventListener('click', () => {
      if (isUnlocked()) {
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'Tu navegador bloqueó la ventana de descarga. Permite las ventanas emergentes para este sitio y toca de nuevo.';
          backupMsg.className = 'backup-msg err';
        }
        return;
      }
      pendingWant = 'pdf';
      openGate();
    });
  }

  // mode buttons: Advanced and Custom are gated behind an account.
  // Round 7 (Antonio, "final instructions"): this used to open a SEPARATE
  // registration gate (#unlock) with its own copy and its own email form.
  // He wants Advanced, Custom and Sync to all lead to the exact same place:
  // the account card, same "one account, no password, ever" copy, same
  // Google-first flow. So this now just opens #acctCard, exactly like
  // clicking Sync does -- see applyPendingModeIfAny() below for what
  // happens once sign-in actually completes.
  // THE TAP HAS TO VISIBLY GO SOMEWHERE (2026-08-06). Tapping a locked mode
  // used to do three things a calm visitor could not connect: nothing to the
  // segmented control (correct, the mode did not change), nothing to the
  // scroll position, and it revealed an unlabelled account card about 140px
  // further down. Read from the top of the page that is a dead button. Now the
  // card says which list was asked for and the page moves to it.
  const GATE_HEADS: Record<string, string> = {
    advanced: 'La lista Avanzado necesita una cuenta gratis',
    custom: 'La lista Personal necesita una cuenta gratis',
  };
  function openAcctGate(target: string) {
    const h = document.getElementById('acctGateH');
    if (h) { h.textContent = GATE_HEADS[target] || ''; h.hidden = !GATE_HEADS[target]; }
    if (acctCard) acctCard.hidden = false;
    if (acctLine) acctLine.setAttribute('aria-expanded', 'true');
    // Same reduced-motion gate as every other scroll on this page.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (acctCard) acctCard.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    // Tapping a locked Advanced or Custom IS a first approach to the account,
    // so it is one of the four triggers. Everything visible has already
    // happened by this line: the heading, the reveal and the scroll all come
    // out of markup that is in the document, so the tap answers instantly and
    // the sign-in controls inside the card wake up a moment later.
    loadAccounts();
  }
  // Opened from the Sync chip the card explains itself, so the heading must
  // not survive from an earlier locked-tab tap and mislabel it.
  function clearAcctGateHead() {
    const h = document.getElementById('acctGateH');
    if (h) { h.textContent = ''; h.hidden = true; }
  }
  modeBtns.forEach((b) => b.addEventListener('click', () => {
    const target = b.dataset.modeSet || 'basic';
    if ((target === 'advanced' || target === 'custom') && !isUnlocked()) {
      pendingMode = target;
      setPendingMode(target);
      openAcctGate(target);
      return;
    }
    if (unlockEl) unlockEl.hidden = true;
    setMode(target);
  }));

  // unlock form: instant access, confirmation email fires in the background
  if (unlockForm) {
    let unlockBusy = false;
    unlockForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (unlockBusy) return; // double-tap sends double emails
      const inp = unlockForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = (inp.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        if (unlockMsg) { unlockMsg.textContent = 'Ese correo no se ve bien. Revísalo e intenta de nuevo.'; unlockMsg.className = 'unlock-msg err'; }
        inp.focus();
        return;
      }
      // The form is novalidate (custom messages), so the artist field's
      // required attribute is decorative: THIS is the real check. Antonio
      // caught the hole registering email-only in a private window. The
      // name is required because the homepage greets the DJ by it.
      const artistInp = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      if (artistInp && !artistInp.value.trim()) {
        if (unlockMsg) { unlockMsg.textContent = 'Pon tu nombre artístico o tu nombre de pila, para saber cómo llamarte.'; unlockMsg.className = 'unlock-msg err'; }
        artistInp.focus();
        return;
      }
      unlockBusy = true;
      setUnlocked();
      setEmail(email);
      if (unlockEl) unlockEl.hidden = true;

      // Give them the thing they actually came for, immediately. The
      // confirmation email fires afterwards in the background: nobody should
      // wait on an inbox while standing in a hurry.
      if (pendingWant === 'pdf') {
        // Popup blockers eat the print view on exactly this path (the user
        // just submitted a form). Dead air after handing over an email address
        // is the worst possible outcome, so say what happened and what to do.
        if (!printCurrentList() && backupMsg) {
          backupMsg.textContent = 'Ya estás registrado. Tu navegador bloqueó la ventana de descarga: toca Descargar lista otra vez y permite las ventanas emergentes.';
          backupMsg.className = 'backup-msg ok';
        }
      }
      else if (pendingWant === 'email') sendBackup(email); // to the address they just registered
      else {
        setMode(pendingMode);
        // Registration done, mode unlocked: put them at the TOP of their
        // new list, ready to work (Antonio), same move as the back-to-top
        // circle, not stranded at the bottom where the gate was.
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      }

      const want = pendingWant === 'pdf' ? 'pdf' : pendingWant === 'email' ? 'email' : pendingMode;
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'advanced_unlock', { placement: 'checklist', mode: want });
      }
      const artistEl = unlockForm.querySelector('input[name="artist"]') as HTMLInputElement | null;
      const igEl = unlockForm.querySelector('input[name="instagram"]') as HTMLInputElement | null;
      // The homepage greets a registered DJ by artist name (Antonio). Stored
      // locally only, first word only; the homepage guards length itself.
      const artistName = artistEl ? artistEl.value.trim() : '';
      if (artistName) {
        try { localStorage.setItem('SMG_ARTIST', artistName.split(/\s+/)[0]); } catch (e) { /* blocked */ }
      }
      try {
        await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'checklist-' + want,
            artist: artistEl ? artistEl.value.trim() : '',
            instagram: igEl ? igEl.value.trim() : '',
          }),
        });
      } catch (e) { /* unlocked anyway; feature is free */ }
      unlockBusy = false;
    });
  }

  // add-your-own inputs (custom mode)
  document.querySelectorAll<HTMLButtonElement>('.add-btn').forEach((btn) => {
    const cat = btn.getAttribute('data-add') || '';
    const input = document.querySelector<HTMLInputElement>('.add-input[data-cat="' + cat + '"]');
    const doAdd = () => { if (input) { addCustom(cat, input.value); input.value = ''; input.focus(); } };
    btn.addEventListener('click', doAdd);
    if (input) input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); doAdd(); } });
  });

  // collapse toggles (restore open state). DEFAULT COLLAPSED (Antonio,
  // collapse doctrine): the three group headers are the index, the page
  // opens compact on any screen, and a group you opened stays open on your
  // next visit because the choice persists.
  const openState = loadOpen();
  toggles.forEach((btn) => {
    const section = btn.closest('.task-group') as HTMLElement;
    const gid = section.getAttribute('data-group') || '';
    const open = openState[gid] === true; // default collapsed
    setGroupOpen(section, open, false);
    btn.addEventListener('click', () => {
      const nowOpen = section.classList.contains('collapsed'); // collapsed -> will open
      setGroupOpen(section, nowOpen, true);
    });
  });

  // restore mode (advanced/custom only if already unlocked on this device)
  let savedMode = 'basic';
  try { savedMode = localStorage.getItem(MODE_KEY) || 'basic'; } catch (e) { /* ignore */ }
  if (restored) savedMode = 'custom';
  if ((savedMode === 'advanced' || savedMode === 'custom') && !isUnlocked()) savedMode = 'basic';
  setMode(savedMode);
  // The markup ships locked, which is right for a first visit and wrong for a
  // returning registered one. This is the one call that clears it on load.
  syncLockedState();

  // reset (ticks only, keeps your custom items and mode)
  const resetBtn = document.getElementById('resetBtn');
  if (resetBtn) {
    // Reset = back to factory, per Antonio: "everything goes back to how it
    // was before you edit anything." In Basic/Advanced that is just the ticks;
    // in Custom it also restores deleted items, undoes renames and reorders,
    // and removes added items. Because that now destroys real work, the first
    // tap arms the button and the second one fires; anything else disarms it.
    let resetArmed = false;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    const disarmReset = () => {
      resetArmed = false;
      if (resetTimer) clearTimeout(resetTimer);
      // Labels live in the markup, stacked; only the class flips. Never
      // write innerHTML here again: label swaps changed the button width
      // and reflowed the whole toolbar.
      resetBtn.classList.remove('armed');
    };
    disarmResetHook = disarmReset;
    resetBtn.addEventListener('click', () => {
      if (!resetArmed) {
        resetArmed = true;
        // "Are you sure?" for every mode (Antonio): short enough to share
        // the idle width, and the red border already says this is serious.
        resetBtn.classList.add('armed');
        resetTimer = setTimeout(disarmReset, 4000);
        return;
      }
      disarmReset();
      allBoxes().forEach((b) => { b.checked = false; });
      save({});
      if (mode === 'custom') {
        try {
          localStorage.removeItem('SMG_CHECKLIST_ORDER_V1');
          localStorage.removeItem('SMG_CHECKLIST_RENAME_V1');
          localStorage.removeItem(CUSTOM_KEY);
          localStorage.removeItem(REMOVED_KEY);
          localStorage.removeItem(SECTIONS_KEY);
          localStorage.removeItem(HIDDENG_KEY);
          localStorage.removeItem(NOTES_KEY);
        } catch (e) {}
        // A full rebuild from defaults beats surgically undoing four kinds of
        // edit in place.
        location.reload();
        return;
      }
      render();
    });
  }

  // ======================= ACCOUNTS / SYNC =======================
  // localStorage stays the source of truth (Antonio's ruling); the server
  // holds copies so another signed-in device can pick them up. Conflict
  // policy is last-write-wins per named list, no merging. MODE and OPEN are
  // device-local on purpose: what you keep collapsed on your phone is not a
  // property of the list.
  //
  // THE LAYER ITSELF IS A SEPARATE, LAZILY IMPORTED FILE (2026-08-06, perf
  // batch 8): ../../scripts/checklist-account.es.
  // It was roughly 16 KB minified of the 58 KB this page shipped to every
  // visitor, and the large majority of DJs who open the checklist tick a few
  // boxes and leave. Read that file's header for the reasoning and the seam.
  //
  // WHAT IS LEFT HERE IS ONLY WHAT CANNOT WAIT:
  //   - the registry's reader and writer, because bumpActive() has to stamp the
  //     active list on every edit whether or not that file ever loads,
  //   - the sync chip's expand and collapse and the click-away close, because
  //     the card has to open on the very tap that starts the download,
  //   - the four triggers that decide the file is needed at all.
  // NOT here, and this is the one that matters: nothing whatsoever about the
  // DOWNLOAD email gate. openGate(), the #unlock card and the unlock form are
  // all above, in this page's own bundle, working off markup that is already in
  // the document. They do not wait for this import and do not know it exists.

  function loadReg(): Registry {
    try {
      const raw = localStorage.getItem(REG_KEY);
      if (raw) {
        const r = JSON.parse(raw);
        if (r && r.active && Array.isArray(r.lists) && r.lists.length) {
          // One-time migration (round 11.5, Antonio: "maybe you don't need to
          // put that name, maybe you can call default"). Only the untouched
          // starter list on 'main' still named exactly the old default text
          // qualifies -- a DJ who deliberately renamed it is, by definition,
          // not this case, whatever they renamed it to.
          let migrated = false;
          r.lists.forEach((l: RegList) => {
            if (l.id === 'main' && l.n === 'My checklist') { l.n = 'Default'; migrated = true; }
          });
          if (migrated) saveReg(r);
          return r;
        }
      }
    } catch (e) { /* fall through */ }
    return { active: 'main', lists: [{ id: 'main', n: 'Default', u: 0 }] };
  }
  function saveReg(r: Registry) { try { localStorage.setItem(REG_KEY, JSON.stringify(r)); } catch (e) { /* blocked */ } }

  // acctLayer and acctLoading are declared at the top of this script, beside
  // `acct`, because bumpActive() reads acctLayer during init. Both stay null
  // until the layer arrives, and everything the page asks of it is safe to skip
  // while they are: all of it needs somebody signed in first, and being signed
  // in is one of the things that loads it.

  /**
   * ONE IMPORT, HOWEVER MANY TRIGGERS FIRE. `me` is the already-fetched
   * /api/auth/me body when the probe below found a signed-in device; on an
   * interaction-triggered load it is undefined and the layer asks for itself,
   * because it needs the Google client id out of that same response to render
   * the Google button for a signed-OUT visitor.
   */
  function loadAccounts(me?: any): Promise<AccountLayer | null> {
    if (!acctLoading) {
      acctLoading = import('../../scripts/checklist-account.es')
        .then((m) => { acctLayer = m.initAccounts(core, me); return acctLayer; })
        .catch(() => {
          // Offline, or the chunk 404s: the page carries on being exactly what
          // it was before accounts existed, which is a fully working checklist.
          // Cleared so a later tap can try again once there is signal.
          acctLoading = null;
          return null;
        });
    }
    return acctLoading;
  }

  // The chip and the card. Both are page furniture: the chip's expand/collapse
  // and the press-and-hold explainer on it stayed here, so their handles do too.
  const acctLine = document.getElementById('acctLine');
  const acctCard = document.getElementById('acctCard');

  /** Everything the account layer is allowed to know about this page. */
  const core: ChecklistCore = {
    keys: {
      STORE_KEY, CUSTOM_KEY, REMOVED_KEY, RENAME_KEY, ORDER_KEY, SECTIONS_KEY,
      HIDDENG_KEY, NOTES_KEY, EMAIL_KEY, REG_KEY, DELETED_KEY, LIST_DATA_PREFIX,
      UNLOCK_KEY,
    },
    acct,
    loadReg, saveReg,
    load, loadCustom, loadRemoved, loadRenames, loadOrder, loadSections,
    loadHiddenGroups, loadNotes,
    getEmail, setEmail, setUnlocked, syncLockedState,
    setMode,
    // GETTERS, NOT VALUES. mode, pendingMode and pendingWant all keep moving
    // after the layer has loaded, so handing over a copy would let it act on a
    // state the DJ has already left.
    getMode: () => mode,
    pendingMode: () => pendingMode,
    pendingWant: () => pendingWant,
    readPendingMode, clearPendingMode,
    printCurrentList,
    sendBackup,
    clearAcctGateHead,
    attachExplainer,
    isInfoLit,
    modeBtns,
  };

  // Every list-mutating save* helper calls this: stamp the active list as
  // just-edited and queue a push. Cheap and safe when signed out, and cheap and
  // safe when the account layer has never loaded, which is the same thing.
  // THE STAMP IS NOT DEFERRABLE. An edit made now and a sign-in made later have
  // to compare correctly, so skipping the stamp until the layer arrived would
  // leave that edit looking older than it is and losing to a stale server copy.
  // That is the round-7 bug (removed sections coming back after sync) waiting to
  // happen again, which is why these ten lines stayed in the page.
  function bumpActive() {
    try {
      const reg = loadReg();
      const a = reg.lists.find((l) => l.id === reg.active);
      if (a) { a.u = Date.now(); saveReg(reg); }
    } catch (e) { /* never let sync bookkeeping break a tick */ }
    if (acctLayer) acctLayer.schedulePush();
  }

  // The sync chip expands and collapses the account card.
  if (acctLine && acctCard) acctLine.addEventListener('click', () => {
    const open = acctCard.hidden;
    acctCard.hidden = !open;
    clearAcctGateHead();
    acctLine.setAttribute('aria-expanded', open ? 'true' : 'false');
    // Round 7: a manual close means "not now" -- drop any pending
    // Advanced/Custom intent so a later, unrelated sign-in never
    // surprise-applies a mode the DJ never got around to confirming.
    if (!open) clearPendingMode();
    // ...and the same tap starts the import. THE CARD OPENED FIRST, above,
    // without waiting: it is hidden markup that is already in the document, so
    // the visible answer to the tap is immediate and the layer lands behind it.
    if (open) loadAccounts();
  });

  // Round 10 (Antonio, live on mobile): tapped a locked Advanced button,
  // the card opened, and he had no way to back out -- the only close
  // control is tapping Sync again, and nothing told him that. "If you
  // click anywhere in the page except for the green box, it's the same
  // as pressing sync." CAPTURE phase, not bubble: it has to run BEFORE
  // whatever was actually clicked handles its own click, or tapping a
  // locked Advanced/Custom button (which opens the card) would see
  // itself land "outside" and immediately close the card it just opened.
  // No preventDefault/stopPropagation -- this only ever closes the card
  // as a side effect and always lets the real click keep going, same as
  // any dropdown/popover that closes when you click away from it.
  document.addEventListener('click', (ev) => {
    if (!acctCard || acctCard.hidden || !acctLine) return;
    const t = ev.target as Node;
    if (acctCard.contains(t) || acctLine.contains(t)) return;
    acctCard.hidden = true;
    acctLine.setAttribute('aria-expanded', 'false');
    clearPendingMode();
  }, true);


  // Press-and-hold explainers: the controls Antonio's rule + review actually
  // calls for. Reset, Download and Email are behavioral (what exactly
  // happens is not obvious from a two-word label); Edit reuses the SAME copy
  // as its own dismissible hint, so a DJ who dismissed that hint forever
  // still has a way back to it; the mode buttons reuse MODE_COPY_MAP, the
  // one place that copy lives.
  attachExplainer(resetBtn, () => 'Devuelve la lista a como empezó. En Base y Avanzado borra todas las marcas. En Personal también deshace los cambios de nombre, el orden y los items que agregaste o quitaste.');
  attachExplainer(pdfBtn, () => 'Guarda tu lista exactamente como se ve ahora, con el modo, el orden, los nombres y las marcas actuales, en un PDF para imprimir.');
  attachExplainer(backupBtn, () => 'Manda tu lista a tu bandeja de entrada: la lista completa, más un enlace que la carga de vuelta en cualquier dispositivo. Antes pide un registro rápido y gratis.');
  attachExplainer(editToggle, () => 'Agrega notas, crea secciones, agrega items, renombra, reordena o borra. Guarda tu lista cuando termines.');
  // Round 11.5 follow-up (Antonio): "the person will not understand that if
  // it clicks there, you have a new list below" -- the Lists accordion
  // trigger itself wasn't covered either, so its whole purpose (opens
  // create/rename/reorder/delete) was invisible under info mode too.
  attachExplainer(document.getElementById('lsHead'), () => 'Abre tus listas guardadas. Desde aquí creas una lista nueva, renombras o reordenas tus listas, o borras alguna.');
  attachExplainer(document.getElementById('lsNewBtn'), () => 'Crea una lista nueva, para planear otro gig por separado. Escribe un nombre y guárdala, hasta siete listas.');
  attachExplainer(document.getElementById('lsMoveBtn'), () => 'Activa renombrar y reordenar en tus listas guardadas. Toca el lápiz de una lista para renombrarla, o arrástrala por el asa de flechas para reordenar.');
  attachExplainer(document.getElementById('lsDelBtn'), () => 'Activa el modo borrar en tus listas guardadas. Toca la × de una lista una vez para armarla, toca de nuevo para borrarla. Tu lista activa no se puede borrar así, cambia a otra primero.');
  modeBtns.forEach((b) => attachExplainer(b, () => (MODE_COPY_MAP[b.dataset.modeSet || 'basic'] || MODE_COPY_MAP.basic).f));
  // Round 8 (Antonio): Sync used to be deliberately excluded ("tapping it
  // already opens a card that explains itself") -- he asked for it to be
  // covered too, same as everything else, since hovering it in place is
  // faster than opening the card just to remember what it does.
  // THE EXPLAINERS FOR THE ACCOUNT CONTROLS STAYED IN THE PAGE (2026-08-06).
  // They are five string literals and a hover. Gating them behind the account
  // layer's arrival would mean hovering the Sync chip explained nothing until
  // after you had already tapped it, which is the wrong way round.
  attachExplainer(acctLine, () => 'Sync te deja entrar una vez, sin contraseña, y mantener tu lista guardada en tu cuenta. Te sigue a cualquier dispositivo donde entres.');

  // The "ⓘ" toggle (round 3: shown on touch AND desktop now, doing two
  // different jobs). Touch: a plain on/off, never persisted. Turning it on
  // arms the document-level click listener above and shows this line once;
  // turning it off closes whatever explainer happens to be open and hands
  // the covered buttons back to their normal click handlers. Desktop: hover-
  // a-beat already always works regardless of this button, so it never
  // touches infoModeOn or the click-swallowing above, it just shows a static
  // reminder that hovering teaches you each control.
  // Round 5, second pass (Antonio): the desktop version used to be a real
  // click-to-toggle (stayed amber/"on" until clicked again), which falsely
  // implied it was a persistent mode like the mobile touch toggle actually
  // is. It never was one on desktop, hover-a-beat already always works
  // regardless of this button's state. Changed to match how every OTHER
  // covered control already behaves: on while you're on it, off the moment
  // you're not. Click still opens it (nothing here is hoverable-only,
  // clicking is the discovery step), but leaving the button with the mouse
  // now closes it automatically, same as attachExplainer's own
  // mouseenter/mouseleave pattern above, no second click required, and it
  // never sits "on" once your cursor has moved away.
  const explainInfoBtn = document.getElementById('explainInfoBtn');
  let desktopInfoOn = false;
  if (explainInfoBtn) {
    explainInfoBtn.addEventListener('click', () => {
      if (HAS_HOVER) {
        desktopInfoOn = true;
        explainInfoBtn.classList.add('mode-active');
        explainInfoBtn.setAttribute('aria-pressed', 'true');
        showExplain(explainInfoBtn, 'Deja el cursor sobre cualquier cosa un segundo para leer sus instrucciones.');
        setAllExplainLit(true);
        return;
      }
      infoModeOn = !infoModeOn;
      explainInfoBtn.classList.toggle('mode-active', infoModeOn);
      explainInfoBtn.setAttribute('aria-pressed', String(infoModeOn));
      if (infoModeOn) showExplain(explainInfoBtn, 'Toca cualquier botón para que te explique su función. Toca ⓘ otra vez para volver a lo normal.');
      else closeExplain();
      setAllExplainLit(infoModeOn);
    });
    if (HAS_HOVER) explainInfoBtn.addEventListener('mouseleave', () => {
      if (!desktopInfoOn) return;
      desktopInfoOn = false;
      explainInfoBtn.classList.remove('mode-active');
      explainInfoBtn.setAttribute('aria-pressed', 'false');
      closeExplain();
      setAllExplainLit(false);
    });
  }

  // COMING BACK FROM A SIGN-IN REDIRECT is an account interaction that started
  // before this page existed, so it loads the layer eagerly. The layer owns the
  // two messages and the card it has to open; all that is decided here is that
  // it is needed. Both parameters are still consumed there, so the URL is still
  // cleaned up.
  {
    const sp = new URLSearchParams(location.search);
    if (sp.get('signedin') === '1' || sp.get('signin')) loadAccounts();
  }

  // The switcher follows the mode. It is a second listener on the same buttons
  // (registered later = runs after setMode has done its work) rather than a
  // call inside setMode that would trip the TDZ during init. The Lists row only
  // exists once somebody is signed in, which means the account layer is loaded
  // by then; before that there is nothing to update and the row is hidden in
  // the markup.
  modeBtns.forEach((b) => b.addEventListener('click', () => { if (acctLayer) acctLayer.updateListSwitch(); }));

  // WHO IS SIGNED IN, and who is even worth asking (2026-08-06, perf batch 8).
  // This used to be an /api/auth/me request fired on every single load, by
  // every visitor, before anything else on the page could settle. It now runs
  // only for a device that could actually be signed in, and only once the page
  // has finished loading, so a first-time DJ's checklist makes no account
  // request at all.
  //
  // THE TEST IS SMG_UNLOCKED, NOT A NEW FLAG. Signing in always sets it
  // (markSignedIn calls setUnlocked), so every account holder is still asked
  // and their behaviour is unchanged: the chip goes green on load, the server
  // pull still happens on load, and an edit made and abandoned still pushes.
  // Nothing to migrate and no new key to get wrong.
  // A browser with localStorage BLOCKED cannot be asked that question at all,
  // so it is probed too, rather than silently losing sync in a private window.
  function storageWorks(): boolean {
    try { localStorage.setItem('SMG_T', '1'); localStorage.removeItem('SMG_T'); return true; }
    catch (e) { return false; }
  }
  function probeAccount() {
    if (!isUnlocked() && storageWorks()) return;
    fetch('/api/auth/me')
      .then((r) => r.json())
      .then((d) => { if (d && d.ok && d.email) loadAccounts(d); })
      .catch(() => { /* offline, or no backend on a static server: signed out */ });
  }
  if (document.readyState === 'complete') probeAccount();
  else window.addEventListener('load', probeAccount, { once: true });

  // back to top
  const topBtn = document.getElementById('topBtn');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
