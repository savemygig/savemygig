  import type { AccountLayer, ChecklistCore, Registry, RegList } from '../../scripts/checklist-account.es';

  const STORE_KEY = 'SMG_CHECKLIST_V1';
  const MODE_KEY = 'SMG_CHECKLIST_MODE';
  const OPEN_KEY = 'SMG_CHECKLIST_OPEN';
  const UNLOCK_KEY = 'SMG_UNLOCKED';
  const CUSTOM_KEY = 'SMG_CHECKLIST_CUSTOM';
  const REMOVED_KEY = 'SMG_CHECKLIST_REMOVED';
  const ORDER_KEY = 'SMG_CHECKLIST_ORDER_V1';
  const RENAME_KEY = 'SMG_CHECKLIST_RENAME_V1';
  const SECTIONS_KEY = 'SMG_CHECKLIST_SECTIONS_V1';
  const HIDDENG_KEY = 'SMG_CHECKLIST_HIDDENGROUPS_V1';
  const NOTES_KEY = 'SMG_CHECKLIST_NOTES_V1';
  const EMAIL_KEY = 'SMG_EMAIL';
  // Accounts/sync build (2026-07-29). The live SMG_CHECKLIST_* keys above
  // always hold the ACTIVE list, so every line of existing code keeps
  // working untouched; other named lists are parked whole under
  // SMG_LIST_DATA_<id>. The registry knows which is which.
  const REG_KEY = 'SMG_LISTS_V1';           // { active, lists: [{id, n, u}] }
  const LIST_DATA_PREFIX = 'SMG_LIST_DATA_'; // parked blobs, one per inactive list
  const DELETED_KEY = 'SMG_SYNC_DELETED_V1'; // list ids deleted locally, pending server delete
  // Round 7 (Antonio): Advanced/Custom now unlock through the SAME account
  // panel as Sync, not a separate registration gate (see the mode-button
  // handler below). Because sign-in can round-trip through a real page
  // redirect (the magic-link path), the "I clicked Advanced" intent has to
  // survive a full reload -- pendingMode alone (an in-memory var) does not.
  // Stored as "mode|timestamp" and timed out at PENDING_MODE_TTL so an
  // abandoned click from days ago can never silently re-fire on some later,
  // unrelated sign-in.
  const PENDING_MODE_KEY = 'SMG_PENDING_MODE';
  const PENDING_MODE_TTL = 60 * 60 * 1000; // 1 hour
  function setPendingMode(m: string) { try { localStorage.setItem(PENDING_MODE_KEY, m + '|' + Date.now()); } catch (e) { /* blocked */ } }
  function clearPendingMode() { try { localStorage.removeItem(PENDING_MODE_KEY); } catch (e) { /* blocked */ } }
  function readPendingMode(): string | null {
    let raw: string | null = null;
    try { raw = localStorage.getItem(PENDING_MODE_KEY); } catch (e) { return null; }
    if (!raw) return null;
    const [m, ts] = raw.split('|');
    if ((m !== 'advanced' && m !== 'custom') || !ts || (Date.now() - Number(ts)) > PENDING_MODE_TTL) {
      clearPendingMode();
      return null;
    }
    return m;
  }
  // Declared HERE, above everything that runs during init: tryRestore()
  // fires early and its save* calls reach bumpActive(), which reads these.
  const acct: { email: string | null; google: string | null; artist: string | null } = { email: null, google: null, artist: null };
  // DECLARED HERE FOR THE SAME REASON `acct` IS, and it is a TDZ trap if it
  // moves: tryRestore() fires early during init and its save* calls reach
  // bumpActive(), which reads this. pushTimer used to sit on this line; the
  // debounce it belonged to lives in the account layer now.
  let acctLayer: AccountLayer | null = null;
  let acctLoading: Promise<AccountLayer | null> | null = null;

  const listEl = document.getElementById('list');
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));
  const pctEl = document.getElementById('pct');
  const fillEl = document.getElementById('meterFill');
  const subEl = document.getElementById('sub');
  const readinessEl = document.getElementById('readiness');
  const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode-btn'));
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.group-toggle'));
  const unlockEl = document.getElementById('unlock') as HTMLElement | null;
  const unlockForm = document.getElementById('unlockForm') as HTMLFormElement | null;
  const unlockMsg = document.getElementById('unlockMsg');
  const customToolbar = document.getElementById('customToolbar') as HTMLElement | null;
  const editToggle = document.getElementById('editToggle');
  const backupBtn = document.getElementById('backupBtn');
  const backupForm = document.getElementById('backupForm') as HTMLFormElement | null;
  const backupMsg = document.getElementById('backupMsg');

  let mode: string = 'basic';
  let pendingMode: string = 'advanced';
  // What the DJ was reaching for when the gate appeared: a mode, or the PDF.
  let pendingWant: 'mode' | 'pdf' | 'email' = 'mode';
  // Assigned by the reset block below; setMode calls it so an armed reset
  // NEVER survives a mode switch. Audit finding: arm "Reset ticks?" in Basic,
  // hop to Custom within 4s, tap again, and the confirmation you gave for
  // ticks wipes the entire custom list. The question and the action must
  // always belong to the same mode.
  let disarmResetHook: () => void = () => {};
  // The old static PDF stays on disk for the email flow, but the Download
  // button no longer serves it: it prints the live list instead.
  let editMode = false;

  const allBoxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.task input[type="checkbox"]'));

  function load(): Record<string, boolean> {
    try { const raw = localStorage.getItem(STORE_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function save(state: Record<string, boolean>) {
    try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) { /* storage blocked */ }
    bumpActive();
  }
  function saveMode(m: string) { try { localStorage.setItem(MODE_KEY, m); } catch (e) { /* blocked */ } }
  function loadOpen(): Record<string, boolean> {
    try { const raw = localStorage.getItem(OPEN_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveOpen(o: Record<string, boolean>) {
    try { localStorage.setItem(OPEN_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ }
  }
  function isUnlocked(): boolean { try { return localStorage.getItem(UNLOCK_KEY) === '1'; } catch (e) { return false; } }
  function setUnlocked() { try { localStorage.setItem(UNLOCK_KEY, '1'); } catch (e) { /* blocked */ } syncLockedState(); }
  // THE CONTROL CARRIES THE LOCK, and it has to be right before the first tap
  // and right after the last unlock. The markup ships locked (a first-time
  // visitor is), so this only ever has work to do on a device that registered:
  // it runs from setUnlocked() above, from the sign-out/delete path that
  // removes the key, and once during init for a returning visitor. A class
  // toggle, never DOM surgery: these buttons carry explainer listeners.
  function syncLockedState() {
    const locked = !isUnlocked();
    modeBtns.forEach((b) => {
      const gated = b.dataset.modeSet === 'advanced' || b.dataset.modeSet === 'custom';
      b.classList.toggle('is-locked', gated && locked);
    });
  }
  // Old group ids (pre-redesign 2026-07-27) mapped to their closest new
  // home, so custom items added under the old taxonomy keep appearing.
  const CAT_MIGRATE: Record<string, string> = { basics: 'logistics', extras: 'personal' };
  function loadCustom(): Record<string, { k: string; t: string }[]> {
    try {
      const raw = localStorage.getItem(CUSTOM_KEY);
      const c = raw ? JSON.parse(raw) : {};
      Object.keys(CAT_MIGRATE).forEach((old) => {
        if (c[old] && c[old].length) {
          const dest = CAT_MIGRATE[old];
          c[dest] = (c[dest] || []).concat(c[old]);
          delete c[old];
        }
      });
      return c;
    }
    catch (e) { return {}; }
  }
  function saveCustom(c: Record<string, { k: string; t: string }[]>) {
    try { localStorage.setItem(CUSTOM_KEY, JSON.stringify(c)); } catch (e) { /* blocked */ }
    bumpActive();
  }
  function loadRemoved(): string[] {
    try { const raw = localStorage.getItem(REMOVED_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function saveRemoved(a: string[]) { try { localStorage.setItem(REMOVED_KEY, JSON.stringify(a)); } catch (e) { /* blocked */ } bumpActive(); }
  function loadSections(): { id: string; t: string }[] {
    try { const raw = localStorage.getItem(SECTIONS_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function saveSections(s: { id: string; t: string }[]) {
    try { localStorage.setItem(SECTIONS_KEY, JSON.stringify(s)); } catch (e) { /* blocked */ }
    bumpActive();
  }
  // Built-in categories the DJ removed in Custom (hidden, not deleted:
  // Reset list restores them). User sections delete outright instead.
  function loadHiddenGroups(): string[] {
    try { const raw = localStorage.getItem(HIDDENG_KEY); return raw ? JSON.parse(raw) : []; }
    catch (e) { return []; }
  }
  function saveHiddenGroups(a: string[]) { try { localStorage.setItem(HIDDENG_KEY, JSON.stringify(a)); } catch (e) { /* blocked */ } bumpActive(); }
  function loadNotes(): Record<string, string> {
    try { const raw = localStorage.getItem(NOTES_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveNotes(n: Record<string, string>) { try { localStorage.setItem(NOTES_KEY, JSON.stringify(n)); } catch (e) { /* blocked */ } bumpActive(); }
  // Escape, keep line breaks, and make URLs clickable. Escape-first, then
  // wrap URL tokens, so nothing a DJ types can inject markup.
  function notesHtml(text: string): string {
    const escN = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c));
    return text.split(/(https?:\/\/[^\s<>"']+)/g).map((part, i) =>
      i % 2 === 1
        ? `<a href="${escN(part)}" target="_blank" rel="noopener">${escN(part)}</a>`
        : escN(part)
    ).join('');
  }
  // The collapsed-state preview under a category title: content + .has flag.
  function updateNotesPreview(gid: string) {
    const prev = document.querySelector<HTMLElement>(`[data-notes-prev="${gid}"]`);
    if (!prev) return;
    const text = (loadNotes()[gid] || '').trim();
    prev.innerHTML = text ? notesHtml(text) : '';
    prev.classList.toggle('has', !!text);
  }
  function updateAllNotesPreviews() {
    document.querySelectorAll<HTMLElement>('[data-notes-prev]').forEach((p) =>
      updateNotesPreview(p.getAttribute('data-notes-prev') || ''));
  }
  // Wire one category's notes trio (button + textarea + hint + preview).
  // Used for the fixed groups at load and for user sections as they render.
  function wireNotes(btn: HTMLButtonElement, area: HTMLTextAreaElement, gid: string) {
    const existing = loadNotes()[gid] || '';
    if (existing) { area.value = existing; area.hidden = false; btn.hidden = true; }
    const hint = area.parentElement ? area.parentElement.querySelector<HTMLElement>('.notes-hint') : null;
    btn.addEventListener('click', () => {
      btn.hidden = true; area.hidden = false; area.focus();
    });
    // No save button exists; the hint says so exactly while it matters.
    area.addEventListener('focus', () => { if (hint) hint.hidden = false; });
    area.addEventListener('blur', () => { if (hint) hint.hidden = true; });
    area.addEventListener('input', () => {
      const n = loadNotes();
      if (area.value.trim()) n[gid] = area.value; else delete n[gid];
      saveNotes(n);
      updateNotesPreview(gid);
    });
    // Tapping the preview = straight into editing: expand, focus, cursor at
    // the end. A tap on a LINK inside it navigates instead.
    const prev = document.querySelector<HTMLElement>(`[data-notes-prev="${gid}"]`);
    if (prev) prev.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const section = prev.closest('.task-group') as HTMLElement;
      if (section) setGroupOpen(section, true, true);
      btn.hidden = true; area.hidden = false;
      area.focus();
      const end = area.value.length;
      area.setSelectionRange(end, end);
    });
    updateNotesPreview(gid);
  }
  function applyHiddenGroups() {
    const hidden = loadHiddenGroups();
    document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => {
      g.classList.toggle('user-hidden', hidden.indexOf(g.getAttribute('data-group') || '') !== -1);
    });
  }
  function loadOrder(): Record<string, string[]> {
    try { const raw = localStorage.getItem(ORDER_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveOrder(o: Record<string, string[]>) { try { localStorage.setItem(ORDER_KEY, JSON.stringify(o)); } catch (e) { /* blocked */ } bumpActive(); }
  function loadRenames(): Record<string, string> {
    try { const raw = localStorage.getItem(RENAME_KEY); return raw ? JSON.parse(raw) : {}; }
    catch (e) { return {}; }
  }
  function saveRenames(r: Record<string, string>) { try { localStorage.setItem(RENAME_KEY, JSON.stringify(r)); } catch (e) { /* blocked */ } bumpActive(); }
  function getEmail(): string { try { return localStorage.getItem(EMAIL_KEY) || ''; } catch (e) { return ''; } }
  function setEmail(v: string) { try { localStorage.setItem(EMAIL_KEY, v); } catch (e) { /* blocked */ } }

  function b64urlToStr(s: string): string {
    let t = s.replace(/-/g, '+').replace(/_/g, '/');
    while (t.length % 4) t += '=';
    const bin = atob(t);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }
  function tryRestore(): boolean {
    const m = location.hash.match(/[#&]r=([^&]+)/);
    if (!m) return false;
    try {
      const data = JSON.parse(b64urlToStr(decodeURIComponent(m[1])));
      if (data && data.c) saveCustom(data.c);
      if (data && Array.isArray(data.x)) saveRemoved(data.x);
      // Renames and order joined the payload later; older links simply lack
      // the keys and restore what they carry.
      if (data && data.r && typeof data.r === 'object') saveRenames(data.r);
      if (data && data.o && typeof data.o === 'object') saveOrder(data.o);
      if (data && Array.isArray(data.s)) saveSections(data.s);
      if (data && Array.isArray(data.h)) saveHiddenGroups(data.h);
      if (data && data.n && typeof data.n === 'object') saveNotes(data.n);
      setUnlocked();
      history.replaceState(null, '', location.pathname + location.search);
      return true;
    } catch (e) { return false; }
  }
  function getListByCat(): Record<string, string[]> {
    const out: Record<string, string[]> = {};
    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      // A category the DJ removed (or one empty in this mode) stays out of
      // the email and the printout entirely.
      if (getComputedStyle(group).display === 'none') return;
      const cat = group.getAttribute('data-group') || '';
      const labels: string[] = [];
      group.querySelectorAll<HTMLElement>('.task').forEach((li) => {
        // Rows hidden by the current MODE (or removal) stay out: emailing from
        // Basic must email the Basic list, not all 37 items. Computed display
        // is checked on the row itself, so items inside a COLLAPSED section
        // still count; collapsing a group is tidiness, not deletion.
        if (getComputedStyle(li).display === 'none') return;
        const el = li.querySelector<HTMLElement>('.task-label');
        const t = el && el.textContent ? el.textContent.trim() : '';
        if (t) labels.push(t);
      });
      out[cat] = labels;
    });
    return out;
  }
  let backupBusy = false;
  async function sendBackup(email: string) {
    if (backupBusy) return; // double-tap sends double emails
    email = (email || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      if (backupMsg) { backupMsg.textContent = 'Ese correo no se ve bien.'; backupMsg.className = 'backup-msg err'; }
      return;
    }
    if (backupMsg) { backupMsg.textContent = 'Enviando...'; backupMsg.className = 'backup-msg'; }
    backupBusy = true;
    try {
      const res = await fetch('/api/backup', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          email, listByCat: getListByCat(), custom: loadCustom(), removed: loadRemoved(),
          renames: loadRenames(), order: loadOrder(),
          // User sections travel too: the email needs their titles and the
          // restore link needs their definitions. Hidden categories travel
          // so the second device matches the first.
          sections: loadSections(),
          hiddenGroups: loadHiddenGroups(),
          notes: loadNotes(),
          catNames: (() => { const m: Record<string, string> = {}; document.querySelectorAll<HTMLElement>('.task-group').forEach((g) => { const t = g.querySelector('.group-title'); if (t) m[g.getAttribute('data-group') || ''] = t.textContent || ''; }); return m; })(),
        }),
      });
      // A non-2xx is a SERVER problem. It used to fall through res.json()
      // into the catch and tell a DJ on solid venue Wi-Fi "no connection,
      // find signal", which misdiagnoses the failure at them.
      if (!res.ok) {
        if (backupMsg) { backupMsg.textContent = 'No se pudo enviar ahora, el problema es de nuestro lado. Intenta de nuevo en un minuto.'; backupMsg.className = 'backup-msg err'; }
        backupBusy = false;
        return;
      }
      const data = await res.json();
      if (data && data.ok) {
        setEmail(email);
        if (backupForm) backupForm.hidden = true;
        if (backupMsg) { backupMsg.textContent = 'Enviado a ' + email + '. Revisa tu bandeja de entrada: ahí está la copia y un enlace para cargarla donde sea.'; backupMsg.className = 'backup-msg ok'; }
      } else if (backupMsg) {
        backupMsg.textContent = 'No se pudo enviar ahora. Intenta de nuevo en un minuto.'; backupMsg.className = 'backup-msg err';
      }
    } catch (e) {
      if (backupMsg) { backupMsg.textContent = 'Sin conexión. Intenta de nuevo cuando tengas señal.'; backupMsg.className = 'backup-msg err'; }
    }
    backupBusy = false;
  }

  function isVisible(box: HTMLInputElement): boolean {
    const lvl = box.dataset.level;
    if (mode === 'custom') {
      if (loadRemoved().indexOf(box.dataset.key || '') !== -1) return false;
      // Items inside a category the DJ removed do not exist for the meter.
      const g = box.closest('.task-group');
      if (g && loadHiddenGroups().indexOf(g.getAttribute('data-group') || '') !== -1) return false;
    }
    if (mode === 'basic') return lvl === 'basic';
    if (mode === 'advanced') return lvl !== 'custom';
    return true; // custom mode shows everything, minus what you removed
  }

  function render() {
    const visible = allBoxes().filter(isVisible);
    const done = visible.filter((b) => b.checked).length;
    const totalV = visible.length;
    const pct = totalV ? Math.round((done / totalV) * 100) : 0;

    if (pctEl) pctEl.textContent = pct + '%';
    if (fillEl) fillEl.style.width = pct + '%';
    if (subEl) subEl.textContent = pct === 100 ? 'Listo. A tocar.' : `${done} de ${totalV} listos`;
    if (readinessEl) readinessEl.classList.toggle('is-ready', pct === 100 && totalV > 0);

    document.querySelectorAll<HTMLElement>('.task-group').forEach((group) => {
      const inGroup = Array.from(group.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')).filter(isVisible);
      const gid = group.getAttribute('data-group');
      const countEl = document.querySelector<HTMLElement>(`.group-count[data-count="${gid}"]`);
      const gdone = inGroup.filter((b) => b.checked).length;
      if (countEl) {
        countEl.textContent = `${gdone}/${inGroup.length}`;
        countEl.classList.toggle('done', gdone === inGroup.length && inGroup.length > 0);
      }
      // Groups with nothing to show in this mode disappear entirely: in
      // Basic, the all-Pro groups (Backups, Technical Kit, Recovery,
      // Travel) would otherwise sit as empty shells. Custom always shows
      // every group, the DJ needs the empty ones to add into.
      group.hidden = mode !== 'custom' && inGroup.length === 0;
    });
  }

  function attachBox(input: HTMLInputElement) {
    const ticks = load();
    if (ticks[input.dataset.key || '']) input.checked = true;
    input.addEventListener('change', () => {
      const s = load(); s[input.dataset.key || ''] = input.checked; save(s); render();
    });
  }

  /* ----- the DJ's own sections (Custom mode, Antonio's spec) ----- */
  // A named section picks its own icon (Antonio: "it has to be intelligent
  // and understand that medicine is medicine"). Keyword match on the title,
  // in English, Portuguese and Spanish; the bulb is the fallback. All
  // monochrome stroke, per the standing no-emoji rule.
  const SECTION_ICONS: Record<string, string> = {
    health: '<path d="M12 3a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-3v3a2 2 0 0 1-2 2h-0a2 2 0 0 1-2-2v-3H7a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h3V5a2 2 0 0 1 2-2z"/>',
    disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/>',
    usb: '<rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/>',
    plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
    cup: '<path d="M17 8h1a3 3 0 0 1 0 6h-1"/><path d="M3 8h14v7a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z"/><path d="M7 2v2"/><path d="M11 2v2"/>',
    shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
    star: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
    bulb: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/>',
  };
  const SECTION_ICON_WORDS: [string, string[]][] = [
    ['health', ['medic', 'remed', 'pill', 'pharma', 'farmac', 'health', 'saude', 'salud', 'first aid', 'aid kit']],
    ['disc', ['music', 'musica', 'track', 'vinyl', 'record', 'playlist', 'set ']],
    ['usb', ['cable', 'cabo', 'adapter', 'adaptador', 'usb', 'tech', 'charger', 'carregador', 'cargador']],
    ['plane', ['travel', 'viagem', 'viaje', 'flight', 'voo', 'vuelo', 'hotel', 'tour', 'passport', 'passaporte']],
    ['cup', ['food', 'comida', 'snack', 'drink', 'bebida', 'agua', 'water', 'coffee', 'cafe']],
