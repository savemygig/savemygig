    }
    .bl-full { display: none; }
    .bl-short { display: inline; }
  }
</style>

<script>
  // TYPE ONLY, so it is erased before anything ships and the account layer is
  // still reached exclusively through the dynamic import() below. Sharing the
  // shapes is what stops the seam drifting: change ChecklistCore in that file
