---
import Base from '../../layouts/Base.astro';
import InstallNudge from '../../components/InstallNudge.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { RUNLIST } from '../../data/runlist.es.js';
import { hrefFor } from '../../data/concepts.js';
import { localizedPath } from '../../i18n/registry';
import Icon from '../../components/Icon.astro';
const lp = (p) => localizedPath(p, 'es');

// EMERGENCY CARD, ESPANOL NEUTRO (LATAM). Fuente de estructura, paneles,
// clases y CSS: src/pages/card.astro.
//
// El bloque del booth sale de src/data/runlist.es.js, la MISMA fuente que usa
// la pantalla de emergencia (src/pages/es/protocol/[...slug].astro), para que
// el orden, los verbos y las frases nunca se separen entre las dos
// superficies. El mapa local que vivia aqui se borro el dia que existio
// runlist.es.js: una sola fuente de verdad por idioma. Si esta card y
// /es/protocol/usb/moves dijeran cosas distintas, el DJ nunca las memoriza,
// que es exactamente lo que el archivo en ingles llama el peor resultado
// posible.
//
// FOLDER y LINK son rotulos impresos en el equipo (modo de navegacion FOLDER,
// PRO DJ LINK) y se quedan en ingles, igual que en emergency-tree.es.js.
// REINICIA y PIDE no son rotulos: son las palabras que el DJ tiene que
// recordar solo.
//
// LOS TRES LINKS DE LOS AJUSTES SAGRADOS (2026-08-05). FAT32, MBR y rekordbox
// aparecian linkados en esta pagina sin estar escritos aqui: los ponia el
// autolinker, que no reconocia /es/card como la misma pagina excluida que
// /card, y por eso apuntaban al ingles. El autolinker quedo arreglado en el
// mismo trabajo, asi que los tres pasan a estar escritos a mano, con prefijo
// /es, en los tres idiomas. Nada mas en la card se linkea: se lee bajo presion.
---
<Base
  title="La Emergency Card del DJ: toma una captura | Save My Gig"
  description="La referencia de emergencia de una sola página para cuando el USB muere en pleno gig. Toma una captura, imprímela, déjala en tu bag. Gratis."
  path="/card"
  lang="es"
>
  <main class="wrap">
    <div class="status-line">Emergency_Card</div>
    <h1 style="margin-bottom:0.5rem">LA EMERGENCY <span class="accent">CARD</span></h1>
    <p class="dim" style="margin-bottom:1.5rem"><Icon name="phone" /> Toma una captura de esta página ahora, funciona sin señal, en cualquier booth, a cualquier hora.</p>

    <div class="panel panel-go">
      <h2 style="margin-bottom:0.4rem">EL USB MURIÓ EN EL BOOTH</h2>
      <p class="dim" style="font-size:0.85rem;margin-bottom:0.9rem">
        Damos por hecho que ya lo reconectaste y ya probaste el otro deck.
        Estos son los cuatro que un buen DJ igual olvida bajo presión.
      </p>
      <ol class="card-moves">
        {RUNLIST.map((s) => (
          <li><strong>{s.verb}</strong> <span>{s.action}</span></li>
        ))}
      </ol>
    </div>

    <div class="panel panel-warn">
      <h2 style="margin-bottom:0.75rem">LOS AJUSTES SAGRADOS</h2>
      <ul class="checklist">
        <li>Formato: <span class="mono" translate="no"><a href={lp(hrefFor('fat32'))}>FAT32</a></span> · Esquema: <span class="mono" translate="no"><a href={lp(hrefFor('mbr'))}>MBR</a></span> · Tamaño: 32 a 64 GB</li>
        <li>Mac: Utilidad de Discos → Mostrar todos los dispositivos → selecciona la UNIDAD → MS-DOS (FAT) + Master Boot Record</li>
        <li>Música a los USB de gig SOLO por el modo EXPORT de <a href={lp(hrefFor('rekordbox'))}>rekordbox</a></li>
        <li>Expulsa desde rekordbox Y desde el reproductor (<span translate="no">USB STOP</span>). Cada vez.</li>
      </ul>
    </div>

    <div class="panel panel-danger">
      <h2 style="margin-bottom:0.75rem">NUNCA (bajo presión)</h2>
      <ul class="checklist">
        <li>Nunca formatees una unidad que todavía tiene archivos sin rescatar.</li>
        <li>Nunca digas que SÍ cuando una computadora se ofrece a formatear tu USB de gig.</li>
        <li>Nunca sigas reconectando una unidad que está fallando, cada montaje puede complicar la recuperación.</li>
        <li>Nunca salgas de casa con un solo USB. <strong>Dos unidades idénticas, dos bolsillos.</strong></li>
      </ul>
    </div>

    {/* Install recommendation, AFTER the card itself. A reader here is
        already solving this problem by hand, with a screenshot, so the offer
        lands. It goes below the three panels rather than above them because
        this page's own rule (see the header) is that the card is read under
        pressure and a card full of exits is a card nobody finishes. */}
    <InstallNudge lang="es" path="/card" placement="card" />

    <div style="text-align:left;margin:2rem 0 1rem">
      <EmailCapture source="card" lang="es" title="¿La quieres en PDF para imprimir?"
        blurb="Esta página es gratis para siempre, toma una captura ahora mismo. Si prefieres la versión para imprimir guardada en tu correo, te la mandamos." />
    </div>
    <p class="dim" style="font-size:0.85rem">savemygig.com/es/emergency, el rescate guiado completo, gratis · Imprime esta página: gasta poca tinta.</p>
  </main>
</Base>

<style>
  /* Compact on screen, still legible in a screenshot on a phone at arm's
     length, and it prints. The verb leads so the eye finds the step it is on
     without reading the sentence. */
  .card-moves { list-style: none; counter-reset: cm; margin: 0; padding: 0; }
  .card-moves li {
    counter-increment: cm;
    position: relative;
    padding: 0.42rem 0 0.42rem 1.75rem;
    line-height: 1.4;
  }
  .card-moves li::before {
    content: counter(cm);
    position: absolute; left: 0; top: 0.42rem;
    width: 1.25rem; text-align: center;
    font-family: var(--font-display); font-weight: 800;
    color: var(--text-faint);
  }
  .card-moves strong {
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.01em;
  }
  .card-moves span { color: var(--text-dim); }
</style>
