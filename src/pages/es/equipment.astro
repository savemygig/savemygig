---
import Base from '../../layouts/Base.astro';
import { BRANDS, modelsOfBrand, modelPath } from '../../data/facts.js';

// /equipment EN ESPAÑOL LATINOAMERICANO NEUTRO. La fuente de verdad de la
// estructura, de los componentes, de las clases y del CSS es
// src/pages/equipment.astro. Aquí solo cambian el texto legible por humanos y
// los hrefs con prefijo /es. Si la página en inglés cambia, cambia esta en el
// mismo commit.

// BRANDS COME FROM THE REGISTRY NOW, and EQUIPMENT is already in canonical
// display order, so the ORDER array and its rank() function are GONE.
//
// That array was a second copy of an ordering that facts.js already knew, and it
// rotted within one commit of being written: three new models were added to
// EQUIPMENT and sorted last here because nobody remembered the duplicate. The fix
// was a thrown error; the better fix is not having the duplicate. EQUIPMENT is
// ordered brand, then category, then family, then descending model number, and
// this page simply preserves that order.
//
// One lead sentence per brand lives here because it is COPY, and copy belongs in
// the page that renders it rather than in the data layer, which is language
// neutral. A brand with no lead still renders.
const LEADS = {
  'pioneer-dj': 'El equipo que está en la mayoría de los booths profesionales. Fallas documentadas, la versión de firmware que corrigió cada una, y qué hacer cuando te pasa en medio del set.',
  'allen-heath': 'El lado analógico del booth profesional, construido alrededor del filtro Xone. Las reglas son otras: uno de ellos no tiene firmware que revisar, y las trampas están en el panel de atrás.',
};

const brands = BRANDS.map((b) => ({
  ...b,
  lead: LEADS[b.key],
  groups: [
    { label: 'Reproductores', items: modelsOfBrand(b.key, 'player') },
    { label: 'Mixers', items: modelsOfBrand(b.key, 'mixer') },
  ].filter((g) => g.items.length > 0),
}));

const allModels = brands.flatMap((b) => b.groups.flatMap((g) => g.items));

const liveCount = allModels.length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/es/equipment#collection',
  name: 'Referencia de equipos de DJ',
  description: 'Referencias operativas de los reproductores y mixers de DJ instalados en booths profesionales, por modelo.',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  about: [
    { '@type': 'Thing', name: 'Pioneer DJ' },
    { '@type': 'Thing', name: 'AlphaTheta' },
    { '@type': 'Thing', name: 'Equipos CDJ y DJM' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: 'Referencias de equipos de DJ por modelo',
    numberOfItems: liveCount,
    itemListElement: allModels.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: m.name,
      url: `https://www.savemygig.com/es${modelPath(m)}`,
    })),
  },
};
---
<Base
  title="Equipo de DJ: referencias de CDJ y DJM | Save My Gig"
  description="Referencia operativa de los CDJ y DJM instalados en booths profesionales. Encuentra tu modelo, mira las fallas documentadas y qué hacer en pleno set."
  path="/equipment"
  crumbName="Equipo"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <div class="status-line">EQUIPO</div>
    <h1 style="margin-bottom:0.8rem">Encuentra <span class="accent">tu modelo</span></h1>
    <p class="dim kb-lead">
      Probablemente llegaste aquí por un aparato específico, el que tienes
      enfrente o el que vas a tocar esta noche. Cada referencia de abajo está
      construida a partir de la documentación del propio fabricante: qué se sabe
      que sale mal, qué versión de firmware lo resolvió, y qué hacer cuando pasa
      con la pista mirando.
    </p>

    <!-- TWO LEVELS OF ACCORDION (Antonio, 2026-08-07): "you click on equipment,
         you have to have an accordion with the brands. You click expands, and then
         you have players, mixers. But it has to be accordion and accordion and
         accordion. Otherwise, starts to become too big."
         He is right, and he is solving a problem that does not exist yet: with two
         brands and seventeen cards this page is already long on a phone, and every
         manufacturer added makes it worse linearly. Nesting makes the phone view a
         list of BRANDS, which stays one screen however many brands arrive.
         Desktop opens everything before paint, so nothing is hidden where there is
         room, exactly as the knowledge hub already does at the same 641px
         breakpoint. Native details and summary, no framework, works with no JS. -->
    {brands.map((b) => (
      <details class="kb-cat eq-brand-cat">
        <summary>
          <h2 class="kb-h">{b.name}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        <p class="dim eq-lead">{b.lead}</p>

        {b.groups.map((g) => (
          <details class="kb-cat eq-group-cat">
            <summary>
              <h3 class="kb-h eq-group-h">{g.label}</h3>
              <span class="kb-chev" aria-hidden="true"></span>
            </summary>
            <div class="kb-grid">
              {g.items.map((m) => (
                <a class="kb-card kb-live" href={`/es${modelPath(m)}`}>
                  <span class="kb-name">{m.name}</span>
                  <span class="kb-go">Abrir la guía &rarr;</span>
                </a>
              ))}
            </div>
          </details>
        ))}

        <p class="eq-more">
          <a href={`/es${b.hub}`}>Todos los modelos {b.name}, incluido lo que todavía está por venir</a>
        </p>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every brand AND every category before first
      // interaction, so a wide screen reads exactly as it did before nesting.
      // Phones keep them collapsed, which is the whole point.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.eq-brand-cat, .eq-group-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <!-- Cross-model entry point, the same one the manufacturer hub promotes.
         It belongs here too: "what is broken on this deck" is a question that
         comes BEFORE "which model am I looking at", and a DJ who does not know
         the model name can still read a version number off the screen. -->
    <a class="pdj-matrix" href="/es/knowledge/pioneer-dj/firmware">
      <span class="pdj-matrix-k">En todos los modelos</span>
      <span class="pdj-matrix-t">Qué está roto en ese reproductor, por versión de firmware &rarr;</span>
      <span class="pdj-matrix-b">Lee la versión en el propio aparato y mira qué fallas documentadas siguen vivas en él.</span>
    </a>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">¿Otro fabricante?</h2>
      <p class="dim" style="margin-bottom:1rem">
        Pioneer DJ y AlphaTheta vinieron primero porque es lo que está instalado
        en la mayoría de los booths. Denon DJ, Allen &amp; Heath y RANE son los
        que más se piden después. Dinos qué usas de verdad y sube en la fila.
      </p>
      <a href="/es/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Cuéntanos qué usas</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      ¿Buscas dudas de biblioteca y de export? <a href="/es/knowledge/pioneer-dj/rekordbox">La referencia de rekordbox</a> cubre eso.
      ¿Buscas memorias USB en vez de reproductores? <a href="/es/gear">Memorias USB en las que confiar</a>.
    </p>
  </main>
</Base>

<style>
  /* Reuses .kb-grid, .kb-card, .kb-live, .kb-name, .kb-go and .kb-h from
     global.css so this page cannot drift from the manufacturer hub it feeds.
     Only the brand and group wrappers are new. */
  .eq-brand { margin-top: 2rem; }
  .eq-lead { margin-bottom: 1.25rem; }
  .eq-group {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 1.5rem 0 0.75rem;
    color: var(--ink-dim);
  }
  .eq-more { margin: 1.25rem 0 0; font-size: 0.9rem; }

  /* The brand level reuses .kb-cat wholesale so it behaves and looks like the
     knowledge hub's categories. The group level nests inside it and needs to be
     visibly subordinate: smaller heading, indented, and no top border of its own
     so two hairlines never stack. */
  .eq-group-cat { margin-left: 0.75rem; }
  .eq-group-h {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin: 0;
    border-bottom: 0;
    padding-bottom: 0;
    flex: 1 1 auto;
  }
  @media (min-width: 641px) {
    /* Open on desktop, so the chevrons would be decoration and the summary
       should not look clickable. Same treatment the knowledge hub uses. */
    .eq-brand-cat > summary, .eq-group-cat > summary { cursor: default; }
    .eq-brand-cat > summary .kb-chev, .eq-group-cat > summary .kb-chev { display: none; }
    .eq-group-cat { margin-left: 0; }
  }
</style>
