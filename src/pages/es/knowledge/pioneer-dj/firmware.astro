---
import Base from '../../../../layouts/Base.astro';
import EmailCapture from '../../../../components/EmailCapture.astro';
import { CHECKED, FIRMWARE_ISSUES } from '../../../../data/facts.js';

// MATRIZ DE FIRMWARE, NEUTRAL LATIN AMERICAN SPANISH. Source of truth for the
// data, the version arithmetic, the accordion, the table and the CSS:
// src/pages/knowledge/pioneer-dj/firmware.astro. Only the human readable copy
// and the /es hrefs differ. If the English page changes, change this one in
// the same commit.
//
// facts.js is language neutral for versions and URLs and ENGLISH for the
// prose fields (`area`, `symptom`, `note`, `noneNote`, `warning.text`). It is
// a shared data file, so it is not translated in place: the maps below
// translate those strings at render time and fall back to the English string
// if facts.js gains an entry this file has not seen yet. A new entry then
// shows up in English rather than disappearing.
const UPDATED = CHECKED;

const MESES = {
  January: 'enero', February: 'febrero', March: 'marzo', April: 'abril',
  May: 'mayo', June: 'junio', July: 'julio', August: 'agosto',
  September: 'septiembre', October: 'octubre', November: 'noviembre', December: 'diciembre',
};
// CHECKED is an English date string in facts.js. Rendered, not rewritten.
const esDate = (s) => {
  const m = /^(\d{1,2}) (\w+) (\d{4})$/.exec(String(s));
  return m && MESES[m[2]] ? `${m[1]} de ${MESES[m[2]]} de ${m[3]}` : String(s);
};

const AREA = {
  Link: 'Link',
  Display: 'Pantalla',
  Audio: 'Audio',
  Browse: 'Browse',
  Playback: 'Reproducción',
  USB: 'USB',
  MIDI: 'MIDI',
  Routing: 'Ruteo',
  Recording: 'Grabación',
  Power: 'Energía',
};

const SYMPTOM = {
  'PRO DJ LINK connection with a DJM-2000NXS could fail.':
    'La conexión PRO DJ LINK con un DJM-2000NXS podía fallar.',
  'Rare dead screen on power-on.':
    'Pantalla muerta al encender, en casos raros.',
  'Occasional no-audio, display blackouts and system freezes on some units.':
    'En algunas unidades, falta de audio ocasional, pantalla apagándose y el sistema congelándose.',
  'A "Waiting" popup could block the BROWSE screen entirely.':
    'Un aviso "Waiting" podía bloquear la pantalla BROWSE por completo.',
  'Emergency Loop triggering wrongly during a Hot Cue pause.':
    'Emergency Loop disparándose mal durante una pausa en Hot Cue.',
  'A startup issue affecting SLIP HOT CUE behaviour.':
    'Un problema de arranque que afectaba el comportamiento de SLIP HOT CUE.',
  'Waveform colour selection went missing, then was restored.':
    'La selección de color de la waveform desapareció y después volvió.',
  'Audio dropouts during Control Mode playback.':
    'Caídas de audio reproduciendo en Control Mode.',
  'UASP-compatible USB drives not recognized.':
    'Las unidades USB compatibles con UASP no se reconocían.',
  'Potential audio cut-out when connected to CDJ-3000s over PRO DJ LINK.':
    'Posible corte de audio conectado a CDJ-3000 por PRO DJ LINK.',
  'Incorrect MIDI output under certain operation.':
    'Salida MIDI incorrecta en determinadas operaciones.',
  'Audio sometimes failing to input to a channel.':
    'El audio a veces no entraba a un canal.',
  'Rare freeze under heavy PRO DJ LINK network load.':
    'Congelamiento raro con carga pesada en la red PRO DJ LINK.',
  'Insert method intermittently disabling itself when switching the Multi I/O input selector, and DVS phono input malfunction on USB-B after swapping computers across ports.':
    'El insert desactivándose solo de vez en cuando al cambiar el selector de entrada Multi I/O, y falla de la entrada phono de DVS en el USB-B después de cambiar las computadoras de puerto.',
  'DJM-REC recording halts affecting iOS and iPadOS audio.':
    'Cortes de grabación de DJM-REC que afectaban el audio en iOS y iPadOS.',
  'DJM-REC recording could halt part-way through a set.':
    'La grabación de DJM-REC podía cortarse a mitad de un set.',


  /*
   * THE 19 ROWS THAT READ IN ENGLISH UNTIL 2026-08-08. The CDJ-2000NXS, the
   * CDJ-900NXS and the XDJ-700 joined FIRMWARE_ISSUES without their fault text
   * joining this map, so `map[s] ?? s` did what it promises and a Spanish speaking
   * reader got 19 English sentences inside a Spanish table, on the page this
   * site offers as its citable asset. scripts/check-firmware-i18n.mjs now fails
   * the gate on a missing key, so the next model cannot repeat it.
   * Control labels stay in English on purpose: HOT CUE, TAG LIST, QUANTIZE,
   * MASTER TEMPO, SEARCH and BEAT DIVIDE are printed on the deck, and a DJ
   * looking at the button needs the page to say what the button says.
   */
  'The player crashed on repeated HOT CUE presses with Master Tempo enabled.':
    'El reproductor se colgaba al presionar HOT CUE varias veces con Master Tempo activado.',
  'Audio dropout on the slave deck when using SYNC.':
    'Caída de audio en el deck slave al usar SYNC.',
  'A freeze could occur while editing the TAG LIST.':
    'Podía colgarse al editar la TAG LIST.',
  'The browse screen slowed or stopped after several hours of use, and a freeze occurred holding HOT CUE over a second during auto hot cue loading.':
    'La pantalla de browse se ponía lenta o se detenía después de varias horas de uso, y se colgaba al mantener HOT CUE más de un segundo durante la carga automática de hot cue.',
  'A WAVE file with an incompatible header left "Loading.." on screen indefinitely. Folders did not list on a 2TB HDD.':
    'Un archivo WAVE con un header incompatible dejaba "Loading.." en pantalla de forma indefinida. Las carpetas no se listaban en un disco duro de 2TB.',
  'Some hard drives were not recognized. Noise when Master Tempo was activated.':
    'Algunos discos duros no se reconocían. Ruido al activar Master Tempo.',
  'AIFF at 24bit/48kHz stopped playing and could not be loaded to a deck. Audio noise while scratching.':
    'AIFF en 24bit/48kHz dejaba de reproducirse y no se podía cargar en un deck. Ruido en el audio al hacer scratch.',
  'Linked to a CDJ-2000NXS, some CDJ-2000NXS2 features were disabled.':
    'Conectado a un CDJ-2000NXS, algunas funciones del CDJ-2000NXS2 quedaban desactivadas.',
  'Digitally distorted white noise on certain WAV files. An active loop could activate a very short loop.':
    'Ruido blanco con distorsión digital en ciertos archivos WAV. Un loop activo podía activar un loop muy corto.',
  'Issues during playback and track selection, and with SLIP HOT CUE.':
    'Problemas durante la reproducción y la selección de tracks, y con SLIP HOT CUE.',
  'Speed did not return to the displayed BPM with Sync on. Popping noise in a loop with QUANTIZE and MASTER TEMPO enabled.':
    'La velocidad no volvía al BPM mostrado en pantalla con Sync activado. Chasquido dentro de un loop con QUANTIZE y MASTER TEMPO activados.',
  'Playback sound stopped while BEAT DIVIDE was activated.':
    'El sonido se detenía con BEAT DIVIDE activado.',
  'Folder browsing failed on 2TB hard drives. Slow track list browsing in Serato DJ HID mode.':
    'La navegación por carpetas fallaba en discos duros de 2TB. Lista de tracks lenta en modo Serato DJ HID.',
  'AIFF at 24bit/48kHz stopped playing and could not be loaded. Digitally distorted white noise on certain WAV files.':
    'AIFF en 24bit/48kHz dejaba de reproducirse y no se podía cargar. Ruido blanco con distorsión digital en ciertos archivos WAV.',
  'PRO DJ LINK compatibility with the CDJ-2000NXS2 and XDJ-1000MK2.':
    'Compatibilidad PRO DJ LINK con el CDJ-2000NXS2 y el XDJ-1000MK2.',
  'Speed did not return to the displayed BPM with Sync enabled.':
    'La velocidad no volvía al BPM mostrado en pantalla con Sync activado.',
  'Categories and tracks were not shown in the browser when a database had many tracks. Search results did not appear when moving the cursor.':
    'Las categorías y las tracks no se mostraban en el browser cuando la base de datos tenía muchas tracks. Los resultados de búsqueda no aparecían al mover el cursor.',
  'SEARCH worked incorrectly under certain conditions.':
    'SEARCH funcionaba de forma incorrecta en ciertas condiciones.',
  'The USB audio function did not work in DJ Software Control mode.':
    'La función de audio USB no funcionaba en modo DJ Software Control.',

  /*
   * SIX MODELS AND THREE ROWS JOINED THE MATRIX ON 2026-08-08, taking it from
   * 9 models and 38 rows to 15 and 63. The strings below are their fault text.
   * Adding them here in the SAME commit is the point: the reason the previous
   * batch shipped in English is that the data landed and the maps did not, and
   * the gate check now refuses the build rather than trusting anyone to remember.
   */
  'BPM could fluctuate during playback using Sync, and so could the tempo of a track with Slip Mode engaged.':
    'El BPM podía fluctuar durante la reproducción con Sync, y también el tempo de una track con Slip Mode activado.',
  'The loop beat display returned to WAVE after a loop ended, and SYNC MASTER switched itself when SYNC was disabled.':
    'El display de beats del loop volvía a WAVE al terminar el loop, y SYNC MASTER cambiaba solo al desactivar SYNC.',
  'Needle Search pad faults, a sorted playlist not being restored on return, and the Master Player switching when an Active Loop started.':
    'Fallas en el pad de Needle Search, una playlist ordenada que no se restauraba al volver, y el Master Player cambiando al iniciar un Active Loop.',
  'Some Apple Lossless files would not play.':
    'Algunos archivos Apple Lossless no se reproducían.',
  'macOS Catalina 10.15 could not see the unit as an audio device.':
    'macOS Catalina 10.15 no reconocía el equipo como dispositivo de audio.',
  'Inconsistencies in the matching function.':
    'Inconsistencias en la función de matching.',
  'Popping noise during a LOOP with QUANTIZE and MASTER TEMPO on.':
    'Chasquido durante un LOOP con QUANTIZE y MASTER TEMPO activados.',
  'A HOT CUE fired after jumping to LOOP-IN when changing the loop beat length with QUANTIZE on.':
    'Un HOT CUE se disparaba después de saltar a LOOP-IN al cambiar el largo del loop en beats con QUANTIZE activado.',
  'Emergency loop triggering on certain MP3 files carrying APE tag data.':
    'Emergency loop disparándose en ciertos archivos MP3 que llevan datos de tag APE.',
  'Track load time grew after several hours of use.':
    'El tiempo de carga de las tracks aumentaba después de varias horas de uso.',
  'Faults using SLIP HOT CUE.':
    'Fallas al usar SLIP HOT CUE.',
  'Some tracks would not play on a linked CDJ-TOUR1.':
    'Algunas tracks no se reproducían en un CDJ-TOUR1 conectado por link.',
  'Standby could not always be cancelled with the LFO FORM (WAKE UP) control.':
    'No siempre se podía salir del standby con el control LFO FORM (WAKE UP).',
  'Noise in USB audio in and out on some computers.':
    'Ruido en la entrada y la salida de audio USB en algunas computadoras.',
  'Some effects did not work as expected when switched on.':
    'Algunos efectos no funcionaban como se esperaba al activarlos.',
  'The mixer shut itself down unexpectedly.':
    'El mixer se apagaba solo de forma inesperada.',
  'BPM display fluctuating when SLIP was used on a linked CDJ-2000NXS or CDJ-900.':
    'El display de BPM fluctuando al usar SLIP en un CDJ-2000NXS o CDJ-900 conectado por link.',
  'ROLL, REV ROLL and SLIP ROLL volume was not always stable.':
    'El volumen de ROLL, REV ROLL y SLIP ROLL no siempre era estable.',
  'No effect sound when REV ROLL followed ROLL immediately.':
    'Sin sonido de efecto cuando REV ROLL venía inmediatamente después de ROLL.',
  'Slight noise while operating the X-PAD.':
    'Un ruido leve al operar el X-PAD.',
  'Audio communication with iOS and iPadOS devices.':
    'Comunicación de audio con equipos iOS y iPadOS.',
  'DJM-REC recording or live streaming sometimes stopped.':
    'La grabación de DJM-REC o la transmisión en vivo a veces se detenía.',
  'Popping noise through USB audio when switching FX ASSIGN with BEAT FX on.':
    'Chasquido en el audio USB al cambiar FX ASSIGN con BEAT FX activado.',

  /*
   * THE ALL-IN-ONE ROWS, added 2026-08-08 with the XDJ-AZ and XDJ-XZ. Their fault
   * text is translated in the SAME commit as the data, which is the rule the
   * firmware i18n gate check exists to enforce: the last time data landed without
   * its translations, 19 rows read in English on this page for weeks.
   */
  'No audio output, display blackouts and system freezes on some units.':
    'En algunas unidades, sin salida de audio, pantalla apagándose y bloqueos del sistema.',
  'Recording could not be stopped with the Rec button.':
    'No se podía detener la grabación con el botón Rec.',
  'A "Library is not responding." error kept appearing.':
    'Un error "Library is not responding." seguía apareciendo.',
  'PRO DJ LINK did not work properly, with jog wheel and beat sync faults.':
    'PRO DJ LINK no funcionaba correctamente, con fallas en el jog y en el beat sync.',
  'Sync was lost after scratching in Slip mode, and some WAV files would not play.':
    'El sync se perdía después de hacer scratch en modo Slip, y algunos archivos WAV no se reproducían.',
  'Faults when using Beat FX.':
    'Fallas al usar Beat FX.',
  'Faults when Master Tempo was turned on.':
    'Fallas con Master Tempo activado.',
  'No sound from the SEND output terminal.':
    'Sin sonido desde el terminal de salida SEND.',

  /*
   * THE DJM-900NXS2 AND CDJ-2000NXS2 ROWS, added 2026-08-08 after an audit found
   * both pages asserting how COMPLETE their firmware history was. One said "the
   * rest of its change history is feature work" and the other said "three firmware
   * updates". The real numbers are ten and thirteen. Between them these two are the
   * most installed professional mixer and player in the world, so they were the
   * worst two pages on the site to be wrong about.
   */
  'Some Apple Lossless files would not play, and macOS Catalina 10.15 could not see the unit as an audio device.':
    'Algunos archivos Apple Lossless no se reproducían, y macOS Catalina 10.15 no reconocía el equipo como dispositivo de audio.',
  'A connection fault with rekordbox on iOS.':
    'Una falla de conexión con rekordbox en iOS.',
  'Popping noise during loop operations, and a HOT CUE disappearing after a search.':
    'Chasquido durante operaciones de loop, y un HOT CUE desapareciendo después de una búsqueda.',
  'Track load delays, a HOT LOOP changing length, and colour selection faults.':
    'Demoras en la carga de tracks, un HOT LOOP cambiando de largo, y fallas en la selección de color.',
  'PRO DJ LINK faults, audio distortion, and screen transition faults.':
    'Fallas en PRO DJ LINK, distorsión de audio, y fallas en la transición de pantallas.',
  'TRACK FILTER worked incorrectly.':
    'TRACK FILTER funcionaba de forma incorrecta.',
  'Incorrect audio in and out when connected to an iOS device, and the effect channel selector not working with it.':
    'Entrada y salida de audio incorrectas al conectarse a un equipo iOS, y el selector de canal de efecto sin funcionar con él.',
  'Crossfader cut lag precision, a linked player display freezing during HID control, and a pop from the EQ or ISO knob with ISOLATOR selected.':
    'Precisión del cut lag del crossfader, la pantalla de un reproductor conectado por link congelándose durante el control HID, y un chasquido en el knob de EQ o ISO con ISOLATOR seleccionado.',
  'Incorrect audio output when changing Beat FX or the FX channel, a channel level indicator lit at power on, and switching noise on the USB output level.':
    'Salida de audio incorrecta al cambiar Beat FX o el canal de FX, un indicador de nivel de canal encendido al prender, y ruido de conmutación en el nivel de salida USB.',
  'Clicking noise using the FILTER of SOUND COLOR FX, and a pop from DIGITAL MASTER OUT at power on.':
    'Ruido de clic usando el FILTER de SOUND COLOR FX, y un chasquido en DIGITAL MASTER OUT al prender.',
  'SOUND COLOR FX worked incorrectly, with flanger volume faults.':
    'SOUND COLOR FX funcionaba de forma incorrecta, con fallas de volumen en el flanger.',
  'Audio dropouts under certain conditions with DIGITAL selected.':
    'Caídas de audio en ciertas condiciones con DIGITAL seleccionado.',
  'PRO DJ LINK network faults, SOUND COLOR FX signal chain faults, and sampling rate switching noise.':
    'Fallas en la red PRO DJ LINK, fallas en la cadena de señal de SOUND COLOR FX, y ruido al cambiar la tasa de muestreo.',
};

const LONG = {
  'A young unit. AlphaTheta has published no defect fix for it, so there is nothing to report here. This section stays empty until a documented one exists.':
    'Una unidad nueva. AlphaTheta no ha publicado ninguna corrección de defectos para ella, así que aquí no hay nada que reportar. Esta sección queda vacía hasta que exista una documentada.',
  'AlphaTheta has published no hardware defect fix for this mixer beyond the DJM-REC recording halts. The rest of its change history is feature work.':
    'AlphaTheta no ha publicado ninguna corrección de defectos de hardware para este mixer más allá de los cortes de grabación de DJM-REC. El resto de su historial de cambios son funciones nuevas.',
  'Withdrawn by AlphaTheta. It added OneLibrary, then playlists failed to display for people exporting from older rekordbox. No music or data was deleted, and the player reverted to Device Library. Do not install this version.':
    'Retirada por AlphaTheta. Trajo OneLibrary, y después las playlists dejaron de aparecer para quienes exportaban desde un rekordbox más viejo. No se borró música ni datos, y el reproductor volvió a Device Library. No instales esta versión.',

  'Not a defect. From this version the unit automatically switches off after 20 minutes of no use when Power Management is on, following the EU Ecodesign Directive. A deck that powered down during a long changeover is obeying that setting, not failing.':
    'No es un defecto. A partir de esta versión el equipo se apaga solo después de 20 minutos sin uso cuando Power Management está activado, siguiendo la Directiva Ecodesign de la Unión Europea. Un deck que se apagó durante un cambio largo está obedeciendo esa configuración, no fallando.',
  'AlphaTheta has published no firmware change history for this unit, so there is no documented fix to report. This section stays empty until one exists.':
    'AlphaTheta no ha publicado ningún historial de cambios de firmware para este equipo, así que no hay una corrección documentada que reportar. Esta sección queda vacía hasta que exista una.',
  'AlphaTheta published no detail for version 1.05 beyond "Minor issues", and versions 1.00 to 1.02 are not listed at all. What is above is every documented fix for this mixer, not necessarily every fix.':
    'AlphaTheta no publicó ningún detalle de la versión 1.05 más allá de "Minor issues", y las versiones 1.00 a 1.02 no aparecen en la lista. Lo de arriba es cada corrección documentada de este mixer, y no necesariamente cada corrección.',
};

const tr = (map, s) => (s == null ? s : map[s] ?? s);

// Version compare that handles 1.9 vs 1.10 correctly (string sort does not).
function cmpVersion(a, b) {
  const pa = String(a).split('.').map(Number);
  const pb = String(b).split('.').map(Number);
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const d = (pa[i] || 0) - (pb[i] || 0);
    if (d !== 0) return d;
  }
  return 0;
}

// The single most useful number per model: the version at or above which every
// documented issue below is already resolved. Computed, not hand-maintained.
// A withdrawn version sitting ABOVE the computed floor is named separately so
// an open-ended "or later" never swallows it.
const models = FIRMWARE_ISSUES.map(m => {
  const issues = [...m.issues].sort((a, b) => cmpVersion(b.fixedIn, a.fixedIn));
  const safeFloor = issues.length ? issues[0].fixedIn : null;
  // ONLY A WITHDRAWN VERSION IS AN EXCEPTION TO THE FLOOR (2026-08-08). This
  // used to test any warning, which was right while the only warning was the
  // CDJ-3000's pulled 3.30, and became a live falsehood the moment the
  // XDJ-1000MK2's Ecodesign warning landed at 1.45 above its 1.42 floor: the
  // header told every reader the player's current firmware was withdrawn. A
  // behaviour change is not something to avoid, so it does not move the floor.
  const floorException =
    m.warning?.kind === 'withdrawn' && safeFloor
      && cmpVersion(m.warning.version, safeFloor) > 0
      ? m.warning.version
      : null;
  return { ...m, issues, safeFloor, floorException };
});

const totalIssues = models.reduce((n, m) => n + m.issues.length, 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/firmware#article',
  headline: 'Problemas de firmware de CDJ y DJM, por versión',
  description: 'Qué fallas documentadas siguen vivas en un reproductor o mixer Pioneer DJ y AlphaTheta en cada versión de firmware, reunidas de los historiales de cambios de la propia AlphaTheta.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-01',
  dateModified: '2026-08-01',
  inLanguage: 'es',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/firmware#webpage' },
};
---
<Base
  title="Firmware del CDJ y del DJM: fallas por versión | Save My Gig"
  description="Lee la versión de firmware en el CDJ o en el DJM y mira qué fallas documentadas siguen vivas. Directo de los historiales de AlphaTheta."
  path="/knowledge/pioneer-dj/firmware"
  crumbName="Fallas de firmware por versión"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <nav class="crumb" aria-label="Ruta de navegación">
      <a href="/es/knowledge">Base de conocimiento</a> <span aria-hidden="true">/</span>
      <a href="/es/knowledge/pioneer-dj">Pioneer DJ / AlphaTheta</a> <span aria-hidden="true">/</span>
      <span>Fallas de firmware</span>
    </nav>

    <div class="status-line sl-desktop">MATRIZ DE FIRMWARE</div>
    <h1 class="rb-h1">Qué está roto en ese reproductor, <span class="accent">por versión de firmware</span></h1>
    <p class="dim rb-updated">Revisado: {esDate(UPDATED)}</p>

    <div class="panel panel-go">
      <input type="checkbox" id="sv-toggle" class="sv-toggle sr-only" />
      <p class="sv-text" style="margin:0">
        <strong>Briefing de booth.</strong> Lee la versión de firmware en el
        aparato, encuéntrala aquí abajo, y ya sabes qué te puede morder hoy.
        Cada entrada viene de los historiales de cambios publicados por la
        propia AlphaTheta: {totalIssues} fallas documentadas en {models.length} modelos.
        En el equipo que es tuyo, quédate en la versión segura indicada para él
        o más arriba. En el equipo que no es tuyo, esto te dice qué tienes que
        prever.
      </p>
      <label for="sv-toggle" class="sv-more">Leer más…</label>
      <label for="sv-toggle" class="sv-more sv-more-open">Leer menos</label>
    </div>

    <div class="fw-how">
      <h2 class="fw-how-h">Dónde encontrar la versión en el aparato</h2>
      <p>
        En un CDJ o en un DJM, la versión del firmware está en el menú UTILITY,
        y en los reproductores también aparece en la pantalla de arranque
        mientras el aparato enciende. Revísala en el soundcheck, no cuando abren
        las puertas. Si el reproductor del lugar está por debajo de la versión
        segura, eso no lo resuelves en el booth, pero sí puedes evitar que te
        tome por sorpresa.
      </p>
    </div>

    {models.map(m => (
      <details class="acc-sec fw-model" name="fw-acc">
        <summary>
          {/* Model names and firmware version strings are read off the
              unit itself, so they must never be auto-translated. */}
          <h2 class="acc-h2 fw-model-h" translate="no">{m.model}</h2>
          {m.safeFloor && (
            <span class="fw-floor">
              Limpio en <strong translate="no">{m.safeFloor}</strong> o más reciente
              {m.floorException && (
                <Fragment>, menos la <strong class="fw-floor-except" translate="no">{m.floorException}</strong> (retirada)</Fragment>
              )}
            </span>
          )}
          <span class="acc-chev" aria-hidden="true"></span>
        </summary>
        <div class="acc-body fw-body">

        {m.warning && (
          <div class="fw-warn">
            <span class="fw-warn-v" translate="no">{m.warning.version}</span>
            <span>
              {tr(LONG, m.warning.text)}{' '}
              <a href={m.warning.sourceUrl} target="_blank" rel="noopener">Aviso oficial</a>
            </span>
          </div>
        )}

        {m.issues.length === 0 ? (
          <p class="fw-none">{tr(LONG, m.noneNote)}</p>
        ) : (
          <table class="fw-table">
            {/* Every model on this page renders one of these, so without a
                caption a screen reader user meets a dozen identical unnamed
                three-column tables. */}
            <caption class="sr-only">Fallas documentadas en el {m.model}, y la versión de firmware que corrigió cada una</caption>
            <thead>
              <tr>
                <th scope="col">Corregido en</th>
                <th scope="col">Área</th>
                <th scope="col">Qué pasaba debajo de esa versión</th>
              </tr>
            </thead>
            <tbody>
              {m.issues.map(i => (
                <tr>
                  <td class="fw-v"><span class="fw-vbadge" translate="no">{i.fixedIn}</span></td>
                  <td class="fw-area">
                    {tr(AREA, i.area)}
                    {i.midSet && <span class="fw-live" title="Puede interrumpir un set en curso">mitad de set</span>}
                  </td>
                  <td>{tr(SYMPTOM, i.symptom)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        {m.note && <p class="fw-note">{tr(LONG, m.note)}</p>}

        <p class="fw-links">
          <a href={`/es${m.href}`}>Manual de campo del {m.model}</a>
          {/* Six models render this row, so the accessible name names the
              model instead of repeating one anonymous link six times. */}
          <a href={m.source} target="_blank" rel="noopener"
             aria-label={`Historial de cambios de AlphaTheta para el ${m.model}`}>Historial de cambios AlphaTheta</a>
        </p>
        </div>
      </details>
    ))}

    <div class="panel">
      <p style="margin:0 0 0.6rem"><strong>Cómo leer esto</strong></p>
      <p style="margin:0 0 0.6rem">
        La versión en la columna "Corregido en" es la release que resolvió esa
        falla. Cualquier cosa debajo de ella todavía la tiene. Cualquier cosa en
        ella o más arriba, no.
      </p>
      <p style="margin:0">
        El marcador <span class="fw-live fw-live-inline">mitad de set</span> es
        nuestro, no de AlphaTheta. Señala las fallas cuyo síntoma documentado
        puede interrumpir un set ya en curso, para que separes un riesgo real de
        una molestia de un vistazo. Todo el resto de esta página es la redacción
        del propio fabricante, condensada.
      </p>
    </div>

    <p class="dim fw-foot">
      Solo fallas. Las funciones nuevas quedan fuera a propósito, porque una
      función que falta no te termina un set. Cada modelo AlphaTheta que existe
      en este sitio tiene una sección aquí, incluidos los que no tienen nada que
      reportar: cuando AlphaTheta no publicó historial de cambios, la sección lo
      dice en lugar de quedar fuera, porque una sección que falta y un historial
      limpio se ven igual desde afuera. ¿Encontraste algo mal aquí?
      <a href="/es/feedback">Avísanos</a> y lo revisamos contra la fuente.
    </p>

    <EmailCapture source="knowledge_firmware" lang="es" />
  </main>

