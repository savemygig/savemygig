---
import Base from '../../../../layouts/Base.astro';
import EmailCapture from '../../../../components/EmailCapture.astro';
import { CHECKED, FIRMWARE_ISSUES } from '../../../../data/facts.js';

// MATRIZ DE FIRMWARE, NEUTRAL LATIN AMERICAN SPANISH. Source of truth for the
// data, the version arithmetic, the accordion, the table and the CSS:
// src/pages/knowledge/pioneer-dj/firmware.astro. Only the human readable copy
// and the /es hrefs differ. If the English page changes, change this one in
// the same commit.
//
// facts.js is language neutral for versions and URLs and ENGLISH for the
// prose fields (`area`, `symptom`, `note`, `noneNote`, `warning.text`). It is
// a shared data file, so it is not translated in place: the maps below
// translate those strings at render time and fall back to the English string
// if facts.js gains an entry this file has not seen yet. A new entry then
// shows up in English rather than disappearing.
const UPDATED = CHECKED;

const MESES = {
  January: 'enero', February: 'febrero', March: 'marzo', April: 'abril',
  May: 'mayo', June: 'junio', July: 'julio', August: 'agosto',
  September: 'septiembre', October: 'octubre', November: 'noviembre', December: 'diciembre',
};
// CHECKED is an English date string in facts.js. Rendered, not rewritten.
const esDate = (s) => {
  const m = /^(\d{1,2}) (\w+) (\d{4})$/.exec(String(s));
  return m && MESES[m[2]] ? `${m[1]} de ${MESES[m[2]]} de ${m[3]}` : String(s);
};

const AREA = {
  Link: 'Link',
  Display: 'Pantalla',
  Audio: 'Audio',
  Browse: 'Browse',
  Playback: 'Reproducción',
  USB: 'USB',
  MIDI: 'MIDI',
  Routing: 'Ruteo',
  Recording: 'Grabación',
};

const SYMPTOM = {
  'PRO DJ LINK connection with a DJM-2000NXS could fail.':
    'La conexión PRO DJ LINK con un DJM-2000NXS podía fallar.',
  'Rare dead screen on power-on.':
    'Pantalla muerta al encender, en casos raros.',
  'Occasional no-audio, display blackouts and system freezes on some units.':
    'En algunas unidades, falta de audio ocasional, pantalla apagándose y el sistema congelándose.',
  'A "Waiting" popup could block the BROWSE screen entirely.':
    'Un aviso "Waiting" podía bloquear la pantalla BROWSE por completo.',
  'Emergency Loop triggering wrongly during a Hot Cue pause.':
    'Emergency Loop disparándose mal durante una pausa en Hot Cue.',
  'A startup issue affecting SLIP HOT CUE behaviour.':
    'Un problema de arranque que afectaba el comportamiento de SLIP HOT CUE.',
  'Waveform colour selection went missing, then was restored.':
    'La selección de color de la waveform desapareció y después volvió.',
  'Audio dropouts during Control Mode playback.':
    'Caídas de audio reproduciendo en Control Mode.',
  'UASP-compatible USB drives not recognized.':
    'Las unidades USB compatibles con UASP no se reconocían.',
  'Potential audio cut-out when connected to CDJ-3000s over PRO DJ LINK.':
    'Posible corte de audio conectado a CDJ-3000 por PRO DJ LINK.',
  'Incorrect MIDI output under certain operation.':
    'Salida MIDI incorrecta en determinadas operaciones.',
  'Audio sometimes failing to input to a channel.':
    'El audio a veces no entraba a un canal.',
  'Rare freeze under heavy PRO DJ LINK network load.':
    'Congelamiento raro con carga pesada en la red PRO DJ LINK.',
  'Insert method intermittently disabling itself when switching the Multi I/O input selector, and DVS phono input malfunction on USB-B after swapping computers across ports.':
    'El insert desactivándose solo de vez en cuando al cambiar el selector de entrada Multi I/O, y falla de la entrada phono de DVS en el USB-B después de cambiar las computadoras de puerto.',
  'DJM-REC recording halts affecting iOS and iPadOS audio.':
    'Cortes de grabación de DJM-REC que afectaban el audio en iOS y iPadOS.',
  'DJM-REC recording could halt part-way through a set.':
    'La grabación de DJM-REC podía cortarse a mitad de un set.',
};

const LONG = {
  'A young unit. AlphaTheta has published no defect fix for it, so there is nothing to report here. This section stays empty until a documented one exists.':
    'Una unidad nueva. AlphaTheta no ha publicado ninguna corrección de defectos para ella, así que aquí no hay nada que reportar. Esta sección queda vacía hasta que exista una documentada.',
  'AlphaTheta has published no hardware defect fix for this mixer beyond the DJM-REC recording halts. The rest of its change history is feature work.':
    'AlphaTheta no ha publicado ninguna corrección de defectos de hardware para este mixer más allá de los cortes de grabación de DJM-REC. El resto de su historial de cambios son funciones nuevas.',
  'Withdrawn by AlphaTheta. It added OneLibrary, then playlists failed to display for people exporting from older rekordbox. No music or data was deleted, and the player reverted to Device Library. Do not install this version.':
    'Retirada por AlphaTheta. Trajo OneLibrary, y después las playlists dejaron de aparecer para quienes exportaban desde un rekordbox más viejo. No se borró música ni datos, y el reproductor volvió a Device Library. No instales esta versión.',
};

const tr = (map, s) => (s == null ? s : map[s] ?? s);

// Version compare that handles 1.9 vs 1.10 correctly (string sort does not).
function cmpVersion(a, b) {
  const pa = String(a).split('.').map(Number);
  const pb = String(b).split('.').map(Number);
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const d = (pa[i] || 0) - (pb[i] || 0);
    if (d !== 0) return d;
  }
  return 0;
}

// The single most useful number per model: the version at or above which every
// documented issue below is already resolved. Computed, not hand-maintained.
// A withdrawn version sitting ABOVE the computed floor is named separately so
// an open-ended "or later" never swallows it.
const models = FIRMWARE_ISSUES.map(m => {
  const issues = [...m.issues].sort((a, b) => cmpVersion(b.fixedIn, a.fixedIn));
  const safeFloor = issues.length ? issues[0].fixedIn : null;
  const floorException =
    m.warning && safeFloor && cmpVersion(m.warning.version, safeFloor) > 0
      ? m.warning.version
      : null;
  return { ...m, issues, safeFloor, floorException };
});

const totalIssues = models.reduce((n, m) => n + m.issues.length, 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/firmware#article',
  headline: 'Problemas de firmware de CDJ y DJM, por versión',
  description: 'Qué fallas documentadas siguen vivas en un reproductor o mixer Pioneer DJ y AlphaTheta en cada versión de firmware, reunidas de los historiales de cambios de la propia AlphaTheta.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-01',
  dateModified: '2026-08-01',
  inLanguage: 'es',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/firmware#webpage' },
};
---
<Base
  title="Fallas de firmware del CDJ y del DJM por versión | Save My Gig"
  description="Lee la versión de firmware en el CDJ o en el DJM y mira qué fallas documentadas siguen vivas en él. Directo de los historiales de cambios de AlphaTheta, modelo por modelo."
  path="/knowledge/pioneer-dj/firmware"
  crumbName="Fallas de firmware por versión"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <nav class="crumb" aria-label="Ruta de navegación">
      <a href="/es/knowledge">Base de conocimiento</a> <span aria-hidden="true">/</span>
      <a href="/es/knowledge/pioneer-dj">Pioneer DJ / AlphaTheta</a> <span aria-hidden="true">/</span>
      <span>Fallas de firmware</span>
    </nav>

    <div class="status-line sl-desktop">MATRIZ DE FIRMWARE</div>
    <h1 class="rb-h1">Qué está roto en ese reproductor, <span class="accent">por versión de firmware</span></h1>
    <p class="dim rb-updated">Revisado: {esDate(UPDATED)}</p>

    <div class="panel panel-go">
      <input type="checkbox" id="sv-toggle" class="sv-toggle sr-only" />
      <p class="sv-text" style="margin:0">
        <strong>Briefing de booth.</strong> Lee la versión de firmware en el
        aparato, encuéntrala aquí abajo, y ya sabes qué te puede morder hoy.
        Cada entrada viene de los historiales de cambios publicados por la
        propia AlphaTheta: {totalIssues} fallas documentadas en {models.length} modelos.
        En el equipo que es tuyo, quédate en la versión segura indicada para él
        o más arriba. En el equipo que no es tuyo, esto te dice qué tienes que
        prever.
      </p>
      <label for="sv-toggle" class="sv-more">Leer más…</label>
      <label for="sv-toggle" class="sv-more sv-more-open">Leer menos</label>
    </div>

    <div class="fw-how">
      <h2 class="fw-how-h">Dónde encontrar la versión en el aparato</h2>
      <p>
        En un CDJ o en un DJM, la versión del firmware está en el menú UTILITY,
        y en los reproductores también aparece en la pantalla de arranque
        mientras el aparato enciende. Revísala en el soundcheck, no cuando abren
        las puertas. Si el reproductor del lugar está por debajo de la versión
        segura, eso no lo resuelves en el booth, pero sí puedes evitar que te
        tome por sorpresa.
      </p>
    </div>

    {models.map(m => (
      <details class="acc-sec fw-model" name="fw-acc">
        <summary>
          {/* Model names and firmware version strings are read off the
              unit itself, so they must never be auto-translated. */}
          <h2 class="acc-h2 fw-model-h" translate="no">{m.model}</h2>
          {m.safeFloor && (
            <span class="fw-floor">
              Limpio en <strong translate="no">{m.safeFloor}</strong> o más reciente
              {m.floorException && (
                <Fragment>, menos la <strong class="fw-floor-except" translate="no">{m.floorException}</strong> (retirada)</Fragment>
              )}
            </span>
          )}
          <span class="acc-chev" aria-hidden="true"></span>
        </summary>
        <div class="acc-body fw-body">

        {m.warning && (
          <div class="fw-warn">
            <span class="fw-warn-v" translate="no">{m.warning.version}</span>
            <span>
              {tr(LONG, m.warning.text)}{' '}
              <a href={m.warning.sourceUrl} target="_blank" rel="noopener">Aviso oficial</a>
            </span>
          </div>
        )}

        {m.issues.length === 0 ? (
          <p class="fw-none">{tr(LONG, m.noneNote)}</p>
        ) : (
          <table class="fw-table">
            {/* Every model on this page renders one of these, so without a
                caption a screen reader user meets a dozen identical unnamed
                three-column tables. */}
            <caption class="sr-only">Fallas documentadas en el {m.model}, y la versión de firmware que corrigió cada una</caption>
            <thead>
              <tr>
                <th scope="col">Corregido en</th>
                <th scope="col">Área</th>
                <th scope="col">Qué pasaba debajo de esa versión</th>
              </tr>
            </thead>
            <tbody>
              {m.issues.map(i => (
                <tr>
                  <td class="fw-v"><span class="fw-vbadge" translate="no">{i.fixedIn}</span></td>
                  <td class="fw-area">
                    {tr(AREA, i.area)}
                    {i.midSet && <span class="fw-live" title="Puede interrumpir un set en curso">mitad de set</span>}
                  </td>
                  <td>{tr(SYMPTOM, i.symptom)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        {m.note && <p class="fw-note">{tr(LONG, m.note)}</p>}

        <p class="fw-links">
          <a href={`/es${m.href}`}>Manual de campo del {m.model}</a>
          {/* Six models render this row, so the accessible name names the
              model instead of repeating one anonymous link six times. */}
          <a href={m.source} target="_blank" rel="noopener"
             aria-label={`Historial de cambios de AlphaTheta para el ${m.model}`}>Historial de cambios AlphaTheta</a>
        </p>
        </div>
      </details>
    ))}

    <div class="panel">
      <p style="margin:0 0 0.6rem"><strong>Cómo leer esto</strong></p>
      <p style="margin:0 0 0.6rem">
        La versión en la columna "Corregido en" es la release que resolvió esa
        falla. Cualquier cosa debajo de ella todavía la tiene. Cualquier cosa en
        ella o más arriba, no.
      </p>
      <p style="margin:0">
        El marcador <span class="fw-live fw-live-inline">mitad de set</span> es
        nuestro, no de AlphaTheta. Señala las fallas cuyo síntoma documentado
        puede interrumpir un set ya en curso, para que separes un riesgo real de
        una molestia de un vistazo. Todo el resto de esta página es la redacción
        del propio fabricante, condensada.
      </p>
    </div>

    <p class="dim fw-foot">
      Solo fallas. Las funciones nuevas quedan fuera a propósito, porque una
      función que falta no te termina un set. Un modelo entra aquí cuando su
      historial de cambios ya fue leído contra la fuente primaria, y por eso
      esta lista es más corta que el catálogo. ¿Encontraste algo mal aquí?
      <a href="/es/feedback">Avísanos</a> y lo revisamos contra la fuente.
    </p>

    <EmailCapture  lang="es" />
  </main>

  <style>
    /* This page puts the eyebrow directly under the breadcrumb rather than
       inside an .hw-head block, so it needs the gap the photo pages get for
       free from that wrapper. */
    .status-line { margin-top: 0.4rem; }
    /* size comes from the global h1 scale, 2026-08-03 */
    .rb-h1 { margin-bottom: 0.4rem; }
    .rb-h1 .accent { font-size: 96%; }
    .rb-updated { font-size: 0.82rem; margin-bottom: 1.6rem; }
    main p { color: var(--text-dim); line-height: 1.65; }
    /* Without this the lead-in inherits the dim paragraph colour and reads
       grey instead of white. */
    main p strong { color: var(--text); }

    .fw-how { margin: 2rem 0 0.6rem; }
    .fw-how-h {
      font-family: var(--font-display); font-size: 0.78rem; font-weight: 800;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint);
      margin: 0 0 0.5rem;
    }
    .fw-how p { margin: 0; font-size: 0.95rem; }

    /* Accordion per model: the full matrix open at once is too much to read.
       Uses the site's shared .acc-sec vocabulary, and the exclusive `name`
       means opening one closes the rest, same as every other reference page.
       The safe version stays in the CLOSED header on purpose: "which deck, and
       is it clear" is the whole lookup, and it should not need a tap. */
    .fw-model { margin-top: 0; }
    .fw-model > summary { align-items: center; gap: 0.9rem; flex-wrap: wrap; }
    .fw-model-h { flex: 1 1 auto; }
    .fw-floor {
      flex: 0 0 auto;
      font-size: 0.78rem; color: var(--green);
      font-weight: 600; white-space: nowrap;
    }
    .fw-floor strong { color: var(--green); }
    /* The withdrawn version named in the closed header is an exclusion, not a
       clear version, so it must not read green. */
    .fw-floor .fw-floor-except { color: var(--red); }
    .fw-body { padding-top: 0.2rem; }

    /* The withdrawn-firmware callout. Uses the danger tone already defined
       sitewide rather than a new colour, so it reads as the same alarm the
       rest of the site uses. */
    .fw-warn {
      display: flex; gap: 0.8rem; align-items: flex-start;
      background: var(--red-dim); border: var(--stroke) solid var(--red-border);
      border-radius: var(--radius); padding: 0.9rem 1rem; margin-bottom: 1rem;
      font-size: 0.9rem; color: var(--text-dim); line-height: 1.6;
    }
    .fw-warn-v {
      flex: 0 0 auto; font-weight: 800; color: var(--red);
      font-family: var(--font-display); letter-spacing: 0.02em;
    }

    .fw-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .fw-table th {
      text-align: left; font-size: 0.7rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-faint); font-weight: 700;
      padding: 0 0.7rem 0.5rem 0; border-bottom: var(--stroke) solid var(--edge);
    }
    .fw-table td {
      padding: 0.7rem 0.7rem 0.7rem 0; border-bottom: var(--stroke) solid var(--edge);
      color: var(--text-dim); line-height: 1.55; vertical-align: top;
    }
    .fw-table tr:last-child td { border-bottom: none; }
    .fw-v { white-space: nowrap; }
    .fw-vbadge {
      display: inline-block; font-family: var(--font-display); font-weight: 800;
      font-size: 0.85rem; color: var(--text);
      background: var(--surf-2); border: var(--stroke) solid var(--edge);
      border-radius: var(--radius); padding: 0.15rem 0.5rem;
    }
    .fw-area { white-space: nowrap; color: var(--text); font-weight: 600; font-size: 0.85rem; }
    .fw-live {
      display: inline-block; margin-left: 0.45rem;
      font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase;
      font-weight: 800; color: var(--red);
      border: var(--stroke) solid var(--red-border); border-radius: var(--radius);
      padding: 0.1rem 0.32rem; vertical-align: middle;
    }
    .fw-live-inline { margin-left: 0; }

    .fw-none, .fw-note { font-size: 0.9rem; margin: 0.2rem 0 0; }
    .fw-links { display: flex; gap: 1.2rem; flex-wrap: wrap; margin: 0.9rem 0 0; font-size: 0.85rem; }
    .fw-foot { font-size: 0.85rem; margin: 1.6rem 0 2rem; }

    /* Phones: the three-column table stops working around 640px, so each row
       becomes a stacked block with the version badge leading. Same data, no
       horizontal scroll, which matters because this page gets read in a booth
       on a phone with one hand. */
    @media (max-width: 640px) {
      .fw-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      .fw-table, .fw-table tbody, .fw-table tr, .fw-table td { display: block; width: 100%; }
      .fw-table tr {
        border-bottom: var(--stroke) solid var(--edge); padding: 0.8rem 0;
      }
      .fw-table tr:last-child { border-bottom: none; }
      .fw-table td { border: none; padding: 0; }
      .fw-v { display: inline-block; margin-right: 0.5rem; }
      .fw-area { display: inline-block; margin-bottom: 0.35rem; }
      .fw-head { flex-direction: column; gap: 0.2rem; }
    }
  </style>
</Base>
