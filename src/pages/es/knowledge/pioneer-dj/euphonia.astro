// euphonia, NEUTRAL LATIN AMERICAN SPANISH. Source of truth for structure,
// components, classes, anchors and CSS:
// src/pages/knowledge/pioneer-dj/euphonia.astro. Only the human readable copy
// and the /es hrefs differ.

const MESES = {
  January: 'enero', February: 'febrero', March: 'marzo', April: 'abril',
  May: 'mayo', June: 'junio', July: 'julio', August: 'agosto',
  September: 'septiembre', October: 'octubre', November: 'noviembre', December: 'diciembre',
};
const esDate = (s) => s.replace(/^(\d+)\s+([A-Za-z]+)\s+(\d+)$/, (_m, d, mo, y) => `${d} de ${MESES[mo] ?? mo} de ${y}`);
const UPDATED = esDate(EUPHONIA.checked);
const FX = EUPHONIA.sendEffects.join(', ');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/euphonia#article',
  headline: 'euphonia: la referencia operativa',
  description: 'Lo que todo DJ necesita saber antes de trabajar un AlphaTheta euphonia: faders rotativos y ningún crossfader, el transformador de master de Rupert Neve, en qué se diferencia el Master Isolator del EQ de canal, y por qué no soporta PRO DJ LINK.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-07',
  dateModified: '2026-08-07',
  inLanguage: 'es',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/es/knowledge/pioneer-dj/euphonia#webpage' },
  image: 'https://www.savemygig.com/images/euphonia-panel-full.webp',
};
---
<Base
  title="euphonia: faders rotativos y sin crossfader | Save My Gig"
  description="Manual de campo del euphonia: faders rotativos y sin crossfader, transformador de master Rupert Neve, el Master Isolator que no es EQ de canal y un USB-C."
  path="/knowledge/pioneer-dj/euphonia"
  crumbName="euphonia"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <nav class="crumb" aria-label="Ruta de navegación">
      <a href="/es/knowledge">Base de conocimiento</a> <span aria-hidden="true">/</span>
      <a href="/es/knowledge/pioneer-dj">Pioneer DJ / AlphaTheta</a> <span aria-hidden="true">/</span>
      <span>euphonia</span>
    </nav>

    <div class="hw-head">
      <div class="hw-head-text">
        <div class="status-line sl-date">Revisado: {UPDATED}</div>
        <h1 class="rb-h1">euphonia, <span class="accent">el manual de campo</span></h1>
      </div>
      <a
        class="hw-thumb"
        href="#euphonia-lightbox"
        aria-label="Abrir una foto más grande del panel de control del euphonia"
