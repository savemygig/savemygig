---
import Base from '../../../../layouts/Base.astro';
import { modelsOfBrand, modelPath } from '../../../../data/facts.js';

// HUB ALLEN & HEATH, ESPAÑOL LATINOAMERICANO NEUTRO. La fuente de verdad de la
// estructura, del catálogo, de las categorías, del contrato CollectionPage, del
// script y del CSS es src/pages/knowledge/allen-heath/index.astro. Aquí solo
// cambian el texto que lee una persona y los hrefs con /es. Si cambia la página
// en inglés, cambia esta en el mismo commit.
//
// La lista de modelos con página viene del grafo de equipos, igual que en la
// página en inglés: modelPath() devuelve la ruta canónica en inglés y el
// prefijo /es entra aquí, en el punto donde se arma el enlace.
const mixers = [
  ...modelsOfBrand('allen-heath', 'mixer').map((m) => ({ name: m.name, href: `/es${modelPath(m)}` })),
  { name: 'Xone:PX5', href: null },
  { name: 'Xone:43', href: null },
];
const controllers = [
  { name: 'Xone:K2', href: null },
  { name: 'Xone:K3', href: null },
];

const categories = [
  { label: 'Mixers', items: mixers },
  { label: 'Controladoras', items: controllers, note: 'La serie K es una controladora con filtro Xone arriba, y por eso el DJ la trata como parte del mixer y no como una caja aparte.' },
];

// El ItemList lleva SOLO los modelos con página de referencia publicada, igual
// que el archivo en inglés. Todo lo demás está marcado como "Muy pronto" y una
// lista legible por máquina no tiene forma de cargar ese aviso. Nada se agrega
// después de los modelos: esta marca no tiene matriz de firmware, y uno de los
// dos mixers no tiene firmware en absoluto.
const listed = [...mixers, ...controllers].filter((x) => x.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/es/knowledge/allen-heath#webpage',
  url: 'https://www.savemygig.com/es/knowledge/allen-heath',
  name: 'Referencia de equipos Allen & Heath Xone',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Allen & Heath' },
    { '@type': 'Thing', name: 'Serie Xone' },
    { '@type': 'Thing', name: 'Mixers de DJ analógicos' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    '@id': 'https://www.savemygig.com/es/knowledge/allen-heath#list',
    name: 'Referencias de modelos Allen & Heath',
    numberOfItems: listed.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: listed.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: x.name,
      url: `https://www.savemygig.com${x.href}`,
    })),
  },
};
---
<Base
  title="Allen & Heath: guía de los mixers Xone | Save My Gig"
  description="Xone:96 y Xone:92: mixers analógicos alrededor del filtro Xone. Qué sale mal, lo que el manual no dice, y el que no tiene firmware."
  path="/knowledge/allen-heath"
  crumbName="Allen & Heath"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <nav class="crumb" aria-label="Ruta de navegación">
      <a href="/es/knowledge">Base de conocimiento</a> <span aria-hidden="true">/</span> <span>Allen &amp; Heath</span>
    </nav>

    <div class="status-line">ALLEN_HEATH</div>
    <h1 style="margin-bottom:0.8rem">Allen &amp; <span class="accent">Heath</span></h1>
    <p class="dim kb-lead">
      Mixers analógicos construidos alrededor del filtro Xone, y lo que importa
      en estas mesas es a dónde va realmente la señal. Micrófonos que no llegan
      ni al booth ni a la grabación hasta que un switch en el panel trasero lo
      permite. Una posición del assign del crossfader que saca un canal completo
      de la mezcla. Un master que llega a unity bastante antes del final del
      recorrido. Y ninguno de los dos manuales tiene sección de
      troubleshooting, que es la mayor razón por la que existen estas páginas.
    </p>

    <!-- No firmware matrix promo here: this brand has none, and one of these
         two mixers has no firmware to have a version of. The honest
         equivalent is the way back out to the other manufacturers. -->
    <p class="ah-out">
      <a href="/es/equipment">Cada fabricante, cada modelo que ya tiene página &rarr;</a>
    </p>

    <!-- Collapsible categories: on a phone the category headers ARE the index.
         On desktop the inline script below opens everything before paint.
         Native details/summary, no framework. -->
    {categories.map(cat => (
      <details class="kb-cat">
        <summary>
          <h2 class="kb-h">{cat.label}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        {cat.note && <p class="dim" style="margin-bottom:0.9rem;font-size:0.85rem">{cat.note}</p>}
        <div class="kb-grid">
          {cat.items.map(m => (
            m.href ? (
              <a class="kb-card kb-live" href={m.href}>
                <span class="kb-name">{m.name}</span>
                <span class="kb-go">Abrir la guía &rarr;</span>
              </a>
            ) : (
              <div class="kb-card kb-soon">
                <span class="kb-name">{m.name}</span>
                <span class="kb-tag">Muy pronto</span>
              </div>
            )
          ))}
        </div>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every category before first interaction.
      // Phones keep them collapsed so the category list is the index.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.kb-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">¿Qué herramienta falta en esta lista?</h2>
      <p class="dim" style="margin-bottom:1rem">Construimos lo que los DJs piden de verdad. Dinos qué usas y sube en la fila.</p>
      <a href="/es/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Cuéntanos qué usas</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      ¿Vas a trabajar con otro equipo esta noche? <a href="/es/equipment">Todos los fabricantes y modelos que ya tienen página</a>.
    </p>
  </main>
</Base>

<style>
  /* The card, the grid, the accordion chevron and the focus ring all come from
     global.css, exactly as on the Pioneer hub. This block is that page's block
     with the .pdj-matrix rules removed, because this page does not draw one. */
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  .kb-lead { max-width: 42rem; margin-bottom: 1.5rem; line-height: 1.6; }
  /* Holds the same vertical rhythm the firmware matrix promo holds on the
     Pioneer hub, without pretending to be a promo. */
  .ah-out { margin: 0 0 1.8rem; font-size: 0.9rem; }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0; flex: 1;
  }
  .kb-cat { margin-top: 1.6rem; }
  .kb-cat > summary {
    display: flex; align-items: center; gap: 0.8rem;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
</style>
