---
import Base from '../../../../layouts/Base.astro';
import { modelsOfBrand, modelPath } from '../../../../data/facts.js';

// HUB TECHNICS, ESPAÑOL LATINOAMERICANO NEUTRO. La fuente de verdad de la
// estructura, del catálogo, de las categorías, del contrato CollectionPage, del
// script y del CSS es src/pages/knowledge/technics/index.astro. Aquí solo
// cambian el texto que lee una persona y los hrefs con /es. Si cambia la
// página en inglés, cambia esta en el mismo commit.
//
// La lista de modelos con página viene del grafo de equipos, igual que en la
// página en inglés: modelPath() devuelve la ruta canónica en inglés y el
// prefijo /es entra aquí, en el punto donde se arma el enlace. Las entradas
// "Muy pronto" siguen siendo literales locales porque no están en el grafo y
// no deben estar.
const turntables = [
  ...modelsOfBrand('technics', 'turntable').map((m) => ({ name: m.name, href: `/es${modelPath(m)}` })),
  { name: 'SL-1200MK5', href: null },
  { name: 'SL-1200GR', href: null },
  { name: 'SL-1200G', href: null },
];

const categories = [
  {
    label: 'Tornamesas',
    items: turntables,
    note: 'El MK7 es la tornamesa que puedes comprar. El MK2 es la que tienes muchas más probabilidades de encontrar ya atornillada en el booth, y salió de producción hace bastante más de una década.',
  },
];

// El ItemList lleva SOLO los modelos con página de referencia publicada, igual
// que el archivo en inglés. Nada de matriz de firmware arriba de las
// categorías: ninguna de estas dos tornamesas tiene firmware del que tener
// versión.
const listed = turntables.filter((x) => x.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/es/knowledge/technics#webpage',
  url: 'https://www.savemygig.com/es/knowledge/technics',
  name: 'Referencia de las tornamesas Technics SL-1200',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  inLanguage: 'es',
  about: [
    { '@type': 'Thing', name: 'Technics' },
    { '@type': 'Thing', name: 'Serie SL-1200' },
    { '@type': 'Thing', name: 'Tornamesas de DJ de tracción directa' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    '@id': 'https://www.savemygig.com/es/knowledge/technics#list',
    name: 'Referencias de modelos Technics',
    numberOfItems: listed.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: listed.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: x.name,
      url: `https://www.savemygig.com${x.href}`,
    })),
  },
};
---
<Base
  title="Technics SL-1200: guía de las tornamesas | Save My Gig"
  description="SL-1200MK7 y SL-1200MK2: zumbido y cable de tierra, pitch y torque, un canal mudo, y el ajuste del brazo que evita que la aguja salte."
  path="/knowledge/technics"
  crumbName="Technics"
  lang="es"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <nav class="crumb" aria-label="Ruta de navegación">
      <a href="/es/knowledge">Base de conocimiento</a> <span aria-hidden="true">/</span> <span>Technics</span>
    </nav>

    <div class="status-line">TECHNICS</div>
    <h1 style="margin-bottom:0.8rem">Tech<span class="accent">nics</span></h1>
    <p class="dim kb-lead">
      Tornamesas de tracción directa, donde todo lo que falla es físico. El
      cable de tierra decide si vas a tener zumbido. Los cables del headshell y
      la cápsula deciden si tienes un canal o dos. El piso debajo del booth
      decide si la aguja se queda en el surco. Panasonic documentó más de lo que
      la mayoría supone, y el modelo que con más probabilidad te van a entregar
      vino con un manual sin ninguna sección de troubleshooting, que es la mayor
      razón por la que existen estas páginas.
    </p>

    <!-- No firmware matrix promo here, and the reason is stronger than on the
         Allen & Heath hub. There, one mixer has firmware nobody documents.
         Here neither deck has firmware to have a version of, so the same green
         box would be a category error. The honest equivalent is the way back
         out to the other manufacturers. -->
    <p class="ah-out">
      <a href="/es/equipment">Cada fabricante, cada modelo que ya tiene página &rarr;</a>
    </p>

    <!-- Collapsible categories: on a phone the category headers ARE the index.
         On desktop the inline script below opens everything before paint.
         Native details/summary, no framework. -->
    {categories.map(cat => (
      <details class="kb-cat">
        <summary>
          <h2 class="kb-h">{cat.label}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        {cat.note && <p class="dim" style="margin-bottom:0.9rem;font-size:0.85rem">{cat.note}</p>}
        <div class="kb-grid">
          {cat.items.map(m => (
            m.href ? (
              <a class="kb-card kb-live" href={m.href}>
                <span class="kb-name">{m.name}</span>
                <span class="kb-go">Abrir la guía &rarr;</span>
              </a>
            ) : (
              <div class="kb-card kb-soon">
                <span class="kb-name">{m.name}</span>
                <span class="kb-tag">Muy pronto</span>
              </div>
            )
          ))}
        </div>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every category before first interaction.
      // Phones keep them collapsed so the category list is the index.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.kb-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">¿Qué tornamesa falta en esta lista?</h2>
      <p class="dim" style="margin-bottom:1rem">Construimos lo que los DJs piden de verdad. Dinos qué usas y sube en la fila.</p>
      <a href="/es/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Cuéntanos qué usas</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      ¿Vas a trabajar con otro equipo esta noche? <a href="/es/equipment">Todos los fabricantes y modelos que ya tienen página</a>.
    </p>
  </main>
</Base>

<style>
  /* The card, the grid, the accordion chevron and the focus ring all come from
     global.css, exactly as on the other two hubs, so the three manufacturer
     hubs cannot drift apart. This block is the Allen & Heath block unchanged. */
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  .kb-lead { max-width: 42rem; margin-bottom: 1.5rem; line-height: 1.6; }
  .ah-out { margin: 0 0 1.8rem; font-size: 0.9rem; }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0; flex: 1;
  }
  .kb-cat { margin-top: 1.6rem; }
  .kb-cat > summary {
    display: flex; align-items: center; gap: 0.8rem;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
</style>
