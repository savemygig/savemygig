const P = (v) => prose('es', v);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/es/knowledge/technics/sl-1200mk7#article',
  headline: 'SL-1200MK7: la referencia operativa',
  description: 'Lo que todo DJ necesita saber antes de trabajar una Technics SL-1200MK7: por qué el cable de tierra es lo primero que se revisa ante un zumbido, qué deja un canal mudo, los switches traseros que cambian cómo arranca y frena, y el rango de pitch que la ficha técnica no publica.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-08',
  dateModified: '2026-08-08',
  inLanguage: 'es',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/es/knowledge/technics/sl-1200mk7#webpage' },
