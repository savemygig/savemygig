---
import Base from '../../layouts/Base.astro';
// 404, SPANISH (neutral Latin American). Source of truth for structure and
// classes: src/pages/404.astro. Only the copy and the /es hrefs differ.
---
<Base
  title="Cable equivocado | Save My Gig"
  description="Esta página no existe. Pero tu gig todavía se puede salvar."
  path="/404"
  lang="es"
  noindex
>
  <main class="wrap" style="padding-top:4rem">
    <div class="status-line red" style="justify-content:center">Senal_Perdida</div>
    <h1 class="danger" style="margin-bottom:1rem">404 - CABLE EQUIVOCADO</h1>
    <p class="dim" style="margin-bottom:2rem">Esta página no está conectada. Pero si tu USB acaba de morir antes de un gig, estás a dos toques de la solución.</p>
    <a href="/es/emergency" class="btn btn-solid" style="max-width:24rem;margin:0 auto"><span aria-hidden="true">🚨</span> Abrir Emergency Mode</a>
    <p style="margin-top:1.5rem"><a href="/es" class="dim" style="text-decoration:none">← Inicio</a></p>
  </main>
</Base>
