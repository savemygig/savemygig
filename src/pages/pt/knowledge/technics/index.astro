---
import Base from '../../../../layouts/Base.astro';
import { modelsOfBrand, modelPath } from '../../../../data/facts.js';

// HUB TECHNICS, PORTUGUÊS DO BRASIL. A fonte de verdade da estrutura, do
// catálogo, das categorias, do contrato CollectionPage, do script e do CSS é
// src/pages/knowledge/technics/index.astro. Aqui muda só o texto que uma
// pessoa lê e os hrefs com /pt. Se a página em inglês mudar, mude esta no
// mesmo commit.
//
// A lista de modelos com página vem do grafo de equipamentos, igual à página
// em inglês: modelPath() devolve o caminho canônico em inglês e o prefixo /pt
// entra aqui, no ponto onde o link é montado. As entradas "Em breve" seguem
// literais locais porque não estão no grafo e não devem estar.
const turntables = [
  ...modelsOfBrand('technics', 'turntable').map((m) => ({ name: m.name, href: `/pt${modelPath(m)}` })),
  { name: 'SL-1200MK5', href: null },
  { name: 'SL-1200GR', href: null },
  { name: 'SL-1200G', href: null },
];

const categories = [
  {
    label: 'Toca-discos',
    items: turntables,
    note: 'O MK7 é o toca-discos que você consegue comprar. O MK2 é o que você tem muito mais chance de encontrar já parafusado na booth, e ele saiu de linha há bem mais de uma década.',
  },
];

// O ItemList carrega SÓ os modelos com página de referência no ar, igual ao
// arquivo em inglês. Nada de matriz de firmware acima das categorias: nenhum
// destes dois toca-discos tem firmware para ter versão.
const listed = turntables.filter((x) => x.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/pt/knowledge/technics#webpage',
  url: 'https://www.savemygig.com/pt/knowledge/technics',
  name: 'Referência dos toca-discos Technics SL-1200',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  inLanguage: 'pt-BR',
  about: [
    { '@type': 'Thing', name: 'Technics' },
    { '@type': 'Thing', name: 'Série SL-1200' },
    { '@type': 'Thing', name: 'Toca-discos de DJ com tração direta' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    '@id': 'https://www.savemygig.com/pt/knowledge/technics#list',
    name: 'Referências de modelos Technics',
    numberOfItems: listed.length,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: listed.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: x.name,
      url: `https://www.savemygig.com${x.href}`,
    })),
  },
};
---
<Base
  title="Technics SL-1200: guia dos toca-discos | Save My Gig"
  description="SL-1200MK7 e SL-1200MK2: zumbido e cabo de terra, pitch e torque, um canal mudo, e o ajuste do braço que impede a agulha de pular."
  path="/knowledge/technics"
  crumbName="Technics"
  lang="pt"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <nav class="crumb" aria-label="Trilha de navegação">
      <a href="/pt/knowledge">Base de conhecimento</a> <span aria-hidden="true">/</span> <span>Technics</span>
    </nav>

    <div class="status-line">TECHNICS</div>
    <h1 style="margin-bottom:0.8rem">Tech<span class="accent">nics</span></h1>
    <p class="dim kb-lead">
      Toca-discos de tração direta, onde tudo que falha é físico. O cabo de
      terra decide se você vai ter zumbido. Os fios do headshell e a cápsula
      decidem se você tem um canal ou dois. O piso embaixo da booth decide se a
      agulha continua no sulco. A Panasonic documentou mais do que a maioria
      imagina, e o modelo que você tem mais chance de receber veio com um manual
      sem nenhuma seção de troubleshooting, que é a maior razão para estas
      páginas existirem.
    </p>

    <!-- No firmware matrix promo here, and the reason is stronger than on the
         Allen & Heath hub. There, one mixer has firmware nobody documents.
         Here neither deck has firmware to have a version of, so the same green
         box would be a category error. The honest equivalent is the way back
         out to the other manufacturers. -->
    <p class="ah-out">
      <a href="/pt/equipment">Todo fabricante, todo modelo que já tem página &rarr;</a>
    </p>

    <!-- Collapsible categories: on a phone the category headers ARE the index.
         On desktop the inline script below opens everything before paint.
         Native details/summary, no framework. -->
    {categories.map(cat => (
      <details class="kb-cat">
        <summary>
          <h2 class="kb-h">{cat.label}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        {cat.note && <p class="dim" style="margin-bottom:0.9rem;font-size:0.85rem">{cat.note}</p>}
        <div class="kb-grid">
          {cat.items.map(m => (
            m.href ? (
              <a class="kb-card kb-live" href={m.href}>
                <span class="kb-name">{m.name}</span>
                <span class="kb-go">Abrir o guia &rarr;</span>
              </a>
            ) : (
              <div class="kb-card kb-soon">
                <span class="kb-name">{m.name}</span>
                <span class="kb-tag">Em breve</span>
              </div>
            )
          ))}
        </div>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every category before first interaction.
      // Phones keep them collapsed so the category list is the index.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.kb-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">Qual toca-discos está faltando nesta lista?</h2>
      <p class="dim" style="margin-bottom:1rem">A gente constrói o que os DJs pedem de verdade. Diga o que você usa e isso sobe na fila.</p>
      <a href="/pt/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Conte o que você usa</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      Vai trabalhar em outro equipamento hoje à noite? <a href="/pt/equipment">Todo fabricante e modelo que já tem página</a>.
    </p>
  </main>
</Base>

<style>
  /* The card, the grid, the accordion chevron and the focus ring all come from
     global.css, exactly as on the other two hubs, so the three manufacturer
     hubs cannot drift apart. This block is the Allen & Heath block unchanged. */
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  .kb-lead { max-width: 42rem; margin-bottom: 1.5rem; line-height: 1.6; }
  .ah-out { margin: 0 0 1.8rem; font-size: 0.9rem; }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0; flex: 1;
  }
  .kb-cat { margin-top: 1.6rem; }
  .kb-cat > summary {
    display: flex; align-items: center; gap: 0.8rem;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
</style>
