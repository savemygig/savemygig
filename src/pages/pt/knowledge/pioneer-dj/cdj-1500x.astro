const MESES = {
  January: 'janeiro', February: 'fevereiro', March: 'março', April: 'abril',
  May: 'maio', June: 'junho', July: 'julho', August: 'agosto',
  September: 'setembro', October: 'outubro', November: 'novembro', December: 'dezembro',
};
const ptDate = (s) => s.replace(/^(\d+)\s+([A-Za-z]+)\s+(\d+)$/, (_m, d, mo, y) => `${d} de ${MESES[mo] ?? mo} de ${y}`);
const UPDATED = ptDate(CDJ_1500X.checked);
const ANNOUNCED = ptDate(CDJ_1500X.announced);
const FS = CDJ_1500X.fileSystems.join(', ');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj/cdj-1500x#article',
  headline: 'CDJ-1500X: a referência operacional',
  description: 'O que todo DJ precisa saber antes de trabalhar num CDJ-1500X: os sistemas de arquivos que ele lê e os que ele recusa, a exigência de OneLibrary, quais portas USB aceitam um drive, e quanto custa depender do Wi-Fi do booth.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-07',
  dateModified: '2026-08-07',
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj/cdj-1500x#webpage' },
