---
import Base from '../../../../layouts/Base.astro';
import EmailCapture from '../../../../components/EmailCapture.astro';
import { CHECKED, FIRMWARE_ISSUES } from '../../../../data/facts.js';

// MATRIZ DE FIRMWARE, BRAZILIAN PORTUGUESE. Source of truth for the data, the
// version arithmetic, the accordion, the table and the CSS:
// src/pages/knowledge/pioneer-dj/firmware.astro. Only the human readable copy
// and the /pt hrefs differ. If the English page changes, change this one in
// the same commit.
//
// facts.js is language neutral for versions and URLs and ENGLISH for the
// prose fields (`area`, `symptom`, `note`, `noneNote`, `warning.text`). It is
// a shared data file, so it is not translated in place: the maps below
// translate those strings at render time and fall back to the English string
// if facts.js gains an entry this file has not seen yet. A new entry then
// shows up in English rather than disappearing.
const UPDATED = CHECKED;

const MONTHS = {
  January: 'janeiro', February: 'fevereiro', March: 'março', April: 'abril',
  May: 'maio', June: 'junho', July: 'julho', August: 'agosto',
  September: 'setembro', October: 'outubro', November: 'novembro', December: 'dezembro',
};
// CHECKED is an English date string in facts.js. Rendered, not rewritten.
const ptDate = (s) => {
  const m = /^(\d{1,2}) (\w+) (\d{4})$/.exec(String(s));
  return m && MONTHS[m[2]] ? `${m[1]} de ${MONTHS[m[2]]} de ${m[3]}` : String(s);
};

const AREA = {
  Link: 'Link',
  Display: 'Tela',
  Audio: 'Áudio',
  Browse: 'Browse',
  Playback: 'Reprodução',
  USB: 'USB',
  MIDI: 'MIDI',
  Routing: 'Roteamento',
  Recording: 'Gravação',
  Power: 'Energia',
};

const SYMPTOM = {
  'PRO DJ LINK connection with a DJM-2000NXS could fail.':
    'A conexão PRO DJ LINK com um DJM-2000NXS podia falhar.',
  'Rare dead screen on power-on.':
    'Tela morta ao ligar o aparelho, em casos raros.',
  'Occasional no-audio, display blackouts and system freezes on some units.':
    'Em algumas unidades, ausência de áudio ocasional, tela apagando e travamento do sistema.',
  'A "Waiting" popup could block the BROWSE screen entirely.':
    'Um aviso "Waiting" podia travar a tela BROWSE por completo.',
  'Emergency Loop triggering wrongly during a Hot Cue pause.':
    'Emergency Loop disparando na hora errada durante uma pausa em Hot Cue.',
  'A startup issue affecting SLIP HOT CUE behaviour.':
    'Um problema na inicialização afetando o comportamento do SLIP HOT CUE.',
  'Waveform colour selection went missing, then was restored.':
    'A seleção de cor do waveform sumiu e depois voltou.',
  'Audio dropouts during Control Mode playback.':
    'Quedas de áudio tocando em Control Mode.',
  'UASP-compatible USB drives not recognized.':
    'Drives USB compatíveis com UASP não eram reconhecidos.',
  'Potential audio cut-out when connected to CDJ-3000s over PRO DJ LINK.':
    'Possível corte de áudio ligado a CDJ-3000 por PRO DJ LINK.',
  'Incorrect MIDI output under certain operation.':
    'Saída MIDI incorreta em determinadas operações.',
  'Audio sometimes failing to input to a channel.':
    'O áudio às vezes não entrava em um canal.',
  'Rare freeze under heavy PRO DJ LINK network load.':
    'Travamento raro sob carga pesada na rede PRO DJ LINK.',
  'Insert method intermittently disabling itself when switching the Multi I/O input selector, and DVS phono input malfunction on USB-B after swapping computers across ports.':
    'O insert se desligando sozinho de vez em quando ao trocar o seletor de entrada Multi I/O, e defeito na entrada phono do DVS na USB-B depois de trocar os computadores de porta.',
  'DJM-REC recording halts affecting iOS and iPadOS audio.':
    'Paradas de gravação do DJM-REC afetando o áudio no iOS e no iPadOS.',
  'DJM-REC recording could halt part-way through a set.':
    'A gravação do DJM-REC podia parar no meio do set.',


  /*
   * THE 19 ROWS THAT READ IN ENGLISH UNTIL 2026-08-08. The CDJ-2000NXS, the
   * CDJ-900NXS and the XDJ-700 joined FIRMWARE_ISSUES without their fault text
   * joining this map, so `map[s] ?? s` did what it promises and a Brazilian
   * reader got 19 English sentences inside a Portuguese table, on the page this
   * site offers as its citable asset. scripts/check-firmware-i18n.mjs now fails
   * the gate on a missing key, so the next model cannot repeat it.
   * Control labels stay in English on purpose: HOT CUE, TAG LIST, QUANTIZE,
   * MASTER TEMPO, SEARCH and BEAT DIVIDE are printed on the deck, and a DJ
   * looking at the button needs the page to say what the button says.
   */
  'The player crashed on repeated HOT CUE presses with Master Tempo enabled.':
    'O player travava ao apertar HOT CUE várias vezes com o Master Tempo ligado.',
  'Audio dropout on the slave deck when using SYNC.':
    'Queda de áudio no deck slave usando SYNC.',
  'A freeze could occur while editing the TAG LIST.':
    'Podia travar ao editar a TAG LIST.',
  'The browse screen slowed or stopped after several hours of use, and a freeze occurred holding HOT CUE over a second during auto hot cue loading.':
    'A tela de browse ficava lenta ou parava depois de várias horas de uso, e travava ao segurar HOT CUE por mais de um segundo durante o carregamento automático de hot cue.',
  'A WAVE file with an incompatible header left "Loading.." on screen indefinitely. Folders did not list on a 2TB HDD.':
    'Um arquivo WAVE com header incompatível deixava "Loading.." na tela para sempre. As pastas não apareciam em um HD de 2TB.',
  'Some hard drives were not recognized. Noise when Master Tempo was activated.':
    'Alguns HDs não eram reconhecidos. Ruído ao ativar o Master Tempo.',
  'AIFF at 24bit/48kHz stopped playing and could not be loaded to a deck. Audio noise while scratching.':
    'AIFF em 24bit/48kHz parava de tocar e não carregava em um deck. Ruído no áudio ao fazer scratch.',
  'Linked to a CDJ-2000NXS, some CDJ-2000NXS2 features were disabled.':
    'Ligado a um CDJ-2000NXS, alguns recursos do CDJ-2000NXS2 ficavam desativados.',
  'Digitally distorted white noise on certain WAV files. An active loop could activate a very short loop.':
    'Ruído branco com distorção digital em certos arquivos WAV. Um loop ativo podia acionar um loop muito curto.',
  'Issues during playback and track selection, and with SLIP HOT CUE.':
    'Problemas durante a reprodução e a seleção de tracks, e com o SLIP HOT CUE.',
  'Speed did not return to the displayed BPM with Sync on. Popping noise in a loop with QUANTIZE and MASTER TEMPO enabled.':
    'A velocidade não voltava para o BPM mostrado na tela com o Sync ligado. Estalo dentro de um loop com QUANTIZE e MASTER TEMPO ligados.',
  'Playback sound stopped while BEAT DIVIDE was activated.':
    'O som parava com o BEAT DIVIDE acionado.',
  'Folder browsing failed on 2TB hard drives. Slow track list browsing in Serato DJ HID mode.':
    'A navegação por pastas falhava em HDs de 2TB. Lista de tracks lenta no modo Serato DJ HID.',
  'AIFF at 24bit/48kHz stopped playing and could not be loaded. Digitally distorted white noise on certain WAV files.':
    'AIFF em 24bit/48kHz parava de tocar e não carregava. Ruído branco com distorção digital em certos arquivos WAV.',
  'PRO DJ LINK compatibility with the CDJ-2000NXS2 and XDJ-1000MK2.':
    'Compatibilidade PRO DJ LINK com o CDJ-2000NXS2 e o XDJ-1000MK2.',
  'Speed did not return to the displayed BPM with Sync enabled.':
    'A velocidade não voltava para o BPM mostrado na tela com o Sync ligado.',
  'Categories and tracks were not shown in the browser when a database had many tracks. Search results did not appear when moving the cursor.':
    'As categorias e as tracks não apareciam no browser quando o banco de dados tinha muitas tracks. Os resultados da busca não apareciam ao mover o cursor.',
  'SEARCH worked incorrectly under certain conditions.':
    'O SEARCH funcionava de forma incorreta em determinadas condições.',
  'The USB audio function did not work in DJ Software Control mode.':
    'A função de áudio USB não funcionava no modo DJ Software Control.',

  /*
   * SIX MODELS AND THREE ROWS JOINED THE MATRIX ON 2026-08-08, taking it from
   * 9 models and 38 rows to 15 and 63. The strings below are their fault text.
   * Adding them here in the SAME commit is the point: the reason the previous
   * batch shipped in English is that the data landed and the maps did not, and
   * the gate check now refuses the build rather than trusting anyone to remember.
   */
  'BPM could fluctuate during playback using Sync, and so could the tempo of a track with Slip Mode engaged.':
    'O BPM podia oscilar durante a reprodução com o Sync, e o tempo de uma track com o Slip Mode ativado também.',
  'The loop beat display returned to WAVE after a loop ended, and SYNC MASTER switched itself when SYNC was disabled.':
    'O display de beats do loop voltava para WAVE quando o loop terminava, e o SYNC MASTER mudava sozinho ao desligar o SYNC.',
  'Needle Search pad faults, a sorted playlist not being restored on return, and the Master Player switching when an Active Loop started.':
    'Falhas no pad do Needle Search, uma playlist ordenada que não voltava ao estado anterior, e o Master Player mudando ao iniciar um Active Loop.',
  'Some Apple Lossless files would not play.':
    'Alguns arquivos Apple Lossless não tocavam.',
  'macOS Catalina 10.15 could not see the unit as an audio device.':
    'O macOS Catalina 10.15 não reconhecia o aparelho como dispositivo de áudio.',
  'Inconsistencies in the matching function.':
    'Inconsistências na função de matching.',
  'Popping noise during a LOOP with QUANTIZE and MASTER TEMPO on.':
    'Estalo durante um LOOP com QUANTIZE e MASTER TEMPO ligados.',
  'A HOT CUE fired after jumping to LOOP-IN when changing the loop beat length with QUANTIZE on.':
    'Um HOT CUE disparava depois de pular para o LOOP-IN ao mudar o tamanho do loop em beats com o QUANTIZE ligado.',
  'Emergency loop triggering on certain MP3 files carrying APE tag data.':
    'Emergency loop disparando em certos arquivos MP3 que carregam dados de tag APE.',
  'Track load time grew after several hours of use.':
    'O tempo de carregamento das tracks aumentava depois de várias horas de uso.',
  'Faults using SLIP HOT CUE.':
    'Falhas ao usar o SLIP HOT CUE.',
  'Some tracks would not play on a linked CDJ-TOUR1.':
    'Algumas tracks não tocavam em um CDJ-TOUR1 ligado por link.',
  'Standby could not always be cancelled with the LFO FORM (WAKE UP) control.':
    'Nem sempre era possível sair do standby pelo controle LFO FORM (WAKE UP).',
  'Noise in USB audio in and out on some computers.':
    'Ruído na entrada e na saída de áudio USB em alguns computadores.',
  'Some effects did not work as expected when switched on.':
    'Alguns efeitos não funcionavam como esperado ao serem acionados.',
  'The mixer shut itself down unexpectedly.':
    'O mixer se desligava sozinho de forma inesperada.',
  'BPM display fluctuating when SLIP was used on a linked CDJ-2000NXS or CDJ-900.':
    'O display de BPM oscilando ao usar o SLIP em um CDJ-2000NXS ou CDJ-900 ligado por link.',
  'ROLL, REV ROLL and SLIP ROLL volume was not always stable.':
    'O volume de ROLL, REV ROLL e SLIP ROLL não era sempre estável.',
  'No effect sound when REV ROLL followed ROLL immediately.':
    'Nenhum som de efeito quando o REV ROLL vinha logo depois do ROLL.',
  'Slight noise while operating the X-PAD.':
    'Um ruído leve ao operar o X-PAD.',
  'Audio communication with iOS and iPadOS devices.':
    'Comunicação de áudio com aparelhos iOS e iPadOS.',
  'DJM-REC recording or live streaming sometimes stopped.':
    'A gravação do DJM-REC ou a transmissão ao vivo às vezes parava.',
  'Popping noise through USB audio when switching FX ASSIGN with BEAT FX on.':
    'Estalo no áudio USB ao trocar o FX ASSIGN com o BEAT FX ligado.',

  /*
   * THE ALL-IN-ONE ROWS, added 2026-08-08 with the XDJ-AZ and XDJ-XZ. Their fault
   * text is translated in the SAME commit as the data, which is the rule the
   * firmware i18n gate check exists to enforce: the last time data landed without
   * its translations, 19 rows read in English on this page for weeks.
   */
  'No audio output, display blackouts and system freezes on some units.':
    'Em algumas unidades, ausência de áudio, tela apagando e travamento do sistema.',
  'Recording could not be stopped with the Rec button.':
    'Não era possível parar a gravação pelo botão Rec.',
  'A "Library is not responding." error kept appearing.':
    'Um erro "Library is not responding." aparecia sem parar.',
  'PRO DJ LINK did not work properly, with jog wheel and beat sync faults.':
    'O PRO DJ LINK não funcionava direito, com falhas no jog e no beat sync.',
  'Sync was lost after scratching in Slip mode, and some WAV files would not play.':
    'O sync se perdia depois de fazer scratch no modo Slip, e alguns arquivos WAV não tocavam.',
  'Faults when using Beat FX.':
    'Falhas ao usar o Beat FX.',
  'Faults when Master Tempo was turned on.':
    'Falhas com o Master Tempo ligado.',
  'No sound from the SEND output terminal.':
    'Nenhum som saindo do terminal de saída SEND.',
};

const LONG = {
  'A young unit. AlphaTheta has published no defect fix for it, so there is nothing to report here. This section stays empty until a documented one exists.':
    'Unidade nova. A AlphaTheta não publicou nenhuma correção de defeito para ela, então não há nada a relatar aqui. Esta seção fica vazia até existir uma correção documentada.',
  'AlphaTheta has published no hardware defect fix for this mixer beyond the DJM-REC recording halts. The rest of its change history is feature work.':
    'A AlphaTheta não publicou nenhuma correção de defeito de hardware para este mixer além das paradas de gravação do DJM-REC. O resto do histórico de mudanças é recurso novo.',
  'Withdrawn by AlphaTheta. It added OneLibrary, then playlists failed to display for people exporting from older rekordbox. No music or data was deleted, and the player reverted to Device Library. Do not install this version.':
    'Retirada pela AlphaTheta. Ela trouxe o OneLibrary, e aí as playlists deixaram de aparecer para quem exportava de um rekordbox mais antigo. Nenhuma música e nenhum dado foram apagados, e o player voltou para o Device Library. Não instale esta versão.',

  'Not a defect. From this version the unit automatically switches off after 20 minutes of no use when Power Management is on, following the EU Ecodesign Directive. A deck that powered down during a long changeover is obeying that setting, not failing.':
    'Não é defeito. A partir desta versão o aparelho se desliga sozinho depois de 20 minutos sem uso quando o Power Management está ligado, seguindo a Diretiva Ecodesign da União Europeia. Um deck que desligou durante uma troca longa está obedecendo a essa configuração, não falhando.',
  'AlphaTheta has published no firmware change history for this unit, so there is no documented fix to report. This section stays empty until one exists.':
    'A AlphaTheta não publicou nenhum histórico de mudanças de firmware para este aparelho, então não há correção documentada a relatar. Esta seção fica vazia até existir uma.',
  'AlphaTheta published no detail for version 1.05 beyond "Minor issues", and versions 1.00 to 1.02 are not listed at all. What is above is every documented fix for this mixer, not necessarily every fix.':
    'A AlphaTheta não publicou nenhum detalhe da versão 1.05 além de "Minor issues", e as versões 1.00 a 1.02 não aparecem na lista. O que está acima é toda correção documentada deste mixer, e não necessariamente toda correção.',
};

const tr = (map, s) => (s == null ? s : map[s] ?? s);

// Version compare that handles 1.9 vs 1.10 correctly (string sort does not).
function cmpVersion(a, b) {
  const pa = String(a).split('.').map(Number);
  const pb = String(b).split('.').map(Number);
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    const d = (pa[i] || 0) - (pb[i] || 0);
    if (d !== 0) return d;
  }
  return 0;
}

// The single most useful number per model: the version at or above which every
// documented issue below is already resolved. Computed, not hand-maintained.
// A withdrawn version sitting ABOVE the computed floor is named separately so
// an open-ended "or later" never swallows it.
const models = FIRMWARE_ISSUES.map(m => {
  const issues = [...m.issues].sort((a, b) => cmpVersion(b.fixedIn, a.fixedIn));
  const safeFloor = issues.length ? issues[0].fixedIn : null;
  // ONLY A WITHDRAWN VERSION IS AN EXCEPTION TO THE FLOOR (2026-08-08). This
  // used to test any warning, which was right while the only warning was the
  // CDJ-3000's pulled 3.30, and became a live falsehood the moment the
  // XDJ-1000MK2's Ecodesign warning landed at 1.45 above its 1.42 floor: the
  // header told every reader the player's current firmware was withdrawn. A
  // behaviour change is not something to avoid, so it does not move the floor.
  const floorException =
    m.warning?.kind === 'withdrawn' && safeFloor
      && cmpVersion(m.warning.version, safeFloor) > 0
      ? m.warning.version
      : null;
  return { ...m, issues, safeFloor, floorException };
});

const totalIssues = models.reduce((n, m) => n + m.issues.length, 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj/firmware#article',
  headline: 'Problemas de firmware de CDJ e DJM, por versão',
  description: 'Quais falhas documentadas estão vivas num player ou mixer Pioneer DJ e AlphaTheta em cada versão de firmware, reunidas dos históricos de mudanças da própria AlphaTheta.',
  author: { '@id': 'https://www.savemygig.com/#org' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  datePublished: '2026-08-01',
  dateModified: '2026-08-01',
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj/firmware#webpage' },
};
---
<Base
  title="Firmware do CDJ e do DJM: falhas por versão | Save My Gig"
  description="Leia a versão de firmware no CDJ ou no DJM e veja quais falhas documentadas ainda estão vivas. Direto dos históricos da AlphaTheta, modelo a modelo."
  path="/knowledge/pioneer-dj/firmware"
  crumbName="Problemas de firmware por versão"
  lang="pt"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <main class="wrap wrap-wide">
    <nav class="crumb" aria-label="Trilha de navegação">
      <a href="/pt/knowledge">Base de conhecimento</a> <span aria-hidden="true">/</span>
      <a href="/pt/knowledge/pioneer-dj">Pioneer DJ / AlphaTheta</a> <span aria-hidden="true">/</span>
      <span>Problemas de firmware</span>
    </nav>

    <div class="status-line sl-desktop">MATRIZ DE FIRMWARE</div>
    <h1 class="rb-h1">O que está quebrado naquele player, <span class="accent">por versão de firmware</span></h1>
    <p class="dim rb-updated">Conferido: {ptDate(UPDATED)}</p>

    <div class="panel panel-go">
      <input type="checkbox" id="sv-toggle" class="sv-toggle sr-only" />
      <p class="sv-text" style="margin:0">
        <strong>Briefing de booth.</strong> Leia a versão de firmware no
        aparelho, ache ela aqui embaixo, e você sabe o que pode te morder hoje.
        Cada entrada vem dos históricos de mudanças publicados pela própria
        AlphaTheta: {totalIssues} falhas documentadas em {models.length} modelos.
        No equipamento que é seu, fique na versão segura indicada para ele ou
        acima dela. No equipamento que não é seu, isto diz o que você precisa
        contornar.
      </p>
      <label for="sv-toggle" class="sv-more">Ler mais…</label>
      <label for="sv-toggle" class="sv-more sv-more-open">Ler menos</label>
    </div>

    <div class="fw-how">
      <h2 class="fw-how-h">Onde achar a versão no aparelho</h2>
      <p>
        Num CDJ ou num DJM, a versão do firmware fica no menu UTILITY, e nos
        players ela também aparece na tela de inicialização enquanto o aparelho
        liga. Confira no soundcheck, não na hora de abrir a casa. Se o player da
        casa estiver abaixo da versão segura, você não resolve isso na booth,
        mas dá para não ser pego de surpresa.
      </p>
    </div>

    {models.map(m => (
      <details class="acc-sec fw-model" name="fw-acc">
        <summary>
          {/* Model names and firmware version strings are read off the
              unit itself, so they must never be auto-translated. */}
          <h2 class="acc-h2 fw-model-h" translate="no">{m.model}</h2>
          {m.safeFloor && (
            <span class="fw-floor">
              Limpo na <strong translate="no">{m.safeFloor}</strong> ou acima
              {m.floorException && (
                <Fragment>, menos a <strong class="fw-floor-except" translate="no">{m.floorException}</strong> (retirada)</Fragment>
              )}
            </span>
          )}
          <span class="acc-chev" aria-hidden="true"></span>
        </summary>
        <div class="acc-body fw-body">

        {m.warning && (
          <div class="fw-warn">
            <span class="fw-warn-v" translate="no">{m.warning.version}</span>
            <span>
              {tr(LONG, m.warning.text)}{' '}
              <a href={m.warning.sourceUrl} target="_blank" rel="noopener">Aviso oficial</a>
            </span>
          </div>
        )}

        {m.issues.length === 0 ? (
          <p class="fw-none">{tr(LONG, m.noneNote)}</p>
        ) : (
          <table class="fw-table">
            {/* Every model on this page renders one of these, so without a
                caption a screen reader user meets a dozen identical unnamed
                three-column tables. */}
            <caption class="sr-only">Falhas documentadas no {m.model}, e a versão de firmware que corrigiu cada uma</caption>
            <thead>
              <tr>
                <th scope="col">Corrigido na</th>
                <th scope="col">Área</th>
                <th scope="col">O que acontecia abaixo dessa versão</th>
              </tr>
            </thead>
            <tbody>
              {m.issues.map(i => (
                <tr>
                  <td class="fw-v"><span class="fw-vbadge" translate="no">{i.fixedIn}</span></td>
                  <td class="fw-area">
                    {tr(AREA, i.area)}
                    {i.midSet && <span class="fw-live" title="Pode interromper um set em andamento">meio do set</span>}
                  </td>
                  <td>{tr(SYMPTOM, i.symptom)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        {m.note && <p class="fw-note">{tr(LONG, m.note)}</p>}

        <p class="fw-links">
          <a href={`/pt${m.href}`}>Manual de campo do {m.model}</a>
          {/* Six models render this row, so the accessible name names the
              model instead of repeating one anonymous link six times. */}
          <a href={m.source} target="_blank" rel="noopener"
             aria-label={`Histórico de mudanças da AlphaTheta para o ${m.model}`}>Histórico de mudanças AlphaTheta</a>
        </p>
        </div>
      </details>
    ))}

    <div class="panel">
      <p style="margin:0 0 0.6rem"><strong>Como ler isto</strong></p>
      <p style="margin:0 0 0.6rem">
        A versão na coluna "Corrigido na" é a release que resolveu aquela falha.
        Qualquer coisa abaixo dela ainda tem a falha. Qualquer coisa nela ou
        acima dela, não.
      </p>
      <p style="margin:0">
        O marcador <span class="fw-live fw-live-inline">meio do set</span> é
        nosso, não da AlphaTheta. Ele sinaliza falhas cujo sintoma documentado
        pode interromper um set já em andamento, para você separar risco real de
        aborrecimento num relance. Todo o resto desta página é a redação do
        próprio fabricante, condensada.
      </p>
    </div>

    <p class="dim fw-foot">
      Só falhas. Recursos novos ficam de fora de propósito, porque recurso
      faltando não acaba com um set. Todo modelo AlphaTheta que existe neste
      site tem uma seção aqui, inclusive os que não têm nada a relatar: quando a
      AlphaTheta não publicou histórico de mudanças, a seção diz isso em vez de
      ficar de fora, porque uma seção que falta e uma ficha limpa parecem a
      mesma coisa de fora. Achou alguma coisa errada aqui?
      <a href="/pt/feedback">Conte pra gente</a> e a gente confere na fonte.
    </p>

    <EmailCapture source="knowledge_firmware" lang="pt" />
  </main>

  <style>
    /* This page puts the eyebrow directly under the breadcrumb rather than
       inside an .hw-head block, so it needs the gap the photo pages get for
       free from that wrapper. */
    .status-line { margin-top: 0.4rem; }
    /* size comes from the global h1 scale, 2026-08-03 */
    .rb-h1 { margin-bottom: 0.4rem; }
    .rb-h1 .accent { font-size: 96%; }
    .rb-updated { font-size: 0.82rem; margin-bottom: 1.6rem; }
    main p { color: var(--text-dim); line-height: 1.65; }
