---
import Base from '../../../../layouts/Base.astro';
import BrandWordmark from '../../../../components/BrandWordmark.astro';

// HUB PIONEER DJ / ALPHATHETA, BRAZILIAN PORTUGUESE. Source of truth for the
// catalogue, the categories, the CollectionPage contract, the script and the
// CSS: src/pages/knowledge/pioneer-dj/index.astro. Only the human readable
// copy and the /pt hrefs differ. If the English page changes, change this one
// in the same commit.
const players = [
  // ORDER: MODEL FAMILY FIRST, THEN DESCENDING MODEL NUMBER (Antonio, 2026-08-07).
  // So every CDJ, high number to low, and then every XDJ, high number to low.
  //
  // THIS REPLACED A WORSE RULE EARLIER THE SAME DAY. That one was "current
  // generation first, then the legacy line", which put the CDJ-1500X third,
  // beside the two 3000s. It read correctly today and it carried a judgement that
  // rots: somebody has to keep deciding which models are still current, and the
  // 1500X becomes legacy the moment its successor ships, at which point the list
  // needs re-sorting by whoever can work out why it was sorted that way.
  //
  // A number never needs that decision, and it matches how a DJ reads the page:
  // they are looking for the deck in front of them, by its number. Insert new
  // models by number, inside their family, and do not think about generations.
  { name: 'CDJ-3000X', href: '/pt/knowledge/pioneer-dj/cdj-3000x' },
  { name: 'CDJ-3000', href: '/pt/knowledge/pioneer-dj/cdj-3000' },
  { name: 'CDJ-2000NXS2', href: '/pt/knowledge/pioneer-dj/cdj-2000nxs2' },
  { name: 'CDJ-2000NXS', href: '/pt/knowledge/pioneer-dj/cdj-2000nxs' },
  { name: 'CDJ-1500X', href: '/pt/knowledge/pioneer-dj/cdj-1500x' },
  { name: 'CDJ-900NXS', href: '/pt/knowledge/pioneer-dj/cdj-900nxs' },
  { name: 'XDJ-1000MK2', href: '/pt/knowledge/pioneer-dj/xdj-1000mk2' },
  { name: 'XDJ-700', href: '/pt/knowledge/pioneer-dj/xdj-700' },
];
const mixers = [
  { name: 'DJM-V10 / V10-LF', href: '/pt/knowledge/pioneer-dj/djm-v10' },
  { name: 'DJM-V5', href: '/pt/knowledge/pioneer-dj/djm-v5' },
  { name: 'DJM-A9', href: '/pt/knowledge/pioneer-dj/djm-a9' },
  { name: 'DJM-900NXS2', href: '/pt/knowledge/pioneer-dj/djm-900nxs2' },
  { name: 'DJM-900NXS', href: '/pt/knowledge/pioneer-dj/djm-900nxs' },
  { name: 'DJM-750MK2', href: '/pt/knowledge/pioneer-dj/djm-750mk2' },
  { name: 'euphonia', href: '/pt/knowledge/pioneer-dj/euphonia' },
];
const allInOne = [
  { name: 'OPUS-QUAD', href: null },
  { name: 'XDJ-AZ', href: '/pt/knowledge/pioneer-dj/xdj-az' },
  { name: 'XDJ-XZ', href: '/pt/knowledge/pioneer-dj/xdj-xz' },
  { name: 'XDJ-RX3', href: null },
];
const turntables = [
  { name: 'PLX-1000', href: null },
];
const effectors = [
  { name: 'RMX-1000', href: null },
  { name: 'RMX-IGNITE', href: null },
];
const controllers = [
  { name: 'DDJ-FLX10', href: null },
  { name: 'DDJ-1000', href: null },
  { name: 'DDJ-REV7', href: null },
  { name: 'DDJ-FLX4', href: null },
];

const categories = [
  { label: 'Players', items: players },
  { label: 'Mixers', items: mixers },
  { label: 'Sistemas all-in-one', items: allInOne },
  { label: 'Toca-discos', items: turntables, note: 'O toca-discos profissional que as casas realmente instalam. A cobertura de vinil cresce aqui conforme for merecendo.' },
  { label: 'Efeitos', items: effectors },
  { label: 'Controladoras', items: controllers, note: 'Raras em clube, mas o padrão para preparar em casa e para gig móvel.' },
];

// The ItemList carries ONLY the models with a live reference page, exactly
// like the English file. Everything else is visibly labelled "Em breve" and a
// machine-readable list has no way to carry that label.
const listed = [
  ...players, ...mixers, ...allInOne, ...turntables, ...effectors, ...controllers,
].filter((x) => x.href);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj#webpage',
  url: 'https://www.savemygig.com/pt/knowledge/pioneer-dj',
  name: 'Referência de equipamentos Pioneer DJ / AlphaTheta',
  isPartOf: { '@id': 'https://www.savemygig.com/#website' },
  publisher: { '@id': 'https://www.savemygig.com/#org' },
  inLanguage: 'pt-BR',
  // Both names on purpose: the company is AlphaTheta and the brand on the gear
  // is Pioneer DJ. DJs search for both.
  about: [
    { '@type': 'Thing', name: 'Pioneer DJ' },
    { '@type': 'Thing', name: 'AlphaTheta' },
    { '@type': 'Thing', name: 'Equipamentos CDJ e DJM' },
  ],
  mainEntity: {
    '@type': 'ItemList',
    '@id': 'https://www.savemygig.com/pt/knowledge/pioneer-dj#list',
    name: 'Referências de modelos Pioneer DJ e AlphaTheta',
    numberOfItems: listed.length + 1,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    itemListElement: [
      ...listed.map((x, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: x.name,
        url: `https://www.savemygig.com${x.href}`,
      })),
      {
        '@type': 'ListItem',
        position: listed.length + 1,
        name: 'O que está quebrado naquele player, por versão de firmware',
        url: 'https://www.savemygig.com/pt/knowledge/pioneer-dj/firmware',
      },
    ],
  },
};
---
<Base
  title="CDJ, XDJ e DJM: guia Pioneer DJ / AlphaTheta | Save My Gig"
  description="CDJs, XDJs e mixers DJM: o manual de campo do equipamento que você encontra de verdade na booth, não um manual de produto reescrito."
  path="/knowledge/pioneer-dj"
  lang="pt"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <main class="wrap">
    <nav class="crumb" aria-label="Trilha de navegação">
      <a href="/pt/knowledge">Base de conhecimento</a> <span aria-hidden="true">/</span> <span>Pioneer DJ / AlphaTheta</span>
    </nav>

    <div class="status-line">PIONEER_DJ</div>
    <BrandWordmark brand="pioneer-dj" />
    <p class="dim kb-lead">
      Não é um manual de produto reescrito. Esta é a referência operacional: o
      que dá errado, como resolver rápido, como DJ experiente roda esse
      equipamento de verdade, e como impedir que a mesma falha aconteça na sua
      próxima gig.
    </p>

    <!-- Cross-model entry point: "what is broken on this deck" is a question
         that comes before "which model am I looking at". -->
    <a class="pdj-matrix" href="/pt/knowledge/pioneer-dj/firmware">
      <span class="pdj-matrix-k">Em todos os modelos</span>
      <span class="pdj-matrix-t">O que está quebrado naquele player, por versão de firmware &rarr;</span>
      <span class="pdj-matrix-b">Leia a versão no próprio aparelho e veja quais falhas documentadas continuam vivas nele.</span>
    </a>

    <!-- Collapsible categories: on a phone the six category headers ARE the
         index. On desktop the inline script below opens everything before
         paint. Native details/summary, no framework. -->
    {categories.map(cat => (
      <details class="kb-cat">
        <summary>
          <h2 class="kb-h">{cat.label}</h2>
          <span class="kb-chev" aria-hidden="true"></span>
        </summary>
        {cat.note && <p class="dim" style="margin-bottom:0.9rem;font-size:0.85rem">{cat.note}</p>}
        <div class="kb-grid">
          {cat.items.map(m => (
            m.href ? (
              <a class="kb-card kb-live" href={m.href}>
                <span class="kb-name">{m.name}</span>
                <span class="kb-go">Abrir o guia &rarr;</span>
              </a>
            ) : (
              <div class="kb-card kb-soon">
                <span class="kb-name">{m.name}</span>
                <span class="kb-tag">Em breve</span>
              </div>
            )
          ))}
        </div>
      </details>
    ))}
    <script is:inline>
      // Desktop has room: open every category before first interaction.
      // Phones keep them collapsed so the category list is the index.
      (function () {
        if (window.matchMedia('(min-width: 641px)').matches) {
          var cats = document.querySelectorAll('.kb-cat');
          for (var i = 0; i < cats.length; i++) cats[i].open = true;
        }
      })();
    </script>

    <div class="panel" style="margin-top:2rem">
      <h2 style="font-size:1.05rem;margin-bottom:0.5rem;text-transform:none;letter-spacing:-0.01em">Qual ferramenta está faltando nesta lista?</h2>
      <p class="dim" style="margin-bottom:1rem">A gente constrói o que os DJs pedem de verdade. Diga o que você usa e isso sobe na fila.</p>
      <a href="/pt/feedback" class="btn btn-neutral" style="width:auto;padding:0.6rem 1.4rem">Conte o que você usa</a>
    </div>

    <p class="dim" style="margin-top:2rem;font-size:0.85rem">
      Procurando dúvidas de biblioteca e de export? <a href="/pt/knowledge/pioneer-dj/rekordbox">A referência do rekordbox</a> cobre isso.
    </p>
  </main>
</Base>

<style>
  .crumb { font-size: 0.78rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumb a { color: var(--text-dim); text-decoration: none; }
  .crumb a:hover { color: var(--red); }
  .kb-lead { max-width: 42rem; margin-bottom: 1.5rem; line-height: 1.6; }
  /* Firmware matrix promo. Green (the site's "you are fine / go" tone) rather
     than red: this is a prevention tool, not an alarm. */
  .pdj-matrix {
    display: block; text-decoration: none;
    background: var(--green-dim); border: var(--stroke) solid var(--green-border);
    border-radius: var(--radius); padding: 1.1rem 1.25rem; margin-bottom: 1.8rem;
  }
  .pdj-matrix-k {
    display: block; font-family: var(--font-display); font-size: 0.68rem;
    font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-faint); margin-bottom: 0.35rem;
  }
  .pdj-matrix-t {
    display: block; color: var(--text); font-weight: 700;
    font-size: 1.02rem; line-height: 1.3; margin-bottom: 0.3rem;
  }
  .pdj-matrix-b { display: block; color: var(--text-dim); font-size: 0.88rem; line-height: 1.55; }
  .pdj-matrix:hover .pdj-matrix-t { color: var(--red); }
  .kb-h {
    font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em;
    margin: 0; flex: 1;
  }
  /* The card, the grid, the accordion chevron and the focus ring all come from
     global.css. Only the group-heading rule is local, because only this page
     draws one. */
  .kb-cat { margin-top: 1.6rem; }
  .kb-cat > summary {
    display: flex; align-items: center; gap: 0.8rem;
    border-bottom: var(--stroke) solid var(--edge); padding-bottom: 0.5rem; margin-bottom: 1rem;
    cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
</style>
