---
import Tunnel from '../../../layouts/Tunnel.astro';
import { TREE } from '../../../data/emergency-tree.pt.js';
import {
  RUNLIST, RUNLIST_HEAD, RUNLIST_ASSUMED, RUNLIST_NEVER, RUNLIST_LAST_RESORT,
} from '../../../data/runlist.pt.js';

// THE TUNNEL RENDERER, BRAZILIAN PORTUGUESE. Mirror of
// src/pages/protocol/[...slug].astro. Everything about the LOOK, the tone
// fallback, the risk list and the analytics payload is deliberately
// identical: the only differences are the tree it renders
// (emergency-tree.pt.js), the language it declares, the /pt prefix on every
// internal href, and the handful of strings this file owns rather than the
// tree. If you change the English renderer, change this one in the same
// commit or the two flows drift.
//
// The four moves on usb/moves come from src/data/runlist.pt.js, the Portuguese
// counterpart of src/data/runlist.js, and src/pages/pt/card.astro prints from
// that same file. One source of truth per language: if the screen and the
// printable card ever say different words the DJ never memorises them, which
// is the whole reason the list is data and not prose.

export function getStaticPaths() {
  // Screens that instruct or consent to formatting, erasing or deleting.
  // Ids are language independent, so this list is a straight copy of the
  // English renderer's and must stay in sync with it.
  const RISK_NODES = new Set([
    'rebuild/risk',
    'rebuild/erase',
    'rebuild/format',
    'rebuild/second-format',
    'export/erase',
    'export/format',
    'export/repair',
    'export/fresh',
  ]);
  return Object.keys(TREE).map((id) => ({
    params: { slug: id },
    props: { node: TREE[id], risk: RISK_NODES.has(id) },
  }));
}

const { node, risk } = Astro.props;

const toneOf = (o, i) => {
  if (o.tone) return o.tone;
  if (node.neutral || node.options.length > 2) return 'neutral';
  return i === 0 ? 'green' : 'red';
};
const padClass = (t) =>
  t === 'green' ? 'pad-green' : t === 'red' ? 'pad-red' : t === 'amber' ? 'pad-yellow' : 'pad-neutral';
const ledClass = (t) =>
  t === 'green' ? 'led-g' : t === 'red' ? 'led-r' : t === 'amber' ? 'led-y' : 'led-n';
// Every internal destination gets the /pt prefix. Node ids stay untranslated
// (they are URLs, not copy), so /protocol/usb/start becomes /pt/protocol/usb/start
// and an absolute target like /saved?path=critical becomes /pt/saved?path=critical.
const hrefOf = (to) => (to.startsWith('/') ? `/pt${to}` : `/pt/protocol/${to}`);
const answerKey = (i) => ['a', 'b', 'c', 'd'][i];
// Analytics payload is IDENTICAL to the English flow on purpose: the same
// step and answer keys, so one funnel covers both languages and pt does not
// need its own report to be readable.
const dataAttrs = (o, i) => {
  const out = {
    'data-event': o.event ?? 'step_completed',
    'data-step': (o.data && o.data.step) ?? node.step ?? 'step',
    'data-answer': answerKey(i),
  };
  for (const [k, v] of Object.entries(o.data ?? {})) if (k !== 'step') out[`data-${k}`] = v;
  return out;
};
---
<Tunnel
  title={`${node.title} | Save My Gig`}
  status={node.status}
  red={node.red}
  heading={node.srHeading}
  risk={risk}
  lang="pt"
>
  {node.draft && import.meta.env.DEV && <div class="review-flag">RASCUNHO, revisão pendente.</div>}
  {node.label && <div class="step-label">{node.label}</div>}
  <h2 class={node.headingClass} style="margin-bottom:1rem" set:html={node.heading} />

  {node.moves ? (
    <Fragment>
      <p class="dim" style="margin-bottom:0.9rem">{RUNLIST_HEAD}</p>
      <p class="assumed">{RUNLIST_ASSUMED}</p>
      <ol class="moves">
        {RUNLIST.map((s) => (
          <li>
            <span class="move-verb">{s.verb}</span>
            <span class="move-action">{s.action}</span>
            <details class="move-more">
              <summary>Por que, e como</summary>
              <p>{s.detail}</p>
            </details>
          </li>
        ))}
      </ol>
      <div class="alert-card" style="margin:1.6rem 0 1.2rem">
        <div>{RUNLIST_NEVER}</div>
      </div>
      <details class="move-more last-resort">
        <summary>{RUNLIST_LAST_RESORT.title}</summary>
        <p>{RUNLIST_LAST_RESORT.body}</p>
      </details>
    </Fragment>
  ) : (
    node.blocks.map((b) =>
      b.t === 'check' ? (
        <ul class="checklist">{b.items.map((it) => <li set:html={it} />)}</ul>
      ) : b.t === 'alert' ? (
        /* The emoji in the tree data is deliberately NOT rendered, same as
           the English renderer. The card's red rule and tint carry the
           weight; the design system says monochrome stroke icons always. */
        <div class="alert-card" style="margin-bottom:1.25rem">
          <div set:html={b.html} />
        </div>
      ) : b.t === 'details' ? (
        <details class="move-more" style="margin-bottom:1.25rem">
          <summary set:html={b.summary} />
          <div set:html={b.html} />
        </details>
      ) : b.t === 'assumed' ? (
        <p class="assumed" set:html={b.html} />
      ) : b.t === 'note' ? (
        <p class="tunnel-note" style="margin-bottom:1.5rem" set:html={b.html} />
      ) : (
        <p class="dim" style="margin-bottom:1.25rem" set:html={b.html} />
      )
    )
  )}

  {node.question && <p class="question">{node.question}</p>}

  <nav class="pad-grid" aria-label={node.question ?? 'O que vem agora'}>
    {node.options.map((o, i) => {
      const tone = toneOf(o, i);
      return (
        <a href={hrefOf(o.to)} class:list={['pad', padClass(tone)]} {...dataAttrs(o, i)}>
          <div class="pad-header">
            <div class:list={['led', ledClass(tone)]}></div>
            <div class="pad-title">{o.label}</div>
          </div>
          {o.desc && <div class="pad-desc">{o.desc}</div>}
        </a>
      );
    })}
  </nav>

  {node.moves && (
    <p class="tunnel-note" style="margin-top:1.6rem">
      Nada disso é preciso para o DJ que chegou com um segundo drive clonado no
      outro bolso. Essa versão de hoje dura dez segundos.
      <a href="/pt/prepare">As regras de prevenção</a>.
    </p>
  )}
</Tunnel>

<style>
  /* Identical to the English renderer's block, copied rather than shared
     because Astro scoped styles do not cross files. If you change one,
     change both: a scoped copy silently defeating the shared rule is the
     exact failure the propagation doctrine warns about. */
  .moves {
    list-style: none; counter-reset: mv; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .moves li {
    counter-increment: mv;
    position: relative;
    background: var(--surf);
    border: var(--stroke) solid var(--edge);
    border-radius: var(--radius);
    padding: var(--sp-5) var(--sp-5) var(--sp-4) 3.1rem;
  }
  .moves li::before {
    content: counter(mv);
    position: absolute;
    left: var(--sp-5);
    top: calc(var(--sp-5) + 0.2rem);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--text-faint);
  }
  .move-verb {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.35rem, 6vw, 1.65rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }
  .move-action {
    display: block;
    font-size: 0.97rem;
    line-height: 1.4;
    color: var(--text-dim);
  }
  .last-resort { margin: 0 0 1.6rem; }
  .last-resort > summary { text-transform: none; letter-spacing: 0; font-size: 0.88rem; }
</style>
