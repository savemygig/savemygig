---
import Base from '../../layouts/Base.astro';
import InstallNudge from '../../components/InstallNudge.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { RUNLIST } from '../../data/runlist.pt.js';
import { hrefFor } from '../../data/concepts.js';
import { localizedPath } from '../../i18n/registry';
import Icon from '../../components/Icon.astro';
const lp = (p) => localizedPath(p, 'pt');

// EMERGENCY CARD, BRAZILIAN PORTUGUESE. Source of truth for structure,
// panels, classes e CSS: src/pages/card.astro.
//
// O bloco da booth sai de src/data/runlist.pt.js, a MESMA fonte que a tela de
// emergência usa (src/pages/pt/protocol/[...slug].astro), para que a ordem, os
// verbos e as frases nunca divirjam entre as duas superfícies. O mapa local que
// ficava aqui saiu no dia em que o runlist.pt.js passou a existir: uma fonte de
// verdade por idioma.
//
// FOLDER e LINK são rótulos impressos no equipamento (modo de navegação
// FOLDER, PRO DJ LINK) e ficam em inglês. REINICIAR e PEDIR não são rótulos,
// são as palavras que o DJ tem que lembrar sozinho.
//
// OS TRÊS LINKS DOS AJUSTES SAGRADOS (2026-08-05). FAT32, MBR e rekordbox
// apareciam linkados nesta página, mas nenhum deles estava escrito aqui: eram
// do autolinker, que não reconhecia /pt/card como a mesma página excluída que
// /card, e por isso apontavam para o inglês. O autolinker foi corrigido no
// mesmo trabalho, então os três passaram a ser escritos à mão, com o prefixo
// /pt, nos três idiomas. Nada mais no card é linkado: ele é lido sob pressão.
---
<Base
  title="Emergency Card do DJ: tire um print disto | Save My Gig"
  description="A referência de emergência de uma página só, para quando o pen drive morre no meio da gig. Tire um print, imprima, deixe na bag. Grátis."
  path="/card"
  lang="pt"
>
  <main class="wrap">
    <div class="status-line">Emergency_Card</div>
    <h1 style="margin-bottom:0.5rem">O EMERGENCY <span class="accent">CARD</span></h1>
    <p class="dim" style="margin-bottom:1.5rem"><Icon name="phone" /> Tire um print desta página agora, ela funciona sem sinal, em qualquer booth, a qualquer hora.</p>

    <div class="panel panel-go">
      <h2 style="margin-bottom:0.4rem">PEN DRIVE MORREU NA BOOTH</h2>
      <p class="dim" style="font-size:0.85rem;margin-bottom:0.9rem">
        Partimos do princípio de que você já recolocou ele e já tentou o outro
        player. Estes são os quatro que um bom DJ ainda esquece sob pressão.
      </p>
      <ol class="card-moves">
        {RUNLIST.map((s) => (
          <li><strong>{s.verb}</strong> <span>{s.action}</span></li>
        ))}
      </ol>
    </div>

    <div class="panel panel-warn">
      <h2 style="margin-bottom:0.75rem">OS AJUSTES SAGRADOS</h2>
      <ul class="checklist">
        <li>Formato: <span class="mono" translate="no"><a href={lp(hrefFor('fat32'))}>FAT32</a></span> · Esquema: <span class="mono" translate="no"><a href={lp(hrefFor('mbr'))}>MBR</a></span> · Tamanho: 32 a 64 GB</li>
        <li>Mac: Utilitário de Disco → Mostrar Todos os Dispositivos → selecione o DRIVE → MS-DOS (FAT) + Master Boot Record</li>
        <li>Música nos drives de gig SÓ pelo modo EXPORT do <a href={lp(hrefFor('rekordbox'))}>rekordbox</a></li>
        <li>Ejete pelo rekordbox E pelo player (<span translate="no">USB STOP</span>). Toda vez.</li>
      </ul>
    </div>

    <div class="panel panel-danger">
      <h2 style="margin-bottom:0.75rem">NUNCA (sob pressão)</h2>
      <ul class="checklist">
        <li>Nunca formate um drive que ainda tem arquivos não resgatados.</li>
        <li>Nunca diga SIM quando um computador se oferecer para formatar o seu drive de gig.</li>
        <li>Nunca fique replugando um drive que está falhando, cada montagem pode dificultar a recuperação.</li>
        <li>Nunca saia de casa com um drive só. <strong>Dois drives idênticos, dois bolsos.</strong></li>
      </ul>
    </div>

    {/* Install recommendation, AFTER the card itself. A reader here is
        already solving this problem by hand, with a screenshot, so the offer
        lands. It goes below the three panels rather than above them because
        this page's own rule (see the header) is that the card is read under
        pressure and a card full of exits is a card nobody finishes. */}
    <InstallNudge lang="pt" path="/card" placement="card" />

    <div style="text-align:left;margin:2rem 0 1rem">
      <EmailCapture source="card" lang="pt" title="Quer isto em PDF para imprimir?"
        blurb="Esta página é grátis para sempre, tire um print dela agora mesmo. Se você preferir a versão para imprimir guardada no seu e-mail, a gente manda." />
    </div>
    <p class="dim" style="font-size:0.85rem">savemygig.com/pt/emergency, o resgate guiado completo, grátis · Imprima esta página: ela gasta pouca tinta.</p>
  </main>
</Base>

<style>
  /* Compact on screen, still legible in a screenshot on a phone at arm's
     length, and it prints. The verb leads so the eye finds the step it is on
     without reading the sentence. */
  .card-moves { list-style: none; counter-reset: cm; margin: 0; padding: 0; }
  .card-moves li {
    counter-increment: cm;
    position: relative;
    padding: 0.42rem 0 0.42rem 1.75rem;
    line-height: 1.4;
  }
  .card-moves li::before {
    content: counter(cm);
    position: absolute; left: 0; top: 0.42rem;
    width: 1.25rem; text-align: center;
    font-family: var(--font-display); font-weight: 800;
    color: var(--text-faint);
  }
  .card-moves strong {
    font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.01em;
  }
  .card-moves span { color: var(--text-dim); }
</style>
