---
import Base from '../layouts/Base.astro';
// Landing page after a subscriber confirms their email (Brevo double opt-in
// redirects here). Not linked from anywhere, not indexed.
---
<Base
  title="Your Emergency Card is ready | Save My Gig!"
  description="Confirmed. Download the printable DJ Emergency Card."
  path="/card-ready"
  noindex
>
  <main class="wrap">
    <div class="status-line" >Confirmed</div>

    <h1 style="margin-bottom:1rem">YOU'RE <span class="accent">IN</span>.<br />HERE IS YOUR CARD.</h1>

    <p class="dim" style=" 2.5rem">
      Download it, then put it somewhere you will actually find it at 3am: your phone's files,
      a screenshot in your camera roll, or printed and folded inside your USB case.
    </p>

    <div style=" 2rem">
      <a
        href="/downloads/save-my-gig-emergency-card.pdf"
        class="btn btn-solid"
        download
        data-event="card_download"
        data-placement="card_ready"
      >
        Download the Emergency Card (PDF)
      </a>
      <a href="/card" class="btn btn-neutral" data-event="step_completed" data-step="view_card_web">
        Or read it on the web
      </a>
      <a href="/downloads/save-my-gig-pre-gig-checklist.pdf" class="btn btn-neutral" download data-event="checklist_download" data-placement="card_ready">
        Also grab the one-page pre-gig checklist (PDF)
      </a>
    </div>

    <section class="panel" style=" 1.25rem">
      <h3 style="margin-bottom:0.75rem">While you are here</h3>
      <p class="dim" style="margin-bottom:1rem">
        The card is the emergency. The system is what stops the emergency from happening.
        It takes one evening to set up and it is free.
      </p>
      <a href="/prepare" class="btn btn-neutral" data-event="step_completed" data-step="prepare_click" data-placement="card_ready">
        See the prevention system
      </a>
    </section>

    <p class="dim" style="margin-top:2rem;font-size:0.9rem">
      We will only email you when something genuinely saves a gig. Unsubscribe any time,
      one click, no hard feelings.
    </p>
  </main>
</Base>
