---
/**
 * "Still in testing" notice for the rescue flow.
 *
 * WHY: the site is live and findable while a large part of the rescue content
 * has not yet had Antonio's expert review, and the flow audit found real
 * issues still open. People arriving in a crisis deserve to know that.
 *
 * HOW, deliberately: honest without being frightening. A DJ mid-crisis needs
 * to trust the next step, so a big "do not trust this" banner would freeze
 * exactly the person we are trying to help. This says the flow is new, tells
 * them to trust the gear in front of them over the screen, and gets out of the
 * way. It never blocks, never gates and never delays the decision.
 *
 * Remove this component (and its two usages) once the protocol review is done.
 */
interface Props {
  /** compact = one line, for inside the sealed tunnel. card = the entry notice. */
  variant?: 'card' | 'line';
}
const { variant = 'card' } = Astro.props;
---
{variant === 'card' ? (
  <aside class="beta-card" role="note">
    <span class="beta-tag">IN TESTING</span>
    <p>
      This rescue flow is new and still being tuned with working DJs. Read each
      step before you act, and trust what is in front of you over what is on the
      screen. Nothing here is guaranteed.
    </p>
  </aside>
) : (
  <p class="beta-line">
    <span class="beta-tag">IN TESTING</span>
    This flow is still being tuned. Trust your gear over the screen.
  </p>
)}

<style is:global>
  .beta-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber);
    border: var(--stroke) solid var(--amber);
    border-radius: var(--radius);
    padding: 2px 6px;
    line-height: 1;
    flex: 0 0 auto;
  }
  .beta-card {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    background: rgba(217, 164, 65, 0.07);
    border: var(--stroke) solid var(--edge);
    border-left: 3px solid var(--amber);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem;
    margin: 0 0 1.2rem;
  }
  .beta-card p {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .beta-card .beta-tag { margin-top: 1px; }
  /* Inside the tunnel this must never compete with the decision, so it is one
     quiet line under the top bar. */
  .beta-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--text-faint);
  }
  @media (max-width: 420px) {
    .beta-card { padding: 0.65rem 0.75rem; gap: 0.55rem; }
    .beta-card p { font-size: 0.82rem; }
  }
</style>
