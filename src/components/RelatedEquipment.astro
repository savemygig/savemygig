---
/**
 * RELATED EQUIPMENT AND RELATED GUIDES. One component, twelve equipment pages,
 * three languages.
 *
 * WHY IT IS A COMPONENT AND NOT PROSE ON EACH PAGE. Antonio's brief asked every
 * equipment page to link a newer model, an older model, and the gear it is
 * genuinely found beside. Written by hand that is 36 places where a
 * relationship lives, so the CDJ-3000X arriving means editing 36 files and
 * missing some. That is the same shape as the bug that put "FAT32 only" on six
 * models: a fact restated by hand in more places than anyone could count. Here
 * the relationships live in EQUIPMENT in facts.js, and this file only decides
 * how they look.
 *
 * THE THREE BLOCKS ARE THREE DIFFERENT KINDS OF CLAIM, and the design says so.
 *
 *   Related players / mixers   LINEAGE, a documented fact. Release order inside
 *                              a product line, topped up from siblings so a
 *                              model at the end of its line still leads
 *                              somewhere. Rendered plainly.
 *
 *   Commonly paired            FIELD JUDGEMENT. No manufacturer publishes
 *                              "these are usually installed together". This is
 *                              real knowledge from club, festival and rental
 *                              installs, and it is useful, but it is NOT a
 *                              sourced specification. So it carries `pairedNote`
 *                              saying exactly that, every time, in the reader's
 *                              language. The site's credibility comes from never
 *                              letting those two voices blur, and an unsourced
 *                              confident claim is how the FAT32 error happened.
 *
 *   Related guides             COMPUTED, not listed. The intersection of the
 *                              model's topic tags with GUIDE_INDEX, capped at
 *                              five. The cap is deliberate: "every page should
 *                              lead somewhere useful" fails if it leads to
 *                              fourteen places at once, which is a link farm
 *                              rather than a next step.
 *
 * A page never links to itself and never emits a link to a model without a
 * page, because the resolvers in facts.js drop unknown slugs. So this component
 * cannot ship a broken link even if someone edits the graph carelessly.
 */
import { lineageOf, siblingModels, pairedModels, relatedGuides, equipmentFor, modelPath, brandFor } from '../data/facts.js';
import { UI } from '../i18n/ui.js';

interface Props {
  slug: string;
  lang?: 'en' | 'pt' | 'es';
}
const { slug, lang = 'en' } = Astro.props;

const S = UI[lang].related;
const me = equipmentFor(slug);

// Every internal href gains the language prefix. The graph stores canonical
// English paths once, exactly like the nav does, so a new model needs no
// per-language href.
const lp = (p: string) => (lang === 'en' ? p : `/${lang}${p}`);

// THE MODEL PATH COMES FROM THE MODEL'S OWN BRAND (2026-08-07). This used to be
// a hardcoded `/knowledge/pioneer-dj/${slug}`, which was invisible as an
// assumption until Allen & Heath arrived: a Xone:92 in a `paired` list would
// have rendered as /knowledge/pioneer-dj/xone-92 and 404ed. It matters here more
// than anywhere else on the site, because `paired` deliberately reaches ACROSS
// brands: a Xone links to the CDJs it sits beside, and a CDJ links back.
const modelHref = (m) => lp(modelPath(m));

// The browse-all link goes to THIS model's manufacturer hub, not to Pioneer's.
const myBrand = brandFor(equipmentFor(slug)?.brand);

/*
 * THE CHAIN AND THE SIBLINGS ARE NOW TWO DIFFERENT CLAIMS (2026-08-08), and
 * they used to be one list. `relatedModels` merged newer, older and siblings
 * under a single heading that said "Related mixers", so a reader could not tell
 * the ancestor from the descendant, which is the question Antonio asked this
 * block to answer: "where does this equipment fit in the history of the booth".
 *
 * Lineage is documented release order and is rendered as a directional chain
 * with each end labelled. Siblings are an editorial judgement about comparable
 * tier and keep the plain heading, because they have not earned a lineage
 * label. Pulling them apart also means a page with a chain no longer spends its
 * two related slots on the chain and hides its siblings.
 */
const lineage = lineageOf(slug);
const hasChain = Boolean(lineage.older || lineage.newer || lineage.variants.length);
const related = siblingModels(slug);
const paired = pairedModels(slug);
const guides = relatedGuides(slug);

/*
 * TITLES BY KIND, NOT BY A BOOLEAN (2026-08-08). This was
 * `isPlayer ? S.players : S.mixers`, which was correct while `kind` had exactly
 * two values and silently wrong the moment it had three: a turntable is not a
 * player, so the SL-1200MK7 page would have headed its own lineage block
 * "Related mixers" and its Xone:92 pairing "Commonly paired players". Both
 * false, both perfectly valid HTML, and nothing would have failed.
 *
 * The second line is the interesting one. What a model is PAIRED WITH is not the
 * same question as what it IS: a player pairs with mixers, a mixer pairs with
 * players, and a turntable also pairs with mixers. So the map is explicit rather
 * than derived, because the derivation would have to encode that asymmetry
 * anyway and would hide it while doing so.
 */
const OWN_TITLE = { player: S.players, mixer: S.mixers, turntable: S.turntables, 'all-in-one': S.allInOnes };
// An all-in-one is not paired with a separate mixer or player, it IS both. What
// it is found beside is additional CDJs linked over PRO DJ LINK, so its paired
// column is titled for that relationship rather than reusing pairedMixers.
const PAIRED_TITLE = { player: S.pairedMixers, mixer: S.pairedPlayers, turntable: S.pairedMixers, 'all-in-one': S.linkedPlayers };
const relatedTitle = OWN_TITLE[me?.kind];
const pairedTitle = PAIRED_TITLE[me?.kind];
---
{me && (
  <div class="panel rel-block" style="margin-top:2rem">
    {hasChain && (
      <div class="rel-chain">
        <h2 class="rel-h">{S.lineage}</h2>
        <ol class="chain">
          {lineage.older && (
            <li class="chain-step">
              <span class="chain-label">{S.earlierGeneration}</span>
              <a class="chain-name" href={modelHref(lineage.older)}>{lineage.older.name}</a>
            </li>
          )}
          <li class="chain-step chain-here" aria-current="true">
            <span class="chain-label">{S.thisModel}</span>
            <span class="chain-name">{me.name}</span>
          </li>
          {lineage.newer && (
            <li class="chain-step">
              <span class="chain-label">{S.laterGeneration}</span>
              <a class="chain-name" href={modelHref(lineage.newer)}>{lineage.newer.name}</a>
            </li>
          )}
        </ol>
        {lineage.variants.length > 0 && (
          <ul class="chain-variants">
            {lineage.variants.map((v) => (
              <li>
                <span class="chain-label">{v.kind === 'motorized' ? S.variantMotorized : S.variantStatic}</span>
                <a class="chain-name" href={modelHref(v.model)}>{v.model.name}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )}
    <div class="rel-grid">
      {related.length > 0 && (
        <div class="rel-col">
          <h2 class="rel-h">{relatedTitle}</h2>
          <ul class="rel-list">
            {related.map((m) => (
              <li><a href={modelHref(m)}>{m.name}</a></li>
            ))}
          </ul>
        </div>
      )}

      {paired.length > 0 && (
        <div class="rel-col">
          <h2 class="rel-h">{pairedTitle}</h2>
          <ul class="rel-list">
            {paired.map((m) => (
              <li><a href={modelHref(m)}>{m.name}</a></li>
            ))}
          </ul>
          <p class="rel-note dim">{S.pairedNote}</p>
        </div>
      )}
    </div>

    {guides.length > 0 && (
      <div class="rel-guides">
        <h2 class="rel-h">{S.guides}</h2>
        <p class="dim" style="margin:0">
          {guides.map((g, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={lp(g.href)}>{S.guideLabels[g.key]}</a>
            </>
          ))}
        </p>
      </div>
    )}

    {myBrand && (
      <p class="rel-all">
        <a href={lp(myBrand.hub)}>{S.browseAll.replace('{brand}', myBrand.name)} →</a>
      </p>
    )}
  </div>
)}

<style>
  /* Two columns on desktop, stacked on phones. The columns are deliberately
     NOT equal-width cards: lineage is a short list and the paired block carries
     a sentence under it, so a grid that lets the second column breathe reads
     better than two boxes of forced equal height. */
  /* THE LINEAGE CHAIN. A horizontal daisy chain on desktop, a vertical one on a
     phone, because three cells side by side at 390px would either wrap badly or
     shrink the model names below reading size. The arrows are CSS ::after on the
     gaps rather than characters in the markup, so a screen reader hears an
     ordered list of labelled steps and not a row of punctuation. */
  .rel-chain { margin-bottom: 1.5rem; }
  .chain {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 0.5rem 1.6rem;
  }
  .chain-step { position: relative; display: flex; flex-direction: column; gap: 0.15rem; }
  .chain-step + .chain-step::before {
    content: ''; position: absolute; left: -1.05rem; top: 50%;
    width: 0.5rem; height: 0.5rem; margin-top: -0.28rem;
    border-top: 1px solid var(--edge-strong); border-right: 1px solid var(--edge-strong);
    transform: rotate(45deg);
  }
  .chain-label {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-dim);
  }
  .chain-name { font-size: 0.95rem; font-weight: 600; }
  .chain-here .chain-name { color: var(--text-dim); font-weight: 500; }
  .chain-variants {
    list-style: none; margin: 0.9rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem;
  }
  .chain-variants li { display: flex; flex-direction: column; gap: 0.15rem; }
  @media (max-width: 560px) {
    .chain { flex-direction: column; gap: 0.7rem; }
    .chain-step + .chain-step::before {
      left: 0; top: -0.5rem; margin-top: 0; transform: rotate(135deg);
    }
  }
  .rel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .rel-h {
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
    border-bottom: 0;
    padding-bottom: 0;
  }
  .rel-list { list-style: none; margin: 0; padding: 0; }
  .rel-list li { margin: 0 0 0.3rem; }
  .rel-note { font-size: 0.8rem; margin: 0.6rem 0 0; line-height: 1.45; }
  .rel-guides { margin-top: 1.5rem; }
  .rel-all { margin: 1.25rem 0 0; font-size: 0.9rem; }

  @media (max-width: 640px) {
    /* One column below 640, matching the breakpoint the knowledge hub
       categories already collapse at, so the page has one behaviour and not
       two competing ones. */
    .rel-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
