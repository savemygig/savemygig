---
/**
 * Expandable section.
 *
 * The point of this component is that a DJ should never be handed a wall of
 * text. They need THEIR branch: Windows or Mac, drive over 32GB or under, it
 * worked or it didn't. Everything else is noise at the worst possible moment.
 *
 * Built on native <details>/<summary>, which means:
 *   - it works with no JavaScript at all
 *   - it is keyboard accessible and screen-reader correct for free
 *   - the content is IN THE HTML, so Google indexes it and AI crawlers read
 *     it exactly as if it were visible. Collapsing costs us nothing for SEO
 *     or GEO; it only spares the human.
 *
 * Use `open` for the branch most people need, so the common path needs no click.
 */
interface Props {
  /** the question, phrased the way the reader would ask it */
  q: string;
  /** one-line hint shown next to the question, before opening */
  hint?: string;
  /** start expanded */
  open?: boolean;
}
const { q, hint, open = false } = Astro.props;
---
<details class="dt" open={open}>
  <summary class="dt-q">
    <span class="dt-txt">
      <span class="dt-title">{q}</span>
      {hint && <span class="dt-hint">{hint}</span>}
    </span>
    <span class="dt-icon" aria-hidden="true"></span>
  </summary>
  <div class="dt-body">
    <slot />
  </div>
</details>

<style is:global>
  /* DESIGN LANGUAGE SPRINT, 2026-08-03. This component used to draw its own
     box, its own summary padding, its own chevron (10px, a different angle,
     with a translate correction) and its own open state. It was one of SIX
     private accordions on the site doing one job. The box, the padding, the
     chevron, the focus ring, the open state and the body typography now come
     from the shared accordion in global.css, which .dt is part of.

     What is left is the only thing genuinely specific to this component: a
     two-line summary, a question with an optional hint under it. That is the
     reason Detail exists. The rest was duplication. */
  .dt-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dt-title {
    font-family: var(--font-display); font-weight: 700; font-size: 1rem;
    letter-spacing: -0.01em; color: var(--text); line-height: 1.3;
  }
  .dt-hint { font-size: 0.82rem; color: var(--text-dim); line-height: 1.4; }
  .dt-body p { font-size: 0.95rem; }
  .dt-body p strong { color: var(--text); }
  .dt-body .checklist { margin-top: 0.4rem; }
</style>
