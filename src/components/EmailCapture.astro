---
/**
 * Emergency Card email capture.
 * NOTE: the card itself is always free and public at /card. This is an
 * upgrade offer ("keep it forever"), never a gate. Do not put this in
 * front of the card or inside the rescue tunnel.
 */
import { t } from '../i18n/ui';
import { localizedPath, DEFAULT_LANG } from '../i18n/registry';
interface Props {
  /** where this form lives, for analytics: saved | prepare | card */
  source: string;
  title?: string;
  blurb?: string;
  lang?: string;
}
// `source` IS DECLARED REQUIRED ABOVE AND ASTRO DOES NOT ENFORCE IT
// (2026-08-06). All three /knowledge/pioneer-dj/firmware pages rendered
// <EmailCapture /> with no source, so each shipped id="cap-undefined", an
// aria-describedby pointing at cap-undefined-msg, and NO data-capture attribute
// at all, which made the submit handler fall through to its 'unknown' default.
// Every subscription and every email_capture event from those three pages was
// unattributable, and the form looked completely normal. The call sites are
// fixed; this default is the floor, so a future omission degrades to a plain
// word instead of putting the string "undefined" into an id a screen reader
// reads out. scripts/check-capture-source.mjs fails the build on either symptom,
// because an interface nothing checks at build time is documentation and not a
// guarantee.
const { source = 'unknown', lang = DEFAULT_LANG } = Astro.props;
const C = t(lang).capture;
// Defaults come from the catalogue rather than being English literals, so a
// caller that passes no title gets the reader's language, not ours.
const { title = C.title, blurb = C.blurb } = Astro.props;
const id = `cap-${source}`;
---
<!-- One registration, sitewide (Antonio). This form used to be its own little
     email system, disconnected from the checklist gate: registering there did
     nothing here and capturing here unlocked nothing there. Now it speaks
     registration, a successful capture REGISTERS the device (same keys the
     checklist reads), and a visitor who is already registered sees a one-tap
     send button with their address instead of a form asking again. -->
<section class="panel capture" data-capture={source}>
  <h3 style="margin-bottom:0.6rem">{title}</h3>
  <p class="dim cap-blurb" style="margin-bottom:1rem">{blurb}</p>

  <form class="cap-form" id={id} novalidate>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder={C.placeholder}
      aria-label={C.emailLabel}
      aria-describedby={`${id}-msg`}
    />
    {/* .btn-neutral, NOT .btn-solid (2026-08-06). Solid red is the
        emergency route now (see global.css). This was the only solid-fill
        button on a fix article, which made the mailing list louder than the
        way out of the emergency. Only its RANK changes: same size, same
        position, same label, same field above it, and it is still the one
        button in this panel. */}
    <button type="submit" class="btn btn-neutral" style="margin:0">{C.submit}</button>
  </form>

  {/* The live region is now also the field's DESCRIPTION (2026-08-04). It is
      where every error this form produces lands ("That does not look like an
      email", "No connection"), and a message that is only ever announced
      once is unrecoverable: tab back to the input and there was nothing to
      re-read. The id is per-instance because /prepare, /saved and the fix
      articles can render several captures on one page. */}
  <p class="cap-msg dim" id={`${id}-msg`} role="status" aria-live="polite"></p>

  <p class="cap-legal">
    {C.legal} <a href={localizedPath("/legal/privacy", lang)}>{C.privacy}</a>
  </p>
</section>

<style>
  .cap-form { display: flex; flex-direction: column; gap: 10px; }
  .cap-form input {
    width: 100%;
    padding: 1rem 1.1rem;
    font-family: inherit;
    font-size: 16px; /* 16px stops iOS zooming on focus */
    color: var(--text);
    background: var(--bg);
    border: var(--stroke) solid var(--edge-strong);
    border-radius: var(--radius);
  }
  .cap-form input::placeholder { color: var(--text-faint); }
  .cap-form input:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
  .cap-msg:empty { display: none; }
  .cap-msg { margin: 0.9rem 0 0; font-size: 0.9rem; }
  .cap-msg.ok { color: var(--green); }
  .cap-msg.err { color: var(--red); }
  .cap-legal {
    margin: 0.9rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-faint);
  }
  .cap-legal a { color: var(--text-dim); }
  @media (min-width: 560px) {
    .cap-form { flex-direction: row; }
    .cap-form input { flex: 1; }
    .cap-form .btn { width: auto; white-space: nowrap; }
  }
</style>

{/* PLAIN JS ONLY IN HERE. is:inline means Astro ships this block byte for
    byte, with no TypeScript pass over it. It carried ten `as HTMLElement`
    casts until 2026-08-05, so every browser threw a SyntaxError on parse,
    the submit handler never bound, and the form fell back to its native GET:
    the reader's address went into the URL, no request ever reached
    /api/subscribe, and nobody was subscribed. Caught in the Aug 5 audit.
    scripts/check-inline-scripts.mjs now parses every shipped inline script
    so this class of bug cannot reach production again. */}
<script is:inline define:vars={{ SEND_TO: C.sendTo, MSG: t(lang).capmsg }}>
  // Already registered on this device: no form, one tap, their address shown.
  document.querySelectorAll('.capture').forEach((wrap) => {
    let unlocked = false; let stored = '';
    try {
      unlocked = localStorage.getItem('SMG_UNLOCKED') === '1';
      stored = localStorage.getItem('SMG_EMAIL') || '';
    } catch (e) {}
    if (unlocked && stored) {
      const form = wrap.querySelector('.cap-form');
      const blurb = wrap.querySelector('.cap-blurb');
      if (form) {
        const input = form.querySelector('input[name="email"]');
        const btn = form.querySelector('button');
        if (input) { input.value = stored; input.hidden = true; }
        if (btn) btn.textContent = SEND_TO + stored;
        if (blurb) blurb.textContent = MSG.registered;
      }
    }
  });

  document.querySelectorAll('.cap-form').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const el = form;
      const wrap = el.closest('.capture');
      const msg = wrap.querySelector('.cap-msg');
      const btn = el.querySelector('button');
      const input = el.querySelector('input[name="email"]');
      const source = wrap.dataset.capture || 'unknown';
      const email = (input.value || '').trim();

      msg.className = 'cap-msg dim';
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        msg.textContent = MSG.bad;
        msg.className = 'cap-msg err';
        input.focus();
        return;
      }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = MSG.sending;
      msg.textContent = '';

      // Registration counts everywhere, and it counts even if the API coughs:
      // same policy as the checklist gate, the features are free and the keys
      // go in before the network is trusted. Both surfaces now behave the
      // same on the failure path.
      try {
        localStorage.setItem('SMG_UNLOCKED', '1');
        localStorage.setItem('SMG_EMAIL', email);
      } catch (e) {}

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, source }),
        });
        const data = await res.json();
        if (data.ok) {
          msg.textContent = MSG.almost;
          msg.className = 'cap-msg ok';
          el.reset();
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'email_capture', { placement: source });
          }
        } else {
          msg.textContent = MSG.server;
          msg.className = 'cap-msg err';
        }
      } catch (err) {
        msg.textContent = MSG.offline;
        msg.className = 'cap-msg err';
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>
