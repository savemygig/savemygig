---
/**
 * Cookie consent, GDPR/ePrivacy.
 *
 * Analytics cookies are only set AFTER the visitor accepts. Declining works
 * and is remembered. Deliberately small and anchored to the bottom so it
 * never covers the emergency CTA, and it is hidden inside the rescue tunnel
 * (the Tunnel layout does not include this component).
 */
---
<div id="ck" class="ck" role="dialog" aria-label="Cookie choice" hidden>
  <p class="ck-t">
    <strong class="ck-h">Before you dive in.</strong>
    Analytics cookies only, so we see which pages help DJs most.
    <a href="/legal/cookies">Cookie policy</a>
  </p>
  <div class="ck-b">
    <button type="button" id="ck-no" class="ck-btn ck-ghost">Decline</button>
    <button type="button" id="ck-yes" class="ck-btn ck-solid">Accept</button>
  </div>
</div>

<style>
  /* Must beat the .ck display rule below, otherwise the banner never hides. */
  .ck[hidden] { display: none !important; }
  .ck {
    position: fixed; z-index: 100;
    left: 12px; right: 12px; bottom: calc(14px + env(safe-area-inset-bottom));
    max-width: 660px; margin: 0 auto;
    /* Elevated + a bold amber notice edge so it reads as a distinct banner,
       not another dark card. It has to hit your face. */
    background: var(--surf-2);
    border: var(--stroke) solid var(--amber);
    border-radius: var(--radius); padding: 16px 18px;
    display: flex; flex-direction: column; gap: 13px;
    box-shadow: 0 10px 44px rgba(0, 0, 0, 0.66), 0 0 0 1px rgba(217, 164, 65, 0.18), 0 0 26px rgba(217, 164, 65, 0.14);
    animation: ckIn 0.32s ease-out both;
  }
  @keyframes ckIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) { .ck { animation: none; } }

  .ck-t { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text); }
  .ck-h { display: block; font-family: var(--font-display); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.02em; font-size: 12.5px;
    color: var(--amber); margin-bottom: 3px; }
  .ck-t a { color: var(--text); text-decoration: underline; }
  .ck-b { display: flex; gap: 10px; justify-content: flex-end; }
  .ck-btn {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: 13px; letter-spacing: 0.02em; padding: 11px 20px;
    border-radius: var(--radius); cursor: pointer; border: var(--stroke) solid var(--edge);
    transition: border-color var(--t-fast), background var(--t-fast), color var(--t-fast);
  }
  /* Both are clearly buttons. Decline is a real outlined button, not a ghost
     that melts into the panel. */
  .ck-ghost { background: transparent; color: var(--text); border-color: var(--text-faint); }
  .ck-ghost:hover { border-color: var(--text-dim); background: var(--surf); }
  .ck-solid { background: var(--red); color: #0a0a0b; border-color: var(--red); }
  .ck-solid:hover { box-shadow: var(--shadow-focus-red); }
  @media (min-width: 560px) {
    .ck { flex-direction: row; align-items: center; gap: 20px; }
    .ck-t { flex: 1; }
    .ck-h { display: inline; margin-bottom: 0; margin-right: 6px; }
    .ck-b { flex-shrink: 0; }
  }

  /* On a phone this card sits on top of the homepage doors on the very first
     visit, so every pixel it wastes is a pixel of the actual choice a DJ came
     for. Kept loud (amber edge, glow) but as short as it can legally be:
     roughly 140px instead of 360px. Buttons stay at a 44px tap target. */
  @media (max-width: 559px) {
    .ck { padding: 12px 14px; gap: 10px; left: 10px; right: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom)); }
    .ck-t { font-size: 13.5px; line-height: 1.42; }
    .ck-h { font-size: 12px; margin-bottom: 2px; }
    .ck-btn { flex: 1; min-height: 44px; padding: 10px 12px; font-size: 12.5px; }
    .ck-b { gap: 8px; }
  }

  /* Short phones (iPhone SE and friends): the banner has to get out of the way
     of the third door, so the heading goes inline and the copy drops to one
     line. Roughly 95px. Buttons keep the 44px target. */
  @media (max-width: 559px) and (max-height: 640px) {
    .ck { padding: 10px 12px; gap: 8px; }
    .ck-t { font-size: 12.5px; line-height: 1.38; }
    .ck-h { display: inline; font-size: 12px; margin: 0 5px 0 0; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'smg-consent';
    var GA = 'G-65PEMEYW2M';

    function loadAnalytics() {
      if (window.__smgGaLoaded) return;
      window.__smgGaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA);
    }
    window.__smgLoadAnalytics = loadAnalytics;

    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}

    if (saved === 'yes') { loadAnalytics(); return; }
    if (saved === 'no') { return; }

    var box = document.getElementById('ck');
    if (!box) return;
    box.hidden = false;
    // Suppress the sticky article CTA while the banner is up, it used to
    // cover both consent buttons on /fix pages at mobile width.
    document.documentElement.classList.add('ck-open');

    // The banner is position:fixed, so it SAT ON TOP of real content: on the
    // first visit it covered the FROZEN PLAYER door on /emergency and the
    // primary CTA on /saved (polish audit C1, 2026-08-03). Shrinking it was
    // never the fix. Reserve exactly its own height at the foot of the page
    // so every element can still be scrolled clear of it, whatever the
    // viewport or the text wrap. Re-measured on resize and orientation change.
    function reserveSpace() {
      if (box.hidden) return;
      var h = box.getBoundingClientRect().height;
      document.body.style.paddingBottom = Math.ceil(h + 24) + 'px';
    }
    reserveSpace();
    // One more pass after fonts settle, since wrapping changes the height.
    setTimeout(reserveSpace, 250);
    window.addEventListener('resize', reserveSpace);
    window.addEventListener('orientationchange', reserveSpace);

    function choose(v) {
      try { localStorage.setItem(KEY, v); } catch (e) {}
      box.hidden = true;
      box.style.display = 'none'; // belt and braces, in case CSS wins
      document.documentElement.classList.remove('ck-open');
      document.body.style.paddingBottom = '';
      window.removeEventListener('resize', reserveSpace);
      window.removeEventListener('orientationchange', reserveSpace);
      if (v === 'yes') loadAnalytics();
    }
    document.getElementById('ck-yes').addEventListener('click', function () { choose('yes'); });
    document.getElementById('ck-no').addEventListener('click', function () { choose('no'); });
  })();
</script>
