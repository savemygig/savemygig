---
// GA4 - G-65PEMEYW2M.
// IMPORTANT: the gtag library is NOT loaded here any more. It is loaded by
// Consent.astro only after the visitor accepts analytics cookies (GDPR).
// This file only wires the click tracking, which safely does nothing when
// consent was declined, because gtag is undefined in that case.
---
<script is:inline>
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-event]');
    if (!el) return;
    if (typeof window.gtag !== 'function') return; // no consent, no tracking
    var params = {};
    for (var i = 0; i < el.attributes.length; i++) {
      var a = el.attributes[i];
      if (a.name.indexOf('data-') === 0 && a.name !== 'data-event') {
        params[a.name.slice(5).replace(/-/g, '_')] = a.value;
      }
    }
    window.gtag('event', el.getAttribute('data-event'), params);
  });
</script>
