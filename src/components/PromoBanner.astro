---
/**
 * Internal promo banner, built to standard IAB ad dimensions.
 *
 * WHY THE ODD SIZES: this slot is deliberately a 728x90 leaderboard on desktop
 * and a 320x100 large mobile banner on phones, the two most widely supported
 * AdSense units. Today it carries internal links only. When ads are switched
 * on, the ad unit drops into this exact slot and NOTHING on the page moves,
 * no layout shift, no CLS penalty, no redesign.
 *
 * Rules for what goes in here:
 *   - internal links only for now, no external or affiliate destinations
 *   - phrased as the problem the DJ actually has, not as a feature
 *   - NEVER rendered inside the rescue tunnel; nothing competes with the rescue
 *
 * A promo is picked at random on load so repeat visitors do not see the same
 * one every time. The first is rendered visible server-side, so it still works
 * with JavaScript disabled.
 */
import { PROMOS as PROMOS_EN } from '../data/promos.js';
import { PROMOS as PROMOS_PT } from '../data/promos.pt.js';
import { PROMOS as PROMOS_ES } from '../data/promos.es.js';

interface Props {
  /** path of the current page, so we never promote the page you are already on.
   *  Compared against the UNPREFIXED href, so callers pass '/emergency' in
   *  every language. */
  exclude?: string;
  /** 'en' | 'pt' | 'es'. Picks the card copy AND prefixes every href so a
   *  reader never leaves their language. Cards were English on /pt and /es
   *  until 2026-08-05, and worse, they linked into the English site. */
  lang?: 'en' | 'pt' | 'es';
}
const { exclude = '', lang = 'en' } = Astro.props;

// The card copy lives in src/data/promos*.js, one file per language, same
// pattern as the emergency tree: identical structure, only strings differ.
const ALL = lang === 'pt' ? PROMOS_PT : lang === 'es' ? PROMOS_ES : PROMOS_EN;
const prefix = lang === 'en' ? '' : `/${lang}`;
const ARIA = { en: 'From Save My Gig', pt: 'Do Save My Gig', es: 'De Save My Gig' };

const promos = ALL
  .filter((p) => p.href !== exclude)
  .map((p) => ({ ...p, href: `${prefix}${p.href}` }));
---
<aside class="promo-slot" aria-label={ARIA[lang]}>
  {promos.map((p, i) => (
    <a
      class:list={['promo', `t-${p.tone}`]}
      href={p.href}
      data-promo={i}
      data-mobile-only={p.mobileOnly ? '1' : undefined}
      hidden={i !== 0}
      data-event="promo_click"
      data-placement="promo_banner"
      data-target={p.href}
    >
      <span class="promo-icon" aria-hidden="true">
        {p.icon === 'alert' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>}
        {p.icon === 'disc' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/></svg>}
        {p.icon === 'check' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
        {p.icon === 'usb' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/></svg>}
        {p.icon === 'rescue' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M3 12h18"/></svg>}
        {p.icon === 'save' && <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg>}
      </span>
      <span class="promo-body">
        <!-- Full question on desktop, short on phones (Antonio: a title
             wrapping to two lines made three lines with the CTA, "looks
             terrible"). test-promo-fit.mjs in the gate proves every slide
             holds ONE title line + ONE CTA line at iPhone widths. -->
        <span class="promo-q"><span class="pq-full">{p.q}</span><span class="pq-short">{p.qs}</span></span>
        <span class="promo-cta">{p.cta} &rarr;</span>
      </span>
    </a>
  ))}
</aside>

<style is:global>
  /* 728x90 leaderboard on desktop, 320x100 large mobile banner on phones.
     Fixed height in both cases so an ad unit can replace the contents later
     without shifting a single pixel of the page. */
  .promo-slot {
    width: 100%;
    max-width: 728px;
    height: 90px;
    margin: 2rem auto 0;
  }
  /* Once there is room, pin it to a true 728x90 leaderboard so a real ad unit
     fits natively rather than being scaled or downgraded. The content column
     is 728px too now (Antonio, round 5: --site-w bumped so the rest of the
     page matches this banner instead of the other way around), so this just
     confirms the exact width rather than sitting proud of it. */
  @media (min-width: 820px) {
    .promo-slot { width: 728px; max-width: none; }
  }
  /* Reads as a distinct slot without shouting. A filled colour block would
     look like a cheap ad and cost trust on a rescue site, so the colour lives
     in a left edge and the icon, using the same red/green/amber language as
     the homepage doors. --tone is set per promo below. */
  .promo {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 0 1.2rem 0 1.35rem;
    background: linear-gradient(90deg, var(--tone-wash) 0%, var(--surf-2) 42%);
    border: var(--stroke) solid var(--edge);
    border-left: 3px solid var(--tone);
    border-radius: var(--radius);
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--t-fast), filter var(--t-fast);
  }
  .promo[hidden] { display: none; }
  .promo:hover { border-color: var(--tone); filter: brightness(1.14); }
  .t-red { --tone: var(--red); --tone-wash: rgba(255, 77, 46, 0.09); }
  .t-green { --tone: var(--green); --tone-wash: rgba(58, 216, 132, 0.08); }
  .t-amber { --tone: var(--amber); --tone-wash: rgba(217, 164, 65, 0.08); }
  .promo-icon {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px; border-radius: var(--radius-round);
    color: var(--tone);
    background: var(--tone-wash);
    border: var(--stroke) solid var(--tone);
  }
  .promo-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .promo-q {
    font-family: var(--font-display); font-weight: 800; font-size: 1.02rem;
    letter-spacing: -0.01em; color: var(--text); line-height: 1.2;
  }
  .promo-cta {
    font-family: var(--font-body); font-weight: 600; font-size: 0.84rem;
    color: var(--tone); line-height: 1.2;
  }

  .pq-short { display: none; }
  @media (max-width: 640px) {
    .pq-full { display: none; }
    .pq-short { display: inline; }
    /* Full width to match the door boxes above it, per Antonio. When real ads
       switch on, a 320x100 unit centers inside this slot without moving the
       page. */
    .promo-slot { max-width: none; height: 100px; margin: 1.6rem auto 0; }
    .promo { padding: 0 0.9rem; gap: 0.7rem; }
    .promo-icon { width: 36px; height: 36px; }
    .promo-icon svg { width: 19px; height: 19px; }
    .promo-q { font-size: 0.92rem; }
    .promo-cta { font-size: 0.78rem; }
  }
  @media (prefers-reduced-motion: reduce) { .promo { transition: none; } }
</style>

<script is:inline>
  (function () {
    var desktop = window.matchMedia('(min-width: 641px)').matches;
    var slots = document.querySelectorAll('.promo-slot');
    for (var s = 0; s < slots.length; s++) {
      var all = slots[s].querySelectorAll('.promo');
      // Mobile-only slides (the install pitch) never enter the desktop pick:
      // desktop already carries the standalone install banner.
      var items = [];
      for (var j = 0; j < all.length; j++) {
        if (desktop && all[j].hasAttribute('data-mobile-only')) { all[j].hidden = true; continue; }
        items.push(all[j]);
      }
      if (items.length < 2) continue;
      var pick = Math.floor(Math.random() * items.length);
      for (var i = 0; i < items.length; i++) items[i].hidden = (i !== pick);
    }
  })();
</script>
