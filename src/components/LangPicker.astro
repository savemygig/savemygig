---
/**
 * THE LANGUAGE PICKER.
 *
 * Antonio, 2026-08-03: EN, ES and PT in the header, and clicking Spanish or
 * Portuguese shows a message IN THAT LANGUAGE, because the site itself is not
 * translated yet. Telling a Spanish speaker "coming soon" in English would be
 * a joke at their expense.
 *
 * ONE ELEMENT, TWO PRESENTATIONS. This is a native <details>. On desktop the
 * summary is styled as a square that matches the search button and the panel
 * floats under it. On a phone the same summary is a drawer row reading
 * "Language   EN" and the panel opens inline beneath it. Native details gives
 * keyboard support and the open state for free, and it means there is one
 * control here, not a desktop one plus a mobile one.
 *
 * WHY THE PHONE VERSION COLLAPSES (Antonio, second pass): the first build
 * printed EN, ES and PT as three permanent rows in the drawer, directly under
 * seven destinations. "Looks a little bit strange that the other three are
 * keeping a permanent spot." He is right, and the site already had the answer
 * in its own collapse doctrine: long lists collapse, the header is the index.
 * One row now, showing the language you are in, which also means somebody who
 * only wants to CHECK never has to tap at all.
 *
 * SHAPE ON DESKTOP. Deliberately the same square as the search button: same
 * box, border, radius, hover, focus ring and 44/35px shrink. Two identical
 * squares read as one utility pair. A text pill beside an icon button would
 * have been another control shape on a site that spent a sprint getting down
 * to one of everything.
 *
 * ORDER. Search keeps the far right corner. Search is a repeat action and
 * that corner is the position people hit without looking. Language is a once
 * ever action, so it sits inboard.
 *
 * NOT IN THE TUNNEL. The rescue top bar carries the brand and nothing else by
 * design. Nothing may compete with the decision on screen.
 *
 * WIRED TO THE REGISTRY, 2026-08-05. The list is no longer written here: it
 * is src/i18n/registry.js, the one switch, so a language becomes real in the
 * picker at the same moment it becomes real in the sitemap and the hreflang
 * set. Three behaviours follow from a language's `live` flag and nothing
 * else, which is the point of having the flag:
 *
 *   live      -> a REAL LINK to this page in that language, and the choice is
 *                remembered in SMG_LANG so the next bare visit lands there.
 *   not live  -> the notice in that language, exactly as before. NO href is
 *                emitted, deliberately: an unpublished language is noindex
 *                and out of the sitemap, and an anchor to it in the header of
 *                107 English pages is precisely how a crawler would discover
 *                what we just took care to hide.
 *
 * THE REVIEW DOOR. Antonio has to read 94 translated pages before he gives
 * the green light, and reading them page by page in a URL bar is not review,
 * it is data entry. Visiting any page with ?preview=1 sets SMG_PREVIEW and
 * turns the held-back languages into working links for that browser only, so
 * he can walk the whole site in Portuguese in context. ?preview=0 clears it.
 * Nothing about the served HTML changes, so a crawler can never take this
 * door: it does not run scripts on our behalf and there is no href to follow.
 *
 * WHAT IT STORES. SMG_LANG, a bare language code, only ever one that is live.
 * It is a functional preference and not tracking, so it sits outside the
 * consent gate, and per the standing rule its privacy line shipped before
 * this code did.
 */
import { LANGS, DEFAULT_LANG, byCode, localizedPath } from '../i18n/registry';
import { t } from '../i18n/ui';

interface Props {
  /** Language of the page this picker sits on. */
  lang?: string;
  /** ENGLISH path of the page, so every option lands on the SAME page. */
  path?: string;
}
const { lang = DEFAULT_LANG, path = '/' } = Astro.props;
const S = t(lang);
const here = byCode(lang);

// ACCENTS ARE NOT OPTIONAL. A first draft shipped "Espanol" and "Portugues"
// bare and it looked exactly like what it was. The no dashes rule in this
// codebase is about em and en dashes and has never touched diacritics.
// The names now come from the registry, where they are already written
// correctly, so there is one place to get this wrong instead of two.
const opts = LANGS.map((l) => ({
  ...l,
  label: l.code.toUpperCase(),
  href: localizedPath(path, l.code),
  current: l.code === lang,
}));

// Written to a speaker's standard. Both notices deliberately sidestep the
// pt-PT against pt-BR split and the regional Spanish splits: "está en camino"
// and "está a caminho" read correctly on both sides of each language.
const NOTICES = {
  es: {
    title: 'Español muy pronto',
    body: 'Save My Gig todavía está solo en inglés. La versión en español está en camino.',
    back: 'Volver',
    soon: 'Muy pronto',
  },
  pt: {
    title: 'Português em breve',
    body: 'O Save My Gig ainda está só em inglês. A versão em português está a caminho.',
    back: 'Voltar',
    soon: 'Em breve',
  },
};
const held = opts.filter((l) => !l.live && NOTICES[l.code]);
---
<details class="lang" id="langWrap">
  <summary class="lang-sum" aria-label={`${S.lang.label}: ${here.name}`}>
    {/* Desktop: this IS the square. Mobile: it is the value at the end of the
        row, so the collapsed row still answers "what language am I in". */}
    <span class="lang-label">{S.lang.label}</span>
    <span class="lang-now">{here.code.toUpperCase()}</span>
    <span class="lang-chev" aria-hidden="true"></span>
  </summary>

  <div class="lang-pop">
    <div class="lang-list" id="langList">
      {opts.map((l) => (
        l.live ? (
          <a
            class:list={['lang-opt', { 'lang-opt-on': l.current }]}
            href={l.href}
            data-lang={l.code}
            data-live="1"
            hreflang={l.tag}
            lang={l.code}
            aria-current={l.current ? 'true' : undefined}
          >
            <span class="lang-code">{l.label}</span>
            <span class="lang-name">{l.name}</span>
          </a>
        ) : (
          <button
            type="button"
            class="lang-opt"
            data-lang={l.code}
            data-href={l.href}
            lang={l.code}
          >
            <span class="lang-code">{l.label}</span>
            <span class="lang-name">{l.name}</span>
            <span class="lang-soon">{NOTICES[l.code].soon}</span>
          </button>
        )
      ))}
    </div>

    {held.map((l) => (
      <div class="lang-note" id={`langNote-${l.code}`} lang={l.code} hidden>
        <p class="lang-note-t">{NOTICES[l.code].title}</p>
        <p class="lang-note-b">{NOTICES[l.code].body}</p>
        {/* The way back is in the same language as the notice. Dropping into
            English for the one word they click would undo the point. */}
        <button type="button" class="lang-note-x" data-back>{NOTICES[l.code].back}</button>
      </div>
    ))}
  </div>
</details>

<style>
  .lang { position: relative; display: inline-flex; flex: 0 0 auto; }

  /* ---------- DESKTOP: the square ----------
     Same box as .nav-search-btn. If you change one, change both: they are one
     utility pair and matching is the entire point. */
  .lang-sum {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap-min); height: var(--tap-min); flex: 0 0 auto;
    background: transparent; border: var(--stroke) solid var(--edge);
    border-radius: var(--radius);
    color: var(--text-dim); cursor: pointer; list-style: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .lang-sum:hover { color: var(--text); border-color: var(--text-dim); }
  /* The row label and the chevron are the PHONE presentation and do not
     exist on desktop, where the square shows only the code. */
  .lang-label, .lang-chev { display: none; }
  .lang-now {
    font-family: var(--font-body); font-weight: 700; font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .lang-pop {
    position: absolute; top: calc(100% + 0.5rem); right: 0; z-index: 60;
    min-width: 15rem;
    background: var(--surf); border: var(--stroke) solid var(--edge);
    border-radius: var(--radius); box-shadow: var(--shadow-raised);
    padding: var(--sp-2);
  }

  .lang-list { display: flex; flex-direction: column; }
  /* `display` beats the `hidden` attribute, so without this the notice
     rendered UNDERNEATH the three options instead of replacing them. */
  .lang-list[hidden] { display: none; }
  .lang-opt {
    display: flex; align-items: center; gap: var(--sp-3);
    width: 100%; min-height: var(--tap-min);
    padding: var(--sp-2) var(--sp-3);
    background: transparent; border: 0; border-radius: var(--radius);
    text-align: left; cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast);
    /* A published language is an <a> and a held-back one is a <button>. They
       have to be the same row to the eye, so the anchor gives up the two
       things a browser insists on adding to it. */
    text-decoration: none; box-sizing: border-box;
  }
  .lang-opt:hover { background: var(--surf-2); }
  .lang-opt:focus-visible { outline: 2px solid var(--red); outline-offset: -2px; }
  .lang-code {
    flex: 0 0 auto; width: 1.9rem;
    font-family: var(--font-body); font-weight: 700; font-size: 0.74rem;
    letter-spacing: 0.06em; color: var(--text);
  }
  .lang-name {
    flex: 1 1 auto;
    font-family: var(--font-body); font-size: 0.88rem; color: var(--text-dim);
  }
  /* The live language carries the accent, the way every current state on this
     site carries it. */
  .lang-opt-on .lang-code { color: var(--red); }
  .lang-soon {
    flex: 0 0 auto; font-size: 0.62rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-faint);
  }

  .lang-note { padding: var(--sp-3); }
  .lang-note[hidden] { display: none; }
  .lang-note-t {
    font-family: var(--font-display); font-weight: 800; font-size: 0.98rem;
    text-transform: uppercase; letter-spacing: -0.01em; color: var(--text);
    margin-bottom: var(--sp-2);
  }
  .lang-note-b {
    font-size: 0.88rem; line-height: 1.55; color: var(--text-dim);
    margin-bottom: var(--sp-3);
  }
  .lang-note-x {
    min-height: var(--tap-min); padding: 0;
    background: transparent; border: 0; cursor: pointer;
    font-family: var(--font-body); font-weight: 600; font-size: 0.82rem;
    color: var(--red);
  }
  .lang-note-x:hover { text-decoration: underline; }
  .lang-note-x:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }

  @media (min-width: 901px) {
    /* 35px is a mouse target, 44px is a thumb. Shrinks with the search button
       so the pair stays a pair. */
    .lang-sum { width: 35px; height: 35px; }
    .lang-now { font-size: 0.68rem; }
  }

  /* ---------- PHONE: one drawer row that opens ----------
     Not three permanent rows. A once ever preference must not sit at the same
     visual weight as seven destinations. */
  @media (max-width: 900px) {
    /* SEPARATED, not just placed last. The row sat last once before and read
       as an eighth destination, then sat between Knowledge and About and read
       as a setting dropped into the middle of a list of places. Neither was a
       position problem. A setting goes after the destinations, and it needs
       to LOOK like a different kind of thing when it gets there: the
       destination list closes, there is a gap, then this. */
    .lang {
      display: block; width: 100%;
      /* Gap only, NO rule of its own. About already closes the destination
         list with its own hairline, so a border here printed two lines with
         a gap between them. The gap is the separation. */
      margin-top: var(--sp-4);
    }
    .lang-sum {
      display: flex; align-items: center; justify-content: flex-start;
      gap: var(--sp-3);
      width: 100%; height: auto; min-height: var(--tap-min);
      padding: 0.8rem 0;
      border: 0; border-radius: 0;
      font-family: var(--font-body); font-weight: 600; font-size: 0.95rem;
      letter-spacing: 0; text-transform: uppercase; color: var(--text-dim);
    }
    .lang-sum:hover { border: 0; }
    .lang-label { display: block; flex: 1 1 auto; }
    /* The current language sits at the end of the row, the way a value sits
       at the end of a settings row. Accent, because it is a current state. */
    .lang-now {
      flex: 0 0 auto; font-size: 0.8rem; color: var(--red);
      letter-spacing: 0.06em;
    }
    .lang-chev { display: block; }
    .lang-pop {
      position: static; min-width: 0;
      border: 0; box-shadow: none; background: transparent;
      padding: 0 0 var(--sp-3);
    }
    .lang-opt { padding-left: 0; padding-right: 0; }
    .lang-note { padding-left: 0; padding-right: 0; }
  }
</style>

<script is:inline define:vars={{ CURRENT: lang }}>
  (function () {
    var wrap = document.getElementById('langWrap');
    var list = document.getElementById('langList');
    if (!wrap || !list) return;
    var sum = wrap.querySelector('.lang-sum');

    function notes() { return wrap.querySelectorAll('.lang-note'); }

    function showList() {
      list.hidden = false;
      notes().forEach(function (n) { n.hidden = true; });
    }

    function showNote(code) {
      var note = document.getElementById('langNote-' + code);
      if (!note) return;
      list.hidden = true;
      notes().forEach(function (n) { n.hidden = n !== note; });
      var back = note.querySelector('[data-back]');
      if (back) back.focus();
    }

    // Always reopen on the list, never on whichever notice was left showing.
    wrap.addEventListener('toggle', function () { if (!wrap.open) showList(); });

    // THE REVIEW DOOR. ?preview=1 turns the held-back languages into working
    // links in this browser only. It is read on every page so Antonio can
    // switch it on once and then browse normally.
    try {
      var q = new URLSearchParams(location.search).get('preview');
      if (q === '1') localStorage.setItem('SMG_PREVIEW', '1');
      else if (q === '0') localStorage.removeItem('SMG_PREVIEW');
    } catch (e) { /* private mode: no preview, which is the safe default */ }
    function preview() {
      try { return localStorage.getItem('SMG_PREVIEW') === '1'; } catch (e) { return false; }
    }

    // Remember the choice, but ONLY a published language. Storing a held-back
    // one would send a reviewer's next bare visit into a language the public
    // cannot see, and the detection script would then have to defend against
    // a value it should never have been given.
    function remember(code, isLive) {
      if (!isLive) return;
      try { localStorage.setItem('SMG_LANG', code); } catch (e) { /* nothing to do */ }
    }

    wrap.addEventListener('click', function (e) {
      var opt = e.target.closest ? e.target.closest('.lang-opt') : null;
      if (opt) {
        var code = opt.getAttribute('data-lang');
        var isLive = opt.getAttribute('data-live') === '1';
        // The language you are already reading: nothing to do but close.
        if (code === CURRENT) {
          e.preventDefault();
          wrap.open = false;
          if (sum) sum.focus();
          return;
        }
        if (isLive) { remember(code, true); return; } // let the anchor navigate
        // Held back. A reviewer goes through; everyone else gets the notice
        // in their own language.
        if (preview()) {
          var href = opt.getAttribute('data-href');
          if (href) { location.href = href; return; }
        }
        showNote(code);
        return;
      }
      if (e.target.closest && e.target.closest('[data-back]')) showList();
    });

    // Click outside and Escape, which native <details> does not give us. Both
    // are desktop behaviours: on a phone this is an inline drawer row and
    // closing it by tapping elsewhere in the menu would be surprising.
    function floating() { return window.matchMedia('(min-width: 901px)').matches; }

    document.addEventListener('click', function (e) {
      if (!wrap.open || !floating()) return;
      if (!wrap.contains(e.target)) wrap.open = false;
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && wrap.open && floating()) {
        wrap.open = false;
        if (sum) sum.focus();
      }
    });
  })();
</script>
