---
// The CTA every /fix article ends with (blueprint §2).
// NOTE: Booth Bible CTA removed 2026-07-24, restore from git history at book launch.
interface Props { article: string }
const { article } = Astro.props;
---
<div class="panel panel-danger" style="margin-top:3rem">
  <h3 style="margin-bottom:0.75rem">Playing soon and still stuck?</h3>
  <p class="dim">The step-by-step emergency flow asks how long you have and walks you through the fastest route, one decision at a time. Free, no account.</p>
  <a href="/emergency" class="btn btn-solid" data-event="begin_checkout" data-placement={`article_${article}`}>
    🚨 Start Emergency Mode
  </a>
</div>
<div class="panel" style="margin-top:1rem">
  <p class="dim" style="margin-bottom:0.75rem"><strong>Never want to read this page again?</strong> Set up the prevention system once and this page becomes irrelevant.</p>
  <a href="/prepare" class="btn btn-neutral" data-event="step_completed" data-step="prepare_click" data-placement={`article_${article}`}>
    🛡 See the prevention checklist
  </a>
</div>
<a href="/emergency" class="sticky-cta" data-event="begin_checkout" data-placement={`article_${article}_sticky`}>🚨 PLAYING SOON? START EMERGENCY MODE</a>
