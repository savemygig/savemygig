---
// The CTA every /fix article ends with (blueprint §2).
// NOTE: Booth Bible CTA removed 2026-07-24, restore from git history at book launch.
// EmailCapture added 2026-07-26 (Antonio's go): fix articles are where cold
// search traffic lands and they captured nothing. Sits below both CTAs so it
// never competes with the rescue.
import EmailCapture from './EmailCapture.astro';
import { t } from '../i18n/ui';
import { localizedPath, DEFAULT_LANG } from '../i18n/registry';
import Icon from './Icon.astro';
// LANGUAGE AWARE 2026-08-05. This block closes all 13 /fix articles, which are
// where cold search traffic lands. It shipped ENGLISH, with unprefixed English
// hrefs, at the bottom of every translated article: the single largest English
// leak on the translated site. `lang` defaults to English so no English page
// changes by a byte.
// `card` (2026-08-05) prints a SECONDARY link to /card under the Emergency
// Mode button. OPT-IN, not on by default: /card was orphaned and needed
// inbound links, but putting the same link at the foot of all 13 articles
// would be a sitewide footer link pretending to be editorial, which is the
// pattern that earns a link no weight and reads as filler. It is passed by the
// two articles about a drive dying AT THE BOOTH, where a page that survives a
// closed tab and no signal is genuinely the next thing the reader needs.
interface Props { article: string; lang?: string; card?: boolean }
const { article, lang = DEFAULT_LANG, card = false } = Astro.props;
const S = t(lang).cta;
const lp = (x) => localizedPath(x, lang);
---
<div class="panel cta-exit" style="margin-top:3rem">
  <h2 style="margin-bottom:0.75rem">{S.stuckH}</h2>
  <p class="dim">{S.stuckP}</p>
  <a href={lp("/emergency")} class="btn btn-quiet-danger" data-event="begin_checkout" data-placement={`article_${article}`}><Icon name="siren" /> {S.stuckBtn}
  </a>
  {card && (
    <p class="dim" style="font-size:0.86rem;margin:0.9rem 0 0">
      <a href={lp("/card")} data-placement={`article_${article}_card`}>{S.cardLink}</a>
    </p>
  )}
</div>
<div class="panel" style="margin-top:1rem">
  <p class="dim" style="margin-bottom:0.75rem"><strong>{S.preventP}</strong> {S.preventP2}</p>
  <a href={lp("/prepare")} class="btn btn-neutral" data-event="step_completed" data-step="prepare_click" data-placement={`article_${article}`}><Icon name="shield" /> {S.preventBtn}
  </a>
</div>
<div style="margin-top:1rem">
  <EmailCapture source={`article_${article}`} lang={lang} />
</div>
<a href={lp("/emergency")} class="sticky-cta" data-event="begin_checkout" data-placement={`article_${article}_sticky`}><Icon name="siren" /> {S.sticky}</a>
