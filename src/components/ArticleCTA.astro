---
// The CTA every /fix article ends with (blueprint §2).
// NOTE: Booth Bible CTA removed 2026-07-24, restore from git history at book launch.
// EmailCapture added 2026-07-26 (Antonio's go): fix articles are where cold
// search traffic lands and they captured nothing. Sits below both CTAs so it
// never competes with the rescue.
import EmailCapture from './EmailCapture.astro';
interface Props { article: string }
const { article } = Astro.props;
---
<div class="panel cta-exit" style="margin-top:3rem">
  <h3 style="margin-bottom:0.75rem">Playing soon and still stuck?</h3>
  <p class="dim">The step-by-step emergency flow asks how long you have and walks you through the fastest route, one decision at a time. Free, no account.</p>
  <a href="/emergency" class="btn btn-quiet-danger" data-event="begin_checkout" data-placement={`article_${article}`}><span aria-hidden="true">🚨</span> Start Emergency Mode
  </a>
</div>
<div class="panel" style="margin-top:1rem">
  <p class="dim" style="margin-bottom:0.75rem"><strong>Never want to read this page again?</strong> Set up the prevention system once and this page becomes irrelevant.</p>
  <a href="/prepare" class="btn btn-neutral" data-event="step_completed" data-step="prepare_click" data-placement={`article_${article}`}><span aria-hidden="true">🛡</span> See the prevention checklist
  </a>
</div>
<div style="margin-top:1rem">
  <EmailCapture source={`article_${article}`} />
</div>
<a href="/emergency" class="sticky-cta" data-event="begin_checkout" data-placement={`article_${article}_sticky`}><span aria-hidden="true">🚨</span> PLAYING SOON? START EMERGENCY MODE</a>
