---
/**
 * "Install this" prompt. Homepage only, dismissible for good via the X.
 *
 * Slimmed 2026-07-27 (Antonio): the banner does not TEACH anymore, it points.
 * One title, one honest line, one "How it works" link to /install, which
 * carries the per-platform steps (the "Tap Share in Safari" walkthrough used
 * to float here below the box, orphaned; it lives on /install now).
 *
 * Shown to EVERYONE not already installed: phones and desktops both (Antonio
 * asked for the desktop appearance explicitly). Where the browser supports
 * one-tap install (beforeinstallprompt), the Install button appears too;
 * everywhere else the link is the route.
 *
 * The claim is engineered, not marketing: the service worker precaches the
 * whole rescue tunnel on first visit. Wording must stay honest about the
 * condition ("once you've opened it") because a first-ever visit with no
 * signal has nothing cached. Full scope and conditions live on /install.
 *
 * THE /install LINK IS LANGUAGE AWARE (2026-08-05). It was hardcoded and this
 * banner renders on all three homepages, so a Spanish reader was sent to the
 * English install guide from the Spanish home page.
 *
 * ONLY THE LINK. The copy in this banner is STILL ENGLISH on the Portuguese
 * and Spanish homepages, and that is a known gap, not a decision: it is a
 * content change and it needs Antonio's words in each language, the way
 * PromoBanner and the header search got theirs on 2026-08-05. Translating it
 * is the next job on this component; the link is fixed here because it was
 * failing the i18n link guard, which is a mechanical defect with one right
 * answer.
 */
import { localizedPath, DEFAULT_LANG } from '../i18n/registry';
interface Props { lang?: string }
const { lang = DEFAULT_LANG } = Astro.props;
---
<div class="inst" id="installWrap" hidden>
  <div class="inst-body">
    <span class="inst-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg>
    </span>
    <span class="inst-txt">
      <!-- Inclusive on purpose (Antonio): the reader must understand it
           installs on ANY device they own, not just the one in front of
           them. This banner renders on desktop only (mobile uses the
           rotating banner slide), so one title serves. -->
      <strong class="inst-h" id="installH">Keep this on your computer and your phone</strong>
      <span class="inst-sub">Once you've opened it, the rescue flow stays on this device, even with no signal. <a class="inst-more" href={localizedPath('/install', lang)} data-event="step_completed" data-placement="home_install_more">More &rarr;</a></span>
    </span>
    <button type="button" class="inst-btn" id="installBtn" hidden>Install</button>
    <button type="button" class="inst-close" id="installClose" aria-label="Dismiss">&times;</button>
  </div>
</div>

<style is:global>
  .inst { margin: 2rem 0 0; }
  .inst[hidden] { display: none; }
  /* DESKTOP ONLY (Antonio, 2026-07-27 evening): two banners polluted the
     phone. On mobile the install pitch is a slide in the rotating
     PromoBanner instead; this standalone banner is a desktop feature. */
  @media (max-width: 640px) { .inst { display: none; } }
  .inst-body {
    display: flex; align-items: center; gap: 0.85rem;
    background: var(--surf-2); border: var(--stroke) solid var(--edge);
    border-left: 3px solid var(--green); border-radius: var(--radius);
    padding: 0.9rem 1.1rem;
  }
  .inst-icon {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: var(--radius-round); color: var(--green);
    background: rgba(58,216,132,0.1); border: var(--stroke) solid rgba(58,216,132,0.4);
  }
  .inst-txt { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .inst-h { font-family: var(--font-display); font-weight: 800; font-size: 0.98rem; color: var(--text); }
  .inst-sub { font-size: 0.83rem; color: var(--text-dim); line-height: 1.45; }
  .inst-more { color: var(--green); text-decoration: none; white-space: nowrap; }
  .inst-more:hover { text-decoration: underline; }
  .inst-btn {
    flex: 0 0 auto; min-height: 44px; padding: 0.6rem 1.2rem; cursor: pointer;
    font-family: var(--font-display); font-weight: 800; font-size: 0.85rem;
    text-transform: uppercase; letter-spacing: 0.02em;
    background: var(--green); color: #0a0a0b; border: var(--stroke) solid var(--green);
    border-radius: var(--radius);
  }
  .inst-btn:hover { filter: brightness(1.08); }
  .inst-btn[hidden] { display: none; }
  /* The X lives in the TOP-RIGHT CORNER, absolutely positioned (Antonio,
     from an Android screenshot: in the flex row it wrapped below the
     full-width Install button and doubled the banner's height). Corner
     placement never moves, whatever wraps. */
  .inst-body { position: relative; padding-right: 2.6rem; }
  .inst-close {
    position: absolute; top: 0.3rem; right: 0.3rem;
    width: 34px; height: 34px;
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: none; color: var(--text-faint);
    font-size: 20px; line-height: 1; cursor: pointer;
  }
  .inst-close:hover { color: var(--text); }
  @media (max-width: 520px) {
    .inst-body { flex-wrap: wrap; }
    .inst-btn { width: 100%; }
  }
</style>

<script is:inline>
  (function () {
    var wrap = document.getElementById('installWrap');
    if (!wrap) return;
    var btn = document.getElementById('installBtn');
    var deferred = null;

    // Already running as an installed app: nothing to offer.
    var standalone = window.matchMedia('(display-mode: standalone)').matches ||
                     window.navigator.standalone === true;
    if (standalone) return;
    // Dismissed once = gone for good (Antonio). The X below writes the flag.
    try { if (localStorage.getItem('SMG_INSTALL_DISMISSED') === '1') return; } catch (e) { /* show */ }
    var closeBtn = document.getElementById('installClose');
    if (closeBtn) closeBtn.addEventListener('click', function () {
      wrap.hidden = true;
      try { localStorage.setItem('SMG_INSTALL_DISMISSED', '1'); } catch (e) { /* session-only then */ }
    });

    // Visible for everyone not installed/dismissed; the button only where the
    // browser offers one-tap install. /install covers every manual route.
    wrap.hidden = false;

    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferred = e;
      btn.hidden = false;
    });

    btn.addEventListener('click', function () {
      if (!deferred) return;
      deferred.prompt();
      deferred.userChoice.then(function (c) {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'pwa_install_prompt', { outcome: c.outcome });
        }
        if (c.outcome === 'accepted') wrap.hidden = true;
        deferred = null;
      });
    });

    window.addEventListener('appinstalled', function () {
      wrap.hidden = true;
      if (typeof window.gtag === 'function') window.gtag('event', 'pwa_installed');
    });
  })();
</script>
