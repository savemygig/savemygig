---
/**
 * Group header for the reference accordions (rekordbox + hardware pages).
 *
 * WHY THIS EXISTS: the group headers used colored emoji (🚨 ⚙ 💡...) and
 * Antonio called it: they read as amateur next to the site's stroke-icon
 * language, and they render differently on every OS. These are the same
 * thin monochrome stroke icons the nav and promo banners already use,
 * inheriting the label's color, identical on every platform.
 *
 * Icons: zap (emergency) · warn (known issues) · book (understanding/FAQ) ·
 * usb (drive prep) · sliders (features/settings) · star (best practices) ·
 * bulb (tips) · shield (maintenance) · sync (compatibility)
 */
interface Props {
  icon: 'zap' | 'warn' | 'book' | 'usb' | 'sliders' | 'star' | 'bulb' | 'shield' | 'sync';
  title: string;
}
const { icon, title } = Astro.props;
---
<h2 class="acc-group">
  <span class="acc-gi" aria-hidden="true">
    {icon === 'zap' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>}
    {icon === 'warn' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>}
    {icon === 'book' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>}
    {icon === 'usb' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/></svg>}
    {icon === 'sliders' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M2 14h4"/><path d="M10 8h4"/><path d="M18 16h4"/></svg>}
    {icon === 'star' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
    {icon === 'bulb' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5"/></svg>}
    {icon === 'shield' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>}
    {icon === 'sync' && <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>}
  </span>
  {title}
</h2>

<style is:global>
  /* Layout for the icon inside .acc-group; the header's own styles stay in
     global.css. Icon inherits the label color so it can never clash. */
  .acc-group { display: flex; align-items: center; gap: 0.5rem; }
  .acc-gi { display: inline-flex; flex: 0 0 auto; }
</style>
