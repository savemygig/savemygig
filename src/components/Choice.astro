---
// The universal A/B decision, two pads, one choice. (Old choose.html language.)
interface Opt {
  href: string;
  label: string;
  desc?: string;
  /** GA4 event name; defaults to step_completed */
  event?: string;
  /** extra data-* attrs, e.g. { outcome: 'saved', path: 'critical' } */
  data?: Record<string, string>;
}
interface Props {
  /** step id for GA4 */
  step: string;
  a: Opt; // the green/positive option
  b: Opt; // the red/negative option
  /** Optional 3rd and 4th options, for symptom pickers where the answer is not
   *  yes/no but "which of these is happening". Rendered neutral, not red or
   *  green, because none of them is the good or the bad answer. */
  c?: Opt;
  d?: Opt;
}
const { step, a, b, c, d } = Astro.props;
const extra = [c, d].filter(Boolean) as Opt[];
// A yes/no pair keeps the green/red language. A list of symptoms does not:
// colouring "one channel is silent" green would be meaningless.
const neutral = extra.length > 0;

const attrs = (o: Opt, answer: string) => {
  const out: Record<string, string> = {
    'data-event': o.event ?? 'step_completed',
    'data-step': step,
    'data-answer': answer,
  };
  for (const [k, v] of Object.entries(o.data ?? {})) out[`data-${k}`] = v;
  return out;
};
---
<nav class="pad-grid" aria-label="Choose one">
  <a href={a.href} class:list={['pad', neutral ? 'pad-neutral' : 'pad-green']} {...attrs(a, 'a')}>
    <div class="pad-header">
      <div class:list={['led', neutral ? 'led-n' : 'led-g']}></div>
      <div class="pad-title">{a.label}</div>
    </div>
    {a.desc && <div class="pad-desc">{a.desc}</div>}
  </a>
  <a href={b.href} class:list={['pad', neutral ? 'pad-neutral' : 'pad-red']} {...attrs(b, 'b')}>
    <div class="pad-header">
      <div class:list={['led', neutral ? 'led-n' : 'led-r']}></div>
      <div class="pad-title">{b.label}</div>
    </div>
    {b.desc && <div class="pad-desc">{b.desc}</div>}
  </a>
  {extra.map((o, i) => (
    <a href={o.href} class="pad pad-neutral" {...attrs(o, i === 0 ? 'c' : 'd')}>
      <div class="pad-header">
        <div class="led led-n"></div>
        <div class="pad-title">{o.label}</div>
      </div>
      {o.desc && <div class="pad-desc">{o.desc}</div>}
    </a>
  ))}
</nav>

<!-- .pad-neutral and .led-n now live in global.css. They are part of the shared
     pad vocabulary, and pages that write pads by hand (e.g. /emergency) need
     them without importing this component. -->

