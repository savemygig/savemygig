---
/**
 * Site search.
 *
 * Static site, so this is entirely client side: it fetches /search-index.json
 * once on first interaction (a few KB, then cached) and scores matches in the
 * browser. No backend, no third-party widget, nothing to pay for, and it keeps
 * working offline once loaded.
 *
 * Scoring is deliberately simple and weighted for this site: a hit in the title
 * or in an expandable section's question beats a hit in body text, because on
 * a troubleshooting site the question IS the thing people type.
 *
 * MULTI-INSTANCE: every page carries the overlay search in the header, and
 * /faq and the homepage embed a second box inline. The script used to wire
 * only the FIRST [data-search] on the page, which left the inline boxes
 * looking perfect and doing nothing (Antonio caught it on /faq). Ids are
 * per-instance now and the script wires every instance it finds.
 */
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/registry';

const uid = 'srch-' + Math.random().toString(36).slice(2, 8);
// lang localizes every string this component owns. A page may still pass its
// own placeholder (the homepage and /faq boxes do); the default comes from
// the ui.js catalogue so the header overlay is never English on /pt or /es.
const { lang = 'en', placeholder, shortPlaceholder } = Astro.props;
const S = t(lang);
const ph = placeholder ?? S.search.placeholder;
// A SHORT PLACEHOLDER FOR NARROW PHONES (2026-08-06).
// The homepage hero box asks for 348px of placeholder against 264px of input at
// 360px and 294px at 390px, in all three languages, so the one line on the page
// that says what the box is FOR was cut off mid-word on every phone.
// The checklist solves the identical problem for its RESET LIST / RESET buttons
// with a .bl-full / .bl-short pair swapped by a 640px media query. A
// placeholder is an ATTRIBUTE, not a text node, so CSS cannot reach it: the
// equivalent here is the same 640px boundary expressed once in matchMedia.
// THE SHORT FORM IS WHAT SHIPS IN THE MARKUP and the long one is the upgrade,
// deliberately that way round. If the script never runs, the reader who is hurt
// is the one on the narrow phone, and this way that reader gets a complete
// sentence while a scriptless desktop merely gets a terser one.
// Callers that pass no shortPlaceholder are byte-identical to before: no
// data attribute is emitted and the script's branch is never entered.
const phShort = shortPlaceholder ?? ph;

// EVERYTHING LOCALIZED IS HANDED OVER ON THE WRAPPER, NOT VIA define:vars.
// Two boxes render on the homepage and on /faq (the header overlay plus the
// inline one), so this script is emitted twice on those pages. define:vars
// would emit `const NONE = ...` twice at the top level of the same document,
// which is a duplicate declaration and a SyntaxError: it would kill search
// outright on exactly the two pages that have the most of it. Data attributes
// are per instance and cannot collide.
const idxUrl = `/search-index.${lang}.json`;
const noneBits = {
  for: S.search.noneFor,
  try: S.search.noneTry,
  faq: S.search.noneFaq,
  or: S.search.noneOr,
  start: S.search.noneStart,
  faqHref: localizedPath('/faq', lang),
  startHref: localizedPath('/emergency', lang),
};
---
<div
  class="srch"
  data-search
  data-index={idxUrl}
  data-none-for={noneBits.for}
  data-none-try={noneBits.try}
  data-none-faq={noneBits.faq}
  data-none-or={noneBits.or}
  data-none-start={noneBits.start}
  data-faq-href={noneBits.faqHref}
  data-start-href={noneBits.startHref}
>
  <label class="sr-only" for={uid}>{S.aria.search}</label>
  <div class="srch-box">
    <svg class="srch-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input
      id={uid} type="search" class="srch-input" autocomplete="off"
      placeholder={phShort}
      data-ph-long={shortPlaceholder ? ph : undefined}
      aria-controls={uid + '-results'} aria-expanded="false" role="combobox" aria-autocomplete="list"
    />
    <button type="button" class="srch-clear" aria-label={S.search.clear} hidden>&times;</button>
  </div>
  <div class="srch-results" id={uid + '-results'} role="listbox" aria-label={S.search.results} hidden></div>
</div>

<style is:global>
  .srch { position: relative; width: 100%; max-width: 34rem; }
  /* --edge, NOT --edge-strong (Antonio, 2026-08-05, seeing it live: "I don't
     like line line line on the search box. I prefer the previous version, that
     gray darker like it was before. Go back how it was.").
     The contrast pass that lightened every field edge on the site was right
     about the fields a DJ has to FIND in a dark booth, and wrong here. This box
     is not one of those: it sits under a magnifier icon, it is the widest
     element in the overlay, and it stacks directly above .srch-results, which
     draws its own hairline. Three lightened lines in a column, which is what he
     saw. The fainter edge also puts the box back in step with its own dropdown.
     The accessibility case is not lost, it moves: focus still paints this
     border --red via :focus-within below, and the fields where finding the edge
     genuinely matters (.fbp-input, .cap-form input, and the checklist's own
     inputs) all keep --edge-strong. Do not "fix" this one back. */
  .srch-box { display: flex; align-items: center; gap: 0.6rem;
    background: var(--surf); border: var(--stroke) solid var(--edge); border-radius: var(--radius);
    padding: 0 0.85rem; transition: border-color var(--t-fast); }
  .srch-box:focus-within { border-color: var(--red); }
  .srch-icon { flex: 0 0 auto; color: var(--text-faint); }
  .srch-input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
    color: var(--text); font-family: inherit; font-size: 16px;
    padding: 0.8rem 0; min-height: 44px;
  }
  .srch-input::placeholder { color: var(--text-faint); }
  .srch-input::-webkit-search-cancel-button { display: none; }
  /* The box already shows focus via .srch-box:focus-within (red border). The
     global input:focus-visible outline would stack a second red ring offset
     outside it (the "line over line"), so suppress it just for this input. */
  .srch-input:focus-visible { outline: none; }
  .srch-clear { background: none; border: 0; color: var(--text-dim); font-size: 1.4rem;
    line-height: 1; cursor: pointer; padding: 0 0.2rem; min-height: 44px; }
  .srch-clear:hover { color: var(--text); }

  .srch-results {
    position: absolute; z-index: 60; left: 0; right: 0; top: calc(100% + 6px);
    background: var(--surf-2); border: var(--stroke) solid var(--edge); border-radius: var(--radius);
    max-height: 62vh; overflow-y: auto; box-shadow: var(--shadow-overlay);
  }
  .srch-results[hidden] { display: none; }
  .srch-hit { display: block; padding: 0.75rem 0.95rem; text-decoration: none;
    border-bottom: var(--stroke) solid var(--edge-soft); }
  .srch-hit:last-child { border-bottom: none; }
  .srch-hit:hover, .srch-hit.on { background: var(--surf); }
  .srch-hit-t { display: block; font-family: var(--font-display); font-weight: 700;
    font-size: 0.95rem; color: var(--text); line-height: 1.3; }
  .srch-hit-d { display: block; font-size: 0.82rem; color: var(--text-dim);
    line-height: 1.45; margin-top: 2px; }
  .srch-hit mark { background: rgba(255,77,46,0.22); color: var(--text); border-radius: var(--radius); }
  .srch-none { padding: 0.9rem 0.95rem; font-size: 0.88rem; color: var(--text-dim); }
  .srch-none a { color: var(--red); }
</style>

{/* THE WIRING LIVES IN src/scripts/site.ts (2026-08-06, perf batch 8).
    It was 6.5 KB of is:inline in here, shipped inside every document that
    carries a search box, and TWICE inside the homepage and /faq because those
    two render a second box. Nothing about it had to be inline: every localized
    string already rode on the wrapper as a data attribute (see the note above
    the markup, and it is the reason two boxes never collided), so the block
    moved out unchanged and is now one cacheable file for the whole site. The
    "wire every instance that is not wired yet" guard is kept there.

    WHAT STAYED HERE, and only this. The long placeholder is an ATTRIBUTE, so
    CSS cannot reach it and the swap has to be script. It MUTATES WHAT IS
    ALREADY ON SCREEN, which is the one thing a deferred module must not do:
    a desktop reader would see the short placeholder and then watch it be
    replaced. The markup ships short on purpose (see the note above), so the
    upgrade has to happen before first paint, and inline is what does that.
    It is emitted only for callers that pass a shortPlaceholder, which is the
    homepage hero box and /faq: six documents, about 250 bytes each.
    NO TYPESCRIPT AND NO define:vars IN HERE. is:inline ships the block byte
    for byte; see EmailCapture.astro for what that costs when it is forgotten.
    Written against [data-ph-long] rather than an id, and marked done on the
    element, so a page with two of these wires each exactly once. */}
{shortPlaceholder && (
  <script is:inline>
    (function () {
      var wide = window.matchMedia('(min-width: 641px)');
      document.querySelectorAll('input[data-ph-long]').forEach(function (input) {
        if (input.dataset.phDone) return;
        input.dataset.phDone = '1';
        var phLong = input.dataset.phLong;
        var phShort = input.getAttribute('placeholder');
        var applyPh = function () {
          input.setAttribute('placeholder', wide.matches ? phLong : phShort);
        };
        applyPh();
        if (wide.addEventListener) wide.addEventListener('change', applyPh);
        else if (wide.addListener) wide.addListener(applyPh);
      });
    })();
  </script>
)}
