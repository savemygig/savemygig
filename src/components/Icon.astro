---
/**
 * INLINE UI ICON. One definition per glyph, ~60 call sites.
 *
 * WHY THIS EXISTS (2026-08-06). The most urgent buttons on the site used
 * COLOUR EMOJI as their icons, sitting beside an otherwise disciplined 17px
 * monochrome stroke set: a glossy 3D siren inside START EMERGENCY MODE, a
 * shield in SEE THE PREVENTION CHECKLIST, a yellow warning triangle inside a
 * RED danger panel on /recovery, a plug on /saved, a phone on /card. The
 * design system has said "monochrome stroke icons always" since the polish
 * sprint, and the rescue tunnel and the /gear and /files-lost headers were
 * cleaned up under that rule on 2026-08-03; the CTA labels were missed because
 * the emoji lived inside the label string rather than in an icon slot.
 *
 * Emoji are the wrong tool here for reasons that are not taste:
 *  - They cannot take the button's colour. A red danger panel got a yellow
 *    triangle, so one card told two colour stories at once. currentColor makes
 *    a tone break structurally impossible.
 *  - They render at whatever size and shape the platform feels like, from a
 *    flat Android glyph to an Apple 3D render, next to icons drawn at a fixed
 *    17px and 2px stroke.
 *  - They cost width nobody budgeted. Dropping them recovered enough room to
 *    stop the two-line wrap on "See the prevention checklist" at 390.
 *
 * The geometry is the house recipe, unchanged: 24-unit viewBox, no fill,
 * currentColor stroke, 2px, round caps and joins, aria-hidden. Same values as
 * the sets already inlined in AccGroup.astro, PromoBanner.astro, Search.astro
 * and the checklist group headers. `size` exists because the promo banner uses
 * 19-22px and the checklist chips use 13px; 17px is the button default.
 *
 * ALWAYS DECORATIVE. Every one of these sits next to a text label that already
 * says what the control does, so the icon is aria-hidden and never the
 * accessible name. If a glyph ever has to carry meaning on its own, give that
 * call site a .sr-only word instead of putting a title in here.
 */
interface Props { name: string; size?: number; class?: string }
const { name, size = 17, class: cls = '' } = Astro.props;
const c = ['ic', cls].filter(Boolean).join(' ');
---
{name === 'siren' && (
  /* Beacon, not a police light: dome, base, and two rays. The rays are what
     make it read as "alarm" rather than "arch" at 17px, and there are two
     rather than lucide's five because at this size five became noise. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18v-5a5 5 0 0 1 10 0v5"/><path d="M5 18h14a1 1 0 0 1 1 1v2H4v-2a1 1 0 0 1 1-1z"/><path d="M12 2v2"/><path d="M4.4 6.4 5.8 7.8"/><path d="M19.6 6.4 18.2 7.8"/></svg>
)}
{name === 'shield' && (
  /* Byte for byte the shield already used by AccGroup.astro, so prevention
     reads the same on a fix article as it does in a knowledge accordion. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
)}
{name === 'warn' && (
  /* Same triangle as AccGroup's 'warn' and PromoBanner's 'alert'. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
)}
{name === 'usb' && (
  /* The site's own USB stick, already on the promo banner and the checklist
     group headers. It replaces a plug emoji: this site talks about drives, not
     mains power, so the stick is also the more honest glyph. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="7" rx="1"/><path d="M12 9v11"/><path d="M8 20h8"/></svg>
)}
{name === 'phone' && (
  /* New glyph, drawn to the same recipe: /card's "screenshot this page" line
     had no stroke equivalent anywhere in the set. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M12 18h.01"/></svg>
)}
{name === 'wrench' && (
  /* Recovery software on /files-lost. Also new, same reason as 'phone'. */
  <svg class={c} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>
)}
